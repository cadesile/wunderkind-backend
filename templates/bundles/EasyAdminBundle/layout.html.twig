{% extends '@!EasyAdmin/layout.html.twig' %}

{#
  The redesigned admin shell. See assets/design_handoff_admin_overhaul/README.md
  (§4) and reference/example-clubs.html for the target markup.

  Three overrides carry the shell:
    head_favicon    — kept from before, null-guards the admin context.
    header_logo     — the sidebar head: brand, server clock, ⌘K jump button.
    wrapper_wrapper — the whole two-column .bmc-shell grid.

  Why wrapper_wrapper and not wrapper: .bmc-shell is a 100vh grid that owns its
  own scrolling, so it cannot sit inside EasyAdmin's .wrapper div — and that div
  is emitted OUTSIDE {% block wrapper %}. Taking wrapper_wrapper instead drops
  it, and with it the three {% set %} blocks that build the user-menu avatar,
  the user-menu dropdown and the settings dropdown — none of which the new shell
  renders (the admin's email and log-out move to .bmc-side__foot).

  What replacing it deliberately gives up: EasyAdmin's responsive header (the
  mobile nav toggle), its global search box, the colour-scheme switcher and the
  two resizer handles. The design replaces search with the ⌘K palette plus the
  per-page filter rail, and is dark-only by intent. There is consequently no
  mobile navigation, which matches §10: "the sidebar keeps a fixed width".
#}

{#
  Override head_favicon to guard against null admin context.
  When the EasyAdmin context isn't set up (e.g. during exception rendering
  or direct route access), ea() returns null and asset(null) throws a TypeError.
#}
{% block head_favicon %}
    {% set _ea = ea() %}
    {% if _ea is not null %}
        <link rel="shortcut icon" href="{{ asset(_ea.dashboardFaviconPath) }}">
    {% endif %}
{% endblock %}

{#
  The sidebar head. Rendered into .bmc-side__head by the wrapper_wrapper
  override below, not by EasyAdmin's own sidebar component.

  The server clock is the same idea as before the redesign: the admin panel is
  where cron-driven work is reasoned about — competition draws run every minute,
  rounds resolve on a schedule — and the server runs UTC while the operator
  rarely does. The rendered value is the initial paint and the no-JS fallback;
  the data attribute is what the ticker anchors to. Both are server time, and
  public/bmc-admin.js (§7) now owns the tick with the same skew logic.
#}
{% block header_logo %}
    <a class="bmc-brand" href="{{ path(ea.dashboardRouteName) }}">
        <img src="{{ asset('logo-192.png') }}" alt="">
        <span class="bmc-brand__name"><span>BUILD MY CLUB</span><span>ADMIN</span></span>
    </a>
    <div class="bmc-clock" id="bmc-server-clock"
         data-server-time="{{ 'now'|date('c') }}"
         title="Server time (UTC) — not your local time">
        {# The zone lives on the label, not the value: it never changes, and
           carrying it on the value crowds the narrow sidebar. #}
        <span class="bmc-clock__label">UTC</span>
        <span class="bmc-clock__value">{{ 'now'|date('Y-m-d H:i:s') }}</span>
    </div>
    <button type="button" class="bmc-jump" data-bmc-open-palette title="Jump to any page">
        <i data-lucide="search" width="16" height="16"></i>
        <span class="bmc-jump__text">Jump to page…</span><span class="bmc-kbd">⌘K</span>
    </button>
{% endblock %}

{% block wrapper_wrapper %}
    {#
      data-bmc-page is the key bmc-admin.js matches against the nav links'
      data-page to drive PINNED and RECENT.

      It is derived from the label of whichever menu item EasyAdmin marked
      selected, through the same replace map menu.html.twig uses — so the two
      sides are the same string by construction and cannot drift. Deriving it
      from ea.crud.entityLabelInPlural instead would look simpler but breaks
      wherever the menu renames a page (the menu's "Awards" against
      LeaderboardPeriodArchiveEntry's own plural label, for one).

      bmc_page still wins if a controller sets it, which is the escape hatch
      for pages that are reached without a menu entry of their own.
    #}
    {# Written as one reduce rather than a nested for/if because Twig scopes
       {% set %} to the loop body — assigning inside a {% for %} would not be
       visible out here. Exactly one menu item can be selected, so folding the
       labels into a string yields that one label, or '' off-menu. #}
    {% set _bmc_page = bmc_page|default(null) %}
    {% if _bmc_page is null %}
        {% set _selected_label = ea.mainMenu.items|reduce(
            (carry, item) => carry ~ item.subItems|reduce((c, sub) => c ~ (sub.selected ? sub.label|trans : ''), ''),
            ''
        ) %}

        {#
          FALLBACK, AND IT IS NOT AN EDGE CASE. EasyAdmin marks a menu item selected by
          matching the whole query string, so the moment a custom page carries a parameter of
          its own — ?country=US&tier=8 on the starter pack check, routeParams[country] on the
          locations dashboard — NOTHING is selected, the label folds to '', and the page
          renders with no data-bmc-page at all. The pin button then silently does nothing.

          That had already shipped broken on the locations dashboard, which is reached with a
          country every time an operator picks one, and on Enrichment.

          So: fall back to the sub-item whose link carries the same routeName as this request.
          It yields the SAME label, and therefore the same slug, as the selected path — a page
          pinned bare and the same page pinned with parameters must not be two entries.
        #}
        {% if _selected_label is empty and app.request.query.get('routeName') %}
            {% set _route = app.request.query.get('routeName') %}
            {% set _selected_label = ea.mainMenu.items|reduce(
                (carry, item) => carry ~ item.subItems|reduce(
                    (c, sub) => (('routeName=' ~ _route) in sub.linkUrl|default('')) ? sub.label|trans : c,
                    ''
                ),
                ''
            ) %}
        {% endif %}

        {% if _selected_label is not empty %}
            {% set _bmc_page = _selected_label|lower|replace({' & ': '-', ' / ': '-', ' ': '-'}) %}
        {% endif %}
    {% endif %}

    <div class="bmc-shell">
        <aside class="bmc-side" aria-label="Admin navigation">
            <div class="bmc-side__head">
                {{ block('header_logo') }}
            </div>

            {# Renders templates/bundles/EasyAdminBundle/menu.html.twig, which
               emits <nav class="bmc-nav"> with the PINNED / RECENT slots. #}
            {{ include(ea.templatePath('main_menu')) }}

            <div class="bmc-side__foot">
                <span class="bmc-side__user">{{ app.user ? app.user.userIdentifier : '' }}</span>
                <a class="bmc-iconbtn bmc-iconbtn--sm" href="{{ path('admin_logout') }}"
                   title="Log out" aria-label="Log out">
                    <i data-lucide="log-out" width="16" height="16"></i>
                </a>
            </div>
        </aside>

        {#
          .bmc-main is the scroll container. Re-declaring content /
          content_header_wrapper / main here is what keeps every page that
          already overrides one of them working — Twig resolves blocks by name,
          not by nesting. That covers templates/admin/dashboard.html.twig
          (overrides content) and the ~30 tool pages that extend this layout.
        #}
        <main class="bmc-main"{% if _bmc_page %} data-bmc-page="{{ _bmc_page }}"{% endif %}>
            {% block content %}
                {#
                  content_header_wrapper is reproduced from @!EasyAdmin/layout.html.twig
                  VERBATIM, and it has to be.

                  Re-declaring it empty here — which is what this did at first — overrides the
                  parent's definition for EVERY page, not just the redesigned ones. The result
                  was that every stock CRUD page silently lost its title, its help popover and
                  its whole page-actions row: New, Filters and Sort. The redesigned pages were
                  unaffected because bmc_index.html.twig overrides this block itself, which is
                  exactly why it went unnoticed.

                  So the default has to be the real thing. Pages that want the new page strip
                  override this block; pages that have not been redesigned get what they always
                  had.
                #}
                {% block content_header_wrapper %}
                    {% set crud_help_message = ea.crud.helpMessage ?? null %}
                    {% set has_help_message = crud_help_message is ea_is_not_empty %}
                    <section class="content-header">
                        {% block content_header %}
                            <div class="content-header-title">
                                <h1 class="title">
                                    {% block content_title %}{% endblock %}

                                    {% block content_help %}
                                        {% if has_help_message %}
                                            <a tabindex="0" class="content-header-help" data-bs-toggle="popover" data-bs-custom-class="ea-content-help-popover" data-bs-animation="true" data-bs-html="true" data-bs-placement="bottom" data-bs-trigger="focus" data-bs-content="{{ ea.crud.helpMessage|trans|e('html') }}">
                                                <twig:ea:Icon name="internal:circle-info" />
                                            </a>
                                        {% endif %}
                                    {% endblock %}
                                </h1>
                            </div>

                            {% block page_actions_wrapper %}
                                <div class="page-actions">{% block page_actions %}{% endblock %}</div>
                            {% endblock %}
                        {% endblock content_header %}
                    </section>
                {% endblock content_header_wrapper %}

                <section id="main" class="content-body">
                    {% block main %}{% endblock %}
                </section>
                {% block content_footer_wrapper %}{% endblock %}
            {% endblock content %}
        </main>
    </div>
{% endblock wrapper_wrapper %}

{# Flashes are rendered as toasts in body_javascript instead. Kept as an
   explicit empty block so anything still calling it renders nothing rather
   than showing every message twice. #}
{% block flash_messages %}{% endblock %}

{% block body_javascript %}
{{ parent() }}
{# The trophy preview that used to live here is gone: it recoloured a static
   black SVG (/images/trophies/trophy-N.svg) with a CSS filter chain, and both
   that asset set and the trophyImage/trophyColour columns behind it have been
   replaced by the 16-bit trophy sprite. The preview is now part of the field
   widget itself (templates/admin/field/trophy_config.html.twig), rendered by
   composeTrophySvg() — so it no longer has to be bolted onto every admin page
   load just in case a League form happens to be the one being shown. #}

{# ── Global delete confirmation modal ──────────────────────────────────────── #}
<div class="modal fade" id="adminDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:500px;">
        <div class="modal-content">
            <form method="POST" id="adminDeleteForm" action="">
                <input type="hidden" name="_token" id="adminDeleteToken" value="">
                <input type="hidden" name="deleteUser" id="adminDeleteUserInput" value="0">
                <div class="modal-header py-2" style="background:rgba(var(--bs-danger-rgb),.08);border-bottom-color:rgba(var(--bs-danger-rgb),.25);">
                    <h6 class="modal-title fw-semibold mb-0 text-danger" id="adminDeleteModalTitle">
                        <i class="fa fa-trash me-1"></i> Delete
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="adminDeleteModalBody">
                    <div class="text-center py-3 text-muted small">
                        <i class="fa fa-spinner fa-spin me-1"></i> Loading…
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger" id="adminDeleteConfirmBtn" disabled>
                        <i class="fa fa-trash fa-xs me-1"></i>
                        <span id="adminDeleteConfirmLabel">Delete</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var modal      = document.getElementById('adminDeleteModal');
    var form       = document.getElementById('adminDeleteForm');
    var body       = document.getElementById('adminDeleteModalBody');
    var titleEl    = document.getElementById('adminDeleteModalTitle');
    var tokenInput = document.getElementById('adminDeleteToken');
    var userInput  = document.getElementById('adminDeleteUserInput');
    var confirmBtn = document.getElementById('adminDeleteConfirmBtn');
    var confirmLbl = document.getElementById('adminDeleteConfirmLabel');
    var bsModal    = null;

    if (!modal) return;

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-delete-trigger]');
        if (!btn) return;
        e.preventDefault();

        var infoUrl   = btn.href;
        var deleteUrl = infoUrl.replace('/delete-info', '/delete');

        body.innerHTML = '<div class="text-center py-3 text-muted small"><i class="fa fa-spinner fa-spin me-1"></i> Loading…</div>';
        confirmBtn.disabled = true;
        form.action = deleteUrl;
        userInput.value = '0';

        if (!bsModal) bsModal = new bootstrap.Modal(modal);
        bsModal.show();

        fetch(infoUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) { renderBody(d, btn.dataset.deleteMode || 'club'); })
            .catch(function () {
                body.innerHTML = '<div class="text-danger small p-2">Failed to load details. Please try again.</div>';
            });
    });

    function renderBody(d, mode) {
        if (mode === 'user') { renderUserBody(d); } else { renderClubBody(d); }
        tokenInput.value = d.csrfToken;
        confirmBtn.disabled = false;
    }

    function renderClubBody(d) {
        titleEl.innerHTML = '<i class="fa fa-trash me-1"></i> Delete Club';

        var otherHtml = '';
        if (d.otherClubs && d.otherClubs.length > 0) {
            otherHtml = '<div id="adminDelOtherClubs" style="display:none;margin-top:.6rem;border-left:3px solid var(--bs-danger);background:rgba(var(--bs-danger-rgb),.06);padding:.5rem .75rem;">'
                + '<div style="font-size:.78rem;font-weight:600;color:var(--bs-danger);margin-bottom:.25rem;"><i class="fa fa-triangle-exclamation me-1"></i>'
                + d.otherClubs.length + ' other club' + (d.otherClubs.length !== 1 ? 's' : '') + ' will also be deleted:</div>'
                + d.otherClubs.map(function (n) { return '<div style="font-size:.73rem;font-family:monospace;color:var(--bs-secondary-color);"><i class="fa fa-caret-right fa-xs me-1"></i>' + esc(n) + '</div>'; }).join('')
                + '</div>';
        }

        body.innerHTML = '<div class="mb-3" style="font-size:.85rem;">'
            + '<div class="d-flex gap-2 mb-1"><span class="text-muted" style="min-width:3rem;">Club</span><strong>' + esc(d.clubName) + '</strong></div>'
            + '<div class="d-flex gap-2"><span class="text-muted" style="min-width:3rem;">Owner</span><span class="font-monospace">' + esc(d.userEmail) + '</span></div>'
            + '</div><hr class="my-2">'
            + '<p class="small text-muted mb-2">What should be deleted?</p>'
            + '<div class="form-check mb-2"><input class="form-check-input" type="radio" name="deleteScope" id="delScopeClub" value="club" checked>'
            + '<label class="form-check-label" for="delScopeClub"><strong>This club only</strong>'
            + '<span class="d-block text-muted" style="font-size:.78rem;">Players, staff and records removed. User account kept.</span></label></div>'
            + '<div class="form-check mb-1"><input class="form-check-input" type="radio" name="deleteScope" id="delScopeUser" value="user">'
            + '<label class="form-check-label" for="delScopeUser"><strong class="text-danger">Club + user account</strong>'
            + '<span class="d-block text-muted" style="font-size:.78rem;">Deletes <strong>' + esc(d.userEmail) + '</strong> and all clubs they own.</span></label></div>'
            + otherHtml;

        updateClubScope();
        var rc = document.getElementById('delScopeClub');
        var ru = document.getElementById('delScopeUser');
        if (rc) rc.addEventListener('change', updateClubScope);
        if (ru) ru.addEventListener('change', updateClubScope);
    }

    function updateClubScope() {
        var ru = document.getElementById('delScopeUser');
        var sel = ru && ru.checked;
        userInput.value = sel ? '1' : '0';
        confirmLbl.textContent = sel ? 'Delete Club & User' : 'Delete Club';
        var warn = document.getElementById('adminDelOtherClubs');
        if (warn) warn.style.display = sel ? 'block' : 'none';
    }

    function renderUserBody(d) {
        titleEl.innerHTML = '<i class="fa fa-user-slash me-1"></i> Delete User';
        userInput.value = '1';
        confirmLbl.textContent = 'Delete User & All Clubs';

        var clubsHtml = '';
        if (d.clubs && d.clubs.length > 0) {
            clubsHtml = '<div class="mb-3"><div class="small text-muted mb-1">All clubs will be permanently deleted:</div>'
                + d.clubs.map(function (n) {
                    return '<div style="font-size:.73rem;font-family:monospace;padding:.15rem .4rem;background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);margin-bottom:.2rem;">'
                        + '<i class="fa fa-caret-right fa-xs me-1 text-danger"></i>' + esc(n) + '</div>';
                }).join('') + '</div>';
        }

        body.innerHTML = '<div class="mb-2" style="font-size:.85rem;">'
            + '<div class="d-flex gap-2"><span class="text-muted" style="min-width:3rem;">User</span><span class="font-monospace">' + esc(d.userEmail) + '</span></div>'
            + '</div>' + clubsHtml
            + '<div class="alert alert-danger py-2 small mb-0">'
            + '<i class="fa fa-triangle-exclamation me-1"></i>This action is <strong>permanent and cannot be undone</strong>.</div>';
    }

    function esc(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
}());
</script>

{# ── Redesign overlays ─────────────────────────────────────────────────────── #}
{# The ⌘K palette reads its page list from the rendered nav links, so it needs
   no config of its own and only ever lists pages this admin can see —
   EasyAdmin has already applied setPermission() by the time the menu renders. #}
<div class="bmc-overlay">
    <div class="bmc-scrim" id="bmc-palette" hidden>
        <div class="bmc-palette" role="dialog" aria-modal="true" aria-label="Jump to page">
            <div class="bmc-palette__head">
                <i data-lucide="search" width="18" height="18"></i>
                <input class="bmc-input" id="bmc-palette-q" type="text" placeholder="Jump to page…"
                       role="combobox" aria-expanded="true" aria-controls="bmc-palette-list" autocomplete="off">
                <span class="bmc-kbd">ESC</span>
            </div>
            <ul class="bmc-palette__list" id="bmc-palette-list" role="listbox"></ul>
            <div class="bmc-palette__empty" id="bmc-palette-empty" hidden>NO PAGES MATCH</div>
            <div class="bmc-palette__foot"><span>↑↓ MOVE</span><span>↵ OPEN</span><span>⌘K TOGGLE</span></div>
        </div>
    </div>

    {# Flashes → toasts. The container stacks them: .bmc-toast is position:fixed
       in the stylesheet, so without it several flashes land on top of each
       other at the same bottom:24px. #}
    {% set _flashes = app.flashes %}
    {% if _flashes is not empty %}
        <div class="bmc-toasts">
            {% for type, messages in _flashes %}
                {% for message in messages %}
                    <div class="bmc-toast" role="status">{{ message|upper }}</div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
