{% extends 'admin/bmc_page.html.twig' %}
{#
  Locations & land → Configuration, on bmc_page + bmc-pages.css/js.
  Data: LocationConfigController::overview().

  TWO SAVE BARS, BOTH INLINE, AND NO STICKY ONE. Every other redesigned settings page has a
  single sticky bar because it has a single form. This page has two, and keeping them apart is
  a decision already argued on LocationConfigController::saveBands(): the plot counts change
  how much land a town of a given size carries, while the bands change what every town IS and
  need a recalculation run afterwards before they mean anything. One bar over two forms would
  have to lie about which of those it had just done. Two STICKY bars is not an option either —
  both would pin to bottom:0 and overlap — so each form carries its own .bmc-savebar--inline,
  in the card whose fields it saves.

  The top-up and the recalculation are ACTIONS, not settings: plain forms and a job queue, no
  dirty tracking, each confirming for itself.
#}

{% set totals = {
    towns:  estate|reduce((c, r) => c + r.towns,  0),
    priced: estate|reduce((c, r) => c + r.priced, 0),
    plots:  estate|reduce((c, r) => c + r.plots,  0),
} %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_locations_dashboard'}) }}"><span>DASHBOARD</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ ea_url().setController('App\\Controller\\Admin\\LocationCrudController').setAction('index').generateUrl() }}"><span>TOWNS</span></a>
{% endblock %}

{% block bmc_body %}

{# ── what the settings currently add up to ───────────────────────────── #}
<div class="bmc-stats bmc-stats--card">
    <div class="bmc-stat">
        <span class="bmc-stat__label">TOWNS</span>
        <span class="bmc-stat__value">{{ totals.towns|number_format }}</span>
        <span class="bmc-stat__sub">active, all countries</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">PRICED</span>
        <span class="bmc-stat__value">{{ totals.priced|number_format }}</span>
        <span class="bmc-stat__sub">{{ totals.towns > totals.priced ? (totals.towns - totals.priced)|number_format ~ ' awaiting enrichment' : 'every town valued' }}</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">PLOTS NOW</span>
        <span class="bmc-stat__value">{{ totals.plots|number_format }}</span>
        <span class="bmc-stat__sub">on the ground</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">TO ADD</span>
        <span class="bmc-stat__value {{ shortfall > 0 ? 'ink-accent' : 'ink-dim' }}">{{ shortfall|number_format }}</span>
        <span class="bmc-stat__sub">{{ shortfall > 0 ? 'priced towns below target' : 'every priced town at target' }}</span>
    </div>
</div>

<div class="bmc-rule"><span class="bmc-rule__title">SETTINGS</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">Balance dials · no deploy needed</span></div>

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(420px,1fr))">

    {# ── plots per city size ─────────────────────────────────────────── #}
    <form method="post" action="{{ path('admin', {routeName: 'admin_location_config_save_plots'}) }}" data-bmc-form id="plots-form" style="display:contents">
        <input type="hidden" name="_token" value="{{ csrf_token('location_config_plots') }}">
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head">
                <i data-lucide="map"></i>
                <span class="bmc-card__title">PLOTS PER CITY SIZE</span>
                <span class="bmc-card__meta">{{ npcPlotCap }} max taken by NPC clubs</span>
            </div>
            <div class="bmc-setting__help bmc-pretty" style="padding:10px 12px 4px">
                How many clubs a town can hold. Generated clubs take at most {{ npcPlotCap }} plots in any
                one town, so a town with fewer than that is full the moment anything is generated there.
            </div>

            {% for size in citySizes %}
                {% set row = estate[size.value] ?? {'towns': 0, 'priced': 0, 'plots': 0} %}
                {% set v   = plots[size.value] %}
                <div class="bmc-setting" data-bmc-setting>
                    <div class="bmc-setting__text">
                        <span class="bmc-setting__label">{{ size.value }}</span>
                        <span class="bmc-setting__help">
                            {{ row.towns|number_format }} town(s) ·
                            {{ row.priced|number_format }} priced ·
                            {{ row.plots|number_format }} plot(s) now
                        </span>
                        <span class="bmc-setting__hint" data-bmc-hint
                              data-default="Default {{ defaults[size.value] ?? '—' }}{% if row.priced < row.towns %} · {{ (row.towns - row.priced)|number_format }} still awaiting enrichment{% endif %}"></span>
                    </div>
                    <div class="bmc-setting__ctl">
                        <label class="bmc-num" style="width:88px">
                            <input name="plots_{{ size.value }}" inputmode="numeric" value="{{ v }}"
                                   data-saved="{{ v }}" data-min="{{ minPlots }}" data-max="{{ maxPlots }}"
                                   aria-label="Plots for a {{ size.value|lower }} town">
                        </label>
                        <button type="button" class="bmc-revert" hidden title="Revert to saved" aria-label="Revert to saved">
                            <i data-lucide="rotate-ccw" width="16" height="16"></i>
                        </button>
                    </div>
                </div>
            {% endfor %}

            <div class="bmc-savebar bmc-savebar--inline" data-bmc-savebar
                 data-idle="Changes the target only — existing towns keep the plots they have.">
                <span class="bmc-savebar__dot"></span>
                <span class="bmc-savebar__title">ALL SAVED</span>
                <span class="bmc-savebar__sub"></span>
                <button type="button" class="bmc-btn" data-bmc-discard><span>DISCARD</span></button>
                <button type="submit" class="bmc-btn bmc-btn--yellow" data-bmc-save><span>SAVE PLOTS</span></button>
            </div>
        </section>
    </form>

    {# ── city size bands ─────────────────────────────────────────────── #}
    <form method="post" action="{{ path('admin', {routeName: 'admin_location_config_save_bands'}) }}" data-bmc-form id="bands-form" style="display:contents">
        <input type="hidden" name="_token" value="{{ csrf_token('location_config_bands') }}">
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head">
                <i data-lucide="chart-no-axes-column"></i>
                <span class="bmc-card__title">CITY SIZE BANDS</span>
                <span class="bmc-card__meta">rank within a country, not absolute population</span>
            </div>
            <div class="bmc-setting__help bmc-pretty" style="padding:10px 12px 4px">
                Every priced town in a country is ordered by population; the top slice is BIG, the bottom
                slice is SMALL, whatever is left is MEDIUM. So &ldquo;big&rdquo; means big compared with its
                neighbours, and a capital is forced BIG whatever its rank.
            </div>

            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">BIG</span>
                    <span class="bmc-setting__help">Top share by population</span>
                    <span class="bmc-setting__hint" data-bmc-hint data-default="Tested first, so it wins an overlap"></span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num" style="width:88px">
                        <input name="bigSharePercent" id="bigSharePercent" inputmode="numeric" value="{{ bigShare }}"
                               data-saved="{{ bigShare }}" data-min="{{ minShare }}" data-max="{{ maxShare }}"
                               aria-label="Big share, percent">
                    </label>
                    <span class="bmc-unitword" style="width:14px">%</span>
                    <button type="button" class="bmc-revert" hidden title="Revert to saved" aria-label="Revert to saved">
                        <i data-lucide="rotate-ccw" width="16" height="16"></i>
                    </button>
                </div>
            </div>

            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">SMALL</span>
                    <span class="bmc-setting__help">Bottom share by population</span>
                    <span class="bmc-setting__hint" data-bmc-hint data-default="Gives way if the two overlap"></span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num" style="width:88px">
                        <input name="smallSharePercent" id="smallSharePercent" inputmode="numeric" value="{{ smallShare }}"
                               data-saved="{{ smallShare }}" data-min="{{ minShare }}" data-max="{{ maxShare }}"
                               aria-label="Small share, percent">
                    </label>
                    <span class="bmc-unitword" style="width:14px">%</span>
                    <button type="button" class="bmc-revert" hidden title="Revert to saved" aria-label="Revert to saved">
                        <i data-lucide="rotate-ccw" width="16" height="16"></i>
                    </button>
                </div>
            </div>

            <div class="bmc-setting">
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">MEDIUM</span>
                    <span class="bmc-setting__help">Whatever is left over</span>
                    <span class="bmc-setting__hint" id="mediumShareNote"></span>
                </div>
                <div class="bmc-setting__ctl">
                    <span class="bmc-badge bmc-badge--subtle" id="mediumSharePreview">{{ mediumShare }}%</span>
                </div>
            </div>

            <div class="bmc-savebar bmc-savebar--inline" data-bmc-savebar
                 data-idle="Stores the bands — nothing is re-sorted until you recalculate below.">
                <span class="bmc-savebar__dot"></span>
                <span class="bmc-savebar__title">ALL SAVED</span>
                <span class="bmc-savebar__sub"></span>
                <button type="button" class="bmc-btn" data-bmc-discard><span>DISCARD</span></button>
                <button type="submit" class="bmc-btn bmc-btn--yellow" data-bmc-save><span>SAVE BANDS</span></button>
            </div>
        </section>
    </form>
</div>

<div class="bmc-rule"><span class="bmc-rule__title">APPLY TO THE ESTATE</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">Settings above do nothing on their own</span></div>

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(420px,1fr))">

    {# ── top up ──────────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="trending-up"></i>
            <span class="bmc-card__title">TOP UP EXISTING TOWNS</span>
            <span class="bmc-card__meta">{{ shortfall|number_format }} to add</span>
        </div>
        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                Brings every <strong>priced</strong> town up to the plots its size calls for. An unpriced
                town stays at zero until enrichment values it — a plot with no land value cannot be bought,
                and creating one would only make the catalogue offer a purchase that fails. Free, no API
                calls, and safe to run repeatedly: it tops up and never removes.
            </p>

            {% if shortfall == 0 %}
                <span class="bmc-empty-note">EVERY PRICED TOWN ALREADY MATCHES ITS TARGET</span>
            {% endif %}

            <form method="post" action="{{ path('admin', {routeName: 'admin_location_config_provision'}) }}"
                  style="display:flex;flex-direction:column;gap:10px;margin-top:10px">
                <input type="hidden" name="_token" value="{{ csrf_token('location_config_provision') }}">

                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <label class="bmc-lbl bmc-lbl--ink" for="provisionCountry">COUNTRY</label>
                    <span class="bmc-select">
                        <select name="country" id="provisionCountry" style="min-width:160px">
                            <option value="">All countries</option>
                            {% for code in seedable %}
                                <option value="{{ code }}">{{ code }}</option>
                            {% endfor %}
                        </select>
                    </span>
                </div>

                <label class="bmc-check" style="padding-left:0">
                    <input type="checkbox" id="provisionDryRun" name="dry_run" value="1" checked>
                    <span class="bmc-tile"></span>
                    <span class="bmc-data">Dry run — report what would change, write nothing</span>
                </label>

                <button type="submit" class="bmc-btn bmc-btn--blue" style="align-self:flex-start"><span>RUN TOP-UP</span></button>
            </form>
        </div>
    </section>

    {# ── recalculate ─────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club" id="reclassify">
        <div class="bmc-card__head">
            <i data-lucide="rotate-cw"></i>
            <span class="bmc-card__title">RECALCULATE EVERY TOWN'S SIZE</span>
            <span class="bmc-card__meta">{{ reclassifyPlan|length }} country(s) with priced towns</span>
        </div>
        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                One step per country, run in sequence. Each step re-ranks that country's priced towns and
                writes their new size. Towns with no population sit out — they join the ranking when
                enrichment prices them. A town that moves <em>down</em> also gives up any land plot nobody
                holds; plots that are claimed or on hold are left alone.
            </p>

            {% if reclassifyPlan is empty %}
                <span class="bmc-empty-note">NO PRICED TOWNS YET, SO NOTHING TO RANK</span>
            {% else %}
                <button type="button" class="bmc-btn bmc-btn--orange" id="reclassifyRun" style="margin-top:10px"
                        data-url="{{ path('admin_location_config_reclassify_chunk') }}"
                        data-token="{{ csrf_token('location_config_reclassify') }}"
                        data-bmc-dialog-title="RECALCULATE {{ reclassifyPlan|length }} COUNTRY(S)?"
                        data-bmc-dialog-message="Every priced town is re-ranked. Towns that move down give up any land plot nobody holds."
                        data-bmc-dialog-confirm="RECALCULATE" data-bmc-dialog-variant="yellow"><span>RECALCULATE ALL SIZES</span></button>
                <script type="application/json" id="reclassifyPlanData">{{ reclassifyPlan|json_encode|raw }}</script>
            {% endif %}
        </div>

        {% if reclassifyPlan is not empty %}
            <div id="reclassifyPanel" hidden>
                <div class="bmc-card__band" style="display:flex;align-items:center;gap:10px">
                    <span class="bmc-bar" style="flex:1"><span class="bmc-bar__fill" id="reclassifyBar" style="display:block;width:0%"></span></span>
                    <span class="bmc-data" id="reclassifySummary"></span>
                </div>
                <div class="bmc-rows bmc-rows--flush bmc-rows--scroll-200" id="reclassifyRows"></div>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var $ = function (s) { return document.querySelector(s); };
    var n = function (v) { return Number(v).toLocaleString('en-GB'); };

    // MEDIUM is derived, so show it moving as the other two are typed rather than making the
    // operator work out what is left — and say BEFORE the save that small will be trimmed.
    var big = $('#bigSharePercent'), small = $('#smallSharePercent'),
        preview = $('#mediumSharePreview'), note = $('#mediumShareNote');

    function drawMedium() {
        if (!big || !small || !preview) return;
        var b = Math.max(0, Math.min(100, parseInt(big.value, 10) || 0));
        var raw = parseInt(small.value, 10) || 0;
        var s = Math.min(Math.max(0, Math.min(100, raw)), 100 - b);
        var trimmed = raw > 100 - b;

        preview.textContent = Math.max(0, 100 - b - s) + '%';
        preview.className = 'bmc-badge ' + (trimmed ? 'bmc-badge--warning' : 'bmc-badge--subtle');
        if (note) note.textContent = trimmed ? 'Small will be cut to ' + s + '% on save — big is tested first' : 'Whatever is left over';
    }

    if (big && small) {
        big.addEventListener('input', drawMedium);
        small.addEventListener('input', drawMedium);
        drawMedium();
    }

    // ── the recalculation queue ─────────────────────────────────────
    var runBtn = $('#reclassifyRun'), planEl = $('#reclassifyPlanData');

    // window.BMC IS DELIBERATELY NOT TESTED HERE — it cannot be. bmc-pages.js is deferred,
    // so it runs after this script and BMC is undefined at this point; the old guard returned
    // every time and the RUN button silently did nothing. BMC is used inside the handlers
    // below, which fire long after the deferred script has loaded.
    if (!runBtn || !planEl) return;

    var plan = JSON.parse(planEl.textContent);
    var panel = $('#reclassifyPanel'), bar = $('#reclassifyBar'),
        summary = $('#reclassifySummary'), rows = $('#reclassifyRows');

    var BADGE = {
        queued:  ['QUEUED',  'subtle'],
        running: ['RUNNING', 'accent'],
        done:    ['DONE',    'positive'],
        skipped: ['SKIPPED', 'subtle'],
        failed:  ['FAILED',  'danger']
    };

    function draw(jobs) {
        panel.hidden = false;
        var settled = jobs.filter(function (j) { return j.status !== 'queued' && j.status !== 'running'; }).length;
        var towns = jobs.reduce(function (a, j) { return a + (j.count || 0); }, 0);

        bar.style.width = Math.round(settled / jobs.length * 100) + '%';
        summary.textContent = settled + ' of ' + jobs.length + ' countries · ' + n(towns) + ' town(s) ranked';

        rows.innerHTML = jobs.map(function (j) {
            var b = BADGE[j.status];
            return '<div class="bmc-jobrow">' +
                '<div><span class="bmc-badge bmc-badge--' + b[1] + '">' + b[0] + '</span></div>' +
                '<span class="bmc-celltext">' + j.label + ' <span class="bmc-data">' + j.code + '</span></span>' +
                '<span class="bmc-cellnum ink-dim">' + n(j.towns) + '</span>' +
                '<span class="bmc-data' + (j.status === 'failed' ? ' ink-danger' : '') + '">' + (j.message || '') + '</span>' +
                '</div>';
        }).join('');
    }

    // The PixelDialog handles the confirm through data-bmc-dialog-*, which re-dispatches the
    // click once the operator says yes — so by the time this listener runs, it is confirmed.
    runBtn.addEventListener('click', function () {
        runBtn.disabled = true;
        BMC.runJobs({
            url: runBtn.dataset.url,
            token: runBtn.dataset.token,
            jobs: plan.map(function (c) {
                return { label: c.name, code: c.code, towns: c.towns, fields: { country: c.code } };
            }),
            onUpdate: draw
        }).then(function (jobs) {
            runBtn.disabled = false;
            var failed = jobs.filter(function (j) { return j.status === 'failed'; }).length;
            BMC.toast(failed ? failed + ' COUNTRY(S) FAILED — SEE THE TABLE' : 'CITY SIZES RECALCULATED');
        });
    });
}());
</script>
{% endblock %}
