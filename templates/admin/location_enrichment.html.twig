{% extends '@EasyAdmin/layout.html.twig' %}

{#
   Location AI enrichment: what is left, what needs a human, and the three triggers.

   Every trigger is a POST with a CSRF token and targets path('admin', {routeName: ...}) rather
   than the bare route — per src/Controller/Admin/CLAUDE.md, routeName is read from the query
   string so this works for POST bodies too, and a bare route would miss EasyAdmin's `ea`
   context. The reason they are POST rather than links is money: each one queues billed API
   calls, and a crawler or a browser prefetch must not be able to spend any.
#}

{% set statusColours = {
    'pending':      'secondary',
    'queued':       'info',
    'enriched':     'success',
    'needs_review': 'warning',
    'failed':       'danger'
} %}

{% block content %}
<div class="row g-4 mt-1">

    {# ── Header ─────────────────────────────────────────────────────────── #}
    <div class="col-12">
        <h5 class="fw-semibold mb-0">Location Enrichment</h5>
        <p class="text-muted small mb-0">
            Seeded towns carry a name, region and population. Coordinates and land values are
            supplied by an AI provider, validated per field, and stored once — subsequent reads
            never call out again.
        </p>
    </div>

    {# ── Focused location (arrived from a Location row's Enrich action) ──── #}
    {% if focus %}
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-crosshairs text-primary"></i>
                <span class="fw-semibold small">Enrich one location</span>
            </div>
            <div class="card-body">
                <div class="row g-3 small align-items-end">
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Town</div>
                        <div class="fw-semibold">{{ focus.town }} <span class="text-muted">{{ focus.country_code }}</span></div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Status</div>
                        <span class="badge bg-{{ statusColours[focus.enrichment_status] ?? 'secondary' }}">{{ focus.enrichment_status }}</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-muted">Attempts</div>
                        <div class="fw-semibold">{{ focus.enrichment_attempts }}</div>
                    </div>
                    <div class="col-12 col-md-4">
                        {#
                           A POST, not the link that brought you here. The row action in the
                           Locations list is deliberately side-effect-free, because an EasyAdmin
                           row action is a plain GET and enriching costs money.
                        #}
                        <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_single'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_single') }}">
                            <input type="hidden" name="location" value="{{ focus.id }}">
                            <button type="submit" class="btn btn-sm btn-primary" {{ connection.ok ? '' : 'disabled' }}>
                                Enrich {{ focus.town }}
                            </button>
                        </form>
                    </div>
                </div>

                {% if focus.enrichment_error %}
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <strong>Last error:</strong> {{ focus.enrichment_error }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Provider / connection ──────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-plug {{ connection.ok ? 'text-success' : 'text-danger' }}"></i>
                <span class="fw-semibold small">Provider</span>
            </div>
            <div class="card-body">
                <div class="row g-3 small">
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Provider</div>
                        <div class="fw-semibold">{{ provider }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Model</div>
                        <div class="fw-semibold">{{ model }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Prompt</div>
                        <div class="fw-semibold">{{ promptVersion }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted">Queue depth</div>
                        <div class="fw-semibold">{{ queueDepth }} undrained</div>
                    </div>
                </div>

                {% if not connection.ok %}
                    {#
                       Said loudly and at the top. A silently unreachable provider once cost
                       this codebase a day of push notifications (see NotificationLog), so an
                       unconfigured enricher must be impossible to miss BEFORE a sweep.
                    #}
                    <div class="alert alert-danger mt-3 mb-0 small">
                        <strong>Enricher not reachable.</strong> {{ connection.detail }}
                        <div class="mt-1">Sweeping now would record a failure against every location it touched.</div>
                    </div>
                {% else %}
                    <div class="alert alert-success mt-3 mb-0 small mb-0">{{ connection.detail }}</div>
                {% endif %}

                <div class="text-muted small mt-3">
                    Last 30 days: {{ usage.attempts }} call(s),
                    {{ usage.inputTokens|number_format }} input / {{ usage.outputTokens|number_format }} output tokens.
                </div>
            </div>
        </div>
    </div>

    {# ── Pull towns ─────────────────────────────────────────────────────────
       Its own card now. It used to be a second form crammed into the Progress by
       country header beside Seed, which hid the fact that the two are nothing alike:
       seeding is free, instant and allows "all countries", where this spends money per
       batch and takes minutes. It also had nowhere to show progress, which is what it
       most needed — the synchronous version timed out at nginx's 60s while the call ran
       on, so the operator's only signal was a failure for work that had often succeeded.
       ─────────────────────────────────────────────────────────────────────── #}
    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-wand-magic-sparkles text-warning"></i>
                <span class="fw-semibold small">Pull towns</span>
                <span class="ms-auto badge bg-secondary" id="suggest-queue-depth"
                      title="Undrained batches on the suggestion queue">
                    {{ suggestionQueueDepth }} queued
                </span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Asks the AI provider for towns the curated registry does not have, in
                    batches of {{ batchSize }}. Each batch is one paid call and they drain about
                    once a minute, so a 300-town pull takes a few minutes and reports as it goes.
                    New towns arrive with no coordinates and no land value; enrichment fills
                    those in lazily, one paid call each, when a player first opens them.
                </p>

                <form method="post"
                      action="{{ path('admin', {routeName: 'admin_locations_suggest_towns'}) }}"
                      id="suggest-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('locations_suggest_towns') }}">

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-7">
                            <label for="suggestCountry" class="form-label fw-semibold small mb-1">Country</label>
                            {# No "All countries" option at all. The simplest way to make a paid
                               fan-out across 25 countries impossible rather than merely
                               discouraged. #}
                            <select name="country" id="suggestCountry" class="form-select form-select-sm" required>
                                <option value="" disabled selected>Country…</option>
                            {% for row in seedable %}
                                <option value="{{ row.code }}"{{ selectedCountry == row.code ? ' selected' : '' }}>
                                    {{ row.code }} — {{ row.name }}
                                </option>
                            {% endfor %}
                            </select>
                        </div>
                        <div class="col-5">
                            <label for="suggestMax" class="form-label fw-semibold small mb-1">Most towns</label>
                            <input type="number" class="form-control form-control-sm" id="suggestMax"
                                   name="max_towns" value="{{ defaultMax }}" min="1" max="{{ hardMax }}" step="10"
                                   title="The reply is ordered largest-first, so a cap drops the smallest towns.">
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-sm btn-outline-warning"
                            id="suggest-submit"
                            {{ connection.ok and suggestionQueueDepth == 0 ? '' : 'disabled' }}
                            title="{{ connection.ok ? 'Queue a batched town pull' : connection.detail }}">
                        <i class="fa fa-wand-magic-sparkles me-1"></i> Pull towns
                    </button>
                    {% if suggestionQueueDepth > 0 %}
                        <span class="text-muted small ms-2">
                            {{ suggestionQueueDepth }} batch(es) still queued — wait for the current pull.
                        </span>
                    {% endif %}
                </form>

                {# Progress. Hidden until there is a run to describe. #}
                <div id="suggest-progress" class="mt-3 pt-3 border-top{{ suggestionRun is null ? ' d-none' : '' }}">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa fa-list-check fa-sm text-muted"></i>
                        <span class="fw-semibold small">Latest pull</span>
                        <span id="suggest-progress-summary" class="text-muted ms-1" style="font-size:.72rem;"></span>
                    </div>
                    <div class="progress mb-2" style="height:6px;">
                        <div class="progress-bar" id="suggest-progress-bar" role="progressbar" style="width:0%"></div>
                    </div>
                    <div id="suggest-batches" class="d-flex flex-column gap-1"></div>
                </div>
            </div>
        </div>
    </div>

    {# ── Progress per country ───────────────────────────────────────────── #}
    <div class="col-12 col-xl-7">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2 flex-wrap">
                <i class="fa fa-flag text-primary"></i>
                <span class="fw-semibold small">Progress by country</span>

                {# Seeding writes town rows from CountryContentRegistry. Free and fast — no
                   external call, no spend — unlike the Enrich buttons below. #}
                <form method="post"
                      action="{{ path('admin', {routeName: 'admin_locations_seed'}) }}"
                      class="ms-auto d-flex align-items-center gap-1">
                    <input type="hidden" name="_token" value="{{ csrf_token('locations_seed') }}">

                    <select name="country" class="form-select form-select-sm py-0"
                            style="width:auto" aria-label="Country to seed">
                        <option value="">All countries</option>
                    {% for row in seedable %}
                        <option value="{{ row.code }}">
                            {{ row.code }} — {{ row.name }}{% if row.seeded %} (seeded){% endif %}
                        </option>
                    {% endfor %}
                    </select>

                    <div class="form-check form-check-inline m-0 ms-1" title="Add towns missing from a country that already has locations. Never rewrites an existing row.">
                        <input class="form-check-input" type="checkbox" id="seedForce" name="force" value="1">
                        <label class="form-check-label small text-muted" for="seedForce">force</label>
                    </div>

                    <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2">
                        <i class="fa fa-seedling me-1"></i> Seed
                    </button>
                </form>

            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small align-middle">
                        <thead>
                            <tr>
                                <th>Country</th>
                                <th class="text-end">Towns</th>
                                <th class="text-end">Enriched</th>
                                <th class="text-end">Left</th>
                                <th class="text-end">Review</th>
                                <th class="text-end">Failed</th>
                                <th>Status</th>
                                <th class="text-end">Sweep</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for row in countries %}
                            {% set left = row.counts.pending + row.counts.queued %}
                            <tr>
                                <td class="fw-semibold">{{ row.name }} <span class="text-muted">{{ row.code }}</span></td>
                                <td class="text-end">{{ row.total }}</td>
                                <td class="text-end">{{ row.counts.enriched }}</td>
                                <td class="text-end">{{ left > 0 ? left : '—' }}</td>
                                <td class="text-end">
                                    {% if row.counts.needs_review > 0 %}
                                        <span class="badge bg-warning">{{ row.counts.needs_review }}</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="text-end">
                                    {% if row.counts.failed > 0 %}
                                        <span class="badge bg-danger">{{ row.counts.failed }}</span>
                                    {% else %}—{% endif %}
                                </td>
                                <td><span class="badge bg-secondary">{{ row.status }}</span></td>
                                <td class="text-end">
                                    {% if row.counts.pending + row.counts.failed > 0 %}
                                        <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_sweep'}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_sweep') }}">
                                            <input type="hidden" name="country" value="{{ row.code }}">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary py-0 px-2"
                                                    {{ connection.ok ? '' : 'disabled' }}
                                                    onclick="return confirm('Queue {{ row.counts.pending + row.counts.failed }} paid API call(s) for {{ row.name }}?')">
                                                Enrich
                                            </button>
                                        </form>
                                    {% else %}—{% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <p class="text-muted mb-1">No countries seeded yet.</p>
                                    <p class="text-muted small mb-3">
                                        Seeding writes <strong>865 towns across 25 countries</strong>
                                        from the curated registry &mdash; one location and one plot
                                        each. It makes no external calls and costs nothing.
                                        Coordinates and land values are <em>not</em> seeded (there
                                        are none in the source data); enrichment fills those in
                                        afterwards.
                                    </p>
                                    <form method="post"
                                          action="{{ path('admin', {routeName: 'admin_locations_seed'}) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('locations_seed') }}">
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="fa fa-seedling me-1"></i> Seed all countries
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# ── Global sweep ───────────────────────────────────────────────────── #}
    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-wand-magic-sparkles text-primary"></i>
                <span class="fw-semibold small">Enrich everything outstanding</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Queues one message per outstanding town. Each is a billed API call, so a
                    second sweep is refused while one is still draining.
                </p>

                <div class="d-flex gap-3 mb-3 small">
                    <div>
                        <div class="text-muted">Outstanding</div>
                        <div class="fs-5 fw-semibold">{{ outstanding }}</div>
                    </div>
                    {% for status in statuses %}
                        {% set n = totals[status.value] ?? 0 %}
                        {% if n > 0 %}
                            <div>
                                <div class="text-muted">{{ status.label }}</div>
                                <div class="fs-5 fw-semibold">{{ n }}</div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_sweep'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_sweep') }}">

                    <div class="form-check small mb-3">
                        <input class="form-check-input" type="checkbox" name="include_review" value="1" id="include_review">
                        <label class="form-check-label" for="include_review">
                            Also re-ask about <strong>needs review</strong> rows
                            <span class="text-muted d-block">
                                Off by default — re-rolling a row nobody has judged hides the thing that needed judging.
                            </span>
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-sm btn-primary"
                            {{ (connection.ok and outstanding > 0 and queueDepth == 0) ? '' : 'disabled' }}
                            onclick="return confirm('Queue up to {{ outstanding }} paid API call(s)?')">
                        Enrich all outstanding
                    </button>

                    {% if queueDepth > 0 %}
                        <div class="text-warning small mt-2">
                            {{ queueDepth }} message(s) still queued — wait for the current sweep to drain.
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>

    {# ── Review queue: the rows that need a human ───────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-list-check text-warning"></i>
                <span class="fw-semibold small">Needs a human ({{ reviewQueue|length }})</span>
            </div>
            <div class="card-body p-0">
                {% if reviewQueue is empty %}
                    <div class="p-3 text-muted small">Nothing flagged. Every enriched town passed validation.</div>
                {% else %}
                <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_subset'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_subset') }}">

                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small align-middle">
                            <thead>
                                <tr>
                                    <th style="width:2rem"></th>
                                    <th>Town</th>
                                    <th>Country</th>
                                    <th>Status</th>
                                    <th>Coords</th>
                                    <th>Land value</th>
                                    <th class="text-end">Attempts</th>
                                    <th>Last error / reason</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for row in reviewQueue %}
                                <tr>
                                    <td><input class="form-check-input" type="checkbox" name="locations[]" value="{{ row.id }}"></td>
                                    <td class="fw-semibold">{{ row.town }}</td>
                                    <td>{{ row.country_code }}</td>
                                    <td>
                                        <span class="badge bg-{{ statusColours[row.enrichment_status] ?? 'secondary' }}">
                                            {{ row.enrichment_status }}
                                        </span>
                                    </td>
                                    <td>{{ row.lat is null ? '—' : 'set' }}</td>
                                    <td>{{ row.land_pence is null ? '—' : (row.land_pence / 100)|number_format(2) }}</td>
                                    <td class="text-end">{{ row.enrichment_attempts }}</td>
                                    <td class="text-muted">{{ row.enrichment_error ?: '—' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 border-top">
                        <button type="submit" class="btn btn-sm btn-outline-primary" {{ connection.ok ? '' : 'disabled' }}>
                            Re-enrich selected
                        </button>
                        <span class="text-muted small ms-2">
                            An explicit retry is the only path past the attempt cap.
                        </span>
                    </div>
                </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Export / import ────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-right-left text-success"></i>
                <span class="fw-semibold small">Export &amp; import</span>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Enrichment costs one billed API call per town, plus the review pass over every
                    valuation it produces. <strong>Enrich once, then move the result.</strong> This
                    file is what stops dev, prod and every rebuilt database from paying for the
                    same 865 towns again.
                </p>
                <p class="small text-muted mb-3">
                    Carries country profiles (including the bounding box validation needs),
                    locations with their coordinates, population, land values, provenance,
                    <em>locks</em> and enrichment status, and their plots. Deliberately carries
                    <strong>no claims, holds or ledger entries</strong> &mdash; those are real
                    money and real player data. Rival sets and stadium estimates are left out too:
                    both are derived and cheaper to recompute than to map between databases.
                </p>

                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="exportCountry" class="form-label fw-semibold small">Export</label>
                        <div class="input-group">
                            <select id="exportCountry" class="form-select form-select-sm">
                                <option value="">All countries</option>
                            {% for row in countries %}
                                <option value="{{ row.code }}" {% if row.code == selectedCountry %}selected{% endif %}>
                                    {{ row.code }} &mdash; {{ row.name }}
                                </option>
                            {% endfor %}
                            </select>
                            <a class="btn btn-sm btn-outline-success"
                               id="exportLink"
                               href="{{ path('admin', {routeName: 'admin_locations_export'}) }}">
                                <i class="fa fa-download me-1"></i> Download JSON
                            </a>
                        </div>
                        <div class="form-text">Reads only. Writes nothing.</div>
                    </div>

                    <div class="col-md-7">
                        <form method="post"
                              action="{{ path('admin', {routeName: 'admin_locations_import'}) }}"
                              enctype="multipart/form-data">
                            <input type="hidden" name="_token" value="{{ csrf_token('locations_import') }}">
                            <label for="locationsFile" class="form-label fw-semibold small">Import</label>
                            <div class="input-group">
                                <input type="file" id="locationsFile" name="locations_file"
                                       accept="application/json,.json"
                                       class="form-control form-control-sm" required>
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-upload me-1"></i> Apply
                                </button>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox"
                                       id="importDryRun" name="dry_run" value="1" checked>
                                <label class="form-check-label small" for="importDryRun">
                                    Dry run &mdash; report what would change and write nothing
                                </label>
                            </div>
                            <div class="form-text">
                                An <strong>upsert</strong>, matched on country + slug. Nothing is
                                ever deleted, and there is no &ldquo;clear first&rdquo;: a town can
                                carry an active claim, and the database refuses to delete one.
                                Fields you have <strong>locked</strong> here are skipped and
                                counted &mdash; an import must not undo your review.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Keeps the download link's ?country= in step with the select, so the button exports what
       the operator just chose rather than whatever the page loaded with. #}
    <script>
        (function () {
            var select = document.getElementById('exportCountry');
            var link   = document.getElementById('exportLink');
            if (!select || !link) { return; }

            var base = link.getAttribute('href');

            function sync() {
                link.setAttribute(
                    'href',
                    select.value ? base + (base.indexOf('?') === -1 ? '?' : '&') + 'country=' + encodeURIComponent(select.value) : base
                );
            }

            select.addEventListener('change', sync);
            sync();
        })();
    </script>

    {# ── Recent runs ────────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-clock-rotate-left text-primary"></i>
                <span class="fw-semibold small">Recent runs</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small align-middle">
                        <thead>
                            <tr>
                                <th>Started</th>
                                <th>Trigger</th>
                                <th>Scope</th>
                                <th>Model</th>
                                <th class="text-end">Queued</th>
                                <th class="text-end">OK</th>
                                <th class="text-end">Review</th>
                                <th class="text-end">Failed</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for run in recentRuns %}
                            <tr>
                                <td>{{ run.startedAt|date('Y-m-d H:i:s') }}</td>
                                <td>{{ run.trigger.value }}</td>
                                <td>{{ run.countryCode ?? 'all' }}</td>
                                <td class="text-muted">{{ run.model }}</td>
                                <td class="text-end">{{ run.queued }}</td>
                                <td class="text-end">{{ run.succeeded }}</td>
                                <td class="text-end">{{ run.needsReview }}</td>
                                <td class="text-end">{{ run.failed }}</td>
                                <td><span class="badge bg-secondary">{{ run.status.value }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9" class="text-muted">No enrichment has been run yet.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

{# ── Pull towns progress poll ───────────────────────────────────────────────
   Recursive setTimeout rather than setInterval, and it swallows transient errors so a
   blip does not end the watch — the pattern worldpack_cache.html.twig established.

   Polls a dedicated JSON route, never a refresh of this page: overview() makes a live
   provider call to render the connection verdict, so re-fetching it every 2.5s would
   turn a six-batch run into a hundred extra round trips.
   ──────────────────────────────────────────────────────────────────────── #}
<script>
(function () {
    const STATUS_URL_TPL  = '{{ path('admin_locations_suggest_towns_status', {country: '__CC__'}) }}';
    const POLL_INTERVAL_MS = 2500;
    const TERMINAL_RUN_STATUSES = ['complete', 'cancelled'];

    const panel    = document.getElementById('suggest-progress');
    const summary  = document.getElementById('suggest-progress-summary');
    const bar      = document.getElementById('suggest-progress-bar');
    const list     = document.getElementById('suggest-batches');
    const depth    = document.getElementById('suggest-queue-depth');
    const submit   = document.getElementById('suggest-submit');

    if (!panel) { return; }

    let polling = false;

    const BATCH_BADGE = {
        pending:   'bg-secondary',
        running:   'bg-primary',
        completed: 'bg-success',
        failed:    'bg-danger',
    };

    function escHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
    }

    function renderBatch(b) {
        const badge = BATCH_BADGE[b.status] ?? 'bg-secondary';
        const spin  = b.status === 'running' ? '<i class="fa fa-spinner fa-spin me-1"></i>' : '';
        // Imported, not offered: it is the only figure that tells the operator whether the
        // money bought anything. A batch that offers fifty towns we already hold is a
        // completed batch with nothing to show, and that is an honest outcome, not a fault.
        const detail = b.status === 'completed'
            ? `${b.imported} added` + (b.alreadyHeld > 0 ? `, ${b.alreadyHeld} already held` : '')
            : (b.status === 'failed' ? escHtml(b.error ?? 'failed') : `${b.requested} requested`);
        const retry = b.attempts > 1 ? ` <span class="text-muted">(attempt ${b.attempts})</span>` : '';

        return `<div class="d-flex align-items-center gap-2 small">
            <span class="badge ${badge}" style="min-width:5.5rem;">${spin}Batch ${b.index}/${b.total}</span>
            <span class="text-muted">${detail}${retry}</span>
        </div>`;
    }

    function render(run, queueDepth) {
        if (depth) { depth.textContent = `${queueDepth} queued`; }

        if (!run) {
            panel.classList.add('d-none');
            return;
        }

        panel.classList.remove('d-none');

        const total   = run.totalBatches || 0;
        const settled = run.settledBatches || 0;
        const pct     = total > 0 ? Math.round((settled / total) * 100) : 0;

        bar.style.width = pct + '%';
        bar.className = 'progress-bar' + (run.failedBatches > 0 ? ' bg-warning' : '');

        const parts = [`${settled} / ${total} batches`, `${run.importedTowns} town(s) added`];
        if (run.failedBatches > 0) { parts.push(`${run.failedBatches} failed`); }
        if (TERMINAL_RUN_STATUSES.includes(run.status)) { parts.push('done'); }
        summary.textContent = `${run.country} · ` + parts.join(' · ');

        list.innerHTML = run.batches.map(renderBatch).join('');

        // Re-enable the button only once the queue is actually clear: the server refuses a
        // second run while batches are undrained, so offering it would just bounce.
        if (submit && queueDepth === 0 && TERMINAL_RUN_STATUSES.includes(run.status)) {
            submit.disabled = false;
        }
    }

    function poll(country) {
        if (polling) { return; }
        polling = true;

        const tick = async () => {
            try {
                const res  = await fetch(STATUS_URL_TPL.replace('__CC__', country));
                const data = await res.json();
                render(data.run, data.queueDepth ?? 0);

                if (data.run && TERMINAL_RUN_STATUSES.includes(data.run.status) && (data.queueDepth ?? 0) === 0) {
                    polling = false;
                    return; // stop; the panel stays rendered as-is
                }
            } catch (e) {
                // transient — the next tick may recover
            }

            setTimeout(tick, POLL_INTERVAL_MS);
        };

        tick();
    }

    // A run already in flight when the page loaded. This is why the status route is keyed by
    // country rather than by run id: the operator is no longer pinned to the request, so they
    // can and will come back to a page they left mid-run.
    const initial = {{ suggestionRun is null ? 'null' : suggestionRun|json_encode|raw }};
    if (initial) {
        render(initial, {{ suggestionQueueDepth }});
        if (!TERMINAL_RUN_STATUSES.includes(initial.status) || {{ suggestionQueueDepth }} > 0) {
            poll(initial.country);
        }
    }
})();
</script>
{% endblock %}
