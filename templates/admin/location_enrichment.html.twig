{% extends 'admin/bmc_page.html.twig' %}
{#
  Locations & land → Enrichment, on bmc_page + bmc-pages.css/js.
  Data: LocationEnrichmentController::overview().

  EVERY TRIGGER IS A POST, and that is about money rather than correctness: each one queues
  billed API calls, and a crawler or a browser prefetch must not be able to spend any. They
  target path('admin', {routeName: …}) rather than the bare route — routeName is read from the
  query string so it works for a POST body too, and a bare route would miss EasyAdmin's `ea`
  context. See src/Controller/Admin/CLAUDE.md.

  CONFIRMS MOVED FROM window.confirm TO THE PIXELDIALOG. The old page used
  onclick="return confirm(…)" on the two spending buttons. data-bmc-dialog-* replaces it —
  but note bmc-admin.js binds [data-bmc-confirm] to window.confirm, so the two attributes must
  never appear on one element (bmc-pages.js header, §2.4).

  THE PULL-TOWNS POLL IS CARRIED OVER ALMOST VERBATIM. It is the one piece of real behaviour
  on this page and its comments record why it is shaped the way it is; only the class names it
  writes have changed, from Bootstrap badges and .d-none to bmc-* and the `hidden` property.
#}

{% set statusBadge = {
    'pending':      'subtle',
    'queued':       'accent',
    'enriched':     'positive',
    'needs_review': 'warning',
    'failed':       'danger',
} %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_locations_dashboard'}) }}"><span>DASHBOARD</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_location_config'}) }}"><span>CONFIGURATION</span></a>
{% endblock %}

{% block bmc_body %}

{# ── provider, and whether it can be reached at all ──────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="plug"></i>
        <span class="bmc-card__title">PROVIDER</span>
        <span class="bmc-card__meta">last 30 days: {{ usage.attempts|number_format }} call(s) · {{ usage.inputTokens|number_format }} in / {{ usage.outputTokens|number_format }} out</span>
    </div>

    <div class="bmc-stats">
        <div class="bmc-stat"><span class="bmc-stat__label">PROVIDER</span><span class="bmc-stat__value">{{ provider }}</span></div>
        <div class="bmc-stat"><span class="bmc-stat__label">MODEL</span><span class="bmc-stat__value" style="font:var(--text-body-step)">{{ model }}</span></div>
        <div class="bmc-stat"><span class="bmc-stat__label">PROMPT</span><span class="bmc-stat__value" style="font:var(--text-body-step)">{{ promptVersion }}</span></div>
        <div class="bmc-stat"><span class="bmc-stat__label">QUEUE</span><span class="bmc-stat__value {{ queueDepth > 0 ? 'ink-accent' : 'ink-dim' }}">{{ queueDepth }}</span><span class="bmc-stat__sub">undrained</span></div>
    </div>

    <div class="bmc-card__band">
        {% if connection.ok %}
            <div class="bmc-status"><span class="bmc-dot" style="background:var(--wk-positive)"></span>{{ connection.detail }}</div>
        {% else %}
            {# Said loudly and at the top. A silently unreachable provider once cost this
               codebase a day of push notifications (see NotificationLog), so an unconfigured
               enricher must be impossible to miss BEFORE a sweep. #}
            <div class="bmc-danger">
                <i data-lucide="triangle-alert"></i>
                <div class="bmc-danger__text">
                    <span class="bmc-lbl bmc-lbl--ink">ENRICHER NOT REACHABLE</span>
                    <span class="bmc-data">{{ connection.detail }}</span>
                    <span class="bmc-data">Sweeping now would record a failure against every location it touched.</span>
                </div>
            </div>
        {% endif %}
    </div>
</section>

{# ── one location, arrived from a Location row's Enrich action ───────── #}
{% if focus %}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="crosshair"></i>
            <span class="bmc-card__title">ENRICH ONE LOCATION</span>
            <span class="bmc-card__meta">{{ focus.enrichment_attempts }} attempt(s) so far</span>
        </div>
        <div class="bmc-card__band" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
            <span class="bmc-celltext">{{ focus.town }} <span class="bmc-data">{{ focus.country_code }}</span></span>
            <span class="bmc-badge bmc-badge--{{ statusBadge[focus.enrichment_status] ?? 'subtle' }}">{{ focus.enrichment_status }}</span>
            <span style="flex:1"></span>
            {# A POST, not the link that brought you here. The row action in the Locations list
               is deliberately side-effect-free, because an EasyAdmin row action is a plain GET
               and enriching costs money. #}
            <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_single'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_single') }}">
                <input type="hidden" name="location" value="{{ focus.id }}">
                <button type="submit" class="bmc-btn bmc-btn--blue" {{ connection.ok ? '' : 'disabled' }}><span>ENRICH {{ focus.town|upper }}</span></button>
            </form>
        </div>
        {% if focus.enrichment_error %}
            <div class="bmc-card__body"><span class="bmc-note"><i data-lucide="triangle-alert"></i>Last error: {{ focus.enrichment_error }}</span></div>
        {% endif %}
    </section>
{% endif %}

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(440px,1fr))">

    {# ── pull towns ──────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="wand-sparkles"></i>
            <span class="bmc-card__title">PULL TOWNS</span>
            <span class="bmc-card__meta"><span id="suggest-queue-depth">{{ suggestionQueueDepth }} queued</span></span>
        </div>
        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                Asks the AI provider for towns the curated registry does not have, in batches of
                {{ batchSize }}. Each batch is one paid call and they drain about once a minute, so a
                300-town pull takes a few minutes and reports as it goes. New towns arrive with no
                coordinates and no land value; enrichment fills those in lazily, one paid call each,
                when a player first opens them.
            </p>

            <form method="post" action="{{ path('admin', {routeName: 'admin_locations_suggest_towns'}) }}"
                  id="suggest-form" style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-top:12px">
                <input type="hidden" name="_token" value="{{ csrf_token('locations_suggest_towns') }}">

                <div class="bmc-field-col">
                    <label class="bmc-lbl bmc-lbl--ink" for="suggestCountry">COUNTRY</label>
                    {# EVERY country, not the 25 the curated registry happens to hold — a
                       country with no place list is the one most worth pulling towns for, and
                       the picker used to exclude exactly those. Countries already under way
                       are grouped first so a 71-entry list stays readable.

                       Still no "All countries" option: the simplest way to make a paid fan-out
                       across every country impossible rather than merely discouraged. #}
                    <label class="bmc-textbox" style="min-width:190px;margin-bottom:6px">
                        <input type="search" id="suggestFilter" placeholder="Filter countries…"
                               autocomplete="off" aria-controls="suggestCountry">
                    </label>
                    <span class="bmc-select">
                        <select name="country" id="suggestCountry" required style="min-width:190px">
                            <option value="" disabled selected>Country…</option>
                            {% for row in pullable %}
                                <option value="{{ row.code }}" data-seeded="{{ row.seeded ? '1' : '0' }}"{{ selectedCountry == row.code ? ' selected' : '' }}>{{ row.code }} — {{ row.name }}{% if row.seeded %} ({{ row.towns }}){% endif %}</option>
                            {% endfor %}
                        </select>
                    </span>
                    <span class="bmc-data" id="suggestCountryCount"></span>
                </div>

                <div class="bmc-field-col">
                    <label class="bmc-lbl bmc-lbl--ink" for="suggestMax">MOST TOWNS</label>
                    <label class="bmc-num bmc-num--104">
                        <input type="number" id="suggestMax" name="max_towns" value="{{ defaultMax }}"
                               min="1" max="{{ hardMax }}" step="1" inputmode="numeric"
                               title="The reply is ordered largest-first, so a cap drops the smallest towns.">
                    </label>
                </div>

                <button type="submit" class="bmc-btn bmc-btn--orange" id="suggest-submit"
                        {{ connection.ok and suggestionQueueDepth == 0 ? '' : 'disabled' }}
                        title="{{ connection.ok ? 'Queue a batched town pull' : connection.detail }}"><span>PULL TOWNS</span></button>
            </form>

            {% if suggestionQueueDepth > 0 %}
                <span class="bmc-note" style="margin-top:8px"><i data-lucide="clock"></i>{{ suggestionQueueDepth }} batch(es) still queued — wait for the current pull.</span>
            {% endif %}
        </div>

        {# Progress. Hidden until there is a run to describe. #}
        <div class="bmc-card__band" id="suggest-progress" {{ suggestionRun is null ? 'hidden' : '' }}
             style="display:flex;flex-direction:column;gap:10px;border-top:3px solid var(--wk-stroke)">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <i data-lucide="list-checks" width="16" height="16" class="ink-dim"></i>
                <span class="bmc-lbl bmc-lbl--ink">LATEST PULL</span>
                <span class="bmc-data" id="suggest-progress-summary"></span>
            </div>
            <span class="bmc-bar"><span class="bmc-bar__fill" id="suggest-progress-bar" style="display:block;width:0%"></span></span>
            <div id="suggest-batches" style="display:flex;flex-direction:column;gap:6px"></div>

            {# Rolling ticker of what has actually landed. A count tells you the run is working;
               the names tell you it is returning real places, which is the thing worth watching
               when every batch costs money. Newest first, capped, so older ones fall off. #}
            <div id="suggest-recent" hidden style="display:flex;flex-direction:column;gap:6px;border-top:2px solid var(--wk-stroke);padding-top:8px">
                <span class="bmc-data">Latest added <span id="suggest-recent-count"></span></span>
                <div id="suggest-recent-list" style="display:flex;flex-wrap:wrap;gap:4px"></div>
            </div>
        </div>
    </section>

    {# ── everything outstanding ──────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="sparkles"></i>
            <span class="bmc-card__title">ENRICH EVERYTHING OUTSTANDING</span>
        </div>
        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                Queues one message per outstanding town. Each is a billed API call, so a second sweep
                is refused while one is still draining.
            </p>
        </div>

        <div class="bmc-stats">
            <div class="bmc-stat"><span class="bmc-stat__label">OUTSTANDING</span><span class="bmc-stat__value">{{ outstanding|number_format }}</span></div>
            {% for status in statuses %}
                {% set n = totals[status.value] ?? 0 %}
                {% if n > 0 %}
                    <div class="bmc-stat"><span class="bmc-stat__label">{{ status.label|upper }}</span><span class="bmc-stat__value">{{ n|number_format }}</span></div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="bmc-card__band">
            <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_sweep'}) }}"
                  style="display:flex;flex-direction:column;gap:10px">
                <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_sweep') }}">

                <label class="bmc-check" style="padding-left:0;align-items:flex-start">
                    <input type="checkbox" name="include_review" value="1" id="include_review">
                    <span class="bmc-tile" style="margin-top:2px"></span>
                    <span style="display:flex;flex-direction:column;gap:2px">
                        <span class="bmc-celltext">Also re-ask about <strong>needs review</strong> rows</span>
                        <span class="bmc-data">Off by default — re-rolling a row nobody has judged hides the thing that needed judging.</span>
                    </span>
                </label>

                <button type="submit" class="bmc-btn bmc-btn--blue" style="align-self:flex-start"
                        {{ (connection.ok and outstanding > 0 and queueDepth == 0) ? '' : 'disabled' }}
                        data-bmc-dialog-title="QUEUE UP TO {{ outstanding|number_format }} PAID CALL(S)?"
                        data-bmc-dialog-message="One billed API call per outstanding town. A second sweep is refused until this one drains."
                        data-bmc-dialog-confirm="QUEUE THEM" data-bmc-dialog-variant="yellow"><span>ENRICH ALL OUTSTANDING</span></button>

                {% if queueDepth > 0 %}
                    <span class="bmc-note"><i data-lucide="clock"></i>{{ queueDepth }} message(s) still queued — wait for the current sweep to drain.</span>
                {% endif %}
            </form>
        </div>
    </section>
</div>

{# ── progress by country ─────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="flag"></i>
        <span class="bmc-card__title">PROGRESS BY COUNTRY</span>
        <span class="bmc-card__meta">{{ countries|length }} seeded</span>
    </div>

    {# Seeding writes town rows from CountryContentRegistry. Free and fast — no external call,
       no spend — unlike every Enrich button on this page. #}
    <div class="bmc-card__band">
        <form method="post" action="{{ path('admin', {routeName: 'admin_locations_seed'}) }}"
              style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <input type="hidden" name="_token" value="{{ csrf_token('locations_seed') }}">
            <span class="bmc-lbl bmc-lbl--ink">SEED</span>
            <span class="bmc-select">
                <select name="country" aria-label="Country to seed" style="min-width:190px">
                    <option value="">All countries</option>
                    {% for row in seedable %}
                        <option value="{{ row.code }}">{{ row.code }} — {{ row.name }}{% if row.seeded %} (seeded){% endif %}</option>
                    {% endfor %}
                </select>
            </span>
            <label class="bmc-check" title="Add towns missing from a country that already has locations. Never rewrites an existing row.">
                <input type="checkbox" id="seedForce" name="force" value="1">
                <span class="bmc-tile"></span>
                <span class="bmc-data">force</span>
            </label>
            <button type="submit" class="bmc-btn bmc-btn--green"><span>SEED</span></button>
            <span class="bmc-data">Free — writes rows from the curated registry, no API calls.</span>
        </form>
    </div>

    {# The country column's own switch. A GET with ?overwrite=1 rather than a field inside each
       row's form, because there is one of these and twenty-five of those — and the choice has
       to survive the page reload that every row button causes. #}
    <div class="bmc-card__band" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span class="bmc-lbl bmc-lbl--ink">PROFILE</span>
        <span class="bmc-data">
            The country's own bounding box, land price band and reference codes — what
            <strong>every town answer in that country is validated against</strong>. The number
            in the column is how many of the {{ profileTotal }} are filled in; click it to ask
            the model for the rest. One billed call per country.
        </span>
        <span style="flex:1"></span>
        <a class="bmc-btn {{ countryOverwrite ? 'bmc-btn--yellow' : '' }}"
           href="{{ path('admin', {routeName: 'admin_location_enrichment', routeParams: {overwrite: countryOverwrite ? 0 : 1}}) }}"
           title="Off by default, so a re-run can never undo a value you set by hand."><span>OVERWRITE: {{ countryOverwrite ? 'ON' : 'OFF' }}</span></a>
    </div>

    {% if countries is empty %}
        <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:10px;align-items:flex-start">
            <span class="bmc-empty-note">NO COUNTRIES SEEDED YET</span>
            <p class="bmc-bodytext">
                Seeding writes <strong>865 towns across 25 countries</strong> from the curated registry —
                one location and one plot each. It makes no external calls and costs nothing. Coordinates
                and land values are <em>not</em> seeded (there are none in the source data); enrichment
                fills those in afterwards.
            </p>
            <form method="post" action="{{ path('admin', {routeName: 'admin_locations_seed'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('locations_seed') }}">
                <button type="submit" class="bmc-btn bmc-btn--green"><span>SEED ALL COUNTRIES</span></button>
            </form>
        </div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:680px">
                <thead><tr>
                    <th>COUNTRY</th>
                    <th class="is-right">TOWNS</th>
                    <th class="is-right">ENRICHED</th>
                    <th class="is-right">LEFT</th>
                    <th class="is-right">REVIEW</th>
                    <th class="is-right">FAILED</th>
                    <th>STATUS</th>
                    <th class="is-right">PROFILE</th>
                    <th class="is-right">SWEEP</th>
                </tr></thead>
                <tbody>
                {% for row in countries %}
                    {% set left = row.counts.pending + row.counts.queued %}
                    {% set due  = row.counts.pending + row.counts.failed %}
                    <tr>
                        <td><span class="bmc-celltext">{{ row.name }}</span> <span class="bmc-data">{{ row.code }}</span></td>
                        <td class="is-right bmc-cellnum">{{ row.total|number_format }}</td>
                        <td class="is-right bmc-cellnum">{{ row.counts.enriched|number_format }}</td>
                        <td class="is-right bmc-cellnum">{{ left > 0 ? left|number_format : '—' }}</td>
                        {# MARKUP AS MARKUP, not as a string with |raw on the end of it. These two
                           built their badge by concatenation and finished with |raw, which binds
                           to the last LITERAL rather than to the concatenation — so the filter
                           applied to '</span>' alone and autoescaping then printed the whole tag
                           as text. The operator saw the span source in the cell. #}
                        <td class="is-right">
                            {%- if row.counts.needs_review > 0 %}<span class="bmc-badge bmc-badge--warning">{{ row.counts.needs_review }}</span>
                            {%- else %}—{% endif -%}
                        </td>
                        <td class="is-right">
                            {%- if row.counts.failed > 0 %}<span class="bmc-badge bmc-badge--danger">{{ row.counts.failed }}</span>
                            {%- else %}—{% endif -%}
                        </td>
                        <td><span class="bmc-badge bmc-badge--subtle">{{ row.status }}</span></td>
                        {# The country's OWN row, not its towns. The bounding box and the land
                           band here are what every town answer in this country is checked
                           against, so a country sitting at 0/8 is sweeping on the weak global
                           checks — which is invisible unless it is said out loud. #}
                        <td class="is-right">
                            {% if row.profileSet == row.profileTotal %}
                                <span class="bmc-badge bmc-badge--positive">{{ row.profileSet }}/{{ row.profileTotal }}</span>
                            {% else %}
                                <form method="post" action="{{ path('admin', {routeName: 'admin_country_profile_enrich'}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('country_profile_enrich') }}">
                                    <input type="hidden" name="country" value="{{ row.code }}">
                                    <input type="hidden" name="overwrite" value="{{ countryOverwrite ? 1 : 0 }}">
                                    <button type="submit" class="bmc-btn bmc-btn--orange" {{ connection.ok ? '' : 'disabled' }}
                                            title="Ask the model for {{ row.name }}'s bounding box, land band and reference data"
                                            data-bmc-dialog-title="ASK ABOUT {{ row.name|upper }}?"
                                            data-bmc-dialog-message="One billed API call for this country's own data — its bounding box, land price band and reference codes. Towns are not touched."
                                            data-bmc-dialog-confirm="ASK" data-bmc-dialog-variant="yellow"><span>{{ row.profileSet }}/{{ row.profileTotal }}</span></button>
                                </form>
                            {% endif %}
                        </td>
                        <td class="is-right">
                            {% if due > 0 %}
                                <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_sweep'}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_sweep') }}">
                                    <input type="hidden" name="country" value="{{ row.code }}">
                                    <button type="submit" class="bmc-btn" {{ connection.ok ? '' : 'disabled' }}
                                            data-bmc-dialog-title="QUEUE {{ due }} PAID CALL(S) FOR {{ row.name|upper }}?"
                                            data-bmc-dialog-message="One billed API call per outstanding town in this country."
                                            data-bmc-dialog-confirm="QUEUE THEM" data-bmc-dialog-variant="yellow"><span>ENRICH</span></button>
                                </form>
                            {% else %}—{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>

{# ── the rows that need a human ───────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="list-checks"></i>
        <span class="bmc-card__title">NEEDS A HUMAN</span>
        <span class="bmc-card__meta">{{ reviewQueue|length }} flagged</span>
    </div>

    {% if reviewQueue is empty %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NOTHING FLAGGED — EVERY ENRICHED TOWN PASSED VALIDATION</span></div>
    {% else %}
        <form method="post" action="{{ path('admin', {routeName: 'admin_location_enrich_subset'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('location_enrichment_subset') }}">
            <div style="overflow-x:auto">
                <table class="bmc-minitable" style="min-width:720px">
                    <thead><tr>
                        <th style="width:44px"></th>
                        <th>TOWN</th>
                        <th>COUNTRY</th>
                        <th>STATUS</th>
                        <th>COORDS</th>
                        <th class="is-right">LAND VALUE</th>
                        <th class="is-right">ATTEMPTS</th>
                        <th>LAST ERROR / REASON</th>
                    </tr></thead>
                    <tbody>
                    {% for row in reviewQueue %}
                        <tr>
                            <td>
                                <label class="bmc-check" style="padding:0">
                                    <input type="checkbox" name="locations[]" value="{{ row.id }}" aria-label="Select {{ row.town }}">
                                    <span class="bmc-tile"></span>
                                </label>
                            </td>
                            <td><span class="bmc-celltext">{{ row.town }}</span></td>
                            <td><span class="bmc-data">{{ row.country_code }}</span></td>
                            <td><span class="bmc-badge bmc-badge--{{ statusBadge[row.enrichment_status] ?? 'subtle' }}">{{ row.enrichment_status }}</span></td>
                            <td><span class="bmc-data">{{ row.lat is null ? '—' : 'set' }}</span></td>
                            <td class="is-right bmc-cellnum">{{ row.land_pence is null ? '—' : '£' ~ (row.land_pence / 100)|number_format(2) }}</td>
                            <td class="is-right bmc-cellnum">{{ row.enrichment_attempts }}</td>
                            <td><span class="bmc-data">{{ row.enrichment_error ?: '—' }}</span></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="bmc-card__band" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <button type="submit" class="bmc-btn bmc-btn--blue" {{ connection.ok ? '' : 'disabled' }}><span>RE-ENRICH SELECTED</span></button>
                <span class="bmc-data">An explicit retry is the only path past the attempt cap.</span>
            </div>
        </form>
    {% endif %}
</section>

{# ── export & import ──────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="arrow-left-right"></i>
        <span class="bmc-card__title">EXPORT &amp; IMPORT</span>
        <span class="bmc-card__meta">enrich once, then move the result</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Enrichment costs one billed API call per town, plus the review pass over every valuation it
            produces. This file is what stops dev, prod and every rebuilt database from paying for the
            same 865 towns again.
        </p>
        <p class="bmc-bodytext">
            Carries country profiles (including the bounding box validation needs), locations with their
            coordinates, population, land values, provenance, <em>locks</em> and enrichment status, and
            their plots. Deliberately carries <strong>no claims, holds or ledger entries</strong> — those
            are real money and real player data. Rival sets and stadium estimates are left out too: both
            are derived and cheaper to recompute than to map between databases.
        </p>
    </div>

    <div class="bmc-card__band bmc-row" style="gap:16px">
        <div class="bmc-field-col" style="flex:1 1 280px">
            <span class="bmc-lbl bmc-lbl--ink">EXPORT</span>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <span class="bmc-select">
                    <select id="exportCountry" style="min-width:190px">
                        <option value="">All countries</option>
                        {% for row in countries %}
                            <option value="{{ row.code }}"{{ row.code == selectedCountry ? ' selected' : '' }}>{{ row.code }} — {{ row.name }}</option>
                        {% endfor %}
                    </select>
                </span>
                <a class="bmc-btn bmc-btn--green" id="exportLink" href="{{ path('admin', {routeName: 'admin_locations_export'}) }}"><span>DOWNLOAD JSON</span></a>
            </div>
            <span class="bmc-data">Reads only. Writes nothing.</span>
        </div>

        <form method="post" action="{{ path('admin', {routeName: 'admin_locations_import'}) }}"
              enctype="multipart/form-data" class="bmc-field-col" style="flex:1 1 320px">
            <input type="hidden" name="_token" value="{{ csrf_token('locations_import') }}">
            <span class="bmc-lbl bmc-lbl--ink">IMPORT</span>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="file" id="locationsFile" name="locations_file" accept="application/json,.json" required
                       class="bmc-data" style="max-width:240px">
                <button type="submit" class="bmc-btn bmc-btn--blue"><span>APPLY</span></button>
            </div>
            <label class="bmc-check" style="padding-left:0">
                <input type="checkbox" id="importDryRun" name="dry_run" value="1" checked>
                <span class="bmc-tile"></span>
                <span class="bmc-data">Dry run — report what would change and write nothing</span>
            </label>
            <span class="bmc-data">
                An <strong>upsert</strong>, matched on country + slug. Nothing is ever deleted, and there is
                no &ldquo;clear first&rdquo;: a town can carry an active claim, and the database refuses to
                delete one. Fields you have <strong>locked</strong> here are skipped and counted — an import
                must not undo your review.
            </span>
        </form>
    </div>
</section>

{# ── recent runs ──────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="history"></i>
        <span class="bmc-card__title">RECENT RUNS</span>
        <span class="bmc-card__meta">last {{ recentRuns|length }}</span>
    </div>
    {% if recentRuns is empty %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NO ENRICHMENT HAS BEEN RUN YET</span></div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:720px">
                <thead><tr>
                    <th>STARTED</th><th>TRIGGER</th><th>SCOPE</th><th>MODEL</th>
                    <th class="is-right">QUEUED</th><th class="is-right">OK</th>
                    <th class="is-right">REVIEW</th><th class="is-right">FAILED</th><th>STATE</th>
                </tr></thead>
                <tbody>
                {% for run in recentRuns %}
                    <tr>
                        <td><span class="bmc-data">{{ run.startedAt|date('Y-m-d H:i:s') }}</span></td>
                        <td><span class="bmc-celltext">{{ run.trigger.value }}</span></td>
                        <td><span class="bmc-data">{{ run.countryCode ?? 'all' }}</span></td>
                        <td><span class="bmc-data">{{ run.model }}</span></td>
                        <td class="is-right bmc-cellnum">{{ run.queued }}</td>
                        <td class="is-right bmc-cellnum">{{ run.succeeded }}</td>
                        <td class="is-right bmc-cellnum">{{ run.needsReview }}</td>
                        <td class="is-right bmc-cellnum">{{ run.failed }}</td>
                        <td><span class="bmc-badge bmc-badge--subtle">{{ run.status.value }}</span></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
// Keeps the download link's ?country= in step with the select, so the button exports what the
// operator just chose rather than whatever the page loaded with.
// Filters the Pull towns picker, which is now seventy-one entries long.
//
// REBUILDS THE OPTION LIST FROM A HELD COPY rather than hiding <option> elements. Hiding them
// with display:none works in Chrome and Firefox and does nothing at all in Safari, so the
// filter would silently not filter for some operators — and a filter you cannot trust is worse
// than none. Removing and re-adding is the one approach every browser agrees on.
//
// The <select> keeps its name and its `required`, so the form posts and validates exactly as
// it did before, and with JS off the full list is simply there.
(function () {
    var filter = document.getElementById('suggestFilter');
    var select = document.getElementById('suggestCountry');
    var count  = document.getElementById('suggestCountryCount');
    if (!filter || !select) { return; }

    var all = Array.prototype.slice.call(select.options);
    var placeholder = all[0];

    function apply() {
        var q = filter.value.trim().toLowerCase();
        var chosen = select.value;
        var shown = 0;

        select.textContent = '';
        select.appendChild(placeholder);

        all.forEach(function (opt) {
            if (opt === placeholder) { return; }
            if (q !== '' && opt.textContent.toLowerCase().indexOf(q) === -1) { return; }
            select.appendChild(opt);
            shown++;
        });

        // Keep the operator's pick if it survived the filter; otherwise fall back to the
        // placeholder so the form cannot post a country that is no longer on screen.
        select.value = chosen;
        if (select.selectedIndex === -1) { select.value = ''; }

        if (count) {
            count.textContent = q === '' ? '' : shown + ' of ' + (all.length - 1) + ' match';
        }
    }

    filter.addEventListener('input', apply);
    // Enter in a filter box would otherwise submit the form and start a paid pull.
    filter.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); } });
})();

(function () {
    var select = document.getElementById('exportCountry'), link = document.getElementById('exportLink');
    if (!select || !link) { return; }
    var base = link.getAttribute('href');
    function sync() {
        link.setAttribute('href', select.value
            ? base + (base.indexOf('?') === -1 ? '?' : '&') + 'country=' + encodeURIComponent(select.value)
            : base);
    }
    select.addEventListener('change', sync);
    sync();
})();
</script>

{# ── Pull towns progress poll ───────────────────────────────────────────────
   Recursive setTimeout rather than setInterval, and it swallows transient errors so a blip
   does not end the watch — the pattern worldpack_cache.html.twig established.

   Polls a dedicated JSON route, never a refresh of this page: overview() makes a live provider
   call to render the connection verdict, so re-fetching it every 2.5s would turn a six-batch
   run into a hundred extra round trips.
   ──────────────────────────────────────────────────────────────────────── #}
<script>
(function () {
    const STATUS_URL_TPL  = '{{ path('admin_locations_suggest_towns_status', {country: '__CC__'}) }}';
    const POLL_INTERVAL_MS = 2500;
    const TERMINAL_RUN_STATUSES = ['complete', 'cancelled'];

    const panel    = document.getElementById('suggest-progress');
    const summary  = document.getElementById('suggest-progress-summary');
    const bar      = document.getElementById('suggest-progress-bar');
    const list     = document.getElementById('suggest-batches');
    const depth    = document.getElementById('suggest-queue-depth');
    const submit   = document.getElementById('suggest-submit');
    const recent      = document.getElementById('suggest-recent');
    const recentList  = document.getElementById('suggest-recent-list');
    const recentCount = document.getElementById('suggest-recent-count');

    // Names already shown, so a name arriving between polls can be highlighted for one tick.
    // Without it every poll would re-render ten identical pills and the ticker would look
    // static even while towns were landing.
    const seenTowns = new Set();

    // The FIRST paint highlights nothing. On a reload mid-run every name is new to this page
    // but none of them is new to the operator, and lighting all ten up would say "ten just
    // arrived" when nothing had.
    let tickerPainted = false;

    if (!panel) { return; }

    let polling = false;

    const BATCH_BADGE = {
        pending:   'subtle',
        running:   'accent',
        completed: 'positive',
        failed:    'danger',
    };

    function escHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
    }

    function renderBatch(b) {
        const badge = BATCH_BADGE[b.status] ?? 'subtle';
        // Imported, not offered: it is the only figure that tells the operator whether the
        // money bought anything. A batch that offers fifty towns we already hold is a
        // completed batch with nothing to show, and that is an honest outcome, not a fault.
        const detail = b.status === 'completed'
            ? `${b.imported} added` + (b.alreadyHeld > 0 ? `, ${b.alreadyHeld} already held` : '')
            : (b.status === 'failed' ? escHtml(b.error ?? 'failed') : `${b.requested} requested`);
        const retry = b.attempts > 1 ? ` (attempt ${b.attempts})` : '';

        return `<div style="display:flex;align-items:center;gap:8px">
            <span class="bmc-badge bmc-badge--${badge}" style="min-width:104px;justify-content:center">BATCH ${b.index}/${b.total}</span>
            <span class="bmc-data">${detail}${retry}</span>
        </div>`;
    }

    function renderRecent(towns, importedTotal) {
        if (!recent) { return; }

        if (!towns || towns.length === 0) { recent.hidden = true; return; }
        recent.hidden = false;

        // "10 of 143" rather than bare "10": the window is capped, and without the total the
        // list reads as though the run only added ten.
        recentCount.textContent = importedTotal > towns.length ? `(${towns.length} of ${importedTotal})` : '';

        recentList.innerHTML = towns.map(name => {
            const isNew = tickerPainted && !seenTowns.has(name);
            return `<span class="bmc-badge bmc-badge--${isNew ? 'positive' : 'subtle'}">${escHtml(name)}</span>`;
        }).join('');

        towns.forEach(name => seenTowns.add(name));
        tickerPainted = true;
    }

    function render(run, queueDepth) {
        if (depth) { depth.textContent = `${queueDepth} queued`; }

        if (!run) { panel.hidden = true; return; }
        panel.hidden = false;

        const total   = run.totalBatches || 0;
        const settled = run.settledBatches || 0;
        const pct     = total > 0 ? Math.round((settled / total) * 100) : 0;

        bar.style.width = pct + '%';
        bar.className = 'bmc-bar__fill' + (run.failedBatches > 0 ? ' bmc-bar__fill--warning' : '');

        const parts = [`${settled} / ${total} batches`, `${run.importedTowns} town(s) added`];
        if (run.failedBatches > 0) { parts.push(`${run.failedBatches} failed`); }
        if (TERMINAL_RUN_STATUSES.includes(run.status)) { parts.push('done'); }
        summary.textContent = `${run.country} · ` + parts.join(' · ');

        list.innerHTML = run.batches.map(renderBatch).join('');
        renderRecent(run.recentTowns, run.importedTowns || 0);

        // Re-enable the button only once the queue is actually clear: the server refuses a
        // second run while batches are undrained, so offering it would just bounce.
        if (submit && queueDepth === 0 && TERMINAL_RUN_STATUSES.includes(run.status)) {
            submit.disabled = false;
        }
    }

    function poll(country) {
        if (polling) { return; }
        polling = true;

        const tick = async () => {
            try {
                const res  = await fetch(STATUS_URL_TPL.replace('__CC__', country));
                const data = await res.json();
                render(data.run, data.queueDepth ?? 0);

                if (data.run && TERMINAL_RUN_STATUSES.includes(data.run.status) && (data.queueDepth ?? 0) === 0) {
                    polling = false;
                    return; // stop; the panel stays rendered as-is
                }
            } catch (e) {
                // transient — the next tick may recover
            }

            setTimeout(tick, POLL_INTERVAL_MS);
        };

        tick();
    }

    // A run already in flight when the page loaded. This is why the status route is keyed by
    // country rather than by run id: the operator is no longer pinned to the request, so they
    // can and will come back to a page they left mid-run.
    const initial = {{ suggestionRun is null ? 'null' : suggestionRun|json_encode|raw }};
    if (initial) {
        render(initial, {{ suggestionQueueDepth }});
        if (!TERMINAL_RUN_STATUSES.includes(initial.status) || {{ suggestionQueueDepth }} > 0) {
            poll(initial.country);
        }
    }
})();
</script>
{% endblock %}
