{% extends 'admin/bmc_page.html.twig' %}
{#
  Templates → Facility templates, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::facilitiesOverview() — facilities, byCategory.

  THE 320-LINE INLINE <style> IS GONE. It built a whole parallel design language — its own
  cards, buttons, inputs, filter pills and modal — on top of Bootstrap variables. Everything it
  drew now comes from bmc components, except the four CATEGORY ACCENT COLOURS, which stay as
  data because they are information: they tell Training from Medical at a glance across the
  grid and have no equivalent token.

  THE QUICK-EDIT MODAL WAS BOOTSTRAP'S, listening on show.bs.modal. It is now a
  .bmc-dialog-scrim driven by this page's own script — the same shape _league_dialogs.html.twig
  established, because BMC.confirm() is for yes/no and this one collects. That removes the last
  Bootstrap JS dependency outside the stock CRUD pages.

  THE DATA- ATTRIBUTES ON EACH CARD ARE THE DIALOG'S ONLY SOURCE. Nothing is re-fetched when it
  opens, so a field added here must be added to the dialog's populate step too.
#}

{% set FACILITY_CTRL = 'App\\Controller\\Admin\\FacilityTemplateCrudController' %}

{# Accent per category — information, not decoration. See the note above. #}
{% set CAT_META = {
    'TRAINING': { label: 'Training', color: '#3B82F6' },
    'MEDICAL':  { label: 'Medical',  color: '#F43F5E' },
    'SCOUTING': { label: 'Scouting', color: '#F59E0B' },
    'STADIUM':  { label: 'Stadium',  color: '#8B5CF6' },
} %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_npc_clubs_content'}) }}"><span>GENERATE</span></a>
    <a class="bmc-btn bmc-btn--blue" href="{{ ea_url().setController(FACILITY_CTRL).setAction('new').generateUrl() }}"><span>NEW TEMPLATE</span></a>
{% endblock %}

{% block bmc_body %}

<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="building"></i>
        <span class="bmc-card__title">FACILITY TEMPLATES</span>
        <span class="bmc-card__meta">
            {{ facilities|length }} template{{ facilities|length != 1 ? 's' : '' }} across
            {{ byCategory|length }} categor{{ byCategory|length != 1 ? 'ies' : 'y' }} · gameplay effects live in Full edit
        </span>
    </div>

    <div class="bmc-card__band" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <div class="bmc-segs" id="fac-filters" role="group" aria-label="Filter by category">
            <button type="button" class="bmc-quick-btn is-on" data-filter="all" aria-pressed="true">
                ALL <span class="bmc-badge bmc-badge--subtle">{{ facilities|length }}</span>
            </button>
            {% for cat, items in byCategory %}
                {% set meta = CAT_META[cat] ?? { label: cat, color: '#6B7280' } %}
                <button type="button" class="bmc-quick-btn" data-filter="{{ cat }}" aria-pressed="false">
                    <span class="bmc-dot" style="background:{{ meta.color }}"></span>
                    {{ meta.label|upper }} <span class="bmc-badge bmc-badge--subtle">{{ items|length }}</span>
                </button>
            {% endfor %}
        </div>
        <span style="flex:1"></span>
        <label class="bmc-search" style="min-width:220px">
            <i data-lucide="search" width="16" height="16"></i>
            <input type="search" class="bmc-input" id="fac-search" placeholder="Search templates…" aria-label="Search templates">
        </label>
    </div>
</section>

<div class="bmc-grid" id="fac-grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
    {% for facility in facilities %}
        {% set cat  = facility.category %}
        {% set meta = CAT_META[cat] ?? { label: cat, color: '#6B7280' } %}
        {% set effects = facility.gameplayEffects %}

        <section class="bmc-card fac-card" data-domain="club"
                 data-category="{{ cat }}"
                 data-label="{{ facility.label|lower }}"
                 data-slug="{{ facility.slug|lower }}"
                 style="border-left:4px solid {{ meta.color }}">
            <div class="bmc-card__head">
                <span class="bmc-dot" style="background:{{ meta.color }}"></span>
                <span class="bmc-card__title">{{ facility.label }}</span>
                <span class="bmc-badge bmc-badge--{{ facility.isActive ? 'positive' : 'subtle' }}">
                    {{ facility.isActive ? 'ACTIVE' : 'INACTIVE' }}
                </span>
            </div>

            <div class="bmc-card__band">
                <code class="bmc-code">{{ facility.slug }}</code>
            </div>

            <div class="bmc-stats">
                <div class="bmc-stat"><span class="bmc-stat__label">COST</span><span class="bmc-stat__value">£{{ (facility.baseCost / 100)|number_format(0, '.', ',') }}</span></div>
                <div class="bmc-stat"><span class="bmc-stat__label">UPKEEP/WK</span><span class="bmc-stat__value">£{{ (facility.weeklyUpkeepBase / 100)|number_format(0, '.', ',') }}</span></div>
                <div class="bmc-stat"><span class="bmc-stat__label">MAX LVL</span><span class="bmc-stat__value">{{ facility.maxLevel }}</span></div>
                <div class="bmc-stat"><span class="bmc-stat__label">BUILD WKS</span><span class="bmc-stat__value">{{ facility.baseConstructionWeeks == 0 ? '—' : facility.baseConstructionWeeks }}</span></div>
                {% if facility.reputationBonus > 0 %}
                    <div class="bmc-stat"><span class="bmc-stat__label">REP BONUS</span><span class="bmc-stat__value ink-positive">+{{ facility.reputationBonus }}</span></div>
                {% endif %}
                {% if facility.matchdayIncome %}
                    <div class="bmc-stat"><span class="bmc-stat__label">MATCHDAY</span><span class="bmc-stat__value">£{{ (facility.matchdayIncome / 100)|number_format(0, '.', ',') }}</span></div>
                {% endif %}
                <div class="bmc-stat"><span class="bmc-stat__label">SORT</span><span class="bmc-stat__value">{{ facility.sortOrder }}</span></div>
            </div>

            <div class="bmc-card__body" style="display:flex;flex-wrap:wrap;gap:4px">
                {% if effects is empty %}
                    <span class="bmc-empty-note">NO GAMEPLAY EFFECTS CONFIGURED</span>
                {% else %}
                    {% for key, val in effects %}
                        {% set displayVal = val is iterable ? val|join(', ') : val %}
                        <span class="bmc-badge bmc-badge--subtle" title="{{ key }}: {{ displayVal }}">
                            {{ key|replace({'PerLevel': '/lvl', 'Multiplier': '×', 'Delta': 'Δ', 'Growth': '+', 'Bonus': '+'}) }}: {{ displayVal }}
                        </span>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="bmc-card__band" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                {# The dialog reads these and re-fetches nothing, so a new field here needs a
                   matching line in its populate step. #}
                <button type="button" class="bmc-btn bmc-btn--blue" data-fac-edit
                        data-id="{{ facility.id|ea_as_string }}"
                        data-label="{{ facility.label|e('html_attr') }}"
                        data-description="{{ facility.description|e('html_attr') }}"
                        data-category="{{ cat }}"
                        data-base-cost="{{ (facility.baseCost / 100) }}"
                        data-weekly-upkeep="{{ (facility.weeklyUpkeepBase / 100) }}"
                        data-max-level="{{ facility.maxLevel }}"
                        data-build-weeks="{{ facility.baseConstructionWeeks }}"
                        data-sort-order="{{ facility.sortOrder }}"
                        data-reputation-bonus="{{ facility.reputationBonus }}"
                        data-decay-base="{{ facility.decayBase }}"
                        data-is-active="{{ facility.isActive ? '1' : '0' }}"
                        data-csrf="{{ csrf_token('facility_qe_' ~ facility.id|ea_as_string) }}"
                        data-full-edit="{{ ea_url().setController(FACILITY_CTRL).setAction('edit').setEntityId(facility.id|ea_as_string).generateUrl() }}"
                        data-accent="{{ meta.color }}"><span>QUICK EDIT</span></button>
                <span style="flex:1"></span>
                <a class="bmc-btn" href="{{ ea_url().setController(FACILITY_CTRL).setAction('edit').setEntityId(facility.id|ea_as_string).generateUrl() }}"
                   title="Full edit in EasyAdmin"><span>FULL EDIT</span></a>
            </div>
        </section>
    {% else %}
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__body"><span class="bmc-empty-note">NO FACILITY TEMPLATES — CREATE ONE TO GET STARTED</span></div>
        </section>
    {% endfor %}
</div>

<section class="bmc-card" id="fac-no-match" data-domain="club" hidden>
    <div class="bmc-card__body"><span class="bmc-empty-note">NO TEMPLATES MATCH YOUR FILTER</span></div>
</section>

{# ── quick edit ──────────────────────────────────────────────────────── #}
<div class="bmc-overlay">
    <div class="bmc-dialog-scrim" id="fac-scrim" hidden>
        <div class="bmc-dialog bmc-dialog--wide" role="dialog" aria-modal="true" aria-labelledby="fac-qe-title">
            <h2 class="bmc-dialog__title" id="fac-qe-title">QUICK EDIT</h2>
            <p class="bmc-dialog__msg" id="fac-qe-sub"></p>

            <form id="fac-qe-form" method="post" action="">
                <input type="hidden" name="_token" id="fac-qe-token" value="">

                <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px">
                    <div class="bmc-field-col" style="grid-column:1/-1">
                        <span class="bmc-lbl">LABEL</span>
                        <label class="bmc-textbox"><input type="text" name="label" id="fac-qe-label" maxlength="100" required placeholder="Display name"></label>
                    </div>
                    <div class="bmc-field-col" style="grid-column:1/-1">
                        <span class="bmc-lbl">DESCRIPTION</span>
                        <label class="bmc-textbox" style="height:auto;padding:6px 8px">
                            <textarea name="description" id="fac-qe-description" rows="2" maxlength="500"
                                      style="all:unset;width:100%;font:var(--text-data);color:var(--wk-text);resize:vertical"></textarea>
                        </label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">CATEGORY</span>
                        <span class="bmc-select">
                            <select name="category" id="fac-qe-category" style="width:100%">
                                {% for value, meta in CAT_META %}
                                    <option value="{{ value }}">{{ meta.label }}</option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">BASE COST £</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="baseCost" id="fac-qe-base-cost" min="0" step="1" inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">UPKEEP/WK £</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="weeklyUpkeepBase" id="fac-qe-upkeep" min="0" step="1" inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">MAX LEVEL</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="maxLevel" id="fac-qe-max-level" min="1" max="100" required inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">BUILD WEEKS</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="baseConstructionWeeks" id="fac-qe-build-weeks" min="0" max="52" inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">SORT ORDER</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="sortOrder" id="fac-qe-sort" min="0" inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">REP BONUS</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="reputationBonus" id="fac-qe-rep-bonus" min="0" step="0.01" inputmode="decimal"></label>
                    </div>
                    <div class="bmc-field-col">
                        <span class="bmc-lbl">DECAY BASE</span>
                        <label class="bmc-num bmc-num--fill"><input type="number" name="decayBase" id="fac-qe-decay-base" min="0" step="0.01" inputmode="decimal"></label>
                    </div>
                </div>

                <label class="bmc-check" style="padding-left:0;margin:12px 0">
                    <input type="checkbox" name="isActive" id="fac-qe-is-active">
                    <span class="bmc-tile"></span>
                    <span class="bmc-data">Active</span>
                </label>

                <div class="bmc-dialog__actions">
                    <a class="bmc-btn" id="fac-qe-full" href="#"><span>FULL EDIT</span></a>
                    <button type="button" class="bmc-btn" data-fac-cancel><span>CANCEL</span></button>
                    <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE</span></button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var $ = function (s) { return document.querySelector(s); };
    var $$ = function (s) { return [].slice.call(document.querySelectorAll(s)); };

    // ── filter + search ─────────────────────────────────────────────
    var filter = 'all';

    function apply() {
        var q = ($('#fac-search').value || '').toLowerCase().trim();
        var visible = 0;

        $$('#fac-grid .fac-card').forEach(function (card) {
            var byCat  = filter === 'all' || card.dataset.category === filter;
            var byText = q === '' || card.dataset.label.indexOf(q) !== -1 || card.dataset.slug.indexOf(q) !== -1;
            card.hidden = !(byCat && byText);
            if (!card.hidden) visible++;
        });

        $('#fac-no-match').hidden = visible > 0;
    }

    $$('#fac-filters [data-filter]').forEach(function (b) {
        b.addEventListener('click', function () {
            filter = b.dataset.filter;
            $$('#fac-filters [data-filter]').forEach(function (o) {
                o.classList.toggle('is-on', o === b);
                o.setAttribute('aria-pressed', o === b ? 'true' : 'false');
            });
            apply();
        });
    });
    $('#fac-search').addEventListener('input', apply);

    // ── quick edit ──────────────────────────────────────────────────
    // Replaces Bootstrap's modal. Same scrim/dialog shape _league_dialogs.html.twig uses:
    // BMC.confirm() is for yes/no, and this one collects.
    var scrim = $('#fac-scrim'), form = $('#fac-qe-form');
    var CAT_COLORS = {{ CAT_META|map(m => m.color)|json_encode|raw }};

    function close() { scrim.hidden = true; document.removeEventListener('keydown', onKey); }
    function onKey(e) { if (e.key === 'Escape') close(); }

    function accent(colour) {
        $('.bmc-dialog', scrim).style.borderColor = colour || 'var(--wk-accent)';
    }

    $$('[data-fac-edit]').forEach(function (b) {
        b.addEventListener('click', function () {
            var d = b.dataset;

            form.action = '/admin/facilities/' + d.id + '/quick-edit';
            $('#fac-qe-token').value       = d.csrf || '';
            $('#fac-qe-sub').textContent   = d.label || '';
            $('#fac-qe-label').value       = d.label || '';
            $('#fac-qe-description').value = d.description || '';
            $('#fac-qe-category').value    = d.category || 'TRAINING';
            $('#fac-qe-base-cost').value   = d.baseCost || '';
            $('#fac-qe-upkeep').value      = d.weeklyUpkeep || '';
            $('#fac-qe-max-level').value   = d.maxLevel || '';
            $('#fac-qe-build-weeks').value = d.buildWeeks || '';
            $('#fac-qe-sort').value        = d.sortOrder || '';
            $('#fac-qe-rep-bonus').value   = d.reputationBonus || '';
            $('#fac-qe-decay-base').value  = d.decayBase || '';
            $('#fac-qe-is-active').checked = d.isActive === '1';
            $('#fac-qe-full').href         = d.fullEdit || '#';

            accent(d.accent);
            scrim.hidden = false;
            document.addEventListener('keydown', onKey);
            $('#fac-qe-label').focus();
        });
    });

    $('#fac-qe-category').addEventListener('change', function () {
        accent(CAT_COLORS[this.value]);
    });

    $('[data-fac-cancel]').addEventListener('click', close);
    scrim.addEventListener('click', function (e) { if (e.target === scrim) close(); });
}());
</script>
{% endblock %}
