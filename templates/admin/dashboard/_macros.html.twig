{#
   Shared dashboard chrome. Extracted so the KPI tiles and section headings
   stop being copy-pasted markup with inline styles.
#}

{# Heading and note sit on separate planes, split by a hairline rule. #}
{% macro section(title, note) %}
    <div class="dash-heading">
        <h2 class="h-title">{{ title }}</h2>
        <span class="h-rule" aria-hidden="true"></span>
        {% if note %}<span class="h-note">{{ note }}</span>{% endif %}
    </div>
{% endmacro %}

{#
   Activity tile: all-time value, three rolling deltas, sparkline behind.
   Every metric in this band has a series, so the row never goes ragged.
#}
{% macro kpi_activity(metric, label, icon, value, modifier) %}
    <div class="kpi {{ modifier }}" data-kpi="{{ metric }}">
        <div class="kpi-label"><i class="fa {{ icon }}" aria-hidden="true"></i>{{ label }}</div>
        <div class="kpi-value{{ value is null ? ' is-muted' : '' }}" data-kpi-value>{{ value is null ? '—' : value|number_format }}</div>
        <div class="kpi-sub" data-kpi-sub></div>
        <div class="kpi-deltas" data-kpi-deltas>
            {% for w in ['24h', '7d', '30d'] %}
                <span class="kpi-delta">
                    <span class="d-window">{{ w }}</span>
                    <span class="d-value is-zero" data-window="{{ w }}">–</span>
                </span>
            {% endfor %}
        </div>
        <div class="kpi-spark"><canvas data-kpi-spark aria-hidden="true"></canvas></div>
    </div>
{% endmacro %}

{# Inventory tile: a standing count with a composition strip, not a trend. #}
{% macro kpi_stock(metric, label, icon, value, modifier) %}
    <div class="kpi {{ modifier }}" data-kpi-stock="{{ metric }}">
        <div class="kpi-label"><i class="fa {{ icon }}" aria-hidden="true"></i>{{ label }}</div>
        <div class="kpi-value{{ value is null ? ' is-muted' : '' }}" data-kpi-value>{{ value is null ? '—' : value|number_format }}</div>
        <div class="kpi-sub" data-kpi-sub></div>
        <div class="kpi-strip" data-kpi-strip aria-hidden="true"></div>
        <div class="kpi-strip-legend" data-kpi-legend></div>
    </div>
{% endmacro %}

{#
   A lazily-loaded panel: header with its own refresh control, a skeleton sized
   to the panel's final height, and an error slot.
#}
{% macro panel(id, title, src, panel_key, height) %}
    <div class="dash-panel" data-panel id="{{ id }}" data-src="{{ src }}" data-panel-key="{{ panel_key }}">
        <div class="dash-panel-head">
            <h3 class="p-title">{{ title }}</h3>
            <span class="p-meta">
                <span class="p-stamp" data-panel-stamp></span>
                <button type="button" class="dash-refresh" data-panel-refresh>
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                    <span class="visually-hidden">Refresh {{ title }}</span>
                </button>
            </span>
        </div>
        <div class="dash-panel-body">
            <div class="dash-skeleton" data-panel-loading style="min-height:{{ height|default(220) }}px;" role="status">
                <span class="visually-hidden">Loading {{ title }}…</span>
                <i></i><i></i><i></i><i></i>
            </div>
            <div class="dash-error d-none" data-panel-error role="alert">
                <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
                <span data-panel-error-text></span>
                <button type="button" class="dash-refresh" data-panel-refresh>Retry</button>
            </div>
            <div class="d-none" data-panel-content></div>
        </div>
    </div>
{% endmacro %}
