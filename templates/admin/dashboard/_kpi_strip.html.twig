{% import 'admin/dashboard/_macros.html.twig' as dash %}

{{ dash.section('Platform', 'rolling windows · 30-day trend') }}

<div data-kpi-strip data-src="{{ path('admin_stats_growth') }}" style="display:flex;flex-direction:column;gap:12px">
    {# Activity: things that happen. Each has a series, so the row never goes ragged. #}
    <div class="bmc-stats bmc-stats--card">
        {{ dash.kpi_activity('users',       'Users',        stats.users) }}
        {{ dash.kpi_activity('clubs',       'Clubs',        stats.clubs) }}
        {{ dash.kpi_activity('syncs',       'Syncs',        stats.syncs) }}
        {{ dash.kpi_activity('activeClubs', 'Active clubs', null) }}
    </div>

    {# Stock: things that exist. A composition strip rather than a trend. #}
    <div class="bmc-stats bmc-stats--card">
        {{ dash.kpi_activity('invalidSyncs', 'Invalid syncs', stats.invalidSyncs) }}
        {{ dash.kpi_stock('players', 'Pool players') }}
        {{ dash.kpi_stock('staff',   'Pool staff') }}
        {{ dash.kpi_stock('agents',  'Agents') }}
    </div>
</div>
