{% extends '@EasyAdmin/layout.html.twig' %}

{% set COUNTRIES = {
    'EN': 'England',     'ES': 'Spain',       'DE': 'Germany',
    'IT': 'Italy',       'FR': 'France',       'BR': 'Brazil',
    'AR': 'Argentina',   'NL': 'Netherlands',  'PT': 'Portugal',
    'NG': 'Nigeria',     'GH': 'Ghana',        'JP': 'Japan',
    'KR': 'South Korea', 'SE': 'Sweden',       'DK': 'Denmark',
    'IE': 'Ireland',     'CI': 'Ivory Coast',  'SN': 'Senegal',
    'CN': 'China'
} %}

{% set NPC_CLUB_CTRL = 'App\\Controller\\Admin\\NpcClubCrudController' %}
{% set LEAGUE_CTRL   = 'App\\Controller\\Admin\\LeagueCrudController' %}

{% set TIER_COLORS = {
    1: '#ffd700', 2: '#e0b020', 3: '#c0a060',
    4: '#6c757d', 5: '#6c757d', 6: '#495057',
    7: '#343a40', 8: '#198754'
} %}

{% block content %}
<style>
    .league-country-section { margin-bottom: 2rem; }
    .league-country-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .6rem 1rem;
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-bottom: 2px solid var(--bs-primary);
        cursor: pointer;
        user-select: none;
    }
    .league-country-header:hover { background: var(--bs-tertiary-bg); }
    .league-country-code {
        font-family: 'Courier New', monospace;
        font-weight: 700;
        font-size: .9rem;
        letter-spacing: .05em;
    }
    .league-country-name { font-weight: 600; }
    .league-country-meta { margin-left: auto; display: flex; align-items: center; gap: .5rem; }

    .league-tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: .75rem;
        padding: .75rem 0;
    }
    .league-card {
        border: 1px solid var(--bs-border-color);
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
    }
    .league-card-header {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        background: var(--bs-tertiary-bg);
    }
    .tier-badge {
        font-family: 'Courier New', monospace;
        font-size: .7rem;
        font-weight: 700;
        padding: .2rem .45rem;
        min-width: 2.2rem;
        text-align: center;
        letter-spacing: .03em;
    }
    .league-name {
        font-weight: 600;
        font-size: .85rem;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .league-edit-btn {
        font-size: .7rem;
        padding: .15rem .4rem;
        opacity: .6;
        transition: opacity .15s;
        white-space: nowrap;
    }
    .league-edit-btn:hover { opacity: 1; }

    .league-stats {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem;
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
    }
    .league-stat-chip {
        display: flex;
        align-items: center;
        gap: .25rem;
        font-size: .7rem;
        padding: .15rem .4rem;
        background: var(--bs-secondary-bg);
        border: 1px solid var(--bs-border-color);
        white-space: nowrap;
    }
    .league-stat-chip .chip-label {
        color: var(--bs-secondary-color);
        font-size: .65rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .league-stat-chip .chip-val {
        font-weight: 600;
        font-family: 'Courier New', monospace;
    }

    .league-sponsors {
        padding: .4rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        display: flex;
        flex-wrap: wrap;
        gap: .3rem;
        align-items: center;
    }
    .sponsor-label {
        font-size: .65rem;
        color: var(--bs-secondary-color);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-right: .15rem;
    }
    .sponsor-chip {
        font-size: .7rem;
        padding: .15rem .45rem;
        background: rgba(var(--bs-warning-rgb), .12);
        border: 1px solid rgba(var(--bs-warning-rgb), .3);
        color: var(--bs-warning-text-emphasis);
        white-space: nowrap;
    }

    .league-clubs {
        padding: .5rem .75rem;
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
        align-items: flex-start;
    }
    .league-clubs-empty {
        padding: .5rem .75rem;
        color: var(--bs-secondary-color);
        font-size: .75rem;
        font-style: italic;
    }
    .club-label {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .72rem;
        padding: .18rem .5rem .18rem .25rem;
        border: 1px solid var(--bs-border-color);
        background: var(--bs-secondary-bg);
        text-decoration: none;
        color: var(--bs-body-color);
        cursor: pointer;
        transition: border-color .15s, background .15s;
        white-space: nowrap;
    }
    .club-label:hover {
        border-color: var(--bs-primary);
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
    }
    .club-swatch {
        width: 10px;
        height: 10px;
        flex-shrink: 0;
        border: 1px solid rgba(0,0,0,.15);
    }
    .club-abbr {
        font-family: 'Courier New', monospace;
        font-size: .65rem;
        color: var(--bs-secondary-color);
    }

    .no-leagues-msg {
        padding: 1rem;
        color: var(--bs-secondary-color);
        font-style: italic;
        font-size: .85rem;
        border: 1px dashed var(--bs-border-color);
        text-align: center;
    }

    /* ── Trophy panel on league cards ──────────────────────────────── */
    .league-trophy-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--bs-border-color);
        background: var(--bs-tertiary-bg);
    }
    .league-trophy-img {
        width: 52px;
        height: 52px;
        object-fit: contain;
        flex-shrink: 0;
        transition: filter .25s;
    }
    .league-trophy-meta {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }
    .league-trophy-name {
        font-size: .72rem;
        font-weight: 600;
        font-family: 'Courier New', monospace;
        color: var(--bs-body-color);
    }
    .league-trophy-colour {
        font-size: .65rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--bs-secondary-color);
    }

    /* ── Trophy panel inside quick-edit modal ───────────────────────── */
    .qe-trophy-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .6rem;
        background: var(--bs-secondary-bg);
        border: 1px solid var(--bs-border-color);
        min-height: 96px;
    }
    .qe-trophy-panel img {
        width: 64px;
        height: 64px;
        object-fit: contain;
        transition: filter .2s, opacity .15s;
    }
    .qe-trophy-panel .qe-trophy-label {
        font-size: .65rem;
        color: var(--bs-secondary-color);
        text-transform: uppercase;
        letter-spacing: .05em;
        text-align: center;
    }
    .qe-trophy-panel.empty img { opacity: 0.12; filter: none !important; }
    .qe-trophy-panel.empty .qe-trophy-label { font-style: italic; }
</style>

<div class="mt-1">

    {# ── Page header ─────────────────────────────────────────────────────── #}
    <div class="d-flex align-items-center gap-3 mb-3">
        <div>
            <h5 class="fw-semibold mb-0">League Overview</h5>
            <p class="text-muted small mb-0">All leagues grouped by country. Click a club to edit it.</p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a href="{{ ea_url().setController(LEAGUE_CTRL).setAction('index') }}"
               class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-trophy me-1"></i>League CRUD
            </a>
            <a href="{{ path('admin_npc_clubs_content') }}"
               class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-wand-magic-sparkles me-1"></i>Generate
            </a>
        </div>
    </div>

    {% if leaguesByCountry is empty %}
        <div class="no-leagues-msg">No leagues found. Use the Generate panel to create league structures.</div>
    {% else %}

        {% for countryCode, tiers in leaguesByCountry %}
        {% set countryName = COUNTRIES[countryCode] ?? countryCode %}
        {% set leagueCount = tiers|length %}
        {% set totalClubs  = 0 %}
        {% for tier, league in tiers %}
            {% set leagueClubs = clubsByLeague[league.id|ea_as_string] ?? [] %}
            {% set totalClubs  = totalClubs + leagueClubs|length %}
        {% endfor %}

        <div class="league-country-section">

            {# ── Country header ─────────────────────────────────────────── #}
            <div class="league-country-header"
                 data-bs-toggle="collapse"
                 data-bs-target="#country-{{ countryCode }}"
                 aria-expanded="true">
                <span class="league-country-code">{{ countryCode }}</span>
                <span class="league-country-name">{{ countryName }}</span>
                <span class="league-country-meta">
                    <span class="badge bg-secondary">{{ leagueCount }} league{{ leagueCount != 1 ? 's' : '' }}</span>
                    {% if totalClubs > 0 %}
                        <span class="badge bg-primary bg-opacity-75">{{ totalClubs }} clubs</span>
                    {% endif %}
                    <i class="fa fa-chevron-down fa-xs text-muted ms-1" style="transition: transform .2s;"></i>
                </span>
            </div>

            {# ── League cards ───────────────────────────────────────────── #}
            <div class="collapse show" id="country-{{ countryCode }}">
                <div class="league-tier-grid">

                    {% for tier, league in tiers %}
                    {% set clubs       = clubsByLeague[league.id|ea_as_string] ?? [] %}
                    {% set tierColor   = TIER_COLORS[tier] ?? '#6c757d' %}
                    {% set hasStats    = league.prizeMoney or league.tvDeal or league.leaguePositionPot or league.promotionSpots %}
                    {% set hasTrophy   = league.trophyImage is not null %}
                    {% set hasSponsors = league.sponsors|length > 0 %}

                    <div class="league-card">

                        {# Header: tier badge + name + quick-edit button #}
                        {# Correct CSS filter chains for black SVG silhouettes:
                           brightness(0) normalises to black, invert(1) flips to white,
                           then sepia+saturate+hue-rotate applies the target colour. #}
                        {% set TROPHY_FILTERS = {
                            'silver':      'brightness(0) invert(0.72) saturate(0) brightness(1.15) contrast(1.05)',
                            'gold':        'brightness(0) invert(1) sepia(1) saturate(6) hue-rotate(8deg) brightness(0.82)',
                            'gold_silver': 'brightness(0) invert(1) sepia(0.7) saturate(3) hue-rotate(8deg) brightness(0.9)'
                        } %}

                        <div class="league-card-header">
                            <span class="tier-badge"
                                  style="background: {{ tierColor }}22; color: {{ tierColor }}; border: 1px solid {{ tierColor }}55;">
                                T{{ tier }}
                            </span>
                            <span class="league-name" title="{{ league.name }}">{{ league.name }}</span>
                            {% if league.leagueReputationTier %}
                                <span class="badge bg-secondary bg-opacity-50 fw-normal"
                                      style="font-size:.6rem;">
                                    {{ league.leagueReputationTier.value|upper }}
                                </span>
                            {% endif %}
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary league-edit-btn"
                                    title="Quick edit"
                                    data-bs-toggle="modal"
                                    data-bs-target="#leagueQuickEditModal"
                                    data-league-id="{{ league.id|ea_as_string }}"
                                    data-name="{{ league.name|e('html_attr') }}"
                                    data-tier="{{ league.tier }}"
                                    data-promotion-spots="{{ league.promotionSpots ?? '' }}"
                                    data-tv-deal="{{ league.tvDeal is not null ? (league.tvDeal / 100)|round : '' }}"
                                    data-prize-money="{{ league.prizeMoney is not null ? (league.prizeMoney / 100)|round : '' }}"
                                    data-league-position-pot="{{ league.leaguePositionPot is not null ? (league.leaguePositionPot / 100)|round : '' }}"
                                    data-trophy-image="{{ league.trophyImage ?? '' }}"
                                    data-trophy-colour="{{ league.trophyColour ? league.trophyColour.value : '' }}"
                                    data-sponsor-count="{{ league.sponsorCount }}"
                                    data-csrf-token="{{ csrf_token('league_qe_' ~ league.id|ea_as_string) }}"
                                    data-full-edit-url="{{ ea_url().setController(LEAGUE_CTRL).setAction('edit').setEntityId(league.id|ea_as_string) }}">
                                <i class="fa fa-pencil"></i>
                            </button>
                        </div>

                        {# Trophy panel — only shown when a trophy is configured #}
                        {% if hasTrophy %}
                        {% set trophyFilter = TROPHY_FILTERS[league.trophyColour ? league.trophyColour.value : ''] ?? 'none' %}
                        <div class="league-trophy-row">
                            <img class="league-trophy-img"
                                 src="/images/trophies/{{ league.trophyImage }}.svg"
                                 alt="Trophy"
                                 style="filter: {{ trophyFilter }};">
                            <div class="league-trophy-meta">
                                <span class="league-trophy-name">{{ league.trophyImage|replace({'trophy-': 'Trophy '}) }}</span>
                                {% if league.trophyColour %}
                                    <span class="league-trophy-colour">{{ league.trophyColour.label() }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}

                        {# Stats: prize money, TV deal, position pot, promotion spots #}
                        {% if hasStats %}
                        <div class="league-stats">
                            {% if league.prizeMoney %}
                                <div class="league-stat-chip">
                                    <span class="chip-label">Prize</span>
                                    <span class="chip-val">£{{ (league.prizeMoney / 100)|number_format(0, '.', ',') }}</span>
                                </div>
                            {% endif %}
                            {% if league.tvDeal %}
                                <div class="league-stat-chip">
                                    <span class="chip-label">TV</span>
                                    <span class="chip-val">£{{ (league.tvDeal / 100)|number_format(0, '.', ',') }}</span>
                                </div>
                            {% endif %}
                            {% if league.leaguePositionPot %}
                                <div class="league-stat-chip">
                                    <span class="chip-label">Pos Pot</span>
                                    <span class="chip-val">£{{ (league.leaguePositionPot / 100)|number_format(0, '.', ',') }}</span>
                                </div>
                            {% endif %}
                            {% if league.promotionSpots %}
                                <div class="league-stat-chip">
                                    <span class="chip-label">Up</span>
                                    <span class="chip-val" style="color: #198754;">+{{ league.promotionSpots }}</span>
                                </div>
                            {% endif %}
                        </div>
                        {% endif %}

                        {# Sponsors #}
                        {% if hasSponsors %}
                        <div class="league-sponsors">
                            <span class="sponsor-label">
                                <i class="fa fa-star fa-xs"></i> Sponsors
                            </span>
                            {% for sponsor in league.sponsors %}
                                <span class="sponsor-chip">{{ sponsor.name }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}

                        {# Clubs inline labels #}
                        {% if clubs|length > 0 %}
                        <div class="league-clubs">
                            {% for club in clubs %}
                                <a href="{{ ea_url().setController(NPC_CLUB_CTRL).setAction('edit').setEntityId(club.id|ea_as_string) }}"
                                   class="club-label"
                                   title="{{ club.name }}{% if club.stadiumName %} · {{ club.stadiumName }}{% endif %} · Rep {{ club.reputation }}">
                                    <span class="club-swatch" style="background: {{ club.primaryColor }};"></span>
                                    {{ club.name }}
                                    {% if club.abbreviation %}
                                        <span class="club-abbr">{{ club.abbreviation }}</span>
                                    {% endif %}
                                </a>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="league-clubs-empty">No clubs assigned to this league.</div>
                        {% endif %}

                    </div>{# /.league-card #}
                    {% endfor %}

                </div>{# /.league-tier-grid #}
            </div>{# /.collapse #}

        </div>{# /.league-country-section #}
        {% endfor %}

    {% endif %}
</div>

{# ── League Quick-Edit Modal ──────────────────────────────────────────────── #}
<div class="modal fade" id="leagueQuickEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
        <div class="modal-content">
            <form method="POST" id="leagueQuickEditForm" action="">
                <input type="hidden" name="_token" id="qe-token" value="">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-semibold mb-0">
                        <i class="fa fa-pencil fa-xs me-1 text-muted"></i> Quick Edit League
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pb-2">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1" for="qe-name">Name</label>
                            <input type="text" class="form-control form-control-sm" id="qe-name" name="name" required maxlength="100">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-tier">Tier</label>
                            <input type="number" class="form-control form-control-sm" id="qe-tier" name="tier" min="1" max="8" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-promotionSpots">Promotion Spots</label>
                            <input type="number" class="form-control form-control-sm" id="qe-promotionSpots" name="promotionSpots" min="0" placeholder="none">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-tvDeal">TV Deal</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">£</span>
                                <input type="number" class="form-control" id="qe-tvDeal" name="tvDeal" min="0" step="1" placeholder="none">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-sponsorCount">Sponsors</label>
                            <input type="number" class="form-control form-control-sm" id="qe-sponsorCount" name="sponsorCount" min="1" max="20" step="1" placeholder="0">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-prizeMoney">Prize Money</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">£</span>
                                <input type="number" class="form-control" id="qe-prizeMoney" name="prizeMoney" min="0" step="1" placeholder="none">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1" for="qe-leaguePositionPot">Position Pot</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">£</span>
                                <input type="number" class="form-control" id="qe-leaguePositionPot" name="leaguePositionPot" min="0" step="1" placeholder="none">
                            </div>
                        </div>
                        {# ── Trophy row: selects left · live preview right ── #}
                        <div class="col-12">
                            <div class="d-flex gap-2 align-items-stretch">
                                <div class="flex-grow-1 d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small fw-semibold mb-1" for="qe-trophyImage">Trophy Design</label>
                                        <select class="form-select form-select-sm" id="qe-trophyImage" name="trophyImage">
                                            <option value="">— None —</option>
                                            {% for n in 1..15 %}
                                                <option value="trophy-{{ n }}">Trophy {{ n }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label small fw-semibold mb-1" for="qe-trophyColour">Colour</label>
                                        <select class="form-select form-select-sm" id="qe-trophyColour" name="trophyColour">
                                            <option value="">— None —</option>
                                            <option value="silver">Silver</option>
                                            <option value="gold">Gold</option>
                                            <option value="gold_silver">Gold &amp; Silver</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="qe-trophy-panel empty" id="qe-trophy-panel" style="width:104px;flex-shrink:0;">
                                    <img id="qe-trophy-preview"
                                         src="/images/trophies/trophy-1.svg"
                                         alt="Trophy preview">
                                    <span class="qe-trophy-label" id="qe-trophy-label">No trophy</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 d-flex align-items-center gap-2">
                    <a href="#" id="qe-full-edit-link" class="btn btn-sm btn-outline-secondary me-auto" title="Open full EasyAdmin edit page">
                        <i class="fa fa-arrow-up-right-from-square fa-xs me-1"></i>Full Edit
                    </a>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="fa fa-floppy-disk fa-xs me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Rotate chevron on collapse toggle
document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function (el) {
    var chevron = el.querySelector('.fa-chevron-down');
    var target  = document.querySelector(el.getAttribute('data-bs-target'));
    if (!target || !chevron) return;
    target.addEventListener('show.bs.collapse',  function () { chevron.style.transform = 'rotate(0deg)';    });
    target.addEventListener('hide.bs.collapse',  function () { chevron.style.transform = 'rotate(-90deg)'; });
});

// Quick-edit modal: populate + AJAX save
(function () {
    var modal = document.getElementById('leagueQuickEditModal');
    if (!modal) return;

    var COLOUR_FILTERS = {
        silver:      'brightness(0) invert(0.72) saturate(0) brightness(1.15) contrast(1.05)',
        gold:        'brightness(0) invert(1) sepia(1) saturate(6) hue-rotate(8deg) brightness(0.82)',
        gold_silver: 'brightness(0) invert(1) sepia(0.7) saturate(3) hue-rotate(8deg) brightness(0.9)',
    };

    var TIER_COLORS = {
        1: '#ffd700', 2: '#e0b020', 3: '#c0a060',
        4: '#6c757d', 5: '#6c757d', 6: '#495057',
        7: '#343a40', 8: '#198754',
    };

    // ── trophy preview in modal ──────────────────────────────────────────
    function refreshTrophyPreview() {
        var slug   = document.getElementById('qe-trophyImage').value;
        var colour = document.getElementById('qe-trophyColour').value;
        var panel  = document.getElementById('qe-trophy-panel');
        var img    = document.getElementById('qe-trophy-preview');
        var label  = document.getElementById('qe-trophy-label');

        if (slug) {
            img.src           = '/images/trophies/' + slug + '.svg';
            img.style.filter  = COLOUR_FILTERS[colour] || 'brightness(0) invert(0.15)';
            label.textContent = slug.replace('trophy-', 'Trophy ') + (colour ? '\n' + colour.replace('_', ' & ') : '');
            panel.classList.remove('empty');
        } else {
            img.src           = '/images/trophies/trophy-1.svg';
            img.style.filter  = 'none';
            label.textContent = 'No trophy';
            panel.classList.add('empty');
        }
    }
    document.getElementById('qe-trophyImage').addEventListener('change', refreshTrophyPreview);
    document.getElementById('qe-trophyColour').addEventListener('change', refreshTrophyPreview);

    // ── toast helper ─────────────────────────────────────────────────────
    function showToast(msg, type) {
        type = type || 'success';
        var ct = document.getElementById('qe-toast-ct');
        if (!ct) {
            ct = document.createElement('div');
            ct.id = 'qe-toast-ct';
            ct.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            ct.style.zIndex = '9999';
            document.body.appendChild(ct);
        }
        var t = document.createElement('div');
        t.className = 'toast align-items-center text-bg-' + type + ' border-0';
        t.setAttribute('role', 'alert');
        t.innerHTML = '<div class="d-flex"><div class="toast-body">' + msg + '</div>'
            + '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
        ct.appendChild(t);
        new bootstrap.Toast(t, { delay: 3000 }).show();
        t.addEventListener('hidden.bs.toast', function () { t.remove(); });
    }

    // ── update card in-place after save ───────────────────────────────────
    function insertBeforeFirst(card, el, selectors) {
        for (var i = 0; i < selectors.length; i++) {
            var ref = card.querySelector(selectors[i]);
            if (ref) { card.insertBefore(el, ref); return; }
        }
        card.appendChild(el);
    }

    function fmt(pence) {
        return '£' + Math.round(pence / 100).toLocaleString('en-GB');
    }

    function updateCard(card, lg, btn) {
        // Tier badge
        var tc = TIER_COLORS[lg.tier] || '#6c757d';
        var badge = card.querySelector('.tier-badge');
        if (badge) {
            badge.textContent         = 'T' + lg.tier;
            badge.style.background    = tc + '22';
            badge.style.color         = tc;
            badge.style.borderColor   = tc + '55';
        }

        // League name
        var nameEl = card.querySelector('.league-name');
        if (nameEl) { nameEl.textContent = lg.name; nameEl.title = lg.name; }

        var cardHeader = card.querySelector('.league-card-header');

        // Trophy row
        var trophyRow = card.querySelector('.league-trophy-row');
        if (lg.trophyImage) {
            var filt   = COLOUR_FILTERS[lg.trophyColour] || 'brightness(0) invert(0.15)';
            var tLabel = lg.trophyImage.replace('trophy-', 'Trophy ');
            var cLabel = lg.trophyColour ? lg.trophyColour.replace('_', ' & ') : '';
            if (trophyRow) {
                trophyRow.querySelector('img').src          = '/images/trophies/' + lg.trophyImage + '.svg';
                trophyRow.querySelector('img').style.filter = filt;
                trophyRow.querySelector('.league-trophy-name').textContent = tLabel;
                var cEl = trophyRow.querySelector('.league-trophy-colour');
                if (cEl) {
                    cEl.textContent = cLabel;
                } else if (cLabel) {
                    var s = document.createElement('span');
                    s.className = 'league-trophy-colour';
                    s.textContent = cLabel;
                    trophyRow.querySelector('.league-trophy-meta').appendChild(s);
                }
            } else {
                trophyRow = document.createElement('div');
                trophyRow.className = 'league-trophy-row';
                trophyRow.innerHTML = '<img class="league-trophy-img" src="/images/trophies/' + lg.trophyImage + '.svg" alt="Trophy" style="filter:' + filt + ';">'
                    + '<div class="league-trophy-meta"><span class="league-trophy-name">' + tLabel + '</span>'
                    + (cLabel ? '<span class="league-trophy-colour">' + cLabel + '</span>' : '') + '</div>';
                insertBeforeFirst(card, trophyRow, ['.league-stats', '.league-sponsors', '.league-clubs', '.league-clubs-empty']);
            }
        } else if (trophyRow) {
            trophyRow.remove();
        }

        // Stats chips
        var statsEl  = card.querySelector('.league-stats');
        var hasStats = lg.prizeMoney || lg.tvDeal || lg.leaguePositionPot || lg.promotionSpots;
        if (hasStats) {
            var h = '';
            if (lg.prizeMoney)        h += '<div class="league-stat-chip"><span class="chip-label">Prize</span><span class="chip-val">' + fmt(lg.prizeMoney) + '</span></div>';
            if (lg.tvDeal)            h += '<div class="league-stat-chip"><span class="chip-label">TV</span><span class="chip-val">' + fmt(lg.tvDeal) + '</span></div>';
            if (lg.leaguePositionPot) h += '<div class="league-stat-chip"><span class="chip-label">Pos Pot</span><span class="chip-val">' + fmt(lg.leaguePositionPot) + '</span></div>';
            if (lg.promotionSpots)    h += '<div class="league-stat-chip"><span class="chip-label">Up</span><span class="chip-val" style="color:#198754;">+' + lg.promotionSpots + '</span></div>';
            if (statsEl) {
                statsEl.innerHTML = h;
            } else {
                statsEl = document.createElement('div');
                statsEl.className = 'league-stats';
                statsEl.innerHTML = h;
                insertBeforeFirst(card, statsEl, ['.league-sponsors', '.league-clubs', '.league-clubs-empty']);
            }
        } else if (statsEl) {
            statsEl.remove();
        }

        // Refresh button data attributes so the next modal open shows fresh values
        btn.dataset.name              = lg.name;
        btn.dataset.tier              = lg.tier;
        btn.dataset.promotionSpots    = lg.promotionSpots != null ? lg.promotionSpots : '';
        btn.dataset.tvDeal            = lg.tvDeal            ? Math.round(lg.tvDeal / 100)            : '';
        btn.dataset.prizeMoney        = lg.prizeMoney        ? Math.round(lg.prizeMoney / 100)        : '';
        btn.dataset.leaguePositionPot = lg.leaguePositionPot ? Math.round(lg.leaguePositionPot / 100) : '';
        btn.dataset.trophyImage       = lg.trophyImage  || '';
        btn.dataset.trophyColour      = lg.trophyColour || '';
        btn.dataset.sponsorCount      = lg.sponsorCount != null ? lg.sponsorCount : '';
    }

    // ── modal populate ────────────────────────────────────────────────────
    var form       = document.getElementById('leagueQuickEditForm');
    var saveBtn    = form.querySelector('[type="submit"]');
    var currentBtn = null;

    modal.addEventListener('show.bs.modal', function (event) {
        currentBtn = event.relatedTarget;
        var id = currentBtn.dataset.leagueId;

        form.action = '/admin/leagues/' + id + '/quick-edit';
        document.getElementById('qe-token').value             = currentBtn.dataset.csrfToken       || '';
        document.getElementById('qe-name').value              = currentBtn.dataset.name             || '';
        document.getElementById('qe-tier').value              = currentBtn.dataset.tier             || '';
        document.getElementById('qe-promotionSpots').value    = currentBtn.dataset.promotionSpots   || '';
        document.getElementById('qe-tvDeal').value            = currentBtn.dataset.tvDeal           || '';
        document.getElementById('qe-prizeMoney').value        = currentBtn.dataset.prizeMoney       || '';
        document.getElementById('qe-leaguePositionPot').value = currentBtn.dataset.leaguePositionPot|| '';
        document.getElementById('qe-trophyImage').value       = currentBtn.dataset.trophyImage      || '';
        document.getElementById('qe-trophyColour').value      = currentBtn.dataset.trophyColour     || '';
        document.getElementById('qe-sponsorCount').value      = currentBtn.dataset.sponsorCount     || '';
        document.getElementById('qe-full-edit-link').href     = currentBtn.dataset.fullEditUrl      || '#';
        refreshTrophyPreview();
    });

    // ── AJAX submit ───────────────────────────────────────────────────────
    form.addEventListener('submit', function (e) {
        e.preventDefault();

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fa fa-spinner fa-spin fa-xs me-1"></i>Saving…';

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: new FormData(form),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                updateCard(currentBtn.closest('.league-card'), data.league, currentBtn);
                bootstrap.Modal.getInstance(modal).hide();
                showToast('League "' + data.league.name + '" updated.');
            } else {
                showToast(data.error || 'Save failed — please try again.', 'danger');
            }
        })
        .catch(function () {
            showToast('Network error — please try again.', 'danger');
        })
        .finally(function () {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fa fa-floppy-disk fa-xs me-1"></i>Save';
        });
    });
}());
</script>
{% endblock %}
