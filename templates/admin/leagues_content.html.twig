{% extends 'admin/bmc_page.html.twig' %}
{#
  League overview — the tier defaults, which leagues have drifted from them, and the pyramids.
  Design source: prototype/League Overview.dc.html. Data: DashboardController::leaguesOverview().

  THREE FORMS, ONE SUBMIT. The tier table and the country × tier picker are the SAME form:
  bulkEditTierDefaults() always saves the eight rows, and additionally overwrites whichever
  leagueIds[] were ticked. Splitting them would mean saving the defaults twice to apply them.

  "DIFFERS" IS SERVER-SIDE. leagueDiffs maps a league id to the names of the fields that have
  drifted from its tier row — see LeagueTierDefaultDiff for why it is not computed here: both
  sides are pence and nullable ints, and this template renders them as formatted pounds, so a
  comparison done here would be comparing display strings.

  MONEY IS POUNDS IN THE FIELDS, PENCE IN THE DATABASE. Rendered with thousands separators
  because that is what makes a seven-figure number readable; parseMoneyToPence() strips them
  on the way back, on both the bulk and the quick-edit paths.
#}

{% set tierColours = {1: '#E8CF59', 2: '#9bb0c4', 3: '#e8852a', 4: '#3FAA7E', 5: '#38BDF8', 6: '#3F52A5', 7: '#6f7f94', 8: '#2d3568'} %}
{% set countries = leaguesByCountry|keys %}
{% set leagueCount = leagueDiffs|length %}
{% set differCount = leagueDiffs|filter(d => d|length > 0)|length %}

{% macro money(pence) %}{{ pence is null ? '' : (pence / 100)|round|number_format(0, '.', ',') }}{% endmacro %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ ea_url().setController('App\\Controller\\Admin\\LeagueCrudController').setAction('index').generateUrl() }}"><span>LEAGUE LIST</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_npc_clubs_content'}) }}" title="Generate a country's pyramid on the NPC clubs screen"><span>GENERATE</span></a>
{% endblock %}

{% block bmc_body %}
<div class="bmc-stats bmc-stats--card">
    <div class="bmc-stat"><span class="bmc-stat__label">COUNTRIES</span><span class="bmc-stat__value">{{ countries|length }}</span><span class="bmc-stat__sub">with a pyramid</span></div>
    <div class="bmc-stat"><span class="bmc-stat__label">LEAGUES</span><span class="bmc-stat__value">{{ leagueCount|number_format }}</span><span class="bmc-stat__sub">across every tier</span></div>
    <div class="bmc-stat"><span class="bmc-stat__label">DIFFER</span><span class="bmc-stat__value{{ differCount > 0 ? ' ink-warning' : '' }}">{{ differCount|number_format }}</span><span class="bmc-stat__sub">from their tier row</span></div>
    <div class="bmc-stat"><span class="bmc-stat__label">CLUBS</span><span class="bmc-stat__value">{{ clubsByLeague|reduce((c, l) => c + l|length, 0)|number_format }}</span><span class="bmc-stat__sub">generated into them</span></div>
</div>

<form method="post" action="{{ path('admin', {routeName: 'admin_league_tier_defaults_bulk_edit'}) }}" id="tiers-form">
    <input type="hidden" name="_token" value="{{ csrf_token('league_tier_defaults_bulk_edit') }}">

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="layers"></i>
            <span class="bmc-card__title">TIER DEFAULTS</span>
            <span class="bmc-card__meta">Saved every time · applied only to leagues ticked below</span>
        </div>
        <div class="bmc-card__body" style="overflow-x:auto">
            <div class="bmc-tiergrid" style="min-width:1240px">
                <div class="bmc-tiergrid__head">
                    <span>TIER</span><span>TROPHY</span><span>PROMOTED</span>
                    <span>TV POOL</span><span>TV DEAL</span><span>PRIZE MONEY</span><span>POSITION POT</span>
                    <span>TAPER %</span><span>PARACHUTE</span><span>SPONSORS</span><span>LEAGUES</span>
                </div>
                {% for tier in 1..8 %}
                    {% set row = tierDefaults[tier] ?? {} %}
                    {% set inTier = leaguesByCountry|reduce((c, byTier) => c + (byTier[tier] is defined ? 1 : 0), 0) %}
                    {% set differInTier = 0 %}
                    {% for byTier in leaguesByCountry %}
                        {% if byTier[tier] is defined and leagueDiffs[byTier[tier].id|ea_as_string]|default([])|length > 0 %}
                            {% set differInTier = differInTier + 1 %}
                        {% endif %}
                    {% endfor %}
                    <div class="bmc-tiergrid__row" data-tier="{{ tier }}">
                        <span class="bmc-tierchip" style="color:{{ tierColours[tier] }}">T{{ tier }}</span>

                        <button type="button" class="bmc-trophy-btn" data-trophy-open="{{ tier }}"
                                title="Edit the tier {{ tier }} trophy" aria-label="Edit the tier {{ tier }} trophy">
                            <span class="bmc-trophy" data-trophy-sprite="{{ tier }}"></span>
                            <span class="bmc-trophy-btn__none" data-trophy-none="{{ tier }}" hidden>NONE</span>
                        </button>
                        {# The editor writes here; the form posts these, not the dialog's controls. #}
                        <input type="hidden" name="tiers[{{ tier }}][trophyStyle]"           data-trophy-field="{{ tier }}:style"           value="{{ row.trophy.style|default('') }}">
                        <input type="hidden" name="tiers[{{ tier }}][trophyFinish]"          data-trophy-field="{{ tier }}:finish"          value="{{ row.trophy.finish|default(trophyDefaults.finish) }}">
                        <input type="hidden" name="tiers[{{ tier }}][trophyRibbons]"         data-trophy-field="{{ tier }}:ribbons"         value="{{ row.trophy.ribbons|default(false) ? '1' : '' }}">
                        <input type="hidden" name="tiers[{{ tier }}][trophyRibbonPrimary]"   data-trophy-field="{{ tier }}:ribbonPrimary"   value="{{ row.trophy.ribbonPrimary|default(trophyDefaults.ribbonPrimary) }}">
                        <input type="hidden" name="tiers[{{ tier }}][trophyRibbonSecondary]" data-trophy-field="{{ tier }}:ribbonSecondary" value="{{ row.trophy.ribbonSecondary|default(trophyDefaults.ribbonSecondary) }}">

                        {% if tier == 1 %}
                            <label class="bmc-num bmc-num--76" title="Top tier — nobody is promoted into it">
                                <input value="—" disabled aria-label="tier 1 is not promoted into">
                            </label>
                        {% else %}
                            <label class="bmc-num bmc-num--76"><span class="bmc-num__unit">+</span>
                                <input name="tiers[{{ tier }}][promotionSpots]" inputmode="numeric" value="{{ row.promotionSpots|default('') }}"
                                       data-min="0" data-max="10" data-blank="ok" aria-label="tier {{ tier }} promotion spots">
                            </label>
                        {% endif %}

                        {% for f in ['tvPoolPence', 'tvDeal', 'prizeMoney', 'leaguePositionPot'] %}
                            <label class="bmc-num"><span class="bmc-num__unit">£</span>
                                <input name="tiers[{{ tier }}][{{ f }}]" inputmode="numeric" data-kind="money" data-blank="ok"
                                       value="{{ _self.money(attribute(row, f)|default(null)) }}"
                                       aria-label="tier {{ tier }} {{ f }}">
                            </label>
                        {% endfor %}

                        <label class="bmc-num bmc-num--76">
                            <input name="tiers[{{ tier }}][leaguePositionDecreasePercent]" inputmode="numeric"
                                   value="{{ row.leaguePositionDecreasePercent|default('') }}"
                                   data-min="0" data-max="100" data-blank="ok"
                                   aria-label="tier {{ tier }} position taper percent">
                        </label>

                        <label class="bmc-ta bmc-ta--parachute">
                            <textarea name="tiers[{{ tier }}][parachute]" rows="2"
                                      placeholder="none"
                                      aria-label="tier {{ tier }} parachute json">{{ row.parachute is defined and row.parachute is not null ? row.parachute|json_encode : '' }}</textarea>
                        </label>

                        <label class="bmc-num bmc-num--76">
                            <input name="tiers[{{ tier }}][sponsorCount]" inputmode="numeric" value="{{ row.sponsorCount|default(0) }}"
                                   data-min="0" data-max="20" aria-label="tier {{ tier }} sponsor count">
                        </label>

                        <span class="bmc-data" title="Leagues in this tier that differ from the row">
                            {% if differInTier > 0 %}<span class="bmc-dot bmc-dot--warning"></span>{% endif %}
                            {{ differInTier > 0 ? differInTier ~ ' of ' ~ inTier ~ ' differ' : inTier ~ ' match' }}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="grid-3x3"></i>
            <span class="bmc-card__title">ALSO OVERWRITE EXISTING LEAGUES</span>
            <span class="bmc-card__meta">Tick a league to push the saved tier row onto it</span>
        </div>
        <div class="bmc-card__band" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="bmc-data" id="pick-note">0 picked</span>
            <span style="flex:1"></span>
            <button type="button" class="bmc-quick-btn" data-lpick="differing">ALL DIFFERING</button>
            <button type="button" class="bmc-quick-btn" data-lpick="all">ALL</button>
            <button type="button" class="bmc-quick-btn" data-lpick="none">CLEAR</button>
        </div>
        <div class="bmc-card__body" style="overflow-x:auto">
            <div class="bmc-matrix" style="min-width:min-content">
                <div class="bmc-matrix__row bmc-matrix__row--head">
                    <span></span>
                    {% for tier in 1..8 %}
                        <button type="button" class="bmc-matrix__col" data-col="{{ tier }}" title="Pick tier {{ tier }}'s differing leagues">T{{ tier }}</button>
                    {% endfor %}
                </div>
                {% for code, byTier in leaguesByCountry %}
                    <div class="bmc-matrix__row">
                        <button type="button" class="bmc-matrix__rowhead" data-row="{{ code }}" title="Pick {{ code }}'s differing leagues">
                            <span class="bmc-flag" style="background-image:url('{{ asset('assets/flags/' ~ code|lower ~ '.svg') }}')"></span>
                            <span>{{ code }}</span>
                        </button>
                        {% for tier in 1..8 %}
                            {% set league = byTier[tier]|default(null) %}
                            {% if league %}
                                {% set id = league.id|ea_as_string %}
                                {% set differs = leagueDiffs[id]|default([])|length > 0 %}
                                <label class="bmc-matrix__cell{{ differs ? ' is-differing' : '' }}"
                                       title="{{ league.name }}{{ differs ? ' — differs: ' ~ leagueDiffs[id]|join(', ') : ' — matches its tier' }}">
                                    <input type="checkbox" name="leagueIds[]" value="{{ id }}" data-differs="{{ differs ? '1' : '' }}" data-country="{{ code }}" data-tier="{{ tier }}">
                                    <span aria-hidden="true">{{ differs ? '✓' : '·' }}</span>
                                </label>
                            {% else %}
                                <span class="bmc-matrix__cell is-empty" title="No tier {{ tier }} league in {{ code }}"></span>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
            <div class="bmc-row" style="margin-top:10px;gap:16px">
                <span class="bmc-data"><span class="bmc-dot bmc-dot--warning"></span> differs from its tier</span>
                <span class="bmc-data"><span class="bmc-dot"></span> matches</span>
                <span class="bmc-data">blank · no league at that tier</span>
            </div>
        </div>
    </section>

    <div class="bmc-savebar" data-bmc-savebar data-idle="The eight rows are saved every time. Ticked leagues are overwritten with them.">
        <span class="bmc-savebar__dot"></span>
        <span class="bmc-savebar__title">ALL SAVED</span>
        <span class="bmc-savebar__sub"></span>
        <button type="submit" class="bmc-btn bmc-btn--yellow" id="tiers-save"
                data-bmc-dialog-title="SAVE TIER DEFAULTS?" data-bmc-dialog-confirm="SAVE"><span>SAVE DEFAULTS</span></button>
    </div>
</form>

<div class="bmc-rule"><span class="bmc-rule__title">PYRAMIDS</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">orange marks differ from the saved tier row</span></div>

<div class="bmc-tabs bmc-tabs--wrap" data-bmc-tabs id="country-tabs" role="tablist" aria-label="Country">
    {% for code, byTier in leaguesByCountry %}
        {% set n = 0 %}
        {% for l in byTier %}{% if leagueDiffs[l.id|ea_as_string]|default([])|length > 0 %}{% set n = n + 1 %}{% endif %}{% endfor %}
        <button type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="pyramid-{{ code }}" data-value="{{ code }}">
            <span class="bmc-flag" style="background-image:url('{{ asset('assets/flags/' ~ code|lower ~ '.svg') }}')"></span>
            {{ code }}{% if n > 0 %} <span class="ink-warning">{{ n }}</span>{% endif %}
        </button>
    {% endfor %}
</div>

{% for code, byTier in leaguesByCountry %}
    <section class="bmc-card" data-domain="club" id="pyramid-{{ code }}" role="tabpanel" {{ loop.first ? '' : 'hidden' }}>
        <div class="bmc-card__head">
            <span class="bmc-flag" style="background-image:url('{{ asset('assets/flags/' ~ code|lower ~ '.svg') }}')"></span>
            <span class="bmc-card__title">{{ countryLabels[code]|default(code) }}</span>
            <span class="bmc-card__meta">{{ byTier|length }} tier(s)</span>
        </div>
        <div class="bmc-rows bmc-rows--flush">
            {% for tier in 1..8 %}
                {% set league = byTier[tier]|default(null) %}
                {% if league %}
                    {% set id = league.id|ea_as_string %}
                    {% set d = leagueDiffs[id]|default([]) %}
                    <div class="bmc-leaguerow" data-league="{{ id }}">
                        <span class="bmc-tierchip" style="color:{{ tierColours[tier] }}">T{{ tier }}</span>
                        <span class="bmc-trophy" data-league-trophy="{{ id }}" data-trophy='{{ league.trophy|default(null)|json_encode }}'></span>
                        <span class="bmc-celltext">{{ league.name }}</span>
                        <span class="bmc-data">{{ clubsByLeague[id]|default([])|length }} club(s)</span>
                        <span class="bmc-cellnum{{ 'promotionSpots' in d ? ' ink-warning' : '' }}">{{ tier == 1 ? '—' : (league.promotionSpots is null ? '—' : '+' ~ league.promotionSpots) }}</span>
                        <span class="bmc-cellnum{{ 'tvPoolPence' in d ? ' ink-warning' : '' }}">{{ league.tvPoolPence is null ? '—' : '£' ~ _self.money(league.tvPoolPence) }}</span>
                        <span class="bmc-cellnum{{ 'tvDeal' in d ? ' ink-warning' : '' }}">{{ league.tvDeal is null ? '—' : '£' ~ _self.money(league.tvDeal) }}</span>
                        <span class="bmc-cellnum{{ 'prizeMoney' in d ? ' ink-warning' : '' }}">{{ league.prizeMoney is null ? '—' : '£' ~ _self.money(league.prizeMoney) }}</span>
                        <span class="bmc-cellnum{{ 'leaguePositionPot' in d ? ' ink-warning' : '' }}">{{ league.leaguePositionPot is null ? '—' : '£' ~ _self.money(league.leaguePositionPot) }}</span>
                        <span class="bmc-cellnum{{ 'sponsorCount' in d ? ' ink-warning' : '' }}">{{ league.sponsorCount }}</span>
                        <button type="button" class="bmc-iconbtn bmc-iconbtn--sm" title="Quick edit {{ league.name }}" aria-label="Quick edit {{ league.name }}"
                                data-qe="{{ id }}"
                                data-qe-url="{{ path('admin', {routeName: 'admin_league_quick_edit', routeParams: {id: id}}) }}"
                                data-qe-token="{{ csrf_token('league_qe_' ~ id) }}"
                                data-qe-name="{{ league.name }}" data-qe-tier="{{ tier }}"
                                data-qe-promotion="{{ league.promotionSpots }}"
                                data-qe-tv="{{ _self.money(league.tvDeal) }}" data-qe-prize="{{ _self.money(league.prizeMoney) }}"
                                data-qe-pot="{{ _self.money(league.leaguePositionPot) }}" data-qe-sponsors="{{ league.sponsorCount }}"
                                data-qe-tvpool="{{ _self.money(league.tvPoolPence) }}"
                                data-qe-slots="{{ league.slots > 0 ? league.slots : '' }}"
                                data-qe-taper="{{ league.leaguePositionDecreasePercent is null ? '' : league.leaguePositionDecreasePercent }}"
                                data-qe-parachute="{{ league.parachute is null ? '' : league.parachute|json_encode }}"
                                data-qe-clubcount="{{ leagueSizes[id]|default(0) }}"
                                data-qe-full="{{ ea_url().setController('App\\Controller\\Admin\\LeagueCrudController').setAction('edit').setEntityId(id).generateUrl() }}">
                            <i data-lucide="pencil" width="16" height="16"></i>
                        </button>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>
{% endfor %}

{{ include('admin/_league_dialogs.html.twig') }}
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script src="{{ asset('assets/trophy-compositor.js') }}?v={{ 'now'|date('Ymd') }}"></script>
<script>
(function () {
    var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return [].slice.call((r || document).querySelectorAll(s)); };

    var STYLES   = {{ trophyStyles|reduce((a, s) => a|merge({(s.value): s.label}), {})|json_encode|raw }};
    var FINISHES = {{ trophyFinishes|reduce((a, f) => a|merge({(f.value): f.label}), {})|json_encode|raw }};
    var DEFAULTS = {{ trophyDefaults|json_encode|raw }};
    var STYLE_KEYS = Object.keys(STYLES);

    // ── trophy sprites ──────────────────────────────────────────────
    // AS A BACKGROUND IMAGE, NOT AN <svg>. The design's fidelity rules say trophies are drawn
    // as background images, and .bmc-trophy is sized for exactly that — so the composed SVG is
    // encoded into a data URI rather than injected as markup.
    function spriteUrl(config) {
        if (!config || !config.style || typeof window.composeTrophySvg !== 'function') return '';
        var svg = window.composeTrophySvg(config, 2, { background: 'none' });
        return svg ? 'url("data:image/svg+xml;utf8,' + encodeURIComponent(svg) + '")' : '';
    }

    function paint(el, config) {
        if (!el) return;
        el.style.backgroundImage = spriteUrl(config);
    }

    function parseTrophy(raw) {
        if (!raw || raw === 'null') return null;
        try { var c = JSON.parse(raw); return c && c.style ? c : null; } catch (e) { return null; }
    }

    // A target is a tier number or 'qe'; both keep their config in hidden inputs so the form
    // posts it whether or not the editor was ever opened.
    function readTarget(target) {
        var get = function (k) { var el = $('[data-trophy-field="' + target + ':' + k + '"]'); return el ? el.value : ''; };
        if (!get('style')) return null;
        return {
            style: get('style'), finish: get('finish') || DEFAULTS.finish,
            ribbons: get('ribbons') === '1',
            ribbonPrimary: get('ribbonPrimary') || DEFAULTS.ribbonPrimary,
            ribbonSecondary: get('ribbonSecondary') || DEFAULTS.ribbonSecondary
        };
    }

    function writeTarget(target, config) {
        var set = function (k, v) { var el = $('[data-trophy-field="' + target + ':' + k + '"]'); if (el) el.value = v; };
        set('style', config ? config.style : '');
        set('finish', config ? config.finish : DEFAULTS.finish);
        set('ribbons', config && config.ribbons ? '1' : '');
        set('ribbonPrimary', config ? config.ribbonPrimary : DEFAULTS.ribbonPrimary);
        set('ribbonSecondary', config ? config.ribbonSecondary : DEFAULTS.ribbonSecondary);
        drawButton(target);
    }

    function drawButton(target) {
        var config = readTarget(target);
        paint($('[data-trophy-sprite="' + target + '"]'), config);
        var none = $('[data-trophy-none="' + target + '"]');
        if (none) none.hidden = !!config;
    }

    // Tier buttons, the quick-edit button, and every league row's sprite.
    $$('[data-trophy-sprite]').forEach(function (el) { drawButton(el.getAttribute('data-trophy-sprite')); });
    $$('[data-league-trophy]').forEach(function (el) { paint(el, parseTrophy(el.getAttribute('data-trophy'))); });

    // ── trophy editor ───────────────────────────────────────────────
    var trScrim = $('#tr-scrim'), trTarget = null, trDraft = null;

    function drawEditor() {
        var c = trDraft || DEFAULTS;
        $$('#tr-styles input').forEach(function (i) { i.checked = !!trDraft && i.value === c.style; });
        $$('#tr-finishes button').forEach(function (b) { b.setAttribute('aria-checked', b.dataset.value === c.finish ? 'true' : 'false'); });
        $('#tr-ribbons').checked = !!c.ribbons;
        $$('[data-ribbon="primary"] input').forEach(function (i) { i.checked = i.value === c.ribbonPrimary; });
        $$('[data-ribbon="secondary"] input').forEach(function (i) { i.checked = i.value === c.ribbonSecondary; });
        $('#tr-ribbon-colours').hidden = !c.ribbons;
        paint($('#tr-preview'), trDraft);
        $('#tr-caption').textContent = trDraft
            ? (STYLES[trDraft.style] || trDraft.style) + ' · ' + (FINISHES[trDraft.finish] || trDraft.finish)
            : 'No trophy';
    }

    function openEditor(target) {
        trTarget = target;
        trDraft = readTarget(target);
        $('#tr-title').textContent = target === 'qe' ? 'LEAGUE TROPHY' : 'TIER ' + target + ' TROPHY';
        drawEditor();
        trScrim.hidden = false;
        $('#tr-ok').focus();
    }

    function closeEditor() { trScrim.hidden = true; trTarget = null; }

    $$('[data-trophy-open]').forEach(function (b) {
        b.addEventListener('click', function () { openEditor(b.getAttribute('data-trophy-open')); });
    });

    $('#tr-styles').addEventListener('change', function (e) {
        trDraft = trDraft || Object.assign({}, DEFAULTS);
        trDraft.style = e.target.value;
        drawEditor();
    });
    $('#tr-finishes').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        trDraft = trDraft || Object.assign({}, DEFAULTS);
        trDraft.finish = b.dataset.value;
        drawEditor();
    });
    $('#tr-ribbons').addEventListener('change', function (e) {
        trDraft = trDraft || Object.assign({}, DEFAULTS);
        trDraft.ribbons = e.target.checked;
        drawEditor();
    });
    $('#tr-ribbon-colours').addEventListener('change', function (e) {
        if (e.target.type !== 'radio') return;
        trDraft = trDraft || Object.assign({}, DEFAULTS);
        trDraft[e.target.closest('[data-ribbon]').dataset.ribbon === 'primary' ? 'ribbonPrimary' : 'ribbonSecondary'] = e.target.value;
        drawEditor();
    });
    $('#tr-random').addEventListener('click', function () {
        trDraft = trDraft || Object.assign({}, DEFAULTS);
        trDraft.style = STYLE_KEYS[Math.floor(Math.random() * STYLE_KEYS.length)];
        drawEditor();
    });

    $('#tr-cancel').addEventListener('click', closeEditor);
    $('#tr-none').addEventListener('click', function () { writeTarget(trTarget, null); closeEditor(); });
    $('#tr-ok').addEventListener('click', function () { writeTarget(trTarget, trDraft); closeEditor(); });
    trScrim.addEventListener('click', function (e) { if (e.target === trScrim) closeEditor(); });

    // ── the country × tier picker ───────────────────────────────────
    var cells = $$('.bmc-matrix__cell input');

    function drawPicks() {
        var n = cells.filter(function (c) { return c.checked; }).length;
        $('#pick-note').textContent = n === 0 ? '0 picked' : n + ' league(s) will be overwritten';
    }

    cells.forEach(function (c) { c.addEventListener('change', drawPicks); });

    $$('[data-lpick]').forEach(function (b) {
        b.addEventListener('click', function () {
            var k = b.dataset.lpick;
            cells.forEach(function (c) { c.checked = k === 'all' || (k === 'differing' && c.dataset.differs === '1'); });
            drawPicks();
        });
    });

    // A row or column header takes that row's or column's DIFFERING leagues — the ones worth
    // acting on. Taking everything would make the header a worse version of ALL.
    $$('[data-row]').forEach(function (h) {
        h.addEventListener('click', function () {
            cells.filter(function (c) { return c.dataset.country === h.dataset.row && c.dataset.differs === '1'; })
                 .forEach(function (c) { c.checked = true; });
            drawPicks();
        });
    });
    $$('[data-col]').forEach(function (h) {
        h.addEventListener('click', function () {
            cells.filter(function (c) { return c.dataset.tier === h.dataset.col && c.dataset.differs === '1'; })
                 .forEach(function (c) { c.checked = true; });
            drawPicks();
        });
    });

    // Saving with leagues ticked rewrites them, so say how many before it happens.
    $('#tiers-save').addEventListener('click', function () {
        var n = cells.filter(function (c) { return c.checked; }).length;
        this.setAttribute('data-bmc-dialog-title', n ? 'OVERWRITE ' + n + ' LEAGUE(S)?' : 'SAVE TIER DEFAULTS?');
        this.setAttribute('data-bmc-dialog-message', n
            ? 'The eight tier rows are saved, and ' + n + ' league(s) are overwritten with them.'
            : 'The eight tier rows are saved. No existing league is changed.');
    });

    drawPicks();

    // ── quick edit ──────────────────────────────────────────────────
    var qeScrim = $('#qe-scrim'), qeForm = $('#qe-form'), qeRow = null;

    $$('[data-qe]').forEach(function (b) {
        b.addEventListener('click', function () {
            qeRow = b.closest('.bmc-leaguerow');
            qeForm.action = b.dataset.qeUrl;
            $('#qe-token').value = b.dataset.qeToken;
            $('#qe-name').value = b.dataset.qeName;
            $('#qe-tier').value = b.dataset.qeTier;
            $('#qe-promotion').value = b.dataset.qePromotion || '';
            $('#qe-tv').value = b.dataset.qeTv || '';
            $('#qe-prize').value = b.dataset.qePrize || '';
            $('#qe-pot').value = b.dataset.qePot || '';
            $('#qe-tvpool').value = b.dataset.qeTvpool || '';
            $('#qe-slots').value = b.dataset.qeSlots || '';
            $('#qe-taper').value = b.dataset.qeTaper || '';
            // Pretty-printed so a multi-season schedule is readable in a 3-row textarea.
            $('#qe-parachute').value = b.dataset.qeParachute
                ? JSON.stringify(JSON.parse(b.dataset.qeParachute), null, 1)
                : '';
            $('#qe-sponsors').value = b.dataset.qeSponsors;

            // THE SERVER IGNORES A TYPED tvDeal WHILE A POOL IS SET — see
            // LeagueAdminController::quickEdit(). Showing that here rather than letting an
            // operator type into a field whose value will be discarded.
            syncTvDerived(b.dataset.qeClubcount || '0');
            $('#qe-full').href = b.dataset.qeFull;
            $('#qe-title').textContent = b.dataset.qeName.toUpperCase();
            $('#qe-error').hidden = true;

            writeTarget('qe', parseTrophy($('[data-league-trophy="' + b.dataset.qe + '"]').getAttribute('data-trophy')));

            qeScrim.hidden = false;
            $('#qe-name').focus();
        });
    });

    // Disables the per-club field while a pool is authored, because the server derives it.
    function syncTvDerived(clubCount) {
        var pooled = String($('#qe-tvpool').value || '').trim() !== '';
        var note   = $('[data-qe-tv-derived]');

        $('#qe-tv').disabled = pooled;
        if (note) {
            note.hidden = !pooled;
            var slot = note.querySelector('[data-qe-clubcount]');
            if (slot) { slot.textContent = String($('#qe-slots').value || '').trim() || clubCount || '—'; }
        }
    }

    ['#qe-tvpool', '#qe-slots'].forEach(function (sel) {
        $(sel).addEventListener('input', function () { syncTvDerived($('#qe-slots').value); });
    });

    $('#qe-cancel').addEventListener('click', function () { qeScrim.hidden = true; });
    qeScrim.addEventListener('click', function (e) { if (e.target === qeScrim) qeScrim.hidden = true; });

    qeForm.addEventListener('submit', function (e) {
        e.preventDefault();

        var data = new FormData(qeForm);
        // STRIP SEPARATORS BEFORE POSTING. The server strips them too now, but the field is
        // rendered with them and there is no reason to make the endpoint clean up after a
        // form that knows better.
        // A DECIMAL POINT SURVIVES NOW. This used to strip to /[^\d]/, which threw away the
        // pence half of "1,000.50" before it ever reached the server — and the server then
        // truncated it a second time. Both halves are fixed; this one keeps the dot.
        ['tvPoolPence', 'tvDeal', 'prizeMoney', 'leaguePositionPot'].forEach(function (k) {
            data.set(k, String(data.get(k) || '').replace(/[^\d.]/g, ''));
        });

        $('#qe-save').disabled = true;
        fetch(qeForm.action, { method: 'POST', body: data, headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
            .then(function (r) { return r.json().catch(function () { return { success: false, error: 'HTTP ' + r.status }; }); })
            .then(function (d) {
                $('#qe-save').disabled = false;
                if (!d.success) {
                    $('#qe-error').textContent = d.error || 'Could not save.';
                    $('#qe-error').hidden = false;
                    return;
                }
                qeScrim.hidden = true;
                // The row's figures and its drift marks both come from the server, so rather
                // than patch them from the response and risk the two disagreeing, reload.
                BMC.toast('LEAGUE SAVED');
                window.location.reload();
            })
            .catch(function () {
                $('#qe-save').disabled = false;
                $('#qe-error').textContent = 'Could not reach the server.';
                $('#qe-error').hidden = false;
            });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!trScrim.hidden) closeEditor();
        else if (!qeScrim.hidden) qeScrim.hidden = true;
    });
}());
</script>
{% endblock %}
