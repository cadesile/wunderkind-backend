{% extends 'admin/bmc_page.html.twig' %}
{#
  World → Generate, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::npcClubsContent() — clubCount, clubsByCountry,
  generationCapableCountries, facilities, gameConfig.

  FOUR INDEPENDENT FORMS, THREE OF THEM PLAIN POSTS. Generate clubs is the exception: it posts
  by fetch() so the pool table can be redrawn from the response rather than reloading a page
  that would also re-run every other query on it.

  THE REDRAW MUST MATCH THE SERVER-RENDERED TABLE. It rebuilds the same markup in JS, so the
  two halves have to agree on classes — they drifted into Bootstrap-vs-bmc once already during
  this rebuild. Keeping the row builder next to the Twig that it mirrors is the cheapest guard
  available without a component layer.

  LEAGUE GENERATION CAN DELETE. Choosing fewer tiers than a country already has removes the
  surplus tiers AND the pool clubs in them, so it confirms; the two save forms do not.
#}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_leagues_overview'}) }}"><span>LEAGUE OVERVIEW</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_worldpack_cache'}) }}"><span>WORLDPACK CACHE</span></a>
{% endblock %}

{% block bmc_body %}

{# ── what exists now ─────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="shield"></i>
        <span class="bmc-card__title">CLUB POOL</span>
        <span class="bmc-card__meta"><span id="club-pool-total">{{ clubCount|number_format }} total</span></span>
    </div>
    <div id="club-pool-body">
        {% if clubsByCountry is empty %}
            <div class="bmc-card__body"><span class="bmc-empty-note">NO CLUBS GENERATED YET</span></div>
        {% else %}
            <div style="overflow-x:auto">
                <table class="bmc-minitable" id="club-pool-table" style="min-width:600px">
                    <thead><tr>
                        <th>COUNTRY</th>
                        {% for tier in 1..8 %}<th class="is-right">T{{ tier }}</th>{% endfor %}
                        <th class="is-right">TOTAL</th>
                    </tr></thead>
                    <tbody id="club-pool-tbody">
                        {% for country, tiers in clubsByCountry %}
                            <tr>
                                <td><span class="bmc-celltext">{{ country }}</span></td>
                                {% for tier in 1..8 %}
                                    <td class="is-right">
                                        {%- if tiers[tier] is defined %}<span class="bmc-badge bmc-badge--subtle">{{ tiers[tier] }}</span>
                                        {%- else %}<span class="ink-dim">—</span>{% endif -%}
                                    </td>
                                {% endfor %}
                                <td class="is-right bmc-cellnum">{{ tiers|reduce((carry, v) => carry + v, 0) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(400px,1fr))">

    {# ── clubs ───────────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="wand-sparkles"></i>
            <span class="bmc-card__title">GENERATE CLUBS</span>
        </div>
        <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:12px">
            <p class="bmc-bodytext">
                Generates NPC clubs for one country and league tier. Facility levels, reputation and balance
                are preset by tier band. NPC clubs are pure metadata — squads are assembled by the frontend
                at game start from the player pool.
            </p>

            <div id="generate-clubs-alert" hidden></div>

            <form id="generate-clubs-form" method="post" action="{{ path('admin_npc_clubs_generate') }}"
                  style="display:flex;flex-direction:column;gap:10px">
                <input type="hidden" name="_token" value="{{ csrf_token('generate_npc_clubs') }}">

                <div style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap">
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="country">COUNTRY</label>
                        <span class="bmc-select">
                            <select id="country" name="country" style="min-width:190px">
                                {% for code, label in generationCapableCountries %}
                                    <option value="{{ code }}">{{ label }} ({{ code }})</option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="tier">TIER</label>
                        <label class="bmc-num bmc-num--60"><input type="number" id="tier" name="tier" value="4" min="1" max="8" inputmode="numeric"></label>
                    </div>
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="count">COUNT</label>
                        <label class="bmc-num bmc-num--60"><input type="number" id="count" name="count" value="8" min="1" max="50" inputmode="numeric"></label>
                    </div>
                </div>

                <label class="bmc-check" style="padding-left:0">
                    <input type="checkbox" id="delete_existing" name="delete_existing" value="1">
                    <span class="bmc-tile"></span>
                    <span class="bmc-data ink-danger">Delete existing clubs in this country and tier first</span>
                </label>

                <button type="submit" id="generate-clubs-btn" class="bmc-btn bmc-btn--blue" style="align-self:flex-start"><span>GENERATE CLUBS</span></button>
            </form>
        </div>
    </section>

    {# ── leagues ─────────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="trophy"></i>
            <span class="bmc-card__title">GENERATE LEAGUE STRUCTURE</span>
        </div>
        <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:12px;height:100%">
            <p class="bmc-bodytext">
                Creates League records for a country, named &ldquo;League 1&rdquo; upward, skipping tiers that
                already exist. Run this <em>before</em> generating clubs so clubs are auto-assigned to their
                league. NPC quality scales to the depth chosen, so the bottom tier is always the bottom of
                that country's pyramid.
            </p>

            <div class="bmc-danger">
                <i data-lucide="triangle-alert"></i>
                <div class="bmc-danger__text">
                    <span class="bmc-data">
                        Choosing <strong>fewer</strong> tiers than the country already has deletes the surplus
                        tiers and the pool clubs in them.
                    </span>
                </div>
            </div>

            <form method="post" action="{{ path('admin_leagues_generate') }}"
                  style="display:flex;flex-direction:column;gap:10px;margin-top:auto">
                <input type="hidden" name="_token" value="{{ csrf_token('generate_leagues') }}">
                <div style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap">
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="league_country">COUNTRY</label>
                        <span class="bmc-select">
                            <select id="league_country" name="country" style="min-width:190px">
                                {% for code, label in generationCapableCountries %}
                                    <option value="{{ code }}">{{ label }} ({{ code }})</option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="league_tiers">TIERS</label>
                        <label class="bmc-num bmc-num--60"><input type="number" id="league_tiers" name="tiers" value="8" min="1" max="8" step="1" required inputmode="numeric"></label>
                    </div>
                </div>
                <span class="bmc-data">1–8. Tier 1 is the top division. Default 8.</span>
                <button type="submit" class="bmc-btn bmc-btn--orange" style="align-self:flex-start"
                        data-bmc-dialog-title="GENERATE THE LEAGUE PYRAMID?"
                        data-bmc-dialog-message="Choosing fewer tiers than this country already has deletes the surplus tiers and every pool club in them."
                        data-bmc-dialog-confirm="GENERATE" data-bmc-dialog-variant="yellow"><span>GENERATE LEAGUES</span></button>
            </form>
        </div>
    </section>
</div>

{# ── facility level ranges ───────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="building"></i>
        <span class="bmc-card__title">FACILITY LEVEL RANGES BY TIER BAND</span>
        <span class="bmc-card__meta">starting level per facility when clubs are generated</span>
    </div>

    {% if facilities is empty %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NO ACTIVE FACILITY TEMPLATES — ADD FACILITIES FIRST</span></div>
    {% else %}
        {% set bandLabels = ['TIERS 1–2', 'TIERS 3–4', 'TIERS 5–6', 'TIERS 7–8'] %}
        {% set trainingSlugs = ['training_pitch', 'strength_suite'] %}
        {% set standsSlugs   = ['north_stand', 'south_stand', 'east_stand', 'west_stand'] %}
        {# Fallbacks mirroring NpcClubGenerationService::FACILITY_LEVELS. #}
        {% set defaults = [
            {training: [7,9], stands: [4,5], other: [3,5]},
            {training: [5,6], stands: [3,4], other: [2,3]},
            {training: [3,4], stands: [2,3], other: [1,2]},
            {training: [1,2], stands: [0,1], other: [0,1]},
        ] %}

        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                Max values are capped to each facility's own max upgrade level. Set both min and max to
                <strong>0</strong> to exclude a facility from clubs generated in that tier band.
            </p>
        </div>

        <form method="post" action="{{ path('admin_npc_clubs_save_facility_config') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('npc_facility_config') }}">
            <div style="overflow-x:auto">
                <table class="bmc-minitable" style="min-width:760px">
                    <thead>
                        <tr>
                            <th>FACILITY</th>
                            {% for bandLabel in bandLabels %}<th class="is-right" colspan="2">{{ bandLabel }}</th>{% endfor %}
                        </tr>
                        <tr>
                            <th>SLUG</th>
                            {% for i in 0..3 %}<th class="is-right">MIN</th><th class="is-right">MAX</th>{% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for facility in facilities %}
                            {% set slug = facility.slug %}
                            {% set isTraining = slug in trainingSlugs %}
                            {% set isStands   = slug in standsSlugs %}
                            <tr>
                                <td>
                                    <span class="bmc-celltext">{{ facility.label }}</span>
                                    <span class="bmc-data" style="display:block"><code class="bmc-code">{{ slug }}</code></span>
                                </td>
                                {% for band in 0..3 %}
                                    {% set stored = gameConfig.npcFacilityLevelRanges[band][slug] ?? null %}
                                    {% if isTraining %}
                                        {% set fallbackMin = defaults[band].training[0] %}{% set fallbackMax = defaults[band].training[1] %}
                                    {% elseif isStands %}
                                        {% set fallbackMin = defaults[band].stands[0] %}{% set fallbackMax = defaults[band].stands[1] %}
                                    {% else %}
                                        {% set fallbackMin = defaults[band].other[0] %}{% set fallbackMax = defaults[band].other[1] %}
                                    {% endif %}
                                    <td class="is-right">
                                        <label class="bmc-num bmc-num--56"><input type="number"
                                               name="facilityRanges[{{ band }}][{{ slug }}][min]"
                                               value="{{ stored ? stored.min : fallbackMin }}" min="0" max="{{ facility.maxLevel }}"
                                               inputmode="numeric" title="Band {{ band + 1 }} min for {{ slug }} — 0 omits the facility"></label>
                                    </td>
                                    <td class="is-right">
                                        <label class="bmc-num bmc-num--56"><input type="number"
                                               name="facilityRanges[{{ band }}][{{ slug }}][max]"
                                               value="{{ stored ? stored.max : fallbackMax }}" min="0" max="{{ facility.maxLevel }}"
                                               inputmode="numeric" title="Band {{ band + 1 }} max for {{ slug }} — 0/0 omits the facility"></label>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="bmc-card__band">
                <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE FACILITY RANGES</span></button>
            </div>
        </form>
    {% endif %}
</section>

{# ── city size weighting ─────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="building-2"></i>
        <span class="bmc-card__title">CITY SIZE WEIGHTING</span>
        <span class="bmc-card__meta">tiers 2–7 interpolate between these two</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            How likely a BIG, MEDIUM or SMALL city is to be picked when generating a club for a tier.
            Tier 1 and tier 8 are the anchors and the rest interpolate linearly between them. Values are
            percentages and do not need to sum to 100.
        </p>
    </div>

    <form method="post" action="{{ path('admin_npc_clubs_save_size_weights') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('npc_size_weights') }}">
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:460px">
                <thead><tr><th>TIER</th><th class="is-right">BIG %</th><th class="is-right">MEDIUM %</th><th class="is-right">SMALL %</th></tr></thead>
                <tbody>
                    {% for row in ['tier1', 'tier8'] %}
                        <tr>
                            <td><span class="bmc-celltext">{{ row == 'tier1' ? 'Tier 1' : 'Tier 8' }}</span></td>
                            {% for size in ['big', 'medium', 'small'] %}
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--60"><input type="number"
                                           name="sizeWeights[{{ row }}][{{ size }}]"
                                           value="{{ attribute(gameConfig.npcClubSizeWeights[row], size) ?? 0 }}"
                                           min="0" max="100" inputmode="numeric"
                                           aria-label="{{ row }} {{ size }} percent"></label>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-card__band">
            <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE SIZE WEIGHTS</span></button>
        </div>
    </form>
</section>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var form  = document.getElementById('generate-clubs-form');
    var btn   = document.getElementById('generate-clubs-btn');
    var note  = document.getElementById('generate-clubs-alert');
    if (!form) return;

    function say(ok, text) {
        note.hidden = false;
        note.className = 'bmc-status';
        note.innerHTML = '<span class="bmc-dot" style="background:var(--wk-' + (ok ? 'positive' : 'danger') + ')"></span>' +
                         String(text).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; });
    }

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        btn.disabled = true;
        btn.querySelector('span').textContent = 'GENERATING…';
        note.hidden = true;

        try {
            var resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });
            var data = await resp.json();

            say(data.success, data.message);
            if (data.success) redrawPool(data.clubCount, data.clubsByCountry);
        } catch (err) {
            say(false, 'Request failed — ' + err.message);
        } finally {
            btn.disabled = false;
            btn.querySelector('span').textContent = 'GENERATE CLUBS';
        }
    });

    // MIRRORS THE TWIG ABOVE. If the server-rendered table changes, this has to change with it
    // — there is no shared component, so the two are kept adjacent on purpose.
    function redrawPool(total, byCountry) {
        document.getElementById('club-pool-total').textContent = Number(total).toLocaleString('en-GB') + ' total';

        var body = document.getElementById('club-pool-body');
        if (!byCountry || Object.keys(byCountry).length === 0) {
            body.innerHTML = '<div class="bmc-card__body"><span class="bmc-empty-note">NO CLUBS GENERATED YET</span></div>';
            return;
        }

        var rows = Object.keys(byCountry).sort().map(function (country) {
            var tiers = byCountry[country], rowTotal = 0, cells = '';
            for (var t = 1; t <= 8; t++) {
                var n = tiers[t] || 0;
                rowTotal += n;
                cells += n
                    ? '<td class="is-right"><span class="bmc-badge bmc-badge--subtle">' + n + '</span></td>'
                    : '<td class="is-right"><span class="ink-dim">—</span></td>';
            }
            return '<tr><td><span class="bmc-celltext">' + country + '</span></td>' + cells +
                   '<td class="is-right bmc-cellnum">' + rowTotal + '</td></tr>';
        }).join('');

        var heads = [1,2,3,4,5,6,7,8].map(function (t) { return '<th class="is-right">T' + t + '</th>'; }).join('');

        body.innerHTML =
            '<div style="overflow-x:auto"><table class="bmc-minitable" id="club-pool-table" style="min-width:600px">' +
            '<thead><tr><th>COUNTRY</th>' + heads + '<th class="is-right">TOTAL</th></tr></thead>' +
            '<tbody id="club-pool-tbody">' + rows + '</tbody></table></div>';
    }
}());
</script>
{% endblock %}
