{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Clubs &amp; Leagues — Quick Actions</h5>
        <p class="text-muted small mb-0">
            Generate NPC clubs for a specific country and tier, or replenish the senior player pool.
            NPC clubs are pure metadata — squads are assembled by the frontend at game-start using the player pool.
        </p>
    </div>

    {# ── Status ─────────────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-shield-halved text-muted"></i>
                <span class="fw-semibold small">Club Pool</span>
                <span class="ms-auto badge bg-secondary" id="club-pool-total">{{ clubCount }} total</span>
            </div>
            <div class="card-body p-0" id="club-pool-body">
                {% if clubsByCountry is empty %}
                    <p class="text-muted small p-3 mb-0" id="club-pool-empty">No clubs generated yet.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 small" id="club-pool-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Country</th>
                                    {% for tier in 1..8 %}
                                        <th class="text-center">T{{ tier }}</th>
                                    {% endfor %}
                                    <th class="text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody id="club-pool-tbody">
                                {% for country, tiers in clubsByCountry %}
                                    <tr>
                                        <td class="ps-3 fw-semibold">{{ country }}</td>
                                        {% for tier in 1..8 %}
                                            <td class="text-center">
                                                {% if tiers[tier] is defined %}
                                                    <span class="badge bg-primary bg-opacity-75">{{ tiers[tier] }}</span>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                        <td class="text-end pe-3 fw-semibold">{{ tiers|reduce((carry, v) => carry + v, 0) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Generate Clubs ─────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-wand-magic-sparkles text-primary"></i>
                <span class="fw-semibold small">Generate Clubs</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Generates NPC clubs for a specific country and league tier.
                    Facility levels, reputation, and balance are preset by tier band.
                </p>
                <div id="generate-clubs-alert" class="d-none small"></div>
                <form id="generate-clubs-form" method="POST" action="{{ path('admin_npc_clubs_generate') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('generate_npc_clubs') }}">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="country" class="form-label fw-semibold small">Country (ISO)</label>
                            <select id="country" name="country" class="form-select form-select-sm">
                                <option value="ES">Spain (ES)</option>
                                <option value="EN">England (EN)</option>
                                <option value="DE">Germany (DE)</option>
                                <option value="IT">Italy (IT)</option>
                                <option value="FR">France (FR)</option>
                                <option value="BR">Brazil (BR)</option>
                                <option value="AR">Argentina (AR)</option>
                                <option value="NL">Netherlands (NL)</option>
                                <option value="PT">Portugal (PT)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="tier" class="form-label fw-semibold small">Tier (1–8)</label>
                            <input type="number" id="tier" name="tier" value="4"
                                   min="1" max="8" class="form-control form-control-sm">
                        </div>
                        <div class="col-md-4">
                            <label for="count" class="form-label fw-semibold small">Count</label>
                            <input type="number" id="count" name="count" value="8"
                                   min="1" max="50" class="form-control form-control-sm">
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button type="submit" id="generate-clubs-btn" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus me-1"></i>Generate Clubs
                        </button>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="delete_existing" name="delete_existing" value="1">
                            <label class="form-check-label small text-danger fw-semibold" for="delete_existing">
                                Delete existing first
                            </label>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# ── Generate League Structure ───────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-trophy text-warning"></i>
                <span class="fw-semibold small">Generate League Structure</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Auto-creates 8 League records (tiers 1–8) for a country, named
                    "League 1" through "League 8". Skips tiers that already exist.
                    Run this before generating clubs so clubs are auto-assigned to their league.
                </p>
                <div class="mt-auto">
                    <form method="POST" action="{{ path('admin_leagues_generate') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('generate_leagues') }}">
                        <div class="mb-3">
                            <label for="league_country" class="form-label fw-semibold small">Country (ISO)</label>
                            <select id="league_country" name="country" class="form-select form-select-sm">
                                <option value="ES">Spain (ES)</option>
                                <option value="EN">England (EN)</option>
                                <option value="DE">Germany (DE)</option>
                                <option value="IT">Italy (IT)</option>
                                <option value="FR">France (FR)</option>
                                <option value="BR">Brazil (BR)</option>
                                <option value="AR">Argentina (AR)</option>
                                <option value="NL">Netherlands (NL)</option>
                                <option value="PT">Portugal (PT)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="fa fa-trophy me-1"></i>Generate Leagues
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>


    {# ── Facility Level Ranges ──────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-building text-info"></i>
                <span class="fw-semibold small">Facility Level Ranges by Tier Band</span>
                <span class="ms-auto text-muted small">Starting level range assigned per facility when clubs are generated</span>
            </div>
            <div class="card-body">
                {% if facilities is empty %}
                    <p class="text-muted small mb-0">No active facility templates found. Add facilities first.</p>
                {% else %}
                    {% set bandLabels = ['Tiers 1–2', 'Tiers 3–4', 'Tiers 5–6', 'Tiers 7–8'] %}
                    {% set trainingSlugs = ['training_pitch', 'strength_suite'] %}
                    {% set standsSlugs   = ['north_stand', 'south_stand', 'east_stand', 'west_stand'] %}
                    {# Hardcoded fallback defaults matching NpcClubGenerationService::FACILITY_LEVELS #}
                    {% set defaults = [
                        {training: [7,9], stands: [4,5], other: [3,5]},
                        {training: [5,6], stands: [3,4], other: [2,3]},
                        {training: [3,4], stands: [2,3], other: [1,2]},
                        {training: [1,2], stands: [0,1], other: [0,1]}
                    ] %}

                    <p class="text-muted small mb-3">
                        Max values are capped to each facility's max upgrade level.
                        Set both min and max to <strong>0</strong> to exclude a facility from clubs generated in that tier band.
                    </p>
                    <form method="POST" action="{{ path('admin_npc_clubs_save_facility_config') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('npc_facility_config') }}">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-3 small align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="min-width:140px">Facility</th>
                                        {% for bandLabel in bandLabels %}
                                            <th class="text-center" colspan="2" style="min-width:120px">{{ bandLabel }}</th>
                                        {% endfor %}
                                    </tr>
                                    <tr class="table-secondary">
                                        <th class="ps-3 text-muted" style="font-size:10px">SLUG</th>
                                        {% for i in 0..3 %}
                                            <th class="text-center text-muted" style="font-size:10px">MIN</th>
                                            <th class="text-center text-muted" style="font-size:10px">MAX</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for facility in facilities %}
                                        {% set slug = facility.slug %}
                                        {% set isTraining = slug in trainingSlugs %}
                                        {% set isStands   = slug in standsSlugs %}
                                        <tr>
                                            <td class="ps-3">
                                                <span class="fw-semibold">{{ facility.label }}</span><br>
                                                <code class="text-muted" style="font-size:9px">{{ slug }}</code>
                                            </td>
                                            {% for band in 0..3 %}
                                                {% set stored = gameConfig.npcFacilityLevelRanges[band][slug] ?? null %}
                                                {% if isTraining %}
                                                    {% set fallbackMin = defaults[band].training[0] %}
                                                    {% set fallbackMax = defaults[band].training[1] %}
                                                {% elseif isStands %}
                                                    {% set fallbackMin = defaults[band].stands[0] %}
                                                    {% set fallbackMax = defaults[band].stands[1] %}
                                                {% else %}
                                                    {% set fallbackMin = defaults[band].other[0] %}
                                                    {% set fallbackMax = defaults[band].other[1] %}
                                                {% endif %}
                                                {% set currentMin = stored ? stored.min : fallbackMin %}
                                                {% set currentMax = stored ? stored.max : fallbackMax %}
                                                <td class="text-center p-1">
                                                    <input type="number" name="facilityRanges[{{ band }}][{{ slug }}][min]"
                                                           value="{{ currentMin }}" min="0" max="{{ facility.maxLevel }}"
                                                           class="form-control form-control-sm text-center p-1"
                                                           style="width:60px;margin:0 auto"
                                                           title="Band {{ band + 1 }} min for {{ slug }} (0 = omit facility)">
                                                </td>
                                                <td class="text-center p-1">
                                                    <input type="number" name="facilityRanges[{{ band }}][{{ slug }}][max]"
                                                           value="{{ currentMax }}" min="0" max="{{ facility.maxLevel }}"
                                                           class="form-control form-control-sm text-center p-1"
                                                           style="width:60px;margin:0 auto"
                                                           title="Band {{ band + 1 }} max for {{ slug }} (0/0 = omit facility)">
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-save me-1"></i>Save Facility Ranges
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── City Size Weighting ───────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-city text-success"></i>
                <span class="fw-semibold small">City Size Weighting</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Controls how likely a BIG/MEDIUM/SMALL city is to be picked when generating a club
                    for a given tier. Tier 1 and Tier 8 are the anchors — tiers 2–7 interpolate
                    linearly between them. Values are percentages and don't need to sum to 100.
                </p>
                <form method="POST" action="{{ path('admin_npc_clubs_save_size_weights') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('npc_size_weights') }}">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-3 small align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Tier</th>
                                    <th class="text-center">Big %</th>
                                    <th class="text-center">Medium %</th>
                                    <th class="text-center">Small %</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in ['tier1', 'tier8'] %}
                                    <tr>
                                        <td class="ps-3 fw-semibold">{{ row == 'tier1' ? 'Tier 1' : 'Tier 8' }}</td>
                                        <td class="text-center p-1">
                                            <input type="number" name="sizeWeights[{{ row }}][big]"
                                                   value="{{ gameConfig.npcClubSizeWeights[row].big ?? 0 }}" min="0" max="100"
                                                   class="form-control form-control-sm text-center p-1" style="width:70px;margin:0 auto">
                                        </td>
                                        <td class="text-center p-1">
                                            <input type="number" name="sizeWeights[{{ row }}][medium]"
                                                   value="{{ gameConfig.npcClubSizeWeights[row].medium ?? 0 }}" min="0" max="100"
                                                   class="form-control form-control-sm text-center p-1" style="width:70px;margin:0 auto">
                                        </td>
                                        <td class="text-center p-1">
                                            <input type="number" name="sizeWeights[{{ row }}][small]"
                                                   value="{{ gameConfig.npcClubSizeWeights[row].small ?? 0 }}" min="0" max="100"
                                                   class="form-control form-control-sm text-center p-1" style="width:70px;margin:0 auto">
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa fa-save me-1"></i>Save Size Weights
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

{% block javascripts %}
<script>
(function () {
    const form    = document.getElementById('generate-clubs-form');
    const btn     = document.getElementById('generate-clubs-btn');
    const alert   = document.getElementById('generate-clubs-alert');

    if (!form) return;

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating…';
        alert.className = 'd-none small';

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form),
            });

            const data = await resp.json();

            alert.className = 'small alert mb-0 py-2 ' + (data.success ? 'alert-success' : 'alert-danger');
            alert.textContent = data.message;

            if (data.success) {
                updatePoolTable(data.clubCount, data.clubsByCountry);
            }
        } catch (err) {
            alert.className = 'small alert alert-danger mb-0 py-2';
            alert.textContent = 'Request failed — ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-plus me-1"></i>Generate Clubs';
        }
    });

    function updatePoolTable(total, byCountry) {
        document.getElementById('club-pool-total').textContent = total + ' total';

        const body = document.getElementById('club-pool-body');
        if (!byCountry || Object.keys(byCountry).length === 0) {
            body.innerHTML = '<p class="text-muted small p-3 mb-0">No clubs generated yet.</p>';
            return;
        }

        const countries = Object.keys(byCountry).sort();
        const rows = countries.map(country => {
            const tiers = byCountry[country];
            let rowTotal = 0;
            let cells = '';
            for (let t = 1; t <= 8; t++) {
                const n = tiers[t] ?? 0;
                rowTotal += n;
                cells += n
                    ? `<td class="text-center"><span class="badge bg-primary bg-opacity-75">${n}</span></td>`
                    : `<td class="text-center"><span class="text-muted">—</span></td>`;
            }
            return `<tr>
                <td class="ps-3 fw-semibold">${country}</td>
                ${cells}
                <td class="text-end pe-3 fw-semibold">${rowTotal}</td>
            </tr>`;
        }).join('');

        body.innerHTML = `
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 small" id="club-pool-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Country</th>
                            ${[1,2,3,4,5,6,7,8].map(t => `<th class="text-center">T${t}</th>`).join('')}
                            <th class="text-end pe-3">Total</th>
                        </tr>
                    </thead>
                    <tbody id="club-pool-tbody">${rows}</tbody>
                </table>
            </div>`;
    }
}());
</script>
{% endblock %}
{% endblock %}
