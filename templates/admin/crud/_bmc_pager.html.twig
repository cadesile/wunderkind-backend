{# @var paginator \EasyCorp\Bundle\EasyAdminBundle\Orm\EntityPaginator #}
{#
  "1–25 of 412 · page 1 / 17".

  Prev and next are always present — at the ends they drop to 0.3 opacity
  rather than disappearing, so the control keeps its shape and the label does
  not jump sideways between pages (handoff §10).
#}
{% if paginator.numResults > 0 %}
    <nav class="bmc-pager" data-domain="{{ bmcDomain|default('club') }}" aria-label="Pagination">
        {% if paginator.hasPreviousPage %}
            <a class="bmc-pager__cell" href="{{ paginator.generateUrlForPage(paginator.previousPage) }}" aria-label="Previous page">
                <i data-lucide="chevron-left" width="18" height="18"></i>
            </a>
        {% else %}
            <a class="bmc-pager__cell is-off" aria-label="Previous page" aria-disabled="true">
                <i data-lucide="chevron-left" width="18" height="18"></i>
            </a>
        {% endif %}

        <span class="bmc-pager__label">
            {{ paginator.rangeFirstResultNumber|number_format(0, '.', ',') }}–{{ paginator.rangeLastResultNumber|number_format(0, '.', ',') }}
            of {{ paginator.numResults|number_format(0, '.', ',') }}
            &nbsp;·&nbsp; page {{ paginator.currentPage }} / {{ max(1, paginator.lastPage) }}
        </span>

        {% if paginator.hasNextPage %}
            <a class="bmc-pager__cell" href="{{ paginator.generateUrlForPage(paginator.nextPage) }}" aria-label="Next page">
                <i data-lucide="chevron-right" width="18" height="18"></i>
            </a>
        {% else %}
            <a class="bmc-pager__cell is-off" aria-label="Next page" aria-disabled="true">
                <i data-lucide="chevron-right" width="18" height="18"></i>
            </a>
        {% endif %}
    </nav>
{% endif %}
