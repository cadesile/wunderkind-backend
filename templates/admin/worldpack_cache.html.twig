{% extends '@EasyAdmin/layout.html.twig' %}

{% set COUNTRIES = {
    'EN': 'England',    'IT': 'Italy',       'DE': 'Germany',
    'ES': 'Spain',      'BR': 'Brazil',      'AR': 'Argentina',
    'NL': 'Netherlands','FR': 'France',      'PT': 'Portugal',
    'NG': 'Nigeria',    'GH': 'Ghana',       'JP': 'Japan',
    'KR': 'South Korea','SE': 'Sweden',      'DK': 'Denmark',
    'IE': 'Ireland',    'CI': 'Ivory Coast', 'SN': 'Senegal',
    'CN': 'China'
} %}

{% block content %}
<div class="row g-4 mt-1">

    {# ── Header ─────────────────────────────────────────────────────────── #}
    <div class="col-12">
        <h5 class="fw-semibold mb-0">Worldpack Cache</h5>
        <p class="text-muted small mb-0">
            Pre-generated NPC league packs keyed by country + tier.
            Used at game initialisation to skip expensive world-pack generation on the device.
        </p>
    </div>

    {# ── Status grid ─────────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-database text-muted"></i>
                <span class="fw-semibold small">Cache Status</span>
                <span class="ms-auto badge bg-secondary">{{ totalEntries }} total entries</span>
            </div>
            <div class="card-body p-0">
                {% if byCountry is empty %}
                    <p class="text-muted small p-3 mb-0">No cache entries found. Use the Regenerate panel below to warm the cache.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Country</th>
                                    {% for tier in 1..8 %}
                                        <th class="text-center">T{{ tier }}</th>
                                    {% endfor %}
                                    <th class="text-end pe-3">Cached</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for code, tiers in byCountry %}
                                    <tr>
                                        <td class="ps-3 fw-semibold">
                                            {{ COUNTRIES[code] ?? code }}
                                            <span class="text-muted fw-normal">({{ code }})</span>
                                        </td>
                                        {% for tier in 1..8 %}
                                            <td class="text-center">
                                                {% if tiers[tier] is defined %}
                                                    <span class="badge bg-success bg-opacity-75">✓</span>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                        <td class="text-end pe-3 fw-semibold">{{ tiers|length }} / 8</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Entry detail table ──────────────────────────────────────────────── #}
    {% if entries is not empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-list text-muted"></i>
                <span class="fw-semibold small">All Entries</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Country</th>
                                <th class="text-center">Tier</th>
                                <th class="text-center">Clubs</th>
                                <th class="text-center">Players</th>
                                <th>Generated</th>
                                <th class="pe-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in entries %}
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        {{ COUNTRIES[entry.country] ?? entry.country }}
                                        <span class="text-muted fw-normal">({{ entry.country }})</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary bg-opacity-75">{{ entry.tier }}</span>
                                    </td>
                                    <td class="text-center">{{ entry.clubCount }}</td>
                                    <td class="text-center">{{ entry.playerCount }}</td>
                                    <td class="text-muted">{{ entry.generatedAt|date('Y-m-d H:i') }}</td>
                                    <td class="pe-3 text-end">
                                        <form method="POST"
                                              action="{{ path('admin_worldpack_delete_entry', {id: entry.id}) }}"
                                              onsubmit="return confirm('Delete {{ COUNTRIES[entry.country] ?? entry.country }} Tier {{ entry.tier }} cache entry?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('worldpack_delete_entry') }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Regenerate (multi-country checkbox + queue) ─────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-rotate text-primary"></i>
                <span class="fw-semibold small">Regenerate Country Cache</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Select one or more countries, then click <strong>Build Queue</strong>.
                    Each tier is warmed sequentially via background requests so the page never times out.
                    Requires leagues to be seeded for the selected countries.
                </p>

                <div class="row g-3">
                    {# ── Left: country checkboxes ────────────────────────────── #}
                    <div class="col-12 col-md-5">
                        <div class="border rounded p-3" style="max-height:340px;overflow-y:auto">
                            {# Select all toggle #}
                            <div class="form-check border-bottom pb-2 mb-2">
                                <input class="form-check-input" type="checkbox" id="select-all-countries">
                                <label class="form-check-label fw-semibold small" for="select-all-countries">
                                    Select All
                                </label>
                            </div>
                            {# Per-country checkboxes #}
                            {% for code, name in enabledCountries %}
                                <div class="form-check">
                                    <input class="form-check-input country-checkbox" type="checkbox"
                                           value="{{ code }}" id="chk_{{ code }}">
                                    <label class="form-check-label small" for="chk_{{ code }}">
                                        {{ name }}
                                        <span class="text-muted">({{ code }})</span>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button id="build-queue-btn" class="btn btn-primary btn-sm" onclick="buildQueue()">
                                <i class="fa fa-list-check me-1"></i>Build Queue
                            </button>
                            <button id="run-queue-btn" class="btn btn-success btn-sm d-none" onclick="runQueue()">
                                <i class="fa fa-play me-1"></i>Run Queue
                            </button>
                            <button id="clear-queue-btn" class="btn btn-outline-secondary btn-sm d-none" onclick="clearQueue()">
                                Clear
                            </button>
                        </div>
                    </div>

                    {# ── Right: queue + progress ─────────────────────────────── #}
                    <div class="col-12 col-md-7">

                        {# Overall progress (hidden until running) #}
                        <div id="overall-progress" class="d-none mb-3">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span id="overall-status" class="text-muted fw-semibold">Idle</span>
                                <span id="overall-fraction" class="fw-semibold text-muted">0 / 0</span>
                            </div>
                            <div class="progress" style="height:10px">
                                <div id="overall-bar"
                                     class="progress-bar progress-bar-striped progress-bar-animated"
                                     role="progressbar" style="width:0%"></div>
                            </div>
                        </div>

                        {# Queue list (empty state) #}
                        <div id="queue-empty" class="text-muted small fst-italic">
                            No queue built yet. Select countries and click <em>Build Queue</em>.
                        </div>

                        {# Queue table #}
                        <div id="queue-wrap" class="d-none border rounded" style="max-height:300px;overflow-y:auto">
                            <table class="table table-sm mb-0 small">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3">#</th>
                                        <th>Country</th>
                                        <th class="text-center">Tier</th>
                                        <th class="text-end pe-3">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="queue-tbody"></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Delete country ──────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-trash text-danger"></i>
                <span class="fw-semibold small">Delete All for Country</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Removes all cache entries for the selected country without regenerating.
                    The cache will be rebuilt on next game initialisation for that country.
                </p>
                <div class="mt-auto">
                    <form method="POST"
                          action="{{ path('admin_worldpack_delete_country') }}"
                          onsubmit="return confirm('Delete all cache entries for ' + this.country.options[this.country.selectedIndex].text + '?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('worldpack_delete_country') }}">
                        <div class="mb-3">
                            <label for="del_country" class="form-label fw-semibold small">Country</label>
                            <select id="del_country" name="country" class="form-select form-select-sm">
                                {% for code, name in enabledCountries %}
                                    <option value="{{ code }}">{{ name }} ({{ code }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fa fa-trash me-1"></i>Delete All
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
const TIERS_URL_TPL = '{{ path('admin_worldpack_tiers', {country: '__CC__'}) }}';
const WARM_TIER_URL = '{{ path('admin_worldpack_warm_tier') }}';
const CSRF_TOKEN    = '{{ csrf_token('worldpack_warm_tier') }}';

// COUNTRY_NAMES maps code → display name for queue rows
const COUNTRY_NAMES = {{ enabledCountries|json_encode|raw }};

// --- State ---
let queue   = [];   // [{country, tier, rowEl}, ...]
let running = false;

// --- Select All toggle ---
document.getElementById('select-all-countries').addEventListener('change', function () {
    document.querySelectorAll('.country-checkbox').forEach(cb => cb.checked = this.checked);
});
document.querySelectorAll('.country-checkbox').forEach(cb => {
    cb.addEventListener('change', () => {
        const all  = document.querySelectorAll('.country-checkbox');
        const done = document.querySelectorAll('.country-checkbox:checked');
        document.getElementById('select-all-countries').checked = all.length === done.length;
    });
});

// --- Build Queue ---
async function buildQueue() {
    if (running) return;

    const selected = [...document.querySelectorAll('.country-checkbox:checked')].map(cb => cb.value);
    if (selected.length === 0) {
        alert('Select at least one country.');
        return;
    }

    const btn = document.getElementById('build-queue-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Fetching tiers…';

    queue = [];
    const tbody = document.getElementById('queue-tbody');
    tbody.innerHTML = '';

    let rowIndex = 1;
    for (const code of selected) {
        const url = TIERS_URL_TPL.replace('__CC__', code);
        try {
            const res  = await fetch(url);
            const data = await res.json();
            if (!res.ok || data.error) {
                appendErrorRow(tbody, rowIndex++, code, data.error ?? 'Failed to load tiers');
                continue;
            }
            for (const tier of data.tiers) {
                const rowEl = appendQueueRow(tbody, rowIndex++, code, tier, 'pending');
                queue.push({ country: code, tier, rowEl });
            }
        } catch (e) {
            appendErrorRow(tbody, rowIndex++, code, e.message);
        }
    }

    document.getElementById('queue-empty').classList.add('d-none');
    document.getElementById('queue-wrap').classList.remove('d-none');
    document.getElementById('run-queue-btn').classList.remove('d-none');
    document.getElementById('clear-queue-btn').classList.remove('d-none');

    btn.disabled = false;
    btn.innerHTML = '<i class="fa fa-list-check me-1"></i>Rebuild Queue';
}

// --- Run Queue ---
async function runQueue() {
    if (running || queue.length === 0) return;
    running = true;

    document.getElementById('run-queue-btn').disabled  = true;
    document.getElementById('build-queue-btn').disabled = true;
    document.getElementById('clear-queue-btn').disabled = true;

    const overallProgress = document.getElementById('overall-progress');
    const overallBar      = document.getElementById('overall-bar');
    const overallStatus   = document.getElementById('overall-status');
    const overallFraction = document.getElementById('overall-fraction');
    overallProgress.classList.remove('d-none');

    const total = queue.length;
    let done = 0, failed = 0;

    for (const item of queue) {
        setRowStatus(item.rowEl, 'processing');
        item.rowEl.scrollIntoView({ block: 'nearest' });
        overallStatus.textContent   = `${COUNTRY_NAMES[item.country] ?? item.country} — Tier ${item.tier}…`;
        overallFraction.textContent = `${done} / ${total}`;

        const body = new FormData();
        body.append('_token',  CSRF_TOKEN);
        body.append('country', item.country);
        body.append('tier',    item.tier);
        body.append('force',   '1');

        try {
            const res  = await fetch(WARM_TIER_URL, { method: 'POST', body });
            const data = await res.json();

            if (data.success) {
                const detail = data.cached
                    ? 'already cached'
                    : `${data.clubCount} clubs, ${data.playerCount} players`;
                setRowStatus(item.rowEl, 'done', detail);
            } else {
                setRowStatus(item.rowEl, 'failed', data.error ?? 'Unknown error');
                failed++;
            }
        } catch (e) {
            setRowStatus(item.rowEl, 'failed', e.message);
            failed++;
        }

        done++;
        const pct = Math.round(done / total * 100);
        overallBar.style.width      = pct + '%';
        overallFraction.textContent = `${done} / ${total}`;
    }

    // Finished
    overallBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
    if (failed === 0) {
        overallBar.classList.add('bg-success');
        overallStatus.textContent = `Done — ${total} tiers warmed.`;
        setTimeout(() => location.reload(), 1400);
    } else {
        overallBar.classList.add('bg-warning');
        overallStatus.textContent = `Finished with ${failed} failure(s).`;
        document.getElementById('run-queue-btn').disabled   = false;
        document.getElementById('build-queue-btn').disabled = false;
        document.getElementById('clear-queue-btn').disabled = false;
    }

    running = false;
}

// --- Clear Queue ---
function clearQueue() {
    if (running) return;
    queue = [];
    document.getElementById('queue-tbody').innerHTML = '';
    document.getElementById('queue-wrap').classList.add('d-none');
    document.getElementById('queue-empty').classList.remove('d-none');
    document.getElementById('run-queue-btn').classList.add('d-none');
    document.getElementById('clear-queue-btn').classList.add('d-none');
    document.getElementById('overall-progress').classList.add('d-none');
    document.getElementById('build-queue-btn').innerHTML = '<i class="fa fa-list-check me-1"></i>Build Queue';
}

// --- DOM helpers ---
function appendQueueRow(tbody, index, country, tier, state) {
    const tr = document.createElement('tr');
    tr.dataset.country = country;
    tr.dataset.tier    = tier;
    tr.innerHTML = `
        <td class="ps-3 text-muted">${index}</td>
        <td class="fw-semibold">${COUNTRY_NAMES[country] ?? country} <span class="text-muted fw-normal">(${country})</span></td>
        <td class="text-center"><span class="badge bg-primary bg-opacity-75">${tier}</span></td>
        <td class="text-end pe-3">${statusBadge(state)}</td>`;
    tbody.appendChild(tr);
    return tr;
}

function appendErrorRow(tbody, index, country, msg) {
    const tr = document.createElement('tr');
    tr.innerHTML = `
        <td class="ps-3 text-muted">${index}</td>
        <td class="fw-semibold text-danger">${COUNTRY_NAMES[country] ?? country} <span class="fw-normal">(${country})</span></td>
        <td class="text-center">—</td>
        <td class="text-end pe-3"><span class="badge bg-danger">Error: ${escHtml(msg)}</span></td>`;
    tbody.appendChild(tr);
}

function setRowStatus(rowEl, state, detail) {
    const cell = rowEl.querySelector('td:last-child');
    cell.innerHTML = statusBadge(state, detail);
}

function statusBadge(state, detail) {
    switch (state) {
        case 'pending':    return '<span class="badge bg-secondary">Pending</span>';
        case 'processing': return '<span class="badge bg-primary"><i class="fa fa-spinner fa-spin me-1"></i>Processing…</span>';
        case 'done':       return `<span class="badge bg-success">Done${detail ? ' — ' + escHtml(detail) : ''}</span>`;
        case 'failed':     return `<span class="badge bg-danger">Failed${detail ? ': ' + escHtml(detail) : ''}</span>`;
        default:           return '';
    }
}

function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
{% endblock %}
