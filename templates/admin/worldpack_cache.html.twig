{% extends 'admin/bmc_page.html.twig' %}
{#
  Config → Worldpack cache, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::worldpackCache() — entries, byCountry, bySet, totalEntries,
  enabledCountries, countryLabels, packVersion, staleByCountry, freshByCountry,
  activeStale, activeFresh, orphanPacks, setSummaries, targetSets, liveCountries,
  belowTarget, readySetTotal.

  A WORLD PACK IS A SET, NOT A (COUNTRY, TIER) ROW. A set is one starter squad plus a payload
  per tier, claimed whole by exactly one club and never served twice. So the figure that
  matters on this page is CLAIMABLE SETS PER COUNTRY against its target: a live country at
  zero means the next player there pays for a live draw instead of getting a pre-built world.
  The tier tables below are still here, but they describe the inside of a set now.

  COMPLETENESS IS PER SET. `bySet` exists because a country holding two sets has two of every
  tier, so a per-country tier count reads 16-of-8 and cannot answer "is this world whole".

  STALE MEANS "THE CACHE WOULD REBUILD IT", not a separate admin judgement: the controller
  compares each row's payload_version against WorldInitializationService::WORLD_PACK_VERSION,
  which is the same comparison WorldPackCacheService makes when deciding a hit from a miss.

  NO SAVE BAR AND NO data-bmc-form. Nothing on this page is a setting: it is three actions
  (regenerate, delete one entry, delete a country) and two read-only tables. Dirty tracking
  would have nothing to track.

  THE RUN POLLER IS CARRIED OVER. One panel per country, each polling its own status route and
  stopping on a terminal status; only the markup it writes has changed. Its retry path still
  finds the owning country by looking for the tierRunId in a panel's HTML, which is why the
  rendered tier keeps carrying that id.

  BOOTSTRAP'S COLLAPSE IS GONE. The two secondary tables used data-bs-toggle="collapse" — the
  last Bootstrap JS dependency on a redesigned page. They are <details class="bmc-fold"> now.
#}

{% set COUNTRIES = countryLabels %}
{# Per SET. Counting tiers per country read 16/8 the moment a country held two sets. #}
{% set fullyCached = bySet|filter(tiers => tiers|length >= 8)|length %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_npc_clubs_content'}) }}"><span>GENERATE CLUBS</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_leagues_overview'}) }}"><span>LEAGUE OVERVIEW</span></a>
{% endblock %}

{% block bmc_body %}

<div class="bmc-stats bmc-stats--card">
    <div class="bmc-stat">
        <span class="bmc-stat__label">CLAIMABLE SETS</span>
        <span class="bmc-stat__value {{ readySetTotal > 0 ? 'ink-positive' : 'ink-negative' }}">{{ readySetTotal|number_format }}</span>
        <span class="bmc-stat__sub">ready, unclaimed, v{{ packVersion }} · live countries</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">BELOW TARGET</span>
        <span class="bmc-stat__value {{ belowTarget > 0 ? 'ink-negative' : 'ink-positive' }}">{{ belowTarget }}</span>
        <span class="bmc-stat__sub">of {{ liveCountries|length }} live · target {{ targetSets }} each</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">ENTRIES</span>
        <span class="bmc-stat__value">{{ totalEntries|number_format }}</span>
        <span class="bmc-stat__sub">tier payloads, across all sets</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">COUNTRIES WITH PACKS</span>
        <span class="bmc-stat__value">{{ byCountry|length }}</span>
        <span class="bmc-stat__sub">of {{ enabledCountries|length }} generation-capable</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">COMPLETE SETS</span>
        <span class="bmc-stat__value {{ fullyCached > 0 ? 'ink-positive' : 'ink-dim' }}">{{ fullyCached }}</span>
        <span class="bmc-stat__sub">sets holding all eight tiers</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">WORLDPACK VERSION</span>
        <span class="bmc-stat__value">v{{ packVersion }}</span>
        <span class="bmc-stat__sub">payload shape the server builds</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">STALE PACKS</span>
        <span class="bmc-stat__value {{ activeStale > 0 ? 'ink-negative' : 'ink-positive' }}">{{ activeStale|number_format }}</span>
        <span class="bmc-stat__sub">
            {{ activeFresh|number_format }} at v{{ packVersion }} · live countries
            {%- if orphanPacks > 0 %}, {{ orphanPacks }} for countries no longer generated{% endif %}
        </span>
    </div>
</div>

{# ── set stock ───────────────────────────────────────────────────────── #}
{#
  The operational view. Every other table on this page describes what has been generated;
  this one says whether a player starting a game right now gets a pre-built world or waits.

  CLAIMABLE is narrower than READY on purpose, and the three ways a ready set is not
  claimable are each a different problem with a different fix:
    · STALE   — built at an older payload shape. A regenerate fixes it; nothing else will,
                since the claim filters on the version and will never hand it out.
    · NO SQUAD — a set the introducing migration wrapped around pre-existing tier payloads.
                Inert by design; the first regenerate for that country clears it.
    · CLAIMED  — spoken for. Kept, not reclaimable: the club may still be fetching tiers.
#}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="layers"></i>
        <span class="bmc-card__title">SET STOCK</span>
        <span class="bmc-card__meta">target {{ targetSets }} claimable per live country</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            A world pack is a <strong>set</strong>: one starter squad plus a payload for every league tier,
            generated together and claimed whole by exactly one club, so no two players ever get the same
            world. The squad is <strong>generated</strong> like every NPC club's is, not drawn from the
            shared player pool, so a set can never be short of players and a new game can never be refused
            for a thin pool. Each game initialisation claims a set and queues a replacement, and
            <code>app:worldpack:maintain</code> sweeps hourly as a backstop. A country below target still
            works — the next player there has their world generated at request time and served uncached —
            it is just slower for them.
        </p>
    </div>

    <div class="bmc-card__band">
        <table class="bmc-table">
            <thead>
                <tr>
                    <th>COUNTRY</th>
                    <th class="num">CLAIMABLE</th>
                    <th class="num">BUILDING</th>
                    <th class="num">CLAIMED</th>
                    <th>FLAGS</th>
                    <th class="num">ACTION</th>
                </tr>
            </thead>
            <tbody>
                {% for code in liveCountries %}
                    {% set sum = setSummaries[code] ?? {'claimable': 0, 'building': 0, 'claimed': 0, 'failed': 0, 'staleReady': 0, 'squadless': 0} %}
                    {% set short = sum.claimable < targetSets %}
                    <tr>
                        <td>
                            <span class="bmc-vchip__code">{{ code }}</span>
                            <span class="bmc-pick-row__name">{{ COUNTRIES[code] ?? code }}</span>
                        </td>
                        <td class="num {{ short ? 'ink-negative' : 'ink-positive' }}">{{ sum.claimable }}/{{ targetSets }}</td>
                        <td class="num {{ sum.building > 0 ? 'ink-dim' : '' }}">{{ sum.building ?: '-' }}</td>
                        <td class="num ink-dim">{{ sum.claimed ?: '-' }}</td>
                        <td>
                            {% if sum.failed > 0 %}<span class="bmc-data ink-negative" title="generation failed — see the set's error">FAILED {{ sum.failed }}</span>{% endif %}
                            {% if sum.staleReady > 0 %}<span class="bmc-data ink-negative" title="ready but built at an older payload shape — never claimable; regenerate">STALE {{ sum.staleReady }}</span>{% endif %}
                            {% if sum.squadless > 0 %}<span class="bmc-data ink-dim" title="migration-backfilled, no starter squad — inert; a regenerate clears it">NO SQUAD {{ sum.squadless }}</span>{% endif %}
                            {% if sum.failed == 0 and sum.staleReady == 0 and sum.squadless == 0 %}
                                <span class="bmc-data {{ short ? 'ink-dim' : 'ink-positive' }}">{{ short ? 'SHORT' : 'OK' }}</span>
                            {% endif %}
                        </td>
                        <td class="num">
                            <button type="button"
                                    class="bmc-quick-btn top-up-btn"
                                    data-country="{{ code }}"
                                    {{ short ? '' : 'disabled' }}
                                    title="{{ short ? 'queue one more set for this country' : 'already at target' }}">TOP UP +1</button>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6"><span class="bmc-empty-note">NO LIVE COUNTRIES — set a country profile to LIVE first</span></td></tr>
                {% endfor %}
            </tbody>
        </table>
        <span class="bmc-data" id="top-up-note"></span>
    </div>
</section>

{# ── regenerate ──────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="refresh-cw"></i>
        <span class="bmc-card__title">REGENERATE COUNTRY CACHE</span>
        <span class="bmc-card__meta">needs leagues seeded for the countries picked</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Pre-generated NPC league packs keyed by country + tier, used at game initialisation to skip
            expensive world-pack generation on the device. Every player, coach and scout is generated
            fresh per club — nothing is drawn from a shared pool. Progress is tracked per tier, then per
            club, and stays visible after the run finishes.
        </p>
    </div>

    <div class="bmc-card__band bmc-row" style="gap:16px;align-items:flex-start">
        <div style="flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <span class="bmc-lbl bmc-lbl--ink">COUNTRIES</span>
                <span class="bmc-data">cached · pack status</span>
                <span class="bmc-data" id="pick-note"></span>
                <span style="flex:1"></span>
                <button type="button" class="bmc-quick-btn" data-pick="all">ALL</button>
                <button type="button" class="bmc-quick-btn" data-pick="none">NONE</button>
            </div>

            <div class="bmc-picklist" id="country-pick">
                {% for code, name in enabledCountries %}
                    {% set cached = (byCountry[code] ?? [])|length %}
                    {% set stale  = staleByCountry[code] ?? 0 %}
                    {% set claimableSets = (setSummaries[code] ?? {}).claimable|default(0) %}
                    {#
                      Three states, not two, because "no packs at all" is not the same problem as
                      "packs that need rebuilding" and the fix differs: one is a first warm, the
                      other a regenerate. Collapsing them into stale/current would tell an
                      operator to regenerate a country that has nothing to regenerate.
                    #}
                    <label class="bmc-pick-row{{ cached == 0 ? ' is-zero' : '' }}" aria-checked="false">
                        <input type="checkbox" class="country-checkbox" value="{{ code }}" aria-label="{{ name }}">
                        <span class="bmc-tile"></span>
                        <span class="bmc-vchip__code">{{ code }}</span>
                        <span class="bmc-pick-row__name">{{ name }}</span>
                        <span class="bmc-pick-row__n" title="claimable sets / target">{{ claimableSets }}/{{ targetSets }}</span>
                        {% if cached == 0 %}
                            <span class="bmc-data ink-dim" title="nothing cached — needs a first warm">NONE</span>
                        {% elseif stale > 0 %}
                            <span class="bmc-data ink-negative" title="{{ stale }} of {{ cached }} pack(s) below v{{ packVersion }} — will rebuild on read">STALE {{ stale }}/{{ cached }}</span>
                        {% else %}
                            <span class="bmc-data ink-positive" title="every cached pack is at v{{ packVersion }}">CURRENT</span>
                        {% endif %}
                    </label>
                {% endfor %}
            </div>

            <button type="button" class="bmc-btn bmc-btn--blue" id="regenerate-btn" style="align-self:flex-start"><span>REGENERATE</span></button>
        </div>

        <div style="flex:2 1 420px;min-width:0;display:flex;flex-direction:column;gap:10px">
            <span class="bmc-empty-note" id="progress-empty">NO RUNS STARTED THIS SESSION</span>
            <div id="progress-panels" style="display:flex;flex-direction:column;gap:10px"></div>
        </div>
    </div>
</section>

{# ── cache status grid ───────────────────────────────────────────────── #}
<details class="bmc-card bmc-fold" data-domain="club">
    <summary class="bmc-card__head">
        <i data-lucide="database"></i>
        <span class="bmc-card__title">CACHE STATUS</span>
        <span class="bmc-card__meta">{{ totalEntries|number_format }} total entries</span>
        <i data-lucide="chevron-right" class="bmc-fold__chev" width="16" height="16"></i>
    </summary>

    {% if byCountry is empty %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NO CACHE ENTRIES — USE REGENERATE ABOVE TO WARM IT</span></div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:560px">
                <thead><tr>
                    <th>COUNTRY</th>
                    {% for tier in 1..8 %}<th class="is-right">T{{ tier }}</th>{% endfor %}
                    <th class="is-right">CACHED</th>
                </tr></thead>
                <tbody>
                    {% for code, tiers in byCountry %}
                        <tr>
                            <td><span class="bmc-celltext">{{ COUNTRIES[code] ?? code }}</span> <span class="bmc-data">{{ code }}</span></td>
                            {% for tier in 1..8 %}
                                <td class="is-right">
                                    {% if tiers[tier] is defined %}
                                        <span class="bmc-checkmark bmc-checkmark--ok">✓</span>
                                    {% else %}
                                        <span class="ink-dim">—</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="is-right bmc-cellnum {{ tiers|length >= 8 ? 'ink-positive' : '' }}">{{ tiers|length }} / 8</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</details>

{# ── every entry ─────────────────────────────────────────────────────── #}
{% if entries is not empty %}
    <details class="bmc-card bmc-fold" data-domain="club">
        <summary class="bmc-card__head">
            <i data-lucide="list"></i>
            <span class="bmc-card__title">ALL ENTRIES</span>
            <span class="bmc-card__meta">{{ entries|length|number_format }}</span>
            <i data-lucide="chevron-right" class="bmc-fold__chev" width="16" height="16"></i>
        </summary>

        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:640px">
                <thead><tr>
                    <th>COUNTRY</th>
                    <th class="is-right">TIER</th>
                    <th class="is-right">CLUBS</th>
                    <th class="is-right">PLAYERS</th>
                    <th>GENERATED</th>
                    <th></th>
                </tr></thead>
                <tbody>
                    {% for entry in entries %}
                        {% set label = COUNTRIES[entry.country] ?? entry.country %}
                        <tr>
                            <td><span class="bmc-celltext">{{ label }}</span> <span class="bmc-data">{{ entry.country }}</span></td>
                            <td class="is-right"><span class="bmc-badge bmc-badge--subtle">T{{ entry.tier }}</span></td>
                            <td class="is-right bmc-cellnum">{{ entry.clubCount|number_format }}</td>
                            <td class="is-right bmc-cellnum">{{ entry.playerCount|number_format }}</td>
                            <td><span class="bmc-data">{{ entry.generatedAt|date('Y-m-d H:i') }}</span></td>
                            <td style="text-align:right">
                                <form method="post" action="{{ path('admin_worldpack_delete_entry', {id: entry.id}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('worldpack_delete_entry') }}">
                                    <button type="submit" class="bmc-iconbtn bmc-iconbtn--sm" title="Delete this entry"
                                            data-bmc-dialog-title="DELETE {{ label|upper }} TIER {{ entry.tier }}?"
                                            data-bmc-dialog-message="The pack is rebuilt on the next game initialisation for this country."
                                            data-bmc-dialog-confirm="DELETE" data-bmc-dialog-variant="red">
                                        <i data-lucide="trash-2" width="16" height="16"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% endif %}

{# ── delete a whole country ──────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="trash-2"></i>
        <span class="bmc-card__title">DELETE ALL FOR COUNTRY</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Removes every cache entry for one country without regenerating. The cache is rebuilt on that
            country's next game initialisation, so this costs a slower first load rather than any data.
        </p>
        <form method="post" action="{{ path('admin_worldpack_delete_country') }}" id="delete-country-form"
              style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-top:12px">
            <input type="hidden" name="_token" value="{{ csrf_token('worldpack_delete_country') }}">
            <div class="bmc-field-col">
                <label class="bmc-lbl bmc-lbl--ink" for="del_country">COUNTRY</label>
                <span class="bmc-select">
                    <select id="del_country" name="country" style="min-width:200px">
                        {% for code, name in enabledCountries %}
                            <option value="{{ code }}">{{ name }} ({{ code }})</option>
                        {% endfor %}
                    </select>
                </span>
            </div>
            {# The dialog's message names the country, so it is written at click time rather than
               rendered — the select may have moved since the page loaded. #}
            <button type="submit" class="bmc-btn bmc-btn--danger-outline" id="delete-country-btn"
                    data-bmc-dialog-title="DELETE EVERY CACHED PACK?"
                    data-bmc-dialog-confirm="DELETE" data-bmc-dialog-variant="red"><span>DELETE ALL</span></button>
        </form>
    </div>
</section>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var $ = function (s, r) { return (r || document).querySelector(s); };
    var $$ = function (s, r) { return [].slice.call((r || document).querySelectorAll(s)); };

    var REGENERATE_URL_TPL   = '{{ path('admin_worldpack_regenerate_country') }}';
    var RUN_STATUS_URL_TPL   = '{{ path('admin_worldpack_run_status', {country: '__CC__'}) }}';
    var RETRY_FAILED_URL_TPL = '{{ path('admin_worldpack_retry_failed_clubs', {tierRunId: '__ID__'}) }}';
    var REGENERATE_TOKEN     = '{{ csrf_token('worldpack_regenerate_country') }}';
    var RETRY_TOKEN          = '{{ csrf_token('worldpack_retry_failed_clubs') }}';
    var TOP_UP_URL           = '{{ path('admin_worldpack_top_up') }}';
    var TOP_UP_TOKEN         = '{{ csrf_token('worldpack_top_up') }}';
    var SET_STATUS_URL_TPL   = '{{ path('admin_worldpack_set_status', {country: '__CC__'}) }}';
    var COUNTRY_NAMES        = {{ enabledCountries|json_encode|raw }};

    var TERMINAL_RUN_STATUSES = ['completed', 'completed_with_errors', 'failed'];
    var POLL_INTERVAL_MS = 2500;

    // country -> { panelEl, polling: bool }
    var activePanels = {};

    function escHtml(str) {
        return String(str).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
    }

    // ── the country picker ──────────────────────────────────────────
    var rows = $$('#country-pick .bmc-pick-row');
    var note = $('#pick-note');

    function picked() { return rows.filter(function (r) { return $('input', r).checked; }); }

    function syncRows() {
        rows.forEach(function (r) { r.setAttribute('aria-checked', $('input', r).checked ? 'true' : 'false'); });
        var n = picked().length;
        note.textContent = n === 0 ? 'none picked' : n + ' picked';
    }

    rows.forEach(function (r) { $('input', r).addEventListener('change', syncRows); });
    $$('[data-pick]').forEach(function (b) {
        b.addEventListener('click', function () {
            var on = b.dataset.pick === 'all';
            rows.forEach(function (r) { $('input', r).checked = on; });
            syncRows();
        });
    });
    syncRows();

    // ── starting a run ──────────────────────────────────────────────
    var btn = $('#regenerate-btn');

    btn.addEventListener('click', async function () {
        var selected = picked().map(function (r) { return $('input', r).value; });

        if (selected.length === 0) {
            BMC.toast('PICK AT LEAST ONE COUNTRY');
            return;
        }

        btn.disabled = true;
        $('span', btn).textContent = 'STARTING…';

        for (var i = 0; i < selected.length; i++) {
            await startRunForCountry(selected[i]);
        }

        btn.disabled = false;
        $('span', btn).textContent = 'REGENERATE';
    });

    // -- TOP UP +1 -----------------------------------------------------------------------
    //
    // Queues one TopUpWorldPackSetMessage -- the SAME message every game initialisation
    // dispatches -- rather than building inline, because a set is 20-40s of generation and an
    // admin request must not hold a worker open for it. The handler re-reads the country's
    // deficit, so a double-click costs one cheap no-op rather than two countries' worth of
    // generation.
    //
    // It polls set-status, not run-status: a top-up creates no WorldPackGenerationRun (see
    // WorldPackSetTopUpService), so the regenerate poller below cannot see it at all.
    async function topUpCountry(btn) {
        var country = btn.getAttribute('data-country');
        var note    = $('#top-up-note');

        btn.disabled = true;
        btn.textContent = 'QUEUEING...';

        var body = new FormData();
        body.append('_token', TOP_UP_TOKEN);
        body.append('country', country);

        try {
            var res  = await fetch(TOP_UP_URL, { method: 'POST', body: body });
            var data = await res.json();

            // A 409 lands here: the endpoint refuses rather than reporting a success it did
            // not perform. Say the numbers, because the operator's next move depends on them.
            if (!data.success) {
                btn.textContent = 'REFUSED';
                btn.disabled = false;
                if (note) { note.textContent = country + ': ' + (data.error || 'top-up refused'); }
                return;
            }

            if (!data.queued) {
                // Only reachable now when the country genuinely holds its buffer -- the
                // starved case is the 409 above. Still prints the figure rather than the bare
                // word, so this can never again be the only thing an operator is told.
                btn.textContent = 'AT TARGET';
                if (note) {
                    note.textContent = country + ' already at target: ' + data.claimable + '/'
                        + data.target + ' claimable -- nothing queued.';
                }
                return;
            }

            btn.textContent = 'QUEUED';
            if (note) {
                // "Within a minute" was wrong and it mattered: the per-minute crontab entry
                // measurably runs every OTHER minute (1,414 log lines over 23h on dev,
                // 2026-11-21 -- busybox crond will not start a tick while it still has the
                // previous child), so pickup is up to ~2 minutes before any build begins.
                note.textContent = country + ' queued (' + data.claimable + '/' + data.target
                    + ' claimable now). Pickup takes up to ~2 minutes, then 8-18s to build.';
            }
            pollSetStatus(country, btn);
        } catch (e) {
            btn.textContent = 'FAILED';
            if (note) { note.textContent = country + ': ' + e.message; }
        }
    }

    // Polls until the country reaches target, or gives up. Bounded deliberately: the cron is
    // per-minute and a build is tens of seconds, so an unbounded poll on a country whose
    // generation keeps failing would hammer the endpoint for as long as the tab stayed open.
    async function pollSetStatus(country, btn) {
        var attempts = 0;
        // ~200s at 2.5s. Was 40 (~100s) against a comment claiming pickup "within a minute";
        // the consumer measurably runs every other minute, so the old budget could expire
        // before the build had started and reported STILL SHORT on a queue that was fine.
        var MAX      = 80;

        var tick = async function () {
            attempts++;
            try {
                var res  = await fetch(SET_STATUS_URL_TPL.replace('__CC__', country));
                var data = await res.json();

                if (data.claimable >= data.target) {
                    btn.textContent = 'AT TARGET';
                    return;
                }

                // A FAILED set carries the reason generation gave. Surfacing it is the
                // difference between "STILL SHORT" after three minutes and knowing why --
                // including the reaped-stranded-build reason, which is the one that used to
                // be invisible.
                var failed = (data.sets || []).filter(function (s) { return s.status === 'failed'; });
                if (failed.length > 0) {
                    btn.textContent = 'FAILED';
                    btn.disabled = false;
                    var note = $('#top-up-note');
                    if (note) {
                        note.textContent = country + ': ' + failed.length + ' set(s) FAILED -- '
                            + (failed[0].errorMessage || 'no reason recorded');
                    }
                    return;
                }

                btn.textContent = 'BUILDING...';
            } catch (e) {
                // A failed poll is not a failed build; let the next tick try.
            }

            if (attempts < MAX) {
                setTimeout(tick, POLL_INTERVAL_MS);
            } else {
                btn.textContent = 'STILL SHORT';
            }
        };

        setTimeout(tick, POLL_INTERVAL_MS);
    }

    $$('.top-up-btn').forEach(function (b) {
        b.addEventListener('click', function () { topUpCountry(b); });
    });

    async function startRunForCountry(country) {
        var body = new FormData();
        body.append('_token', REGENERATE_TOKEN);
        body.append('country', country);

        try {
            var res  = await fetch(REGENERATE_URL_TPL, { method: 'POST', body: body });
            var data = await res.json();
            if (!data.success) {
                ensurePanel(country).innerHTML = errorPanelHtml(country, data.error || 'Failed to start run');
                return;
            }
        } catch (e) {
            ensurePanel(country).innerHTML = errorPanelHtml(country, e.message);
            return;
        }

        $('#progress-empty').hidden = true;

        // The clear's own report, rendered ABOVE the per-tier progress and left there for the
        // run. A spared claimed set keeps its tier rows at the version it was built at, so
        // after a WORLD_PACK_VERSION bump a FINISHED rebuild still leaves STALE rows in the
        // table below — which was read as a partial rebuild (2026-11-22). It is not: those
        // rows are never served. Saying so here is cheaper than the operator finding the two
        // version filters in the code.
        ensurePanel(country);
        activePanels[country].note = data.note || '';

        beginPolling(country);
    }

    function ensurePanel(country) {
        var panel = activePanels[country] && activePanels[country].panelEl;
        if (!panel) {
            panel = document.createElement('div');
            panel.className = 'bmc-inset';
            panel.id = 'panel-' + country;
            $('#progress-panels').prepend(panel);
            activePanels[country] = { panelEl: panel, polling: false };
        }
        return panel;
    }

    function errorPanelHtml(country, msg) {
        return '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">' +
            '<span class="bmc-celltext">' + escHtml(COUNTRY_NAMES[country] || country) + '</span>' +
            '<span class="bmc-data">' + escHtml(country) + '</span>' +
            '<span class="bmc-badge bmc-badge--danger">' + escHtml(msg) + '</span></div>';
    }

    function beginPolling(country) {
        ensurePanel(country);
        if (activePanels[country].polling) return;
        activePanels[country].polling = true;

        var poll = async function () {
            if (!activePanels[country] || !activePanels[country].polling) return;

            try {
                var res  = await fetch(RUN_STATUS_URL_TPL.replace('__CC__', country));
                var data = await res.json();
                renderPanel(country, data.run);

                if (data.run && TERMINAL_RUN_STATUSES.indexOf(data.run.status) !== -1) {
                    activePanels[country].polling = false;
                    return; // stop polling — panel stays rendered as-is
                }
            } catch (e) {
                // transient — keep polling, next tick may recover
            }

            setTimeout(poll, POLL_INTERVAL_MS);
        };

        poll();
    }

    var RUN_BADGE = {
        pending:               ['PENDING', 'subtle'],
        in_progress:           ['IN PROGRESS', 'accent'],
        completed:             ['COMPLETED', 'positive'],
        completed_with_errors: ['COMPLETED WITH ERRORS', 'warning'],
        failed:                ['FAILED', 'danger'],
    };

    var TIER_BADGE = {
        pending:     ['PENDING', 'subtle'],
        in_progress: ['IN PROGRESS', 'accent'],
        assembling:  ['ASSEMBLING', 'accent'],
        completed:   ['DONE', 'positive'],
        failed:      ['FAILED', 'danger'],
    };

    var CLUB_STEP = {
        generating_players: 'generating players…',
        generating_staff:   'generating staff…',
        generating_scouts:  'generating scouts…',
        assigning:          'assigning to club…',
    };

    function badge(map, status) {
        var b = map[status];
        return b ? '<span class="bmc-badge bmc-badge--' + b[1] + '">' + b[0] + '</span>' : '';
    }

    function renderPanel(country, run) {
        var panel = ensurePanel(country);
        var name  = escHtml(COUNTRY_NAMES[country] || country);
        // Re-emitted on every poll, because this function replaces the panel's innerHTML
        // wholesale — a note appended once would survive exactly until the first tick.
        var note  = activePanels[country].note
            ? '<div class="bmc-celltext" style="margin-bottom:8px">' + escHtml(activePanels[country].note) + '</div>'
            : '';

        if (!run) {
            panel.innerHTML = note + '<span class="bmc-data">' + name + ' (' + escHtml(country) + ') — no run found.</span>';
            return;
        }

        panel.innerHTML = note +
            '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">' +
                '<span class="bmc-celltext">' + name + '</span>' +
                '<span class="bmc-data">' + escHtml(country) + '</span>' +
                badge(RUN_BADGE, run.status) +
            '</div>' +
            '<div style="display:flex;flex-direction:column;gap:8px">' + run.tiers.map(renderTier).join('') + '</div>';
    }

    function renderTier(t) {
        var current = t.status === 'in_progress'
            ? t.clubs.filter(function (c) { return ['pending', 'completed', 'failed'].indexOf(c.status) === -1; })[0]
            : null;

        var done    = t.clubs.filter(function (c) { return c.status === 'completed'; });
        var failed  = t.clubs.filter(function (c) { return c.status === 'failed'; });
        var pending = t.clubs.filter(function (c) { return c.status === 'pending'; });

        var lines = '';
        if (current) {
            lines += '<span class="bmc-data"><strong>' + escHtml(current.name) + '</strong>: ' +
                     escHtml(CLUB_STEP[current.status] || current.status) + '</span>';
        }
        if (done.length) {
            lines += '<span class="bmc-data">' + done.length + ' club(s) complete: ' +
                     done.map(function (c) { return escHtml(c.name); }).join(', ') + '</span>';
        }
        if (failed.length) {
            lines += '<span class="bmc-data ink-danger">' + failed.length + ' failed: ' +
                     failed.map(function (c) { return escHtml(c.name) + (c.error ? ' (' + escHtml(c.error) + ')' : ''); }).join('; ') + '</span>';
        }
        if (pending.length && !current) {
            lines += '<span class="bmc-data">' + pending.length + ' club(s) queued</span>';
        }

        // The tierRunId is carried in the markup because retryFailedClubs() finds the owning
        // country by searching each panel's HTML for it — see the handler below.
        var retry = failed.length
            ? '<button type="button" class="bmc-quick-btn" data-retry="' + escHtml(t.tierRunId) + '">RETRY ' + failed.length + '</button>'
            : '';

        return '<div class="bmc-inset bmc-inset--panel" style="gap:6px">' +
            '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">' +
                '<span class="bmc-lbl bmc-lbl--ink">TIER ' + t.tier + '</span>' +
                badge(TIER_BADGE, t.status) +
                '<span class="bmc-data">' + (t.completedClubs + t.failedClubs) + ' / ' + t.totalClubs + ' clubs</span>' +
                '<span style="flex:1"></span>' + retry +
            '</div>' + lines + '</div>';
    }

    // Delegated, because the retry buttons are re-rendered on every poll.
    document.addEventListener('click', async function (e) {
        var b = e.target.closest('[data-retry]');
        if (!b) return;

        b.disabled = true;
        var tierRunId = b.dataset.retry;
        var body = new FormData();
        body.append('_token', RETRY_TOKEN);

        try {
            await fetch(RETRY_FAILED_URL_TPL.replace('__ID__', tierRunId), { method: 'POST', body: body });
        } finally {
            // The country this tier belongs to picks the change up on its next poll — find it
            // from the panel currently showing this tierRunId and resume polling.
            Object.keys(activePanels).some(function (country) {
                if (activePanels[country].panelEl.innerHTML.indexOf(tierRunId) === -1) return false;
                activePanels[country].polling = true;
                beginPolling(country);
                return true;
            });
        }
    });

    // The country delete names its target, and the select can move after the page loads.
    var delBtn = $('#delete-country-btn'), delSel = $('#del_country');
    if (delBtn && delSel) {
        delBtn.addEventListener('mousedown', function () {
            delBtn.setAttribute('data-bmc-dialog-message',
                'Every cached pack for ' + delSel.options[delSel.selectedIndex].text +
                ' is removed. It is rebuilt on that country\'s next game initialisation.');
        });
    }
}());
</script>
{% endblock %}
