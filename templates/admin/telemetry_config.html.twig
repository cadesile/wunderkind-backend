{% extends 'admin/bmc_page.html.twig' %}
{#
  Config → Telemetry config, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::telemetryConfig() — snapshot (a LiveTelemetrySnapshot row).

  MOSTLY DOCUMENTATION. The landing page's "Chairman's Terminal" widget reads one cached row,
  and the six folds below are the record of which raw data feeds which number on it — written
  here rather than in a docblock because the person who needs it is an operator looking at a
  figure that seems wrong, not someone reading the service.

  THE SIX ACCORDION PANELS ARE <details class="bmc-fold"> NOW, which removes the last Bootstrap
  accordion in the admin. Bootstrap's version needs a matching #id on each half, so six panels
  was six chances to typo one into a panel that never opens — and that still renders, and still
  passes a page-loads test.

  THE CSRF FIELD IS _csrf_token, NOT _token. DashboardController::rebuildTelemetry() reads that
  name; the rest of the admin uses _token. Left as-is rather than renamed, because the field
  name is the contract between this form and that action and nothing else reads either.
#}

{% set stats = [
    {label: 'FIXTURES SIMULATED', value: snapshot.fixturesSimulated|number_format, sub: 'from form[] entries'},
    {label: 'CAPITAL DEPLOYED',   value: snapshot.getCapitalDeployedFormatted(),   sub: 'upkeep, wages and signings', ink: 'positive'},
    {label: 'RESULTS W/D/L',      value: snapshot.getResultsFormatted(),           sub: 'tallied, not delta'},
    {label: 'ACTIVE CLUBS',       value: snapshot.activeClubs|number_format,       sub: 'distinct, valid sync in 24h'},
    {label: 'WEEKS PLAYED',       value: snapshot.weeksPlayed|number_format,       sub: 'syncs × 4, an approximation'},
    {label: 'FEED EVENTS',        value: snapshot.recentEvents|length,             sub: 'merged by recency'},
] %}

{% set sources = [
    {
        title: 'CAPITAL DEPLOYED & W/D/L',
        source: 'SyncRecord.payload',
        scope: 'last 24h, valid syncs only',
    },
    {
        title: 'FEED: PROMOTION / RELEGATION / TITLE LINES',
        source: 'SeasonRecord',
        scope: 'last 7 days',
    },
    {
        title: 'FEED: HIGH-COST SPEND LINES',
        source: 'SyncRecord.payload.ledger[]',
        scope: 'last 24h',
    },
    {
        title: 'FEED: ATTENDANCE RECORDS',
        source: 'SyncRecord.payload.attendance',
        scope: 'last 24h',
    },
    {
        title: 'FOOTER: ACTIVE CLUBS & WEEKS PLAYED',
        source: 'SyncRecord',
        scope: 'last 24h',
    },
    {
        title: 'FEED ORDERING',
        source: 'LiveTelemetryService::mergeEventsByRecency()',
        scope: 'how the three sources combine',
    },
] %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_settings'}) }}"><span>SETTINGS</span></a>
{% endblock %}

{% block bmc_body %}

{# ── the cached row ──────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="radio-tower"></i>
        <span class="bmc-card__title">CURRENT SNAPSHOT</span>
        <span class="bmc-card__meta">refreshed {{ snapshot.generatedAt|date('Y-m-d H:i') }}</span>
    </div>

    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            The landing page's &ldquo;Chairman's Terminal&rdquo; widget reads a single cached
            <code class="bmc-code">LiveTelemetrySnapshot</code> row, refreshed on a cron schedule
            (<code class="bmc-code">app:telemetry:generate</code>). Rebuild it on demand below, or open a
            source to see exactly what raw data feeds each number.
        </p>
    </div>

    <div class="bmc-stats">
        {% for s in stats %}
            <div class="bmc-stat">
                <span class="bmc-stat__label">{{ s.label }}</span>
                <span class="bmc-stat__value{{ s.ink is defined ? ' ink-' ~ s.ink : '' }}">{{ s.value }}</span>
                <span class="bmc-stat__sub">{{ s.sub }}</span>
            </div>
        {% endfor %}
    </div>

    <div class="bmc-card__band" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <form method="post" action="{{ path('admin_telemetry_rebuild') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('rebuild_telemetry') }}">
            <button type="submit" class="bmc-btn bmc-btn--blue"
                    data-bmc-dialog-title="REBUILD THE TELEMETRY SNAPSHOT?"
                    data-bmc-dialog-message="Recomputes every figure from the last 24h of sync data. Same operation the cron job runs."
                    data-bmc-dialog-confirm="REBUILD" data-bmc-dialog-variant="yellow"><span>REBUILD SNAPSHOT</span></button>
        </form>
        <span class="bmc-data">Same operation the cron job runs — safe to trigger manually at any time.</span>
    </div>
</section>

<div class="bmc-rule"><span class="bmc-rule__title">RAW DATA USES</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">what feeds each number</span></div>

{# ── where each figure comes from ────────────────────────────────────── #}
{% for i, s in sources %}
    <details class="bmc-card bmc-fold" data-domain="club">
        <summary class="bmc-card__head">
            <i data-lucide="database"></i>
            <span class="bmc-card__title">{{ s.title }}</span>
            <span class="bmc-card__meta"><code class="bmc-code">{{ s.source }}</code> · {{ s.scope }}</span>
            <i data-lucide="chevron-right" class="bmc-fold__chev" width="16" height="16"></i>
        </summary>
        <div class="bmc-card__body">
            {% if i == 0 %}
                <p class="bmc-bodytext">
                    <code class="bmc-code">SyncRecordRepository::findValidPayloadsSince()</code> pulls every valid sync in
                    the last 24 hours; <code class="bmc-code">LiveTelemetryService::aggregate()</code> tallies three
                    sub-fields of each payload.
                </p>
                <div style="overflow-x:auto;margin-top:10px">
                    <table class="bmc-minitable" style="min-width:560px">
                        <thead><tr><th>PAYLOAD FIELD</th><th>USED FOR</th><th>RULE</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><code class="bmc-code">form[]</code></td>
                                <td><span class="bmc-data">Fixtures Simulated, Results W/D/L</span></td>
                                <td><span class="bmc-data">Each W/D/L entry tallied directly — no delta against the prior sync.</span></td>
                            </tr>
                            <tr>
                                <td><code class="bmc-code">ledger[].amount</code></td>
                                <td><span class="bmc-data">Capital Deployed</span></td>
                                <td><span class="bmc-data">
                                    <code class="bmc-code">|amount|</code> summed for <code class="bmc-code">category</code> in
                                    <code class="bmc-code">upkeep</code>/<code class="bmc-code">wages</code> only (revenue categories excluded).
                                    Raw <code class="bmc-code">amount</code> is <strong>100× true pence</strong> — divided by 100 through
                                    <code class="bmc-code">ledgerAmountToPence()</code> before summing. See the "Ledger unit convention" note on
                                    <code class="bmc-code">LiveTelemetryService</code> and <code class="bmc-code">.context/stages/03_data/output/schema.md</code>.
                                </span></td>
                            </tr>
                            <tr>
                                <td><code class="bmc-code">transfers[].grossFee</code></td>
                                <td><span class="bmc-data">Capital Deployed</span></td>
                                <td><span class="bmc-data">
                                    Summed for <code class="bmc-code">type</code> in <code class="bmc-code">signing</code>/<code class="bmc-code">agent_assisted</code>
                                    only — <code class="bmc-code">sale</code> and other outgoing types are excluded.
                                </span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% elseif i == 1 %}
                <p class="bmc-bodytext">
                    <code class="bmc-code">SeasonRecordRepository::findRecentPyramidEvents()</code> selects rows where
                    <code class="bmc-code">promoted = true</code>, <code class="bmc-code">relegated = true</code>, or
                    <code class="bmc-code">finalPosition = 1</code>, joined to the real club name.
                    <code class="bmc-code">LiveTelemetryService::describeOutcome()</code> renders one line per row — a title
                    takes priority over a promotion for the same row.
                </p>
                <span class="bmc-note">
                    <i data-lucide="info"></i>
                    Names the real club, which is safe because club names come from a curated, server-generated set of
                    options rather than free text.
                </span>
            {% elseif i == 2 %}
                <p class="bmc-bodytext">
                    From the same 24h sync batch, <code class="bmc-code">LiveTelemetryService::buildLedgerEvents()</code>
                    ranks every negative-amount <code class="bmc-code">ledger[]</code> entry with a non-empty description by
                    magnitude — regardless of category, so a one-off cost naturally outranks routine payroll — keeps the
                    top 5, and renders <code class="bmc-code">"{club} spent {amount}: {description}"</code>.
                </p>
                <span class="bmc-note">
                    <i data-lucide="triangle-alert"></i>
                    The description is client-generated narrative text and may name a player.
                </span>
            {% elseif i == 3 %}
                <p class="bmc-bodytext">
                    <code class="bmc-code">SyncRecordRepository::findTopAttendanceSince()</code> ranks valid syncs by
                    <code class="bmc-code">payload.attendance.fanCount</code> and keeps the top 5, joined to the real club
                    name — rendered as <code class="bmc-code">"{club} recorded attendance of {fanCount}!"</code>.
                </p>
            {% elseif i == 4 %}
                <p class="bmc-bodytext">
                    <strong>Active Clubs</strong> — <code class="bmc-code">SyncRecordRepository::countActiveClubsSince()</code>:
                    the count of <em>distinct</em> clubs with a valid sync in the last 24h, the same definition the admin
                    dashboard's Active clubs KPI uses.
                </p>
                <p class="bmc-bodytext">
                    <strong>Weeks Played</strong> — <code class="bmc-code">count(syncRows) × 4</code>: each sync represents
                    roughly four on-device weekly ticks. An approximation, not a true weeks-elapsed count.
                </p>
            {% else %}
                <p class="bmc-bodytext">
                    <code class="bmc-code">LiveTelemetryService::mergeEventsByRecency()</code> merges the pyramid,
                    ledger-spend and attendance lines and sorts the combined list by each line's real timestamp, newest
                    first — so the widget shows one true chronological feed rather than the three sources grouped by type.
                </p>
            {% endif %}
        </div>
    </details>
{% endfor %}
{% endblock %}
