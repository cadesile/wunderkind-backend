{% extends 'admin/bmc_page.html.twig' %}
{#
  Config → Starter pack check, on bmc_page + bmc-pages.css/js.
  Data: StarterPackCheckController::check() — countries, country, tier, defaultTier, result.

  A DIAGNOSTIC, NOT A SETTINGS PAGE. No save bar and no data-bmc-form: nothing here is edited,
  it is a question asked of the pool and the answer. The only control that writes is the warm
  button, and that is its own POST.

  TWO FORMS AND THEY HAVE TO BE TWO. The check is a GET so its result is a linkable URL; the
  warm creates data and must be a CSRF-guarded POST. One form cannot be both. The warm carries
  the server's own last-checked country and tier rather than the selects' current values, so it
  can never act on a dropdown that was changed but never submitted — and it is hidden entirely
  until a check has been run, because there is nothing to warm before then.

  #spc-funnel AND #spc-staff ARE LOAD-BEARING. StarterPackCheckControllerTest counts rows and
  header cells through those ids to prove the funnel steps reached the template at all.
#}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_starter_config'}) }}"><span>STARTER CONFIG</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_player_pool_config'}) }}"><span>PLAYER POOL</span></a>
{% endblock %}

{% block bmc_body %}

<section class="bmc-card" data-domain="people">
    <div class="bmc-card__head">
        <i data-lucide="flask-conical"></i>
        <span class="bmc-card__title">RUN A CHECK</span>
        <span class="bmc-card__meta">reads only — creates nothing, consumes nothing</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Tests whether the pool can actually supply a starter squad for a country, without creating a
            club or consuming anything. Safe to run against live data.
        </p>

        <form method="get" action="{{ path('admin') }}"
              style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-top:12px">
            <input type="hidden" name="routeName" value="admin_starter_pack_check">

            <div class="bmc-field-col">
                <label class="bmc-lbl bmc-lbl--ink" for="spc-country">COUNTRY</label>
                <span class="bmc-select">
                    <select name="country" id="spc-country" required style="min-width:220px">
                        <option value="">— Select a country —</option>
                        {% for code, label in countries %}
                            <option value="{{ code }}"{{ code == country ? ' selected' : '' }}>{{ label }} ({{ code }})</option>
                        {% endfor %}
                    </select>
                </span>
            </div>

            <div class="bmc-field-col">
                <label class="bmc-lbl bmc-lbl--ink" for="spc-tier">LEAGUE TIER</label>
                <span class="bmc-select">
                    <select name="tier" id="spc-tier" style="min-width:220px">
                        {% for t in 1..8 %}
                            <option value="{{ t }}"{{ t == tier ? ' selected' : '' }}>Tier {{ t }}{{ t == defaultTier ? ' — new clubs start here' : '' }}</option>
                        {% endfor %}
                    </select>
                </span>
            </div>

            <button type="submit" class="bmc-btn bmc-btn--blue"><span>RUN CHECK</span></button>
        </form>

        {% if result is not null %}
            <form method="post" action="{{ path('admin', {routeName: 'admin_starter_pack_warm'}) }}"
                  style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px">
                <input type="hidden" name="_token" value="{{ csrf_token('starter_pack_warm') }}">
                <input type="hidden" name="country" value="{{ country }}">
                <input type="hidden" name="tier" value="{{ tier }}">
                <button type="submit" class="bmc-btn bmc-btn--orange"
                        data-bmc-dialog-title="GENERATE STARTER PACK FOR {{ country }}?"
                        data-bmc-dialog-message="Creates pool players, staff and scouts. This writes data and can take up to a minute."
                        data-bmc-dialog-confirm="GENERATE" data-bmc-dialog-variant="yellow"><span>GENERATE STARTER PACK</span></button>
                <span class="bmc-data">
                    Tops the {{ country }} pool up to the minimums the starter draw needs, then re-runs this check.
                </span>
            </form>
        {% endif %}
    </div>
</section>

{% if result is null %}
    <section class="bmc-card" data-domain="people">
        <div class="bmc-card__body">
            <span class="bmc-note">
                <i data-lucide="info"></i>
                Pick a country to test. A new club has no league when its starter pack is built, so
                <strong>tier&nbsp;{{ defaultTier }}</strong> is what real club creation uses.
            </span>
        </div>
    </section>
{% else %}
    {% set verdict = {
        'ok':       {badge: 'positive', icon: 'circle-check',      text: 'A full starter pack can be built for ' ~ result.countryLabel ~ '.'},
        'degraded': {badge: 'warning',  icon: 'triangle-alert',    text: 'A starter pack can be built, but it will be under-filled.'},
        'blocked':  {badge: 'danger',   icon: 'circle-x',          text: 'A starter pack CANNOT be built — club initialisation will fail.'},
    }[result.verdict] %}

    {# ── the verdict ─────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="people" id="spc-verdict">
        <div class="bmc-card__band" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <i data-lucide="{{ verdict.icon }}" class="ink-{{ result.verdict == 'ok' ? 'positive' : (result.verdict == 'degraded' ? 'dim' : 'danger') }}"></i>
            <span class="bmc-badge bmc-badge--{{ verdict.badge }}">{{ result.verdict }}</span>
            <div class="bmc-danger__text">
                <span class="bmc-lbl bmc-lbl--ink">{{ verdict.text }}</span>
                <span class="bmc-data">
                    {{ result.playersAvailable|number_format }} of {{ result.playersRequested|number_format }} players available
                    for {{ result.countryLabel }} ({{ result.country }}) at tier {{ result.tier }}.
                </span>
            </div>
        </div>
    </section>

    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(400px,1fr))">

        {# ── what the draw asks for ──────────────────────────────────── #}
        <section class="bmc-card" data-domain="people">
            <div class="bmc-card__head">
                <i data-lucide="sliders-horizontal"></i>
                <span class="bmc-card__title">WHAT THE DRAW ASKS FOR</span>
            </div>
            <table class="bmc-minitable" style="min-width:0">
                <tbody>
                    <tr>
                        <td><span class="bmc-data">Nationality</span></td>
                        <td class="is-right">
                            {% if result.nationality %}
                                <span class="bmc-celltext">{{ result.nationality }}</span>
                            {% else %}
                                <span class="bmc-badge bmc-badge--danger">UNRESOLVED</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td><span class="bmc-data">Ability band</span></td>
                        <td class="is-right bmc-cellnum">{{ result.ability.min }}–{{ result.ability.max }}</td>
                    </tr>
                    <tr>
                        <td><span class="bmc-data">Band comes from</span></td>
                        <td class="is-right"><code class="bmc-code">{{ result.ability.source }}</code></td>
                    </tr>
                    <tr>
                        <td><span class="bmc-data">First-team age floor</span></td>
                        <td class="is-right">
                            <span class="bmc-cellnum">{{ result.firstTeamAgeMin }}+</span>
                            <span class="bmc-data">born ≤ {{ result.bornOnOrBefore|date('Y-m-d') }}</span>
                        </td>
                    </tr>
                    <tr>
                        <td><span class="bmc-data">Squad size</span></td>
                        <td class="is-right bmc-cellnum">{{ result.playersRequested }} players</td>
                    </tr>
                    <tr>
                        <td><span class="bmc-data">Client can pick this country</span></td>
                        <td class="is-right">
                            {% if result.countryEnabled %}
                                <span class="bmc-badge bmc-badge--positive">YES</span>
                            {% else %}
                                <span class="bmc-badge bmc-badge--warning">NO</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>

        {# ── what the pool holds ─────────────────────────────────────── #}
        <section class="bmc-card" data-domain="people">
            <div class="bmc-card__head">
                <i data-lucide="database"></i>
                <span class="bmc-card__title">WHAT THE POOL HOLDS</span>
            </div>
            <div class="bmc-stats">
                <div class="bmc-stat">
                    <span class="bmc-stat__label">IN POOL</span>
                    <span class="bmc-stat__value">{{ result.poolTotal|number_format }}</span>
                    <span class="bmc-stat__sub">players, any age</span>
                </div>
                <div class="bmc-stat">
                    <span class="bmc-stat__label">AGED {{ result.firstTeamAgeMin }}+</span>
                    <span class="bmc-stat__value {{ result.poolAgeEligible == 0 ? 'ink-danger' : '' }}">{{ result.poolAgeEligible|number_format }}</span>
                    <span class="bmc-stat__sub">old enough for a first team</span>
                </div>
                <div class="bmc-stat">
                    <span class="bmc-stat__label">IN BAND</span>
                    <span class="bmc-stat__value">{{ result.poolInBand|number_format }}</span>
                    <span class="bmc-stat__sub">any age</span>
                </div>
            </div>
            <div class="bmc-card__body">
                <p class="bmc-bodytext">
                    A big pool and a wide ability band can still produce an empty draw — the squad needs players
                    that satisfy <em>both</em> at once. The funnel below shows which condition empties it.
                </p>
            </div>
        </section>
    </div>

    {# ── the draw, step by step ──────────────────────────────────────── #}
    <section class="bmc-card" data-domain="people">
        <div class="bmc-card__head">
            <i data-lucide="filter"></i>
            <span class="bmc-card__title">PLAYER DRAW, FILTER BY FILTER</span>
        </div>
        <div style="overflow-x:auto">
            <table class="bmc-minitable" id="spc-funnel" style="min-width:680px">
                <thead><tr>
                    <th>POSITION</th>
                    <th class="is-right">NEEDS</th>
                    {% for step in result.positions|first.funnel %}
                        <th class="is-right">{{ step.label|upper }}</th>
                    {% endfor %}
                    <th class="is-right">CAN DRAW</th>
                    <th></th>
                </tr></thead>
                <tbody>
                    {% for row in result.positions %}
                        <tr>
                            <td><span class="bmc-celltext">{{ row.position }}</span></td>
                            <td class="is-right bmc-cellnum">{{ row.requested }}</td>
                            {% for step in row.funnel %}
                                {% set previous = loop.first ? null : row.funnel[loop.index0 - 1].count %}
                                {% set collapsed = step.count == 0 and previous is not null and previous > 0 %}
                                <td class="is-right bmc-cellnum {{ collapsed ? 'ink-danger' : (step.count == 0 ? 'ink-dim' : '') }}"
                                    {{ collapsed ? 'title="The draw empties at this filter"' : '' }}>
                                    {{ step.count|number_format }}{{ collapsed ? ' ◀' : '' }}
                                </td>
                            {% endfor %}
                            <td class="is-right bmc-cellnum">{{ row.available|number_format }}</td>
                            <td class="is-right">
                                {% if row.ok %}
                                    <span class="bmc-badge bmc-badge--positive">OK</span>
                                {% else %}
                                    <span class="bmc-badge bmc-badge--{{ row.available == 0 ? 'danger' : 'warning' }}">SHORT BY {{ row.shortfall }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-card__body">
            <span class="bmc-note">
                <i data-lucide="info"></i>
                The last funnel column is the <em>native</em> draw. Anything short of the need is topped up from the
                same ability band regardless of nationality, so “can draw” is the whole age-eligible band.
            </span>
        </div>
    </section>

    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(400px,1fr))">

        {# ── staff & scouts ──────────────────────────────────────────── #}
        <section class="bmc-card" data-domain="people">
            <div class="bmc-card__head">
                <i data-lucide="users"></i>
                <span class="bmc-card__title">STAFF &amp; SCOUTS</span>
            </div>
            <div style="overflow-x:auto">
                <table class="bmc-minitable" id="spc-staff" style="min-width:420px">
                    <thead><tr>
                        <th>ROLE</th>
                        <th class="is-right">NEEDS</th>
                        <th class="is-right">{{ (result.nationality ?? 'Native')|upper }}</th>
                        <th class="is-right">IN POOL</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                        {% for row in result.staff %}
                            <tr>
                                <td><span class="bmc-celltext">{{ row.role|replace({'_': ' '})|title }}</span></td>
                                <td class="is-right bmc-cellnum">{{ row.requested }}</td>
                                <td class="is-right bmc-cellnum {{ row.native == 0 ? 'ink-dim' : '' }}">{{ row.native|number_format }}</td>
                                <td class="is-right bmc-cellnum">{{ row.available|number_format }}</td>
                                <td class="is-right">
                                    {% if row.ok %}
                                        <span class="bmc-badge bmc-badge--positive">OK</span>
                                    {% else %}
                                        <span class="bmc-badge bmc-badge--warning">SHORT BY {{ row.shortfall }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        <tr>
                            <td><span class="bmc-celltext">Scout</span></td>
                            <td class="is-right bmc-cellnum">{{ result.scouts.requested }}</td>
                            <td class="is-right bmc-cellnum {{ result.scouts.native == 0 ? 'ink-dim' : '' }}">{{ result.scouts.native|number_format }}</td>
                            <td class="is-right bmc-cellnum">{{ result.scouts.available|number_format }}</td>
                            <td class="is-right">
                                {% if result.scouts.ok %}
                                    <span class="bmc-badge bmc-badge--positive">OK</span>
                                {% else %}
                                    <span class="bmc-badge bmc-badge--warning">SHORT BY {{ result.scouts.shortfall }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        {# ── findings ────────────────────────────────────────────────── #}
        <section class="bmc-card" data-domain="people">
            <div class="bmc-card__head">
                <i data-lucide="clipboard-list"></i>
                <span class="bmc-card__title">FINDINGS</span>
                <span class="bmc-card__meta">{{ result.findings|length }}</span>
            </div>
            <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:10px">
                {% set findingIcon = {
                    'danger':  {icon: 'circle-x',       ink: 'danger'},
                    'warning': {icon: 'triangle-alert', ink: 'dim'},
                    'success': {icon: 'circle-check',   ink: 'positive'},
                    'info':    {icon: 'info',           ink: 'dim'},
                } %}
                {% for finding in result.findings %}
                    {% set f = findingIcon[finding.level] ?? findingIcon.info %}
                    <span class="bmc-note">
                        <i data-lucide="{{ f.icon }}" class="ink-{{ f.ink }}"></i>
                        {{ finding.message }}
                    </span>
                {% else %}
                    <span class="bmc-empty-note">NOTHING TO REPORT</span>
                {% endfor %}

                {% if result.suggestedBand %}
                    <div class="bmc-inset">
                        <span class="bmc-inset__title">SUGGESTED TIER {{ result.tier }} BAND</span>
                        <span class="bmc-data">
                            <strong>{{ result.suggestedBand.min }}–{{ result.suggestedBand.max }}</strong> — set it on
                            <a class="bmc-card__link" href="{{ path('admin', {routeName: 'admin_starter_config'}) }}">Starter config</a>
                            under League Player Ability Ranges.
                        </span>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>
{% endif %}
{% endblock %}
