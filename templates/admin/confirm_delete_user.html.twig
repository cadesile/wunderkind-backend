{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<style>
    .delete-card { max-width: 520px; margin: 2rem auto; }
    .club-row {
        font-size: .78rem;
        padding: .2rem .4rem;
        background: var(--bs-secondary-bg);
        border: 1px solid var(--bs-border-color);
        margin-bottom: .3rem;
        font-family: 'Courier New', monospace;
    }
</style>

<div class="delete-card">
    <div class="card border-danger border-opacity-50">
        <div class="card-header d-flex align-items-center gap-2 py-2 bg-danger bg-opacity-10 border-danger border-opacity-25">
            <i class="fa fa-user-slash text-danger"></i>
            <span class="fw-semibold">Delete User</span>
        </div>
        <div class="card-body">

            <div class="mb-3">
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <span class="text-muted small">User</span>
                    <span class="font-monospace">{{ user.email }}</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="text-muted small">Clubs</span>
                    <span class="fw-semibold">{{ clubs|length }}</span>
                </div>
            </div>

            {% if clubs|length > 0 %}
            <div class="mb-3">
                <p class="small text-muted mb-1">The following clubs and all their associated data will be permanently deleted:</p>
                {% for c in clubs %}
                    <div class="club-row">
                        <i class="fa fa-caret-right fa-xs me-1 text-danger"></i>
                        {{ c.name }}{% if c.country %} <span class="text-muted">({{ c.country }})</span>{% endif %}
                    </div>
                {% endfor %}
            </div>
            {% endif %}

            <div class="alert alert-danger py-2 small mb-3">
                <i class="fa fa-triangle-exclamation me-1"></i>
                This action is <strong>permanent and cannot be undone</strong>.
            </div>

            <form method="POST" action="{{ path('admin_user_delete', { id: user.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}"
                       class="btn btn-sm btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="fa fa-user-slash fa-xs me-1"></i>Delete User &amp; All Clubs
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
{% endblock %}
