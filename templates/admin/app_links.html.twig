{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">App Links</h5>
        <p class="text-muted small mb-0">Download URLs shown on the landing page and returned by <code>GET /api/app-links</code>. Leave a field blank to hide that platform's button.</p>
    </div>
    <div class="col-12">
    <form method="POST" action="{{ path('admin_app_links_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_app_links') }}">

        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-mobile-screen text-muted"></i>
                <span class="fw-semibold small">Download URLs</span>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="androidDownloadUrl" class="form-label fw-semibold">
                            <i class="fa fa-android text-success me-1"></i> Android
                        </label>
                        <input type="url" id="androidDownloadUrl" name="androidDownloadUrl"
                               value="{{ config.androidDownloadUrl ?? '' }}"
                               class="form-control font-monospace"
                               placeholder="https://play.google.com/store/apps/... or APK URL">
                        <div class="form-text">Google Play listing or direct APK link. Blank = button hidden.</div>
                    </div>
                    <div class="col-md-6">
                        <label for="iosDownloadUrl" class="form-label fw-semibold">
                            <i class="fa fa-apple text-secondary me-1"></i> iOS
                        </label>
                        <input type="url" id="iosDownloadUrl" name="iosDownloadUrl"
                               value="{{ config.iosDownloadUrl ?? '' }}"
                               class="form-control font-monospace"
                               placeholder="https://apps.apple.com/app/...">
                        <div class="form-text">App Store listing URL. Blank = button hidden.</div>
                    </div>
                </div>

                {% if config.androidDownloadUrl or config.iosDownloadUrl %}
                <div class="mt-4 p-3 bg-body-secondary rounded">
                    <p class="small fw-semibold mb-2 text-muted">Current live links</p>
                    <div class="d-flex flex-column gap-1">
                        {% if config.androidDownloadUrl %}
                            <a href="{{ config.androidDownloadUrl }}" target="_blank" rel="noopener" class="small text-break">
                                <i class="fa fa-android text-success me-1"></i>{{ config.androidDownloadUrl }}
                            </a>
                        {% else %}
                            <span class="small text-muted"><i class="fa fa-android me-1"></i>Android — not set</span>
                        {% endif %}
                        {% if config.iosDownloadUrl %}
                            <a href="{{ config.iosDownloadUrl }}" target="_blank" rel="noopener" class="small text-break">
                                <i class="fa fa-apple text-secondary me-1"></i>{{ config.iosDownloadUrl }}
                            </a>
                        {% else %}
                            <span class="small text-muted"><i class="fa fa-apple me-1"></i>iOS — not set</span>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-envelope text-muted"></i>
                <span class="fw-semibold small">Beta Access Requests</span>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="betaRequestEmail" class="form-label fw-semibold">Notification Email</label>
                        <input type="email" id="betaRequestEmail" name="betaRequestEmail"
                               value="{{ config.betaRequestEmail ?? '' }}"
                               class="form-control font-monospace"
                               placeholder="e.g. beta@wunderkindfactory.com">
                        <div class="form-text">Receives an email for each beta request submitted via the landing page. Blank = requests are silently accepted without notification.</div>
                    </div>
                </div>
                <hr class="my-4">
                <p class="small fw-semibold text-muted mb-3">Google reCAPTCHA v2</p>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="recaptchaSiteKey" class="form-label fw-semibold">Site Key <span class="text-muted fw-normal">(public)</span></label>
                        <input type="text" id="recaptchaSiteKey" name="recaptchaSiteKey"
                               value="{{ config.recaptchaSiteKey ?? '' }}"
                               class="form-control font-monospace"
                               placeholder="6Lc…">
                        <div class="form-text">Embedded in the landing page HTML. Leave blank to hide the CAPTCHA widget (no bot protection).</div>
                    </div>
                    <div class="col-md-6">
                        <label for="recaptchaSecretKey" class="form-label fw-semibold">Secret Key <span class="text-muted fw-normal">(private)</span></label>
                        <input type="text" id="recaptchaSecretKey" name="recaptchaSecretKey"
                               value="{{ config.recaptchaSecretKey ?? '' }}"
                               class="form-control font-monospace"
                               placeholder="6Lc…">
                        <div class="form-text">Used server-side to verify CAPTCHA responses. Never expose this publicly.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-sm">Save App Links</button>
        </div>
    </form>
    </div>

</div>
{% endblock %}
