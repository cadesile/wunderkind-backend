{% macro currency(pence) %}
    {%- set pounds = pence / 100 -%}
    {%- set abs = pounds|abs -%}
    {%- set sign = pounds < 0 ? '-' : '' -%}
    {%- if abs >= 1000000 -%}
        {{ sign }}£{{ (abs / 1000000)|number_format(1) }}M
    {%- elseif abs >= 1000 -%}
        {{ sign }}£{{ (abs / 1000)|number_format(1) }}K
    {%- else -%}
        {{ sign }}£{{ abs|number_format(0) }}
    {%- endif -%}
{% endmacro %}

{#
 # Formats a raw payload.ledger[].amount value. Unlike every other money field on
 # this page (club.balance, signing.fee, promise.offer.amountPence — all real
 # pence), ledger[].amount arrives from the client at 100x true pence — confirmed
 # by cross-referencing payload.excursions[].costPence (exact) against its matching
 # fan_initiative ledger line: the ledger amount is always exactly 100x costPence.
 # See the "Ledger unit convention" note in LiveTelemetryService's class docblock
 # (same source data, same correction) and .context/stages/03_data/output/schema.md.
 # Never pass a raw ledger[].amount straight to currency() — divide by 100 first, as
 # below.
 #}
{% macro ledgerCurrency(rawAmount) %}
    {%- import _self as macros -%}
    {{- macros.currency(rawAmount / 100) -}}
{% endmacro %}

{#
 # A single W/D/L form-strip square, most-recent-first — shared between the club profile
 # page and the user profile's club summary cards so a result reads identically everywhere.
 #}
{% macro resultBadge(r) %}
    <span class="fw-bold d-inline-flex align-items-center justify-content-center rounded-1"
          style="width:26px;height:26px;font-size:.75rem;letter-spacing:0;
                 background:{{ r == 'W' ? '#198754' : (r == 'D' ? '#6c757d' : '#dc3545') }};color:#fff;">
        {{ r }}
    </span>
{% endmacro %}
