{% extends 'admin/bmc_page.html.twig' %}
{#
  System → Logs, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::logs() — files, selectedFile, lines, logLines, fileSize, error.

  THE <pre> KEEPS ITS OWN DARK PALETTE. Every other surface on this page is a bmc token, but
  log output is read as a terminal and the level colours (#f85149 for ERROR, #d29922 for
  WARNING) are the GitHub-dark set the eye already parses that way. Mapping them onto the
  design tokens would make a WARNING and an INFO line harder to tell apart, which is the only
  thing this page is for.

  THE COLOURISER REBUILDS innerHTML FROM textContent, so it must keep escaping as it goes —
  the lines are user-influenced (an exception message can contain anything).
#}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_settings'}) }}"><span>SETTINGS</span></a>
{% endblock %}

{% block bmc_body %}

<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="scroll-text"></i>
        <span class="bmc-card__title">{{ selectedFile|default('LOG')|upper }}.LOG</span>
        <span class="bmc-card__meta">
            {%- if fileSize is not null %}{{ (fileSize / 1024)|round(1) }} KB · {% endif -%}
            live view of var/log/
        </span>
    </div>

    <div class="bmc-card__band">
        <form method="get" action="{{ path('admin') }}" style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap">
            <input type="hidden" name="routeName" value="admin_logs">

            {% if files|length > 1 %}
                <div class="bmc-field-col">
                    <label class="bmc-lbl bmc-lbl--ink" for="file">LOG FILE</label>
                    <span class="bmc-select">
                        <select id="file" name="file" onchange="this.form.submit()" style="min-width:170px">
                            {% for f in files %}
                                <option value="{{ f }}"{{ f == selectedFile ? ' selected' : '' }}>{{ f }}.log</option>
                            {% endfor %}
                        </select>
                    </span>
                </div>
            {% endif %}

            <div class="bmc-field-col">
                <label class="bmc-lbl bmc-lbl--ink" for="lines">LAST LINES</label>
                <span class="bmc-select">
                    <select id="lines" name="lines" onchange="this.form.submit()" style="min-width:110px">
                        {% for n in [100, 250, 500, 1000, 2000] %}
                            <option value="{{ n }}"{{ n == lines ? ' selected' : '' }}>{{ n }}</option>
                        {% endfor %}
                    </select>
                </span>
            </div>

            {% if files|length > 0 %}
                <button type="submit" class="bmc-btn bmc-btn--blue"><span>REFRESH</span></button>
            {% endif %}
        </form>
    </div>

    {% if error %}
        <div class="bmc-card__body">
            <div class="bmc-danger">
                <i data-lucide="triangle-alert"></i>
                <div class="bmc-danger__text"><span class="bmc-data">{{ error }}</span></div>
            </div>
        </div>
    {% elseif logLines|length == 0 %}
        <div class="bmc-card__body">
            <span class="bmc-empty-note">{{ selectedFile }}.LOG EXISTS BUT CONTAINS NO LINES</span>
        </div>
    {% else %}
        <div class="bmc-card__band" style="display:flex;align-items:center;gap:10px">
            <span class="bmc-lbl bmc-lbl--ink">OUTPUT</span>
            <span class="bmc-data">showing the last {{ logLines|length|number_format }} lines, newest at the bottom</span>
        </div>
        {# Escaped by Twig on the way out; the colouriser re-escapes when it rebuilds. #}
        <pre id="log-output" class="bmc-logview">{% for line in logLines %}{{ line }}
{% endfor %}</pre>
    {% endif %}
</section>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var pre = document.getElementById('log-output');
    if (!pre) return;

    // GitHub-dark level colours — see the template note on why these are not design tokens.
    var LEVELS = {
        EMERGENCY: '#f85149', CRITICAL: '#f85149', ERROR: '#f85149',
        WARNING:   '#d29922', NOTICE:   '#58a6ff', INFO:  '#3fb950', DEBUG: '#8b949e',
    };

    // Symfony's format: [datetime] channel.LEVEL: message …
    var levelRe = /\]\s+\w+\.(EMERGENCY|CRITICAL|ERROR|WARNING|NOTICE|INFO|DEBUG):/;

    pre.innerHTML = pre.textContent.split('\n').map(function (line) {
        // RE-ESCAPED, because this writes innerHTML from text that an exception message can
        // have put anything into.
        var safe = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        var m = levelRe.exec(line);
        return (m && LEVELS[m[1]]) ? '<span style="color:' + LEVELS[m[1]] + '">' + safe + '</span>' : safe;
    }).join('\n');

    pre.scrollTop = pre.scrollHeight;
})();
</script>
{% endblock %}
