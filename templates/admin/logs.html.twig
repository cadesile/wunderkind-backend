{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12 d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <h5 class="fw-semibold mb-0">Symfony Logs</h5>
            <p class="text-muted small mb-0">Live view of application log files from <code>var/log/</code>.</p>
        </div>
        {% if fileSize is not null %}
            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle align-self-center">
                {{ (fileSize / 1024)|round(1) }} KB
            </span>
        {% endif %}
    </div>

    {# ── Controls ─────────────────────────────────────────────────────── #}
    <div class="col-12">
        <form method="GET" action="{{ path('admin_logs') }}" class="d-flex flex-wrap align-items-end gap-3">
            {% if files|length > 1 %}
            <div>
                <label for="file" class="form-label fw-semibold small mb-1">Log file</label>
                <select id="file" name="file" class="form-select form-select-sm" onchange="this.form.submit()">
                    {% for f in files %}
                        <option value="{{ f }}" {% if f == selectedFile %}selected{% endif %}>{{ f }}.log</option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}

            <div>
                <label for="lines" class="form-label fw-semibold small mb-1">Last lines</label>
                <select id="lines" name="lines" class="form-select form-select-sm" onchange="this.form.submit()">
                    {% for n in [100, 250, 500, 1000, 2000] %}
                        <option value="{{ n }}" {% if n == lines %}selected{% endif %}>{{ n }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if files|length > 0 %}
            <div>
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fa fa-rotate-right me-1"></i>Refresh
                </button>
            </div>
            {% endif %}
        </form>
    </div>

    {# ── Output ───────────────────────────────────────────────────────── #}
    <div class="col-12">
        {% if error %}
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="fa fa-triangle-exclamation"></i>
                <span>{{ error }}</span>
            </div>
        {% elseif logLines|length == 0 %}
            <div class="card">
                <div class="card-body text-muted small text-center py-5">
                    <i class="fa fa-file-lines fa-2x mb-2 d-block"></i>
                    <code>{{ selectedFile }}.log</code> exists but contains no lines.
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-header py-2 d-flex align-items-center justify-content-between">
                    <span class="fw-semibold small">
                        <i class="fa fa-file-lines text-muted me-1"></i>
                        {{ selectedFile }}.log
                    </span>
                    <span class="text-muted" style="font-size:.75rem;">
                        showing last {{ logLines|length }} lines
                    </span>
                </div>
                <div class="card-body p-0">
                    {# Lines are output HTML-escaped; JS colorizes them by level keyword #}
                    <pre id="log-output"
                         style="background:#0d1117;color:#e6edf3;font-size:.72rem;line-height:1.6;
                                max-height:76vh;overflow-y:auto;border-radius:0 0 .375rem .375rem;
                                white-space:pre-wrap;word-break:break-all;margin:0;padding:1rem;">{% for line in logLines %}{{ line }}
{% endfor %}</pre>
                </div>
            </div>
        {% endif %}
    </div>

</div>

<script>
(function () {
    var pre = document.getElementById('log-output');
    if (!pre) return;

    // Colorize lines by Symfony log level
    var levelColors = {
        'EMERGENCY': '#f85149',
        'CRITICAL':  '#f85149',
        'ERROR':     '#f85149',
        'WARNING':   '#d29922',
        'NOTICE':    '#58a6ff',
        'INFO':      '#3fb950',
        'DEBUG':     '#8b949e',
    };

    // Symfony log format: [datetime] channel.LEVEL: message ...
    var levelRe = /\]\s+\w+\.(EMERGENCY|CRITICAL|ERROR|WARNING|NOTICE|INFO|DEBUG):/;

    var raw   = pre.textContent;
    var lines = raw.split('\n');
    var html  = lines.map(function (line) {
        var escaped = line
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        var m = levelRe.exec(line);
        if (m && levelColors[m[1]]) {
            return '<span style="color:' + levelColors[m[1]] + '">' + escaped + '</span>';
        }
        return escaped;
    }).join('\n');

    pre.innerHTML = html;

    // Scroll to bottom
    pre.scrollTop = pre.scrollHeight;
})();
</script>
{% endblock %}
