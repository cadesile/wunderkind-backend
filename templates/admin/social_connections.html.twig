{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Social Account Connections</h5>
        <p class="text-muted small mb-0">Connect Facebook Pages and X (Twitter) accounts the backend can post to later. Tokens are encrypted at rest.</p>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-plug text-muted"></i>
                <span class="fw-semibold small">Connect a New Account</span>
            </div>
            <div class="card-body d-flex gap-2">
                <a href="{{ path('admin_social_facebook_connect') }}" class="btn btn-primary btn-sm">
                    <i class="fa-brands fa-facebook me-1"></i> Connect Facebook Page
                </a>
                <a href="{{ path('admin_social_twitter_connect') }}" class="btn btn-dark btn-sm">
                    <i class="fa-brands fa-x-twitter me-1"></i> Connect X Account
                </a>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-list text-muted"></i>
                <span class="fw-semibold small">Connected Accounts</span>
            </div>
            <div class="card-body p-0">
                {% if connections is empty %}
                    <p class="text-muted small p-3 mb-0">No accounts connected yet.</p>
                {% else %}
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Platform</th>
                                <th>Account</th>
                                <th>Status</th>
                                <th>Connected</th>
                                <th>Last Refreshed</th>
                                <th>Token Expires</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for connection in connections %}
                                <tr>
                                    <td>
                                        {% if connection.platform.value == 'facebook' %}
                                            <i class="fa-brands fa-facebook text-primary me-1"></i> Facebook
                                        {% else %}
                                            <i class="fa-brands fa-x-twitter me-1"></i> X (Twitter)
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="fw-semibold">{{ connection.displayName }}</span>
                                        <span class="text-muted small d-block font-monospace">{{ connection.externalAccountId }}</span>
                                    </td>
                                    <td>
                                        {% if connection.active %}
                                            <span class="badge bg-success">Active</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Disconnected</span>
                                        {% endif %}
                                    </td>
                                    <td class="small text-muted">{{ connection.connectedAt ? connection.connectedAt|date('Y-m-d H:i') : '—' }}</td>
                                    <td class="small text-muted">{{ connection.lastRefreshedAt ? connection.lastRefreshedAt|date('Y-m-d H:i') : '—' }}</td>
                                    <td class="small text-muted">{{ connection.tokenExpiresAt ? connection.tokenExpiresAt|date('Y-m-d H:i') : 'Never' }}</td>
                                    <td class="text-end">
                                        {% if connection.active %}
                                        <form method="POST" action="{{ path('admin_social_disconnect', {id: connection.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('social_disconnect') }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Disconnect {{ connection.displayName }}?');">Disconnect</button>
                                        </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-flask text-muted"></i>
                <span class="fw-semibold small">Test Post</span>
            </div>
            <div class="card-body">
                {#
                    This form must POST through EasyAdmin's own entry point
                    (/admin?routeName=...) rather than directly to the named
                    route. socialTestPreview() renders this same
                    @EasyAdmin-extending template inline (unlike the other
                    custom actions on this page, which only ever redirect) —
                    the `ea` Twig context used by @EasyAdmin/layout.html.twig
                    is only populated by AdminRouterSubscriber for requests
                    that pass through the dashboard's own route, so a direct
                    POST to admin_social_test_preview would blow up with
                    "i18n on null" (see CLAUDE.md's EasyAdmin Custom Routes
                    gotcha — same root cause, just also applicable here for
                    an action that renders rather than redirects).
                #}
                <form method="POST" action="{{ path('admin', {routeName: 'admin_social_test_preview'}) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('social_test_preview') }}">
                    <div class="col-auto">
                        <label class="form-label small mb-0">Template</label>
                        <select name="templateId" class="form-select form-select-sm">
                            {% for template in templates %}
                                <option value="{{ template.id }}">
                                    {{ template.category.value }} / {{ template.platform.value }} / {{ template.period.value }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Preview</button>
                    </div>
                </form>

                {% if previewRequested and previewText is not null %}
                    <div class="alert alert-info mt-3 mb-2">
                        <strong>Rendered preview ({{ previewTemplate.category.value }} / {{ previewTemplate.platform.value }}):</strong>
                        <p class="mb-0 mt-1">{{ previewText }}</p>
                        {% if previewTemplate.platform.value == 'twitter' %}
                            <small class="text-muted">{{ previewText|length }} / 280 characters</small>
                        {% endif %}
                    </div>

                    <div class="alert alert-warning small mb-2">
                        This will publish a REAL post to the connected {{ previewTemplate.platform.value }} account(s). This cannot be undone.
                    </div>

                    {# Hit directly (not via admin?routeName=...) is safe only because socialTestPublish()
                       always redirects and never renders Twig. If it ever gains a render path
                       (e.g. an error page instead of a redirect), route this through
                       path('admin', {routeName: 'admin_social_test_publish'}) like the preview
                       form above, or it will hit the same "i18n on null" EasyAdmin gap. #}
                    <form method="POST" action="{{ path('admin_social_test_publish') }}"
                          onsubmit="return confirm('Publish this post live to the real connected account? This cannot be undone.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('social_test_publish') }}">
                        <input type="hidden" name="templateId" value="{{ previewTemplate.id }}">
                        <input type="hidden" name="renderedText" value="{{ previewText }}">
                        <button type="submit" class="btn btn-danger btn-sm">Publish Now</button>
                    </form>
                {% elseif previewRequested %}
                    <div class="alert alert-secondary mt-3 mb-0 small">No leaderboard data currently available for this category/period — nothing would be posted.</div>
                {% endif %}
            </div>
        </div>
    </div>

</div>
{% endblock %}
