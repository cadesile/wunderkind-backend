{% extends 'admin/bmc_page.html.twig' %}
{#
  Operate → Comms → Social connections, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::socialConnections() — connections, schedulePeriods, scheduleConfig,
  templates, previewRequested, previewText, previewTemplate.

  THREE FORMS AND THEY POST TO THREE DIFFERENT PLACES ON PURPOSE. Two go straight to their
  named route because those actions only ever REDIRECT; the preview form goes through
  /admin?routeName=… because socialTestPreview() RENDERS this same @EasyAdmin-extending
  template, and the `ea` Twig context only exists for requests that pass through the
  dashboard's own route — a direct POST there dies on "i18n on null". The original comments
  making that argument are kept inline below, because the distinction is invisible from the
  markup and someone will otherwise "tidy" them into agreement.

  THE SCHEDULE FORM IS NOT data-bmc-form. Its rows are checkbox + interval pairs built from an
  enum, and the save bar would be a page-level claim about one card among four.
#}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_app_links'}) }}"><span>APP LINKS</span></a>
{% endblock %}

{% block bmc_body %}

{# ── connect ─────────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="plug"></i>
        <span class="bmc-card__title">CONNECT A NEW ACCOUNT</span>
        <span class="bmc-card__meta">tokens are encrypted at rest</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Connect Facebook Pages and X (Twitter) accounts the backend can post to later.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
            <a class="bmc-btn bmc-btn--blue" href="{{ path('admin_social_facebook_connect') }}"><span>CONNECT FACEBOOK PAGE</span></a>
            <a class="bmc-btn" href="{{ path('admin_social_twitter_connect') }}"><span>CONNECT X ACCOUNT</span></a>
        </div>
    </div>
</section>

{# ── what is connected ───────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="list"></i>
        <span class="bmc-card__title">CONNECTED ACCOUNTS</span>
        <span class="bmc-card__meta">{{ connections|length }}</span>
    </div>
    {% if connections is empty %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NO ACCOUNTS CONNECTED YET</span></div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:760px">
                <thead><tr>
                    <th>PLATFORM</th><th>ACCOUNT</th><th>STATUS</th>
                    <th>CONNECTED</th><th>LAST REFRESHED</th><th>TOKEN EXPIRES</th><th></th>
                </tr></thead>
                <tbody>
                    {% for connection in connections %}
                        <tr>
                            <td><span class="bmc-celltext">{{ connection.platform.value == 'facebook' ? 'Facebook' : 'X (Twitter)' }}</span></td>
                            <td>
                                <span class="bmc-celltext">{{ connection.displayName }}</span>
                                <span class="bmc-data" style="display:block"><code class="bmc-code">{{ connection.externalAccountId }}</code></span>
                            </td>
                            <td>
                                <span class="bmc-badge bmc-badge--{{ connection.active ? 'positive' : 'subtle' }}">
                                    {{ connection.active ? 'ACTIVE' : 'DISCONNECTED' }}
                                </span>
                            </td>
                            <td><span class="bmc-data">{{ connection.connectedAt ? connection.connectedAt|date('Y-m-d H:i') : '—' }}</span></td>
                            <td><span class="bmc-data">{{ connection.lastRefreshedAt ? connection.lastRefreshedAt|date('Y-m-d H:i') : '—' }}</span></td>
                            <td><span class="bmc-data">{{ connection.tokenExpiresAt ? connection.tokenExpiresAt|date('Y-m-d H:i') : 'Never' }}</span></td>
                            <td style="text-align:right">
                                {% if connection.active %}
                                    <form method="post" action="{{ path('admin_social_disconnect', {id: connection.id}) }}" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('social_disconnect') }}">
                                        <button type="submit" class="bmc-btn bmc-btn--danger-outline"
                                                data-bmc-dialog-title="DISCONNECT {{ connection.displayName|upper }}?"
                                                data-bmc-dialog-message="The stored token is revoked. Reconnecting means going through the provider's OAuth flow again."
                                                data-bmc-dialog-confirm="DISCONNECT" data-bmc-dialog-variant="red"><span>DISCONNECT</span></button>
                                    </form>
                                {% else %}—{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>

{# ── the schedule ────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="clock"></i>
        <span class="bmc-card__title">AUTO-POST SCHEDULE</span>
        <span class="bmc-card__meta">checked every 15 minutes by a background job</span>
    </div>
    <div class="bmc-card__body">
        <p class="bmc-bodytext">
            Each period tier round-robins through every category before repeating — the rotation cursor lives
            in <code class="bmc-code">GameConfig</code>. Enabling a tier here posts automatically whenever its
            interval elapses, and a change takes effect without a deploy.
        </p>
    </div>

    {#
        This form only ever REDIRECTS (never renders), so — unlike the preview form below — it can
        safely POST directly to the named route instead of going through /admin?routeName=…, the
        same exemption admin_social_test_publish and admin_app_links_save already use. See
        CLAUDE.md's EasyAdmin Custom Routes gotcha.
    #}
    <form method="post" action="{{ path('admin_social_schedule_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_social_schedule') }}">
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:520px">
                <thead><tr><th>PERIOD</th><th>ENABLED</th><th>INTERVAL</th><th>LAST RAN</th></tr></thead>
                <tbody>
                    {% for period in schedulePeriods %}
                        {% set lastRun = scheduleConfig.getLastAutoPostRunAt(period) %}
                        <tr>
                            <td><span class="bmc-celltext">{{ period.value }}</span></td>
                            <td>
                                <label class="bmc-check" style="padding:0">
                                    <input type="checkbox" name="schedule[{{ period.value }}][enabled]" value="1"
                                           {{ scheduleConfig.isAutoPostEnabled(period) ? 'checked' : '' }}
                                           aria-label="Auto-post {{ period.value }}">
                                    <span class="bmc-tile"></span>
                                </label>
                            </td>
                            <td>
                                <label class="bmc-num bmc-num--76">
                                    <input name="schedule[{{ period.value }}][intervalHours]" inputmode="numeric"
                                           value="{{ scheduleConfig.getAutoPostIntervalHours(period) }}"
                                           aria-label="{{ period.value }} interval, hours">
                                    <span class="bmc-num__unit">h</span>
                                </label>
                            </td>
                            <td><span class="bmc-data">{{ lastRun ? lastRun|date('Y-m-d H:i') : 'never' }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-card__band">
            <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE SCHEDULE</span></button>
        </div>
    </form>
</section>

{# ── test post ───────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="flask-conical"></i>
        <span class="bmc-card__title">TEST POST</span>
        <span class="bmc-card__meta">preview is free · publish is real</span>
    </div>
    <div class="bmc-card__body">
        {#
            This form MUST post through EasyAdmin's own entry point (/admin?routeName=…) rather
            than directly to the named route. socialTestPreview() renders this same
            @EasyAdmin-extending template inline — unlike the other custom actions on this page,
            which only ever redirect — and the `ea` Twig context the layout reads is populated by
            AdminRouterSubscriber only for requests that pass through the dashboard's own route.
            A direct POST to admin_social_test_preview blows up with "i18n on null". Same root
            cause as CLAUDE.md's EasyAdmin Custom Routes gotcha, applied to an action that
            renders rather than redirects.
        #}
        <form method="post" action="{{ path('admin', {routeName: 'admin_social_test_preview'}) }}"
              style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap">
            <input type="hidden" name="_token" value="{{ csrf_token('social_test_preview') }}">
            <div class="bmc-field-col">
                <label class="bmc-lbl bmc-lbl--ink" for="templateId">TEMPLATE</label>
                <span class="bmc-select">
                    <select name="templateId" id="templateId" style="min-width:280px">
                        {% for template in templates %}
                            <option value="{{ template.id }}">{{ template.category.value }} / {{ template.platform.value }} / {{ template.period.value }}</option>
                        {% endfor %}
                    </select>
                </span>
            </div>
            <button type="submit" class="bmc-btn bmc-btn--blue"><span>PREVIEW</span></button>
        </form>

        {% if previewRequested and previewText is not null %}
            <div class="bmc-inset" style="margin-top:12px">
                <span class="bmc-inset__title">RENDERED PREVIEW — {{ previewTemplate.category.value }} / {{ previewTemplate.platform.value }}</span>
                <p class="bmc-bodytext" style="margin:0">{{ previewText }}</p>
                {% if previewTemplate.platform.value == 'twitter' %}
                    <span class="bmc-data {{ previewText|length > 280 ? 'ink-danger' : '' }}">{{ previewText|length }} / 280 characters</span>
                {% endif %}
            </div>

            <div class="bmc-danger" style="margin-top:12px">
                <i data-lucide="triangle-alert"></i>
                <div class="bmc-danger__text">
                    <span class="bmc-lbl bmc-lbl--ink">PUBLISHING IS REAL AND CANNOT BE UNDONE</span>
                    <span class="bmc-data">
                        This posts to the connected {{ previewTemplate.platform.value }} account(s), live.
                    </span>
                </div>
            </div>

            {# Posted directly, not via admin?routeName=…, which is safe ONLY because
               socialTestPublish() always redirects and never renders Twig. If it ever gains a
               render path — an error page instead of a redirect — route it through
               path('admin', {routeName: 'admin_social_test_publish'}) like the preview form
               above, or it hits the same "i18n on null" gap. #}
            <form method="post" action="{{ path('admin_social_test_publish') }}" style="margin-top:12px">
                <input type="hidden" name="_token" value="{{ csrf_token('social_test_publish') }}">
                <input type="hidden" name="templateId" value="{{ previewTemplate.id }}">
                <input type="hidden" name="renderedText" value="{{ previewText }}">
                <button type="submit" class="bmc-btn bmc-btn--danger-outline"
                        data-bmc-dialog-title="PUBLISH THIS POST LIVE?"
                        data-bmc-dialog-message="It goes to the real connected account and cannot be undone."
                        data-bmc-dialog-confirm="PUBLISH" data-bmc-dialog-variant="red"><span>PUBLISH NOW</span></button>
            </form>
        {% elseif previewRequested %}
            <span class="bmc-note" style="margin-top:12px">
                <i data-lucide="info"></i>
                No leaderboard data currently available for this category and period — nothing would be posted.
            </span>
        {% endif %}
    </div>
</section>
{% endblock %}
