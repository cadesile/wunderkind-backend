{% extends 'admin/bmc_page.html.twig' %}
{#
  WORKED EXAMPLE — the Investor pool page rebuilt on bmc_page + bmc-pages.css/js.
  Design source: prototype/Investor Pool.dc.html. Data: PoolConfigController::investorPoolConfig()
  (config, poolCounts{agents,sponsors,investors}) plus bmcGroup: 'Config', bmcTitle: 'Investor pool'.

  It is complete for this page and is the pattern the other pages follow:
    · static markup is Twig, styled only with bmc-* classes (no inline style except live widths)
    · the save form is a plain POST to the existing save route, enhanced by form[data-bmc-form]
    · generation runs client-side through BMC.runJobs() against the existing generate-chunk route
    · destructive actions confirm through the PixelDialog (data-bmc-dialog-*)
  Keep whatever form action URLs the current pool_investor_config.html.twig uses if they differ —
  the ones below follow the redirect convention in PoolConfigController.
#}

{% set types = [
    {key: 'agents',    label: 'AGENTS',    noun: 'Agents',    field: 'agentPoolTarget',    scope: 'Every agent',          count: poolCounts.agents,    target: config.agentPoolTarget},
    {key: 'sponsors',  label: 'SPONSORS',  noun: 'Sponsors',  field: 'sponsorPoolTarget',  scope: 'Not yet with a club',  count: poolCounts.sponsors,  target: config.sponsorPoolTarget},
    {key: 'investors', label: 'INVESTORS', noun: 'Investors', field: 'investorPoolTarget', scope: 'Not yet with a club',  count: poolCounts.investors, target: config.investorPoolTarget},
] %}
{% set clearN = poolCounts.agents + poolCounts.sponsors + poolCounts.investors %}

{% block bmc_page_class %} bmc-page--savebar{% endblock %}

{% block bmc_body %}
<section class="bmc-card" data-domain="club" id="gen"
         data-url="{{ path('admin_investor_pool_generate_chunk') }}" data-token="{{ csrf_token('generate_investor_pool') }}">
    <div class="bmc-card__head">
        <i data-lucide="sparkles"></i>
        <span class="bmc-card__title">GENERATE</span>
        <span class="bmc-card__meta">Agents, plus unassigned sponsors &amp; investors</span>
    </div>

    <div class="bmc-card__band" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="bmc-lbl bmc-lbl--ink">POOLS</span>
            <span class="bmc-data" id="type-note"></span>
            <span style="flex:1"></span>
            <button type="button" class="bmc-quick-btn" data-pick="all">ALL</button>
            <button type="button" class="bmc-quick-btn" data-pick="below" title="Pick only the pools below their target">BELOW TARGET</button>
            <button type="button" class="bmc-quick-btn" data-pick="none">NONE</button>
        </div>
        <div class="bmc-pooltiles">
            {% for t in types %}
                {% set r = t.target > 0 ? t.count / t.target : 1 %}
                <button type="button" class="bmc-pooltile" role="checkbox" aria-checked="true"
                        data-type="{{ t.key }}" data-noun="{{ t.noun }}" data-count="{{ t.count }}" data-target="{{ t.target }}">
                    <span class="bmc-pooltile__top"><span class="bmc-tile is-on"></span><span class="bmc-pooltile__name">{{ t.label }}</span></span>
                    <span style="display:flex;align-items:baseline;gap:6px"><span class="bmc-fig">{{ t.count|number_format }}</span><span class="bmc-data">/ {{ t.target|number_format }}</span></span>
                    <span class="bmc-data">{{ t.scope }}</span>
                    <span class="bmc-bar bmc-bar--8"><span class="bmc-bar__fill{{ r >= 1 ? '' : (r >= 0.5 ? ' bmc-bar__fill--warning' : ' bmc-bar__fill--danger') }}" style="display:block;width:{{ min(100, r * 100) }}%"></span></span>
                    <span class="bmc-badge {{ t.count == 0 ? 'bmc-badge--danger' : (r >= 1 ? 'bmc-badge--positive' : 'bmc-badge--warning') }}" style="align-self:flex-start">
                        {{ t.count == 0 ? 'EMPTY' : (r >= 1.5 ? (r|round(1)) ~ '× TARGET' : (r >= 1 ? 'AT TARGET' : (t.target - t.count)|number_format ~ ' SHORT')) }}
                    </span>
                </button>
            {% endfor %}
        </div>
    </div>

    <div class="bmc-tabs" role="tablist" aria-label="Generation mode" data-bmc-tabs id="modes">
        <button type="button" class="bmc-tab" role="tab" aria-selected="true" data-value="replenish">
            <i data-lucide="arrow-up-to-line" width="18" height="18"></i>
            <span class="bmc-tab__text"><span class="bmc-tab__label">REPLENISH TO TARGET</span><span class="bmc-tab__sub">Fills each pool’s gap only</span></span>
        </button>
        <button type="button" class="bmc-tab" role="tab" aria-selected="false" data-value="force">
            <i data-lucide="zap" width="18" height="18"></i>
            <span class="bmc-tab__text"><span class="bmc-tab__label">FORCE ADD BATCH</span><span class="bmc-tab__sub">Adds each pool’s full target</span></span>
        </button>
    </div>

    <div class="bmc-card__band bmc-row">
        <div style="flex:2 1 420px;min-width:0;display:flex;flex-direction:column;gap:10px">
            <span class="bmc-lbl bmc-lbl--ink" id="plan-title">BATCH PLAN</span>
            <div style="border:2px solid var(--wk-stroke);overflow-x:auto">
                <table class="bmc-minitable">
                    <thead><tr><th>POOL</th><th class="is-right">NOW</th><th class="is-right">ADDS</th><th class="is-right">AFTER</th></tr></thead>
                    <tbody id="plan"></tbody>
                </table>
            </div>
        </div>
        <aside class="bmc-inset" style="flex:1 1 260px;min-width:240px;gap:12px;padding:12px">
            <span class="bmc-inset__title">THIS RUN</span>
            <div class="bmc-stats bmc-stats--2">
                <div class="bmc-stat"><span class="bmc-stat__label">JOBS</span><span class="bmc-stat__value" id="sum-jobs">0</span></div>
                <div class="bmc-stat"><span class="bmc-stat__label">ADDS</span><span class="bmc-stat__value" id="sum-adds">+0</span></div>
            </div>
            <div id="sum-notes" style="display:flex;flex-direction:column;gap:8px"></div>
            <button type="button" class="bmc-btn bmc-btn--full" id="run"><span>REPLENISH</span></button>
        </aside>
    </div>

    <div class="bmc-card__band" id="progress" hidden style="display:flex;flex-direction:column;gap:10px;border-top:3px solid var(--wk-stroke)">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <i data-lucide="list-checks" width="16" height="16" class="ink-dim"></i>
            <span class="bmc-lbl bmc-lbl--ink">BATCH PROGRESS</span><span class="bmc-data" id="job-summary"></span>
        </div>
        <div class="bmc-strips" id="job-strip"></div>
        <div class="bmc-rows" id="job-rows"></div>
    </div>
</section>

<section class="bmc-card" data-domain="club" id="activity" hidden>
    <div class="bmc-card__head">
        <i data-lucide="history"></i><span class="bmc-card__title">ACTIVITY</span>
        <span class="bmc-card__meta">since page load · UTC</span>
        <button type="button" class="bmc-card__link" id="log-clear">CLEAR</button>
    </div>
    <div class="bmc-rows bmc-rows--flush bmc-rows--scroll-200" id="log"></div>
</section>

<div class="bmc-rule"><span class="bmc-rule__title">GENERATION RULES</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">Saved together · used from the next run</span></div>

<form method="post" action="{{ path('admin', {routeName: 'admin_investor_pool_config_save'}) }}" data-bmc-form id="rules" style="display:contents">
    <input type="hidden" name="_token" value="{{ csrf_token('save_investor_pool_config') }}">
    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(380px,1fr))">
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head"><i data-lucide="target"></i><span class="bmc-card__title">POOL TARGETS</span></div>
            <div class="bmc-setting__help bmc-pretty" style="padding:10px 12px 4px">Auto-replenish triggers when a pool drops below its target. Also the batch size for each Force add job.</div>
            {% for t in types %}
                {% set v = attribute(config, t.field) %}
                <div class="bmc-setting" data-bmc-setting>
                    <div class="bmc-setting__text">
                        <span class="bmc-setting__label">{{ t.label }}</span>
                        <span class="bmc-setting__help">{{ t.scope }} · in pool: {{ t.count|number_format }}</span>
                        <span class="bmc-setting__hint" data-bmc-hint data-default="{{ t.count >= v ? 'At or above target' : (v - t.count)|number_format ~ ' short of target' }}"></span>
                    </div>
                    <div class="bmc-setting__ctl">
                        <label class="bmc-num" style="width:88px"><input name="{{ t.field }}" inputmode="numeric" value="{{ v }}" data-saved="{{ v }}" data-min="0" data-max="10000" aria-label="{{ t.noun }} pool target"></label>
                        <button type="button" class="bmc-revert" hidden title="Revert to saved" aria-label="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button>
                    </div>
                </div>
            {% endfor %}
        </section>

        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head"><i data-lucide="handshake"></i><span class="bmc-card__title">AGENTS</span></div>
            {% for r in [
                {label: 'REPUTATION', help: 'Reputation on generation, 0–100.', a: 'agentReputationMin', b: 'agentReputationMax', lo: 0, hi: 100, unit: '', d: '30–70'},
                {label: 'AGE', help: 'Age range for new agents.', a: 'agentAgeMin', b: 'agentAgeMax', lo: 18, hi: 90, unit: 'yrs', d: '30–60'},
            ] %}
                <div class="bmc-setting" data-bmc-setting>
                    <div class="bmc-setting__text">
                        <span class="bmc-setting__label">{{ r.label }}</span>
                        <span class="bmc-setting__help">{{ r.help }}</span>
                        <span class="bmc-setting__hint" data-bmc-hint data-default="Default {{ r.d }}"></span>
                    </div>
                    <div class="bmc-setting__ctl">
                        <label class="bmc-num"><input name="{{ r.a }}" inputmode="numeric" value="{{ attribute(config, r.a) }}" data-saved="{{ attribute(config, r.a) }}" data-min="{{ r.lo }}" data-max="{{ r.hi }}" data-lte="{{ r.b }}" aria-label="{{ r.label|lower }} minimum"></label>
                        <span class="bmc-sep">–</span>
                        <label class="bmc-num"><input name="{{ r.b }}" inputmode="numeric" value="{{ attribute(config, r.b) }}" data-saved="{{ attribute(config, r.b) }}" data-min="{{ r.lo }}" data-max="{{ r.hi }}" aria-label="{{ r.label|lower }} maximum"></label>
                        <span class="bmc-unitword" style="width:26px">{{ r.unit }}</span>
                        <button type="button" class="bmc-revert" hidden title="Revert to saved" aria-label="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button>
                    </div>
                </div>
            {% endfor %}
            <div class="bmc-card__body" style="gap:6px;padding-bottom:0">
                {% set rl = config.agentReputationMin %}{% set rh = config.agentReputationMax %}
                <div class="bmc-bar bmc-bar--22"><span class="bmc-bar__span" style="left:{{ rl }}%;width:{{ max(0, rh - rl) }}%;background:var(--wk-positive)"></span></div>
                <div class="bmc-bar__scale"><span>0</span><span>reputation {{ rl }}–{{ rh }}</span><span>100</span></div>
            </div>
            <div class="bmc-note" style="padding:12px"><i data-lucide="info" class="ink-info"></i><span>How often a new player arrives with an agent is set on the Player pool page.</span></div>
        </section>
    </div>

    <section class="bmc-danger">
        <i data-lucide="triangle-alert"></i>
        <div class="bmc-danger__text">
            <span class="bmc-lbl bmc-lbl--ink">CLEAR THE POOL</span>
            <span class="bmc-data">Deletes every agent and every sponsor and investor not yet with a club — {{ clearN|number_format }} records. Cannot be undone.</span>
        </div>
        <button type="submit" class="bmc-btn bmc-btn--danger-outline" form="clear-form" {{ clearN == 0 ? 'disabled' }}
                data-bmc-dialog-title="CLEAR {{ clearN|number_format }} FROM THE POOL?"
                data-bmc-dialog-message="Every agent and every unassigned sponsor and investor is deleted. This cannot be undone."
                data-bmc-dialog-confirm="CLEAR" data-bmc-dialog-variant="red"><span>CLEAR INVESTOR POOL</span></button>
    </section>

    <div class="bmc-savebar" data-bmc-savebar data-idle="Targets and agent ranges are used from the next run.">
        <span class="bmc-savebar__dot"></span>
        <span class="bmc-savebar__title">ALL SAVED</span>
        <span class="bmc-savebar__sub"></span>
        <button type="button" class="bmc-btn" data-bmc-discard><span>DISCARD</span></button>
        <button type="submit" class="bmc-btn bmc-btn--yellow" data-bmc-save><span>SAVE RULES</span></button>
    </div>
</form>
<form method="post" id="clear-form" action="{{ path('admin', {routeName: 'admin_investor_pool_clear'}) }}" hidden>
    <input type="hidden" name="_token" value="{{ csrf_token('clear_investor_pool') }}">
</form>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
(function () {
    var $ = function (s, r) { return (r || document).querySelector(s); }, $$ = function (s, r) { return [].slice.call((r || document).querySelectorAll(s)); };
    var n = function (v) { return Number(v).toLocaleString('en-GB'); };
    var gen = $('#gen'), tiles = $$('.bmc-pooltile', gen), mode = 'replenish', running = false, log = [];
    var JC = { queued: ['QUEUED', 'subtle', 'var(--wk-panel)'], running: ['RUNNING', 'accent', 'var(--wk-accent)'],
               done: ['DONE', 'positive', 'var(--wk-positive)'], skipped: ['AT TARGET', '', 'var(--wk-text-faint)'], failed: ['FAILED', 'danger', 'var(--wk-danger)'] };
    var picked = function () { return tiles.filter(function (t) { return t.getAttribute('aria-checked') === 'true'; }); };
    var adds = function (t) { var c = +t.dataset.count, tg = +t.dataset.target; return mode === 'force' ? tg : Math.max(0, tg - c); };

    function draw() {
        tiles.forEach(function (t) { var on = t.getAttribute('aria-checked') === 'true'; $('.bmc-tile', t).classList.toggle('is-on', on); t.disabled = running; });
        var p = picked(), total = p.reduce(function (a, t) { return a + adds(t); }, 0), force = mode === 'force';
        var below = tiles.filter(function (t) { return +t.dataset.count < +t.dataset.target; }).length;
        $('#type-note').textContent = p.length + ' of ' + tiles.length + ' picked · ' + below + ' below target';
        $('#plan-title').textContent = force ? 'FORCE ADD PLAN' : 'REPLENISH PLAN';
        $('#plan').innerHTML = p.length ? p.map(function (t) {
            var a = adds(t), c = +t.dataset.count;
            return '<tr><td>' + t.dataset.noun + '</td><td class="is-right ink-dim">' + n(c) + '</td><td class="is-right ' + (a ? (force ? 'ink-warning' : 'ink-positive') : 'ink-dim') + '">' + (a ? '+' + n(a) : 'at target') + '</td><td class="is-right">' + n(c + a) + '</td></tr>';
        }).join('') : '<tr><td colspan="4" class="bmc-empty-note">PICK AT LEAST ONE POOL</td></tr>';
        var jobsN = force ? p.length : p.filter(function (t) { return adds(t) > 0; }).length;
        $('#sum-jobs').textContent = n(jobsN); $('#sum-adds').textContent = '+' + n(total);
        var notes = [];
        if (!p.length) notes.push(['triangle-alert', 'ink-warning', 'Pick at least one pool above.']);
        if (!force && p.length && !total) notes.push(['check', 'ink-positive', 'Every picked pool is at or above target, so replenish would add nothing.']);
        if (force && p.length) notes.push(['info', 'ink-info', 'Force add ignores what is already in the pool. Nationality isn’t used for this pool.']);
        if ($('#rules')._bmcDirty) notes.push(['info', 'ink-info', 'Uses the saved targets until you save the new ones.']);
        $('#sum-notes').innerHTML = notes.map(function (x) { return '<div class="bmc-note"><i data-lucide="' + x[0] + '" class="' + x[1] + '"></i><span>' + x[2] + '</span></div>'; }).join('');
        var run = $('#run');
        run.disabled = running || !p.length || (!force && !total);
        run.className = 'bmc-btn bmc-btn--full ' + (force ? 'bmc-btn--orange' : '');
        $('span', run).textContent = running ? 'RUNNING…' : !p.length ? 'PICK A POOL' : force ? 'FORCE ADD ' + n(total) : total ? 'REPLENISH +' + n(total) : 'AT TARGET';
        if (window.lucide) lucide.createIcons();
    }
    function drawJobs(jobs) {
        $('#progress').hidden = false;
        var done = jobs.filter(function (j) { return j.status !== 'queued' && j.status !== 'running'; }).length;
        var added = jobs.reduce(function (a, j) { return a + (j.count || 0); }, 0);
        $('#job-summary').textContent = done + ' of ' + jobs.length + ' jobs · +' + n(added);
        $('#job-strip').innerHTML = jobs.map(function (j) { return '<span title="' + j.label + '" style="background:' + JC[j.status][2] + '"></span>'; }).join('');
        $('#job-rows').innerHTML = jobs.map(function (j) {
            var c = JC[j.status];
            return '<div class="bmc-jobrow"><div><span class="bmc-badge' + (c[1] ? ' bmc-badge--' + c[1] : '') + '">' + c[0] + '</span></div><span class="bmc-celltext">' + j.label + ' · ' + j.mode + '</span><span class="bmc-cellnum ' + (j.status === 'done' ? 'ink-positive' : 'ink-dim') + '">' + (j.status === 'done' ? '+' + n(j.count) : j.status === 'skipped' ? '0' : '—') + '</span></div>';
        }).join('');
    }
    function drawLog() {
        $('#activity').hidden = !log.length;
        $('#log').innerHTML = log.map(function (l) {
            return '<div class="bmc-logrow"><span class="bmc-data">' + l.time + '</span><span class="bmc-bodytext ' + (l.ok ? 'ink-positive' : 'ink-dim') + '" style="text-align:center">' + (l.ok ? '✓' : '–') + '</span><span class="bmc-celltext">' + l.label + '</span><span class="bmc-lbl">' + l.mode + '</span><span class="bmc-cellnum ' + (l.ok ? 'ink-positive' : 'ink-dim') + '">' + l.count + '</span></div>';
        }).join('');
    }

    tiles.forEach(function (t) { t.addEventListener('click', function () { t.setAttribute('aria-checked', t.getAttribute('aria-checked') === 'true' ? 'false' : 'true'); draw(); }); });
    $$('[data-pick]', gen).forEach(function (b) { b.addEventListener('click', function () {
        var k = b.dataset.pick;
        tiles.forEach(function (t) { t.setAttribute('aria-checked', k === 'all' || (k === 'below' && +t.dataset.count < +t.dataset.target) ? 'true' : 'false'); });
        draw();
    }); });
    $('#modes').addEventListener('bmc:change', function (e) { mode = e.detail.value; draw(); });
    $('#rules').addEventListener('bmc:state', draw);
    $('#log-clear').addEventListener('click', function () { log = []; drawLog(); });

    $('#run').addEventListener('click', function () {
        var p = picked(), total = p.reduce(function (a, t) { return a + adds(t); }, 0), force = mode === 'force';
        BMC.confirm({
            title: (force ? 'FORCE ADD ' : 'REPLENISH +') + n(total) + '?', confirm: force ? 'FORCE ADD' : 'REPLENISH', variant: force ? 'orange' : 'teal',
            message: force ? 'Adds each picked pool’s full target, whatever is already there: ' + p.map(function (t) { return n(t.dataset.target) + ' ' + t.dataset.noun.toLowerCase(); }).join(', ') + '.'
                           : 'Tops up ' + p.length + (p.length === 1 ? ' pool' : ' pools') + ' to target. Pools already at target are skipped.'
        }).then(function (yes) {
            if (!yes) return;
            running = true; draw();
            BMC.runJobs({
                url: gen.dataset.url, token: gen.dataset.token,
                jobs: p.map(function (t) { return { type: t.dataset.type, label: t.dataset.noun, mode: mode }; }),
                onUpdate: drawJobs
            }).then(function (jobs) {
                var d = new Date(), z = function (x) { return String(x).padStart(2, '0'); }, time = z(d.getUTCHours()) + ':' + z(d.getUTCMinutes()) + ':' + z(d.getUTCSeconds());
                var added = 0;
                jobs.forEach(function (j) {
                    var tile = tiles.filter(function (t) { return t.dataset.type === j.type; })[0];
                    if (j.status === 'done') { tile.dataset.count = +tile.dataset.count + j.count; added += j.count; }
                    log.unshift({ time: time, label: j.label, mode: j.mode.toUpperCase(), ok: j.status === 'done', count: j.status === 'done' ? '+' + n(j.count) : j.status === 'failed' ? 'failed' : 'at target' });
                });
                log = log.slice(0, 60); running = false; drawLog(); draw();
                // Tile figures/bars are server-rendered; refresh them from the counts endpoint
                // (GET admin_investor_pool_counts) or reload — the prototype redraws them live.
                BMC.toast(added ? 'GENERATED ' + n(added) : 'EVERY PICKED POOL IS AT TARGET');
            });
        });
    });
    draw();
}());
</script>
{% endblock %}
