{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Configuration — Import / Export</h5>
        <p class="text-muted small mb-0">
            Export all configuration (game config, starter config, pool config) to a single JSON file.
            Import a file to overwrite the current configuration — all three configs are updated in one operation.
            Use this to copy configuration between environments.
        </p>
    </div>

    {# ── Export ──────────────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-file-arrow-down text-primary"></i>
                <span class="fw-semibold small">Export</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Downloads a <code>.json</code> snapshot of all configuration in this environment.
                    The file is safe to commit to version control for local development workflows.
                </p>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Game config (engine, scouting, morale, guardian, incidents)</li>
                    <li>Starter config (starting balance, initial staff counts, tiers)</li>
                    <li>Pool config (generation ranges, position weights, pool targets)</li>
                </ul>
                <div class="mt-auto">
                    <a href="{{ path('admin_config_export') }}" class="btn btn-primary btn-sm">
                        <i class="fa fa-download me-1"></i> Download JSON
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ── Import ──────────────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100 border-warning">
            <div class="card-header py-2 d-flex align-items-center gap-2 bg-warning-subtle">
                <i class="fa fa-file-arrow-up text-warning"></i>
                <span class="fw-semibold small">Import</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Upload a previously exported <code>.json</code> file. All configuration values in the
                    file will overwrite the current settings — only keys present in the file are applied,
                    so partial exports are safe.
                </p>
                <div class="alert alert-warning py-2 small mb-0">
                    <i class="fa fa-triangle-exclamation me-1"></i>
                    <strong>This overwrites live configuration immediately.</strong>
                    Export the current config first if you want a backup.
                </div>
                <form method="POST" action="{{ path('admin_config_import') }}" enctype="multipart/form-data" class="mt-auto">
                    <input type="hidden" name="_token" value="{{ csrf_token('config_import') }}">
                    <div class="mb-3">
                        <label for="config_file" class="form-label small fw-semibold">JSON file</label>
                        <input class="form-control form-control-sm" type="file" id="config_file"
                               name="config_file" accept=".json,application/json" required>
                    </div>
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="fa fa-upload me-1"></i> Import
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}
