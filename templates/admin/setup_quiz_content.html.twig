{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Setup Quiz — Import / Export</h5>
        <p class="text-muted small mb-0">
            Move the onboarding quiz between environments, or author it from a file instead of
            the form.
        </p>
    </div>

    {# ── Current state ─────────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-circle-question text-primary"></i>
                <span class="fw-semibold small">Current quiz</span>
                <a class="ms-auto small" href="{{ ea_url().setController('App\\Controller\\Admin\\SetupQuizQuestionCrudController').setAction('index') }}">
                    Edit questions
                </a>
            </div>
            <div class="card-body">
                <div class="d-flex gap-4 flex-wrap small">
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">Questions</div>
                        <div class="fw-semibold">{{ total }}</div>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">Active</div>
                        <div class="fw-semibold">{{ active }}</div>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;" title="Active AND with a correct answer that exists among its options">Served to players</div>
                        <div class="fw-semibold {{ servable < active ? 'text-warning' : '' }}">{{ servable }}</div>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">Player answers recorded</div>
                        <div class="fw-semibold">{{ answers }}</div>
                    </div>
                </div>

                {% if servable < active %}
                    <div class="alert alert-warning py-2 small mb-0 mt-3">
                        <i class="fa fa-triangle-exclamation me-1"></i>
                        {{ active - servable }} active question(s) are not served because their correct
                        answer does not exist among their options. Fix or withdraw them.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Export ────────────────────────────────────────────────────────────── #}
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-download text-muted"></i>
                <span class="fw-semibold small">Export</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Every question, active and withdrawn, with its options, correct answer and
                    sort order. Player answers are <strong>not</strong> included &mdash; they are
                    per-account game history.
                </p>

                <div class="alert alert-danger py-2 small mb-0">
                    <i class="fa fa-key me-1"></i>
                    <strong>This file contains the answer key.</strong> The quiz multiplies a
                    player&rsquo;s opening credit by how much they got right, so unlike the config
                    export this one must not be committed to a public repository or shared with
                    players.
                </div>

                <a href="{{ path('admin_setup_quiz_export') }}" class="btn btn-sm btn-primary align-self-start mt-auto">
                    <i class="fa fa-download me-1"></i> Download JSON
                </a>
            </div>
        </div>
    </div>

    {# ── Import ────────────────────────────────────────────────────────────── #}
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-upload text-muted"></i>
                <span class="fw-semibold small">Import</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Matched on <code>id</code>, so re-importing an export updates rather than
                    duplicates. <code>id</code> is optional &mdash; a hand-written file of prompts
                    and options imports as new questions, which is the quickest way to author a
                    quiz. A row with no correct answer among its options is refused and named
                    rather than imported as a question nobody can get right.
                </p>

                <div class="alert alert-secondary py-2 small mb-0">
                    <i class="fa fa-shield-halved me-1"></i>
                    Import never deletes. A question missing from the file is left alone, or
                    withdrawn if you tick the box below &mdash; deleting one would cascade and take
                    every player&rsquo;s answer to it with it.
                </div>

                <form method="POST" action="{{ path('admin_setup_quiz_import') }}" enctype="multipart/form-data" class="mt-auto">
                    <input type="hidden" name="_token" value="{{ csrf_token('setup_quiz_import') }}">

                    <div class="mb-2">
                        <label for="quizFile" class="form-label small fw-semibold">JSON file</label>
                        <input class="form-control form-control-sm" type="file" id="quizFile"
                               name="quiz_file" accept=".json,application/json" required>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="quizDryRun" name="dry_run" value="1" checked>
                        <label class="form-check-label small" for="quizDryRun">
                            Dry run &mdash; report what would change, write nothing
                        </label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="quizDeactivateMissing" name="deactivate_missing" value="1">
                        <label class="form-check-label small" for="quizDeactivateMissing">
                            Withdraw questions missing from the file
                            <span class="d-block text-muted" style="font-size:.72rem;">
                                Makes the quiz match the file exactly, without deleting anything.
                            </span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-sm btn-warning">
                        <i class="fa fa-upload me-1"></i> Import
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# ── File shape ────────────────────────────────────────────────────────── #}
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-code text-muted"></i>
                <span class="fw-semibold small">File shape</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    The smallest file that works. <code>version</code>, <code>id</code>,
                    <code>sortOrder</code> and <code>isActive</code> may all be omitted;
                    <code>correctIndex</code> is a zero-based index into <code>options</code>.
                </p>
                <div class="table-responsive">
<pre class="small mb-0 p-3" style="background:var(--bs-secondary-bg);border:1px solid var(--bs-border-color);">{
  "questions": [
    {
      "prompt": "What does a scout do?",
      "options": ["Finds players", "Sells tickets", "Cuts the grass"],
      "correctIndex": 0,
      "sortOrder": 1
    }
  ]
}</pre>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
