{% extends '@EasyAdmin/layout.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/lint.min.css">
    <style>
        .CodeMirror { height: 140px; font-size: 13px; border: 1px solid #ced4da; border-radius: 0.375rem; }
        .CodeMirror-focused { border-color: #86b7fe; box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25); outline: 0; }
        .cm-json-error .CodeMirror { border-color: #dc3545; }
        #defaultFacilities-error, #setupTutorialConfig-error { display: none; }
        .cm-json-error #defaultFacilities-error,
        .cm-json-error #setupTutorialConfig-error { display: block; }
    </style>
{% endblock %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Starter Config</h5>
        <p class="text-muted small mb-0">These values define the starting conditions for every new club. Changes take effect on the next new registration.</p>
    </div>

    <div class="col-12">
    <form method="POST" action="{{ path('admin_starter_config_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_starter_config') }}">

        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-flag text-muted"></i>
                <span class="fw-semibold small">New Club Defaults</span>
            </div>
            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="startingBalance" class="form-label fw-semibold small">Club Starting Balance</label>
                        <div class="input-group">
                            <span class="input-group-text">£</span>
                            <input type="number" id="startingBalance" name="startingBalance"
                                   value="{{ config.startingBalancePounds }}"
                                   min="0" step="1" class="form-control">
                        </div>
                        <div class="form-text">
                            The new club's own transfer kitty. Device-owned &mdash; every sync
                            reassigns it, so land is <strong>not</strong> charged against this.
                            Default: £50,000
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Account Starting Balance Range</label>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <div class="input-group">
                                    <span class="input-group-text">Min £</span>
                                    <input type="number" id="userStartingBalanceMinPounds"
                                           name="userStartingBalanceMinPounds"
                                           value="{{ config.userStartingBalanceMinPounds }}"
                                           min="0" step="1" class="form-control">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="input-group">
                                    <span class="input-group-text">Max £</span>
                                    <input type="number" id="userStartingBalanceMaxPounds"
                                           name="userStartingBalanceMaxPounds"
                                           value="{{ config.userStartingBalanceMaxPounds }}"
                                           min="0" step="1" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="form-text">
                            The <strong>account's</strong> opening credit, granted once when the
                            player creates their owner avatar. This is the balance land and
                            stadiums are charged against (<code>UserLedger</code>), and it is
                            durable &mdash; unlike the club kitty above, a sync cannot overwrite
                            it. Each account is given a figure drawn from this range,
                            deterministically from its own id, so the same account always
                            resolves to the same amount. Set both ends equal for a fixed grant.
                            Default: £5,000,000 &ndash; £6,000,000.
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label for="maxEnrichmentRequestsPerUser" class="form-label fw-semibold small">
                            Land Valuations Per Account
                        </label>
                        <input type="number" id="maxEnrichmentRequestsPerUser"
                               name="maxEnrichmentRequestsPerUser"
                               value="{{ config.maxEnrichmentRequestsPerUser }}"
                               min="0" step="1" class="form-control">
                        <div class="form-text">
                            How many AI land valuations one account may ever request. Each one is
                            a <strong>billed external API call</strong>, so this is the ceiling on
                            what a single player can spend &mdash; the catalogue is thousands of
                            towns, and without a cap one account can walk it.
                            <br>
                            <strong>Set to 0 for unlimited.</strong> Only requests that actually
                            start a valuation are counted: a repeat tap, or a second player
                            opening a town somebody else is already valuing, costs nothing and is
                            not charged against the allowance. The count is a lifetime total per
                            account and does not reset.
                            {% if config.maxEnrichmentRequestsPerUser == 0 %}
                                <br><span class="text-warning">Currently unlimited.</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="quizBonusMultiplier" class="form-label fw-semibold small">
                            Quiz Bonus Multiplier
                        </label>
                        <input type="number" id="quizBonusMultiplier"
                               name="quizBonusMultiplier"
                               value="{{ config.quizBonusMultiplier }}"
                               min="0" step="0.05" class="form-control">
                        <div class="form-text">
                            What finishing the onboarding quiz pays, as a multiple of
                            <strong>that account's own</strong> starting grant above &mdash; scaled
                            by the share of questions answered correctly. At the default
                            <code>1.0</code>, a perfect score doubles the grant and half marks add
                            50%.
                            <br>
                            A multiple rather than a fixed amount because the grant is a range: a
                            flat bonus would be a bigger proportion of an unlucky account's grant
                            than a lucky one's.
                            <strong>Set to 0 to switch the bonus off</strong> &mdash; the quiz
                            still runs and still records answers, it just pays nothing.
                            {% if config.quizBonusMultiplier == 0 %}
                                <br><span class="text-warning">Bonus currently switched off.</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="clubFundingMinimumPounds" class="form-label fw-semibold small">
                            Minimum Club Stake (&pound;)
                        </label>
                        <input type="number" id="clubFundingMinimumPounds"
                               name="clubFundingMinimumPounds"
                               value="{{ (config.clubFundingMinimumPence / 100)|round }}"
                               min="0" step="1000" class="form-control">
                        <div class="form-text">
                            The smallest opening capital a player may stake into a new club on
                            <code>POST /api/club/fund</code>.
                            <strong>0 means no minimum</strong>, which is the default: the setup
                            flow offers any part of the account balance, up to all of it, and
                            refusing a stake the player was told they could make is a worse
                            failure than letting them underfund a club they can top up from a
                            dividend later.
                            {% if config.clubFundingMinimumPence == 0 %}
                                <br><span class="text-warning">No minimum enforced.</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="clubFundingProjectionWeeks" class="form-label fw-semibold small">
                            Funding Projection Weeks
                        </label>
                        <input type="number" id="clubFundingProjectionWeeks"
                               name="clubFundingProjectionWeeks"
                               value="{{ config.clubFundingProjectionWeeks }}"
                               min="1" step="1" class="form-control">
                        <div class="form-text">
                            How many weeks of running costs the funding screen projects, published
                            to the app on <code>/api/starter-config</code>. Advisory &mdash; it
                            warns, it does not refuse.
                            <br>
                            The app does the wage half of that projection itself: hired staff and
                            players are removed from the pool on assign, so the server holds no
                            roster and can only report facility upkeep.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="starterSponsorTier" class="form-label fw-semibold small">Starter Sponsor Tier</label>
                        <select id="starterSponsorTier" name="starterSponsorTier" class="form-select">
                            <option value="SMALL"  {% if config.starterSponsorTier == 'SMALL'  %}selected{% endif %}>SMALL</option>
                            <option value="MEDIUM" {% if config.starterSponsorTier == 'MEDIUM' %}selected{% endif %}>MEDIUM</option>
                            <option value="LARGE"  {% if config.starterSponsorTier == 'LARGE'  %}selected{% endif %}>LARGE</option>
                        </select>
                        <div class="form-text">Sponsor company-size tier assigned at club creation. Default: SMALL</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterPlayerCount" class="form-label fw-semibold small">Players</label>
                        <input type="number" id="starterPlayerCount" name="starterPlayerCount"
                               value="{{ config.starterPlayerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Players assigned at club creation. Default: 5</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterManagerCount" class="form-label fw-semibold small">Managers</label>
                        <input type="number" id="starterManagerCount" name="starterManagerCount"
                               value="{{ config.starterManagerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Managers assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterCoachCount" class="form-label fw-semibold small">Coaches</label>
                        <input type="number" id="starterCoachCount" name="starterCoachCount"
                               value="{{ config.starterCoachCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Coaches assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterScoutCount" class="form-label fw-semibold small">Scouts</label>
                        <input type="number" id="starterScoutCount" name="starterScoutCount"
                               value="{{ config.starterScoutCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Scouts assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterDirectorOfFootballCount" class="form-label fw-semibold small">Directors of Football</label>
                        <input type="number" id="starterDirectorOfFootballCount" name="starterDirectorOfFootballCount"
                               value="{{ config.starterDirectorOfFootballCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Directors of Football assigned at club creation. Default: 0</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterFacilityManagerCount" class="form-label fw-semibold small">Facility Managers</label>
                        <input type="number" id="starterFacilityManagerCount" name="starterFacilityManagerCount"
                               value="{{ config.starterFacilityManagerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Facility Managers assigned at club creation. Default: 0</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterChairmanCount" class="form-label fw-semibold small">Chairmen</label>
                        <input type="number" id="starterChairmanCount" name="starterChairmanCount"
                               value="{{ config.starterChairmanCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Chairmen assigned at club creation. Default: 1</div>
                    </div>


                    <div class="col-md-6">
                        <label for="starterReputationTier" class="form-label fw-semibold small">Starter Reputation Tier</label>
                        <select id="starterReputationTier" name="starterReputationTier" class="form-select">
                            <option value="local"    {% if config.starterReputationTier.value == 'local'    %}selected{% endif %}>Local</option>
                            <option value="regional" {% if config.starterReputationTier.value == 'regional' %}selected{% endif %}>Regional</option>
                            <option value="national" {% if config.starterReputationTier.value == 'national' %}selected{% endif %}>National</option>
                            <option value="elite"    {% if config.starterReputationTier.value == 'elite'    %}selected{% endif %}>Elite</option>
                        </select>
                        <div class="form-text">Club reputation band at creation. Default: Local</div>
                    </div>

                    <div class="col-md-6">
                        <label for="starterClubTier" class="form-label fw-semibold small">Starter Club Tier</label>
                        <select id="starterClubTier" name="starterClubTier" class="form-select">
                            <option value="local"      {% if config.starterClubTier == 'local'      %}selected{% endif %}>Local</option>
                            <option value="regional"   {% if config.starterClubTier == 'regional'   %}selected{% endif %}>Regional</option>
                            <option value="national"   {% if config.starterClubTier == 'national'   %}selected{% endif %}>National</option>
                            <option value="elite"      {% if config.starterClubTier == 'elite'      %}selected{% endif %}>Elite</option>
                        </select>
                        <div class="form-text">Club tier assigned at creation. Default: Local</div>
                    </div>

                    <div class="col-12" id="defaultFacilities-wrap">
                        <label for="defaultFacilities" class="form-label fw-semibold small">Default Facilities (JSON)</label>
                        <textarea id="defaultFacilities" name="defaultFacilities"
                                  class="font-monospace" rows="6">{{ config.defaultFacilitiesJson }}</textarea>
                        <div id="defaultFacilities-error" class="text-danger small mt-1">Invalid JSON — please fix before saving.</div>
                        <div class="form-text">
                            Flat slug → level map, e.g. <code>{"training_pitch": 1, "north_stand": 0}</code>.
                            Leave as <code>{}</code> for no default facilities.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-graduation-cap text-muted"></i>
                <span class="fw-semibold small">Setup Tutorial</span>
            </div>
            <div class="card-body">
                <div class="col-12" id="setupTutorialConfig-wrap">
                    <label for="setupTutorialConfig" class="form-label fw-semibold small">Tutorial block (JSON)</label>
                    <textarea id="setupTutorialConfig" name="setupTutorialConfig"
                              class="font-monospace" rows="14">{{ config.setupTutorialConfigJson }}</textarea>
                    <div id="setupTutorialConfig-error" class="text-danger small mt-1">Invalid JSON — please fix before saving.</div>
                    <div class="form-text">
                        First-run cards inside the app's <strong>new-game setup</strong> flow, served as
                        <code>tutorial</code> on <code>GET /api/starter-config</code>. Shape:
                        <code>{"version": 1, "items": [...]}</code>.
                        <br><br>
                        <strong>A <code>note</code></strong> is a dismissible card at the top of a step
                        (<code>anchor.on</code>); <strong>a <code>briefing</code></strong> replaces the step's body
                        until the player taps its CTA (<code>anchor.before</code>). A briefing is not a step — it
                        does not affect the counter, BACK or FOUND CLUB.
                        <br><br>
                        Anchors are a step name, optionally <code>kind:role</code> with at most one colon. Steps:
                        <code>welcome avatar owner country club badge kits stadium hire role overview</code>; a role
                        suffix is legal only on <code>hire</code> and <code>role</code>, from
                        <code>chairman dof manager facilities</code>. A bare <code>hire</code> matches all four hire
                        steps.
                        <br><br>
                        Copy lives in the translation catalogue under <code>ngs.tut.*</code> — the JSON carries
                        <em>keys</em>, never text.
                        <br><br>
                        <strong>Raise <code>version</code> to show everything again to everyone.</strong> Changing one
                        item's <code>id</code> replays just that item.
                        <br><br>
                        ⚠️ <strong>Mistakes here are silent.</strong> The app cannot fail on this data — setup is the
                        one screen a new account cannot skip — so an item with an unknown anchor or an unresolvable
                        copy key simply never appears, with no error anywhere. Saving runs a check and reports what
                        it finds; <code>php bin/console app:check-setup-tutorial</code> runs the same check plus
                        translation-row coverage. An empty <code>{}</code> is a valid "no tutorial" state.
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-users-cog text-muted"></i>
                <span class="fw-semibold small">NPC Squad Config</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Configure squad size, staff counts, and recruitment balance for each league tier. These settings apply globally across all countries for that tier.</p>
                
                {% set allTiers = [] %}
                {% for country, tiers in dynamicLeagueTiers %}
                    {% for tier in tiers %}
                        {% if tier not in allTiers %}
                            {% set allTiers = allTiers|merge([tier]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                {% set allTiers = allTiers|sort %}

                <div class="row g-3">
                    {% for tier in allTiers %}
                        {% set tc = config.npcSquadConfig[tier] ?? {} %}
                        <div class="col-md-4">
                            <div class="card shadow-sm h-100 border-light">
                                <div class="card-header bg-light py-1 fw-bold small text-primary">Tier {{ tier }}</div>
                                <div class="card-body p-2">
                                    <div class="mb-2">
                                        <label class="small fw-bold mb-1">Squad Size</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">Min</span>
                                            <input type="number" name="npcConfig[{{ tier }}][playerMin]" 
                                                   class="form-control" value="{{ tc.playerMin ?? 15 }}" min="1">
                                            <span class="input-group-text">Max</span>
                                            <input type="number" name="npcConfig[{{ tier }}][playerMax]" 
                                                   class="form-control" value="{{ tc.playerMax ?? 25 }}" min="1">
                                        </div>
                                    </div>
                                    
                                    <div class="row g-1 mb-2">
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Mgr</label>
                                            <input type="number" name="npcConfig[{{ tier }}][managerCount]" 
                                                   class="form-control form-control-sm" value="{{ tc.managerCount ?? 1 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Coach</label>
                                            <input type="number" name="npcConfig[{{ tier }}][coachCount]" 
                                                   class="form-control form-control-sm" value="{{ tc.coachCount ?? 1 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Chair</label>
                                            <input type="number" name="npcConfig[{{ tier }}][chairmanCount]"
                                                   class="form-control form-control-sm" value="{{ tc.chairmanCount ?? 1 }}" min="0">
                                        </div>
                                    </div>

                                    <div class="row g-1 mb-2">
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">DoF</label>
                                            <input type="number" name="npcConfig[{{ tier }}][directorOfFootballCount]"
                                                   class="form-control form-control-sm" value="{{ tc.directorOfFootballCount ?? 0 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Fac Mgr</label>
                                            <input type="number" name="npcConfig[{{ tier }}][facilityManagerCount]"
                                                   class="form-control form-control-sm" value="{{ tc.facilityManagerCount ?? 0 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Scout</label>
                                            <input type="number" name="npcConfig[{{ tier }}][scoutCount]"
                                                   class="form-control form-control-sm" value="{{ tc.scoutCount ?? 0 }}" min="0">
                                        </div>
                                    </div>

                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="small fw-bold mb-0">Foreign %</label>
                                            <span class="badge bg-secondary rounded-pill" id="fp-label-{{ tier }}">{{ tc.foreignPercent ?? 0 }}%</span>
                                        </div>
                                        <input type="range" name="npcConfig[{{ tier }}][foreignPercent]" 
                                               class="form-range" min="0" max="100" 
                                               value="{{ tc.foreignPercent ?? 0 }}"
                                               oninput="document.getElementById('fp-label-{{ tier }}').innerText = this.value + '%'">
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-chart-line text-muted"></i>
                <span class="fw-semibold small">League Player Ability Ranges</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Define the min/max ability for players generated for NPC clubs in each league tier. If missing, sensible tier-based defaults are used (e.g. Tier 1: 75-95, Tier 8: 10-25).</p>
                
                {% for country, tiers in dynamicLeagueTiers %}
                    <div class="d-flex align-items-center justify-content-between mt-3 mb-1">
                        <h6 class="small fw-bold text-uppercase text-muted mb-0">{{ country }} Leagues</h6>
                        <div class="d-flex gap-1">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary copy-ranges-btn"
                                    data-country="{{ country }}"
                                    style="font-size:.72rem;padding:.2rem .55rem;">
                                <i class="fa fa-copy me-1"></i>Copy
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary paste-ranges-btn"
                                    data-country="{{ country }}"
                                    disabled
                                    style="font-size:.72rem;padding:.2rem .55rem;">
                                <i class="fa fa-paste me-1"></i>Paste
                            </button>
                        </div>
                    </div>
                    <div class="row g-2" data-ranges-country="{{ country }}">
                        {% for tier in tiers %}
                            <div class="col-md-3" data-tier="{{ tier }}">
                                <label class="small fw-bold d-block mb-1">Tier {{ tier }}</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Min</span>
                                    <input type="number" name="leagueRanges[{{ country }}][{{ tier }}][min]"
                                           class="form-control" placeholder="Min"
                                           value="{{ config.leagueAbilityRanges[country][tier]['min'] ?? '' }}"
                                           min="1" data-range="min">
                                    <span class="input-group-text">Max</span>
                                    <input type="number" name="leagueRanges[{{ country }}][{{ tier }}][max]"
                                           class="form-control" placeholder="Max"
                                           value="{{ config.leagueAbilityRanges[country][tier]['max'] ?? '' }}"
                                           min="1" data-range="max">
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
                
                {% if dynamicLeagueTiers is empty %}
                    <div class="alert alert-info small mb-0">No leagues found in the database. Generate leagues first in NPC Clubs section.</div>
                {% endif %}
            </div>
        </div>

        {# ── Fan Base Initialisation ──────────────────────────────────────── #}
        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-users text-muted"></i>
                <span class="fw-semibold small">Fan Base Initialisation</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Starting fan base count range per league tier assigned during world initialisation.
                    A random value in [min, max] is chosen for each NPC club at that tier.
                </p>

                {# Per-tier fan base ranges table #}
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0" style="min-width:480px;">
                        <thead class="table-light">
                            <tr>
                                <th class="small text-muted fw-semibold" style="width:80px;">Tier</th>
                                <th class="small text-muted fw-semibold" style="width:160px;">Min Fans</th>
                                <th class="small text-muted fw-semibold" style="width:160px;">Max Fans</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for tier in 1..8 %}
                            {% set tierKey = tier ~ '' %}
                            {% set fb = config.fanBaseRanges[tierKey] ?? {min: 0, max: 0} %}
                            <tr>
                                <td class="small fw-semibold text-muted">Tier {{ tier }}</td>
                                <td>
                                    <input type="number" name="fanBaseRanges[{{ tier }}][min]"
                                           value="{{ fb.min ?? 0 }}"
                                           min="0" step="100" class="form-control form-control-sm">
                                </td>
                                <td>
                                    <input type="number" name="fanBaseRanges[{{ tier }}][max]"
                                           value="{{ fb.max ?? 0 }}"
                                           min="0" step="100" class="form-control form-control-sm">
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Promotion / relegation changes #}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="fanBasePromotionIncrease" class="form-label fw-semibold small">
                            Promotion Fan Base Increase
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" id="fanBasePromotionIncrease" name="fanBasePromotionIncrease"
                                   value="{{ config.fanBasePromotionIncrease }}"
                                   min="0" max="2" step="0.01" class="form-control">
                            <span class="input-group-text">× (e.g. 0.20 = +20%)</span>
                        </div>
                        <div class="form-text">Percentage increase to fan base on promotion. Default: 0.20</div>
                    </div>
                    <div class="col-md-6">
                        <label for="fanBaseRelegationDecrease" class="form-label fw-semibold small">
                            Relegation Fan Base Decrease
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" id="fanBaseRelegationDecrease" name="fanBaseRelegationDecrease"
                                   value="{{ config.fanBaseRelegationDecrease }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <span class="input-group-text">× (e.g. 0.10 = −10%)</span>
                        </div>
                        <div class="form-text">Percentage decrease to fan base on relegation. Default: 0.10</div>
                    </div>
                </div>
            </div>
        </div>

        {# COUNTRY CONFIG LIVED HERE. A country is now offered to players when its profile is
           LIVE — set on the country itself, where whether it is ready is actually known —
           rather than ticked here in a list that could disagree with it. Change it at
           /admin?routeName=admin_locations, on the country. #}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-sm">Save Starter Config</button>
        </div>
    </form>
    </div>

</div>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsonlint/1.6.0/jsonlint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/lint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/json-lint.min.js"></script>
    <script>
    // Both JSON textareas on this screen get the same editor + lint + submit guard.
    // Was hardcoded to `defaultFacilities`; generalised 2026-11-02 when Setup Tutorial
    // added a second one, rather than copying 40 lines.
    ['defaultFacilities', 'setupTutorialConfig'].forEach(function (id) {
        const ta = document.getElementById(id);
        const wrap = document.getElementById(id + '-wrap');
        if (!ta || !wrap) return;
        const form = ta.closest('form');

        const editor = CodeMirror.fromTextArea(ta, {
            mode: { name: 'javascript', json: true },
            lineNumbers: true,
            lineWrapping: true,
            gutters: ['CodeMirror-lint-markers'],
            lint: true,
            theme: 'default',
        });

        function isValidJson(str) {
            try { JSON.parse(str); return true; } catch (e) { return false; }
        }

        function validate() {
            if (isValidJson(editor.getValue().trim())) {
                wrap.classList.remove('cm-json-error');
            } else {
                wrap.classList.add('cm-json-error');
            }
        }

        editor.on('change', validate);
        validate();

        form.addEventListener('submit', function (e) {
            editor.save(); // sync CodeMirror back to the hidden textarea
            if (!isValidJson(editor.getValue().trim())) {
                e.preventDefault();
                wrap.classList.add('cm-json-error');
                wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    });

    // ── League Ability Range copy / paste ────────────────────────────────────
    (function () {
        // clipboard: { fromCountry: string, tiers: { [tier]: { min: string, max: string } } } | null
        let clipboard = null;

        function readCountry(country) {
            const container = document.querySelector(`[data-ranges-country="${country}"]`);
            if (!container) return {};
            const data = {};
            container.querySelectorAll('[data-tier]').forEach(function (cell) {
                const tier = cell.dataset.tier;
                const min  = cell.querySelector('[data-range="min"]');
                const max  = cell.querySelector('[data-range="max"]');
                data[tier] = { min: min ? min.value : '', max: max ? max.value : '' };
            });
            return data;
        }

        function writeCountry(country, data) {
            const container = document.querySelector(`[data-ranges-country="${country}"]`);
            if (!container) return 0;
            let applied = 0;
            container.querySelectorAll('[data-tier]').forEach(function (cell) {
                const tier = cell.dataset.tier;
                if (!data[tier]) return;
                const min = cell.querySelector('[data-range="min"]');
                const max = cell.querySelector('[data-range="max"]');
                if (min) { min.value = data[tier].min; }
                if (max) { max.value = data[tier].max; }
                applied++;
            });
            return applied;
        }

        function updatePasteButtons() {
            document.querySelectorAll('.paste-ranges-btn').forEach(function (btn) {
                if (!clipboard) {
                    btn.disabled = true;
                    btn.title    = '';
                } else {
                    const isSelf = btn.dataset.country === clipboard.fromCountry;
                    btn.disabled = false;
                    btn.title    = isSelf
                        ? 'Re-paste copied values back into ' + clipboard.fromCountry
                        : 'Paste values copied from ' + clipboard.fromCountry;
                }
            });
        }

        document.querySelectorAll('.copy-ranges-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const country = btn.dataset.country;
                clipboard = { fromCountry: country, tiers: readCountry(country) };

                // Visual feedback — briefly flash the button
                btn.classList.add('btn-secondary');
                btn.classList.remove('btn-outline-secondary');
                btn.innerHTML = '<i class="fa fa-check me-1"></i>Copied';
                setTimeout(function () {
                    btn.classList.remove('btn-secondary');
                    btn.classList.add('btn-outline-secondary');
                    btn.innerHTML = '<i class="fa fa-copy me-1"></i>Copy';
                }, 1200);

                updatePasteButtons();
            });
        });

        document.querySelectorAll('.paste-ranges-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!clipboard) return;
                const country = btn.dataset.country;
                const count   = writeCountry(country, clipboard.tiers);

                // Visual feedback
                btn.classList.add('btn-primary');
                btn.classList.remove('btn-outline-primary');
                btn.innerHTML = '<i class="fa fa-check me-1"></i>Pasted ' + count + ' tier' + (count !== 1 ? 's' : '');
                setTimeout(function () {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                    btn.innerHTML = '<i class="fa fa-paste me-1"></i>Paste';
                }, 1500);
            });
        });

        updatePasteButtons();
    })();
    </script>
{% endblock %}
