{% extends '@EasyAdmin/layout.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/lint.min.css">
    <style>
        .CodeMirror { height: 140px; font-size: 13px; border: 1px solid #ced4da; border-radius: 0.375rem; }
        .CodeMirror-focused { border-color: #86b7fe; box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25); outline: 0; }
        .cm-json-error .CodeMirror { border-color: #dc3545; }
        #defaultFacilities-error { display: none; }
        .cm-json-error #defaultFacilities-error { display: block; }
    </style>
{% endblock %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Starter Config</h5>
        <p class="text-muted small mb-0">These values define the starting conditions for every new club. Changes take effect on the next new registration.</p>
    </div>

    <div class="col-12">
    <form method="POST" action="{{ path('admin_starter_config_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_starter_config') }}">

        <div class="card">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-flag text-muted"></i>
                <span class="fw-semibold small">New Club Defaults</span>
            </div>
            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="startingBalance" class="form-label fw-semibold small">Starting Balance (£)</label>
                        <input type="number" id="startingBalance" name="startingBalance"
                               value="{{ config.startingBalancePounds }}"
                               min="0" step="1" class="form-control">
                        <div class="form-text">Enter in pounds. Default: £50,000</div>
                    </div>

                    <div class="col-md-6">
                        <label for="starterSponsorTier" class="form-label fw-semibold small">Starter Sponsor Tier</label>
                        <select id="starterSponsorTier" name="starterSponsorTier" class="form-select">
                            <option value="SMALL"  {% if config.starterSponsorTier == 'SMALL'  %}selected{% endif %}>SMALL</option>
                            <option value="MEDIUM" {% if config.starterSponsorTier == 'MEDIUM' %}selected{% endif %}>MEDIUM</option>
                            <option value="LARGE"  {% if config.starterSponsorTier == 'LARGE'  %}selected{% endif %}>LARGE</option>
                        </select>
                        <div class="form-text">Sponsor company-size tier assigned at club creation. Default: SMALL</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterPlayerCount" class="form-label fw-semibold small">Players</label>
                        <input type="number" id="starterPlayerCount" name="starterPlayerCount"
                               value="{{ config.starterPlayerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Players assigned at club creation. Default: 5</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterManagerCount" class="form-label fw-semibold small">Managers</label>
                        <input type="number" id="starterManagerCount" name="starterManagerCount"
                               value="{{ config.starterManagerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Managers assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterCoachCount" class="form-label fw-semibold small">Coaches</label>
                        <input type="number" id="starterCoachCount" name="starterCoachCount"
                               value="{{ config.starterCoachCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Coaches assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterScoutCount" class="form-label fw-semibold small">Scouts</label>
                        <input type="number" id="starterScoutCount" name="starterScoutCount"
                               value="{{ config.starterScoutCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Scouts assigned at club creation. Default: 1</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterDirectorOfFootballCount" class="form-label fw-semibold small">Directors of Football</label>
                        <input type="number" id="starterDirectorOfFootballCount" name="starterDirectorOfFootballCount"
                               value="{{ config.starterDirectorOfFootballCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Directors of Football assigned at club creation. Default: 0</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterFacilityManagerCount" class="form-label fw-semibold small">Facility Managers</label>
                        <input type="number" id="starterFacilityManagerCount" name="starterFacilityManagerCount"
                               value="{{ config.starterFacilityManagerCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Facility Managers assigned at club creation. Default: 0</div>
                    </div>

                    <div class="col-md-4">
                        <label for="starterChairmanCount" class="form-label fw-semibold small">Chairmen</label>
                        <input type="number" id="starterChairmanCount" name="starterChairmanCount"
                               value="{{ config.starterChairmanCount }}"
                               min="0" class="form-control">
                        <div class="form-text">Chairmen assigned at club creation. Default: 1</div>
                    </div>


                    <div class="col-md-6">
                        <label for="starterReputationTier" class="form-label fw-semibold small">Starter Reputation Tier</label>
                        <select id="starterReputationTier" name="starterReputationTier" class="form-select">
                            <option value="local"    {% if config.starterReputationTier.value == 'local'    %}selected{% endif %}>Local</option>
                            <option value="regional" {% if config.starterReputationTier.value == 'regional' %}selected{% endif %}>Regional</option>
                            <option value="national" {% if config.starterReputationTier.value == 'national' %}selected{% endif %}>National</option>
                            <option value="elite"    {% if config.starterReputationTier.value == 'elite'    %}selected{% endif %}>Elite</option>
                        </select>
                        <div class="form-text">Club reputation band at creation. Default: Local</div>
                    </div>

                    <div class="col-md-6">
                        <label for="starterClubTier" class="form-label fw-semibold small">Starter Club Tier</label>
                        <select id="starterClubTier" name="starterClubTier" class="form-select">
                            <option value="local"      {% if config.starterClubTier == 'local'      %}selected{% endif %}>Local</option>
                            <option value="regional"   {% if config.starterClubTier == 'regional'   %}selected{% endif %}>Regional</option>
                            <option value="national"   {% if config.starterClubTier == 'national'   %}selected{% endif %}>National</option>
                            <option value="elite"      {% if config.starterClubTier == 'elite'      %}selected{% endif %}>Elite</option>
                        </select>
                        <div class="form-text">Club tier assigned at creation. Default: Local</div>
                    </div>

                    <div class="col-12" id="defaultFacilities-wrap">
                        <label for="defaultFacilities" class="form-label fw-semibold small">Default Facilities (JSON)</label>
                        <textarea id="defaultFacilities" name="defaultFacilities"
                                  class="font-monospace" rows="6">{{ config.defaultFacilitiesJson }}</textarea>
                        <div id="defaultFacilities-error" class="text-danger small mt-1">Invalid JSON — please fix before saving.</div>
                        <div class="form-text">
                            Flat slug → level map, e.g. <code>{"training_pitch": 1, "north_stand": 0}</code>.
                            Leave as <code>{}</code> for no default facilities.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-users-cog text-muted"></i>
                <span class="fw-semibold small">NPC Squad Config</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Configure squad size, staff counts, and recruitment balance for each league tier. These settings apply globally across all countries for that tier.</p>
                
                {% set allTiers = [] %}
                {% for country, tiers in dynamicLeagueTiers %}
                    {% for tier in tiers %}
                        {% if tier not in allTiers %}
                            {% set allTiers = allTiers|merge([tier]) %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                {% set allTiers = allTiers|sort %}

                <div class="row g-3">
                    {% for tier in allTiers %}
                        {% set tc = config.npcSquadConfig[tier] ?? {} %}
                        <div class="col-md-4">
                            <div class="card shadow-sm h-100 border-light">
                                <div class="card-header bg-light py-1 fw-bold small text-primary">Tier {{ tier }}</div>
                                <div class="card-body p-2">
                                    <div class="mb-2">
                                        <label class="small fw-bold mb-1">Squad Size</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">Min</span>
                                            <input type="number" name="npcConfig[{{ tier }}][playerMin]" 
                                                   class="form-control" value="{{ tc.playerMin ?? 15 }}" min="1">
                                            <span class="input-group-text">Max</span>
                                            <input type="number" name="npcConfig[{{ tier }}][playerMax]" 
                                                   class="form-control" value="{{ tc.playerMax ?? 25 }}" min="1">
                                        </div>
                                    </div>
                                    
                                    <div class="row g-1 mb-2">
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Mgr</label>
                                            <input type="number" name="npcConfig[{{ tier }}][managerCount]" 
                                                   class="form-control form-control-sm" value="{{ tc.managerCount ?? 1 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Coach</label>
                                            <input type="number" name="npcConfig[{{ tier }}][coachCount]" 
                                                   class="form-control form-control-sm" value="{{ tc.coachCount ?? 1 }}" min="0">
                                        </div>
                                        <div class="col-4">
                                            <label class="small fw-bold mb-0">Chair</label>
                                            <input type="number" name="npcConfig[{{ tier }}][chairmanCount]" 
                                                   class="form-control form-control-sm" value="{{ tc.chairmanCount ?? 1 }}" min="0">
                                        </div>
                                    </div>

                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="small fw-bold mb-0">Foreign %</label>
                                            <span class="badge bg-secondary rounded-pill" id="fp-label-{{ tier }}">{{ tc.foreignPercent ?? 0 }}%</span>
                                        </div>
                                        <input type="range" name="npcConfig[{{ tier }}][foreignPercent]" 
                                               class="form-range" min="0" max="100" 
                                               value="{{ tc.foreignPercent ?? 0 }}"
                                               oninput="document.getElementById('fp-label-{{ tier }}').innerText = this.value + '%'">
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-chart-line text-muted"></i>
                <span class="fw-semibold small">League Player Ability Ranges</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Define the min/max ability for players generated for NPC clubs in each league tier. If missing, sensible tier-based defaults are used (e.g. Tier 1: 75-95, Tier 8: 10-25).</p>
                
                {% for country, tiers in dynamicLeagueTiers %}
                    <h6 class="mt-3 small fw-bold text-uppercase text-muted">{{ country }} Leagues</h6>
                    <div class="row g-2">
                        {% for tier in tiers %}
                            <div class="col-md-3">
                                <label class="small fw-bold d-block mb-1">Tier {{ tier }}</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">Min</span>
                                    <input type="number" name="leagueRanges[{{ country }}][{{ tier }}][min]" 
                                           class="form-control" placeholder="Min" 
                                           value="{{ config.leagueAbilityRanges[country][tier]['min'] ?? '' }}"
                                           min="1" max="100">
                                    <span class="input-group-text">Max</span>
                                    <input type="number" name="leagueRanges[{{ country }}][{{ tier }}][max]" 
                                           class="form-control" placeholder="Max"
                                           value="{{ config.leagueAbilityRanges[country][tier]['max'] ?? '' }}"
                                           min="1" max="100">
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
                
                {% if dynamicLeagueTiers is empty %}
                    <div class="alert alert-info small mb-0">No leagues found in the database. Generate leagues first in NPC Clubs section.</div>
                {% endif %}
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-globe text-muted"></i>
                <span class="fw-semibold small">Country Config</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Controls which countries are available when a player creates a new club. Only enable countries with complete league and club data.</p>
                {% set allCountries = [
                    {code: 'EN', label: 'England 🏴󠁧󠁢󠁥󠁮󠁧󠁿'},
                    {code: 'IT', label: 'Italy 🇮🇹'},
                    {code: 'DE', label: 'Germany 🇩🇪'},
                    {code: 'ES', label: 'Spain 🇪🇸'},
                    {code: 'BR', label: 'Brazil 🇧🇷'},
                    {code: 'AR', label: 'Argentina 🇦🇷'},
                    {code: 'NL', label: 'Netherlands 🇳🇱'}
                ] %}
                {% for country in allCountries %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="enabledCountries[]"
                               value="{{ country.code }}"
                               id="country_{{ country.code }}"
                               {% if country.code in config.enabledCountries %}checked{% endif %}>
                        <label class="form-check-label" for="country_{{ country.code }}">
                            {{ country.label }}
                        </label>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-sm">Save Starter Config</button>
        </div>
    </form>
    </div>

</div>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsonlint/1.6.0/jsonlint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/lint.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/lint/json-lint.min.js"></script>
    <script>
    (function () {
        const ta = document.getElementById('defaultFacilities');
        const wrap = document.getElementById('defaultFacilities-wrap');
        const form = ta.closest('form');

        const editor = CodeMirror.fromTextArea(ta, {
            mode: { name: 'javascript', json: true },
            lineNumbers: true,
            lineWrapping: true,
            gutters: ['CodeMirror-lint-markers'],
            lint: true,
            theme: 'default',
        });

        function isValidJson(str) {
            try { JSON.parse(str); return true; } catch (e) { return false; }
        }

        function validate() {
            const val = editor.getValue().trim();
            if (isValidJson(val)) {
                wrap.classList.remove('cm-json-error');
            } else {
                wrap.classList.add('cm-json-error');
            }
        }

        editor.on('change', validate);
        validate();

        form.addEventListener('submit', function (e) {
            editor.save(); // sync CodeMirror back to the hidden textarea
            if (!isValidJson(editor.getValue().trim())) {
                e.preventDefault();
                wrap.classList.add('cm-json-error');
                wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    })();
    </script>
{% endblock %}
