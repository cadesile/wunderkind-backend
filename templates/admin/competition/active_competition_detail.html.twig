{% extends '@EasyAdmin/layout.html.twig' %}

{% macro status_badge(color, label) %}
    <span class="badge bg-{{ color }}-subtle text-{{ color }} border border-{{ color }}-subtle">{{ label }}</span>
{% endmacro %}

{% macro player_name(lineup, id) %}
    {%- if id is null -%}
        &mdash;
    {%- else -%}
        {%- set matches = lineup|filter(e => e.id == id) -%}
        {%- if matches|length > 0 -%}
            {{- (matches|first).name ?? id -}}
        {%- else -%}
            {{- id -}}
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

{% set competitionStatusColor = {
    registering: 'secondary',
    scheduled:   'primary',
    running:     'warning',
    completed:   'success',
    cancelled:   'danger',
} %}

{% set roundStatusColor = {
    draw_pending:      'secondary',
    drawn:              'warning',
    results_published: 'success',
    cancelled:          'danger',
} %}

{% set fixtureStatusColor = {
    pending:  'secondary',
    complete: 'success',
    bye:      'secondary',
} %}

{% block content %}
<div class="row g-4 mt-1">
    <div class="col-12 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="fw-semibold mb-0">{{ competition.template.name }}</h5>
            <p class="text-muted small mb-0">
                {{ _self.status_badge(competitionStatusColor[competition.status.value] ?? 'secondary', competition.status.value) }}
                &middot; {{ competition.entrantCapacity }} entrants &middot; {{ competition.durationOption.value }}
                {% if competition.startsAt %}&middot; starts {{ competition.startsAt|date('Y-m-d H:i') }}{% endif %}
                {% if competition.endsAt %}&middot; ends {{ competition.endsAt|date('Y-m-d H:i') }}{% endif %}
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if canGenerateSpoof %}
                <a href="{{ generateSpoofUrl }}" class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-clone"></i> Generate Spoof Entrants
                </a>
            {% endif %}
            {% if canSpoofAll %}
                <a href="{{ spoofAllUrl }}" class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-users"></i> Spoof All Entrants
                </a>
            {% endif %}
        </div>
    </div>

    {% if rounds is empty %}
        <div class="col-12">
            <p class="text-muted small">No rounds yet — this competition is still REGISTERING.</p>
        </div>
    {% endif %}

    {% for round in rounds %}
        {% set fixtures = fixturesByRoundId[round.id|ea_as_string] ?? [] %}
        <div class="col-12">
            <div class="card">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <span class="fw-semibold small">{{ round.label }}</span>
                    {{ _self.status_badge(roundStatusColor[round.status.value] ?? 'secondary', round.status.value) }}
                    {% if round.matchEngineIdentifier %}
                        <span class="badge bg-dark-subtle text-dark border border-dark-subtle">{{ round.matchEngineIdentifier.value }}</span>
                    {% endif %}
                    {% if round.status.value == 'draw_pending' %}
                        <span class="ms-auto text-muted small">draw due {{ round.scheduledAt|date('Y-m-d H:i') }}</span>
                        <form method="post" action="{{ forceDrawUrlByRoundId[round.id|ea_as_string] }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('force_draw_round') }}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="fa fa-bolt"></i> Force Draw
                            </button>
                        </form>
                    {% elseif round.status.value == 'drawn' %}
                        <span class="ms-auto text-muted small">results due {{ round.matchesResolveAt|date('Y-m-d H:i') }}</span>
                    {% else %}
                        <span class="ms-auto text-muted small">completed {{ round.completedAt|date('Y-m-d H:i') }}</span>
                    {% endif %}
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 small align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Home</th>
                                <th>Away</th>
                                <th class="text-center">Score</th>
                                <th>Status</th>
                                <th class="pe-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for fixture in fixtures %}
                                {% set result = resultsByFixtureId[fixture.id|ea_as_string] ?? null %}
                                {% set rowId = 'fixture-' ~ fixture.id %}
                                <tr>
                                    <td class="ps-3">
                                        {% if fixture.homeEntrant %}
                                            {{ fixture.homeEntrant.club.name }}
                                            <span class="text-muted">#{{ fixture.homeEntrant.seed }}</span>
                                        {% else %}
                                            <span class="text-muted">BYE</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if fixture.awayEntrant %}
                                            {{ fixture.awayEntrant.club.name }}
                                            <span class="text-muted">#{{ fixture.awayEntrant.seed }}</span>
                                        {% else %}
                                            <span class="text-muted">BYE</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center fw-semibold">
                                        {% if result %}
                                            {{ result.homeScore }} &ndash; {{ result.awayScore }}
                                            {% if result.wentToPenalties %}
                                                <br><span class="badge bg-warning text-dark fw-normal">Pens {{ result.penaltyHomeScore }}-{{ result.penaltyAwayScore }}</span>
                                            {% elseif result.wentToExtraTime %}
                                                <br><span class="badge bg-info text-dark fw-normal">AET</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ _self.status_badge(fixtureStatusColor[fixture.status.value] ?? 'secondary', fixture.status.value) }}</td>
                                    <td class="pe-3 text-end">
                                        {% if result %}
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="collapse" data-bs-target="#{{ rowId }}" aria-expanded="false">
                                                <i class="fa fa-magnifying-glass"></i> Details
                                            </button>
                                        {% elseif fixture.status.value == 'pending' and fixture.homeEntrant and fixture.awayEntrant %}
                                            <form method="post" action="{{ generateResultUrlByFixtureId[fixture.id|ea_as_string] }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('generate_fixture_result') }}">
                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-bolt"></i> Generate Result
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% if result %}
                                    {% set homeLineup = result.homeLineupJson %}
                                    {% set awayLineup = result.awayLineupJson %}
                                    <tr class="collapse" id="{{ rowId }}">
                                        <td colspan="5" class="bg-body-tertiary">
                                            <div class="p-3">
                                                <div class="d-flex gap-3 mb-2 small text-muted">
                                                    <span class="fw-semibold text-body">{{ result.homeClubJson.name ?? 'Home' }} vs {{ result.awayClubJson.name ?? 'Away' }}</span>
                                                    <span><i class="fa fa-microchip me-1"></i>{{ result.engineIdentifier.value }}</span>
                                                    <span><i class="fa fa-clock me-1"></i>{{ result.generatedAt|date('Y-m-d H:i:s') }}</span>
                                                </div>
                                                {% if result.eventLogJson is not empty %}
                                                    <table class="table table-sm mb-2">
                                                        <thead>
                                                            <tr class="text-muted small">
                                                                <th style="width:4rem;">Min</th>
                                                                <th>Type</th>
                                                                <th>Team</th>
                                                                <th>Player</th>
                                                                <th>Assist</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            {% for event in result.eventLogJson %}
                                                                {% set eventLineup = event.team == 'home' ? homeLineup : awayLineup %}
                                                                <tr>
                                                                    <td>{{ event.minute ?? '' }}'</td>
                                                                    <td>{{ event.type ?? '' }}</td>
                                                                    <td>{{ event.team ?? '' }}</td>
                                                                    <td>{{ _self.player_name(eventLineup, event.scorer ?? event.player ?? null) }}</td>
                                                                    <td>{{ event.assist is defined ? _self.player_name(eventLineup, event.assist) : '' }}</td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                {% else %}
                                                    <p class="text-muted small mb-2">No event log recorded.</p>
                                                {% endif %}
                                                {% if result.narrativePayloadPretty %}
                                                    <pre class="small bg-body p-2 mb-2">{{ result.narrativePayloadPretty }}</pre>
                                                {% endif %}

                                                <div class="row g-2 mb-2">
                                                    <div class="col-12 col-lg-6">
                                                        <div class="text-muted small fw-semibold mb-1">{{ result.homeClubJson.name ?? 'Home' }} — Starting XI</div>
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr class="text-muted small">
                                                                        <th>Player</th><th>Pos</th>
                                                                        <th class="text-center">G</th><th class="text-center">A</th>
                                                                        <th class="text-center">YC</th><th class="text-center">RC</th>
                                                                        <th class="text-center">Rating</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    {% for player in homeLineup %}
                                                                        <tr>
                                                                            <td>{{ player.name ?? player.id }}</td>
                                                                            <td>{{ player.position ?? '' }}</td>
                                                                            <td class="text-center">{{ player.goals }}</td>
                                                                            <td class="text-center">{{ player.assists }}</td>
                                                                            <td class="text-center">{{ player.yellowCards }}</td>
                                                                            <td class="text-center">{{ player.redCards }}</td>
                                                                            <td class="text-center fw-semibold">{{ player.rating }}</td>
                                                                        </tr>
                                                                    {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-lg-6">
                                                        <div class="text-muted small fw-semibold mb-1">{{ result.awayClubJson.name ?? 'Away' }} — Starting XI</div>
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr class="text-muted small">
                                                                        <th>Player</th><th>Pos</th>
                                                                        <th class="text-center">G</th><th class="text-center">A</th>
                                                                        <th class="text-center">YC</th><th class="text-center">RC</th>
                                                                        <th class="text-center">Rating</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    {% for player in awayLineup %}
                                                                        <tr>
                                                                            <td>{{ player.name ?? player.id }}</td>
                                                                            <td>{{ player.position ?? '' }}</td>
                                                                            <td class="text-center">{{ player.goals }}</td>
                                                                            <td class="text-center">{{ player.assists }}</td>
                                                                            <td class="text-center">{{ player.yellowCards }}</td>
                                                                            <td class="text-center">{{ player.redCards }}</td>
                                                                            <td class="text-center fw-semibold">{{ player.rating }}</td>
                                                                        </tr>
                                                                    {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row g-2 mt-1">
                                                    <div class="col-12 col-lg-8">
                                                        <div class="text-muted small fw-semibold mb-1">
                                                            <i class="fa fa-database me-1"></i>Full stored payload (CompetitionResult, raw)
                                                        </div>
                                                        <pre class="small bg-body p-2 mb-0" style="max-height: 320px; overflow:auto;">{{ result.fullPayloadPretty }}</pre>
                                                    </div>
                                                    <div class="col-12 col-lg-4">
                                                        <div class="text-muted small fw-semibold mb-1">
                                                            <i class="fa fa-mobile-screen me-1"></i>What the device receives
                                                        </div>
                                                        <pre class="small bg-body p-2 mb-0" style="max-height: 320px; overflow:auto;">{{ result.clientSummaryPretty }}</pre>
                                                        <p class="text-muted small mb-0 mt-1">
                                                            The event log, starting XI, ratings, engine, and timestamp
                                                            above are admin-only — the device gets the score plus each
                                                            club's display data (name, kit colours, badge, stadium)
                                                            so it can render kits and names for this result.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% else %}
                                <tr><td colspan="5" class="text-muted small p-3">No fixtures.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
