{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">
    <div class="col-12 col-lg-6">
        <h5 class="fw-semibold mb-0">Generate Spoof Entrants</h5>
        <p class="text-muted small">
            Clones the earliest registered entrant's club/players/staff into new spoof
            entrants for <strong>{{ competition }}</strong> — each clone gets a renamed club,
            renamed players/staff, and jittered attributes. Spoof clubs are tagged
            (<code>Club.isSpoof</code>) so they're easy to tell apart from real clubs later.
        </p>

        <div class="card">
            <div class="card-body">
                <form method="post" action="{{ actionUrl }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('generate_spoof_entrants') }}">

                    <div class="mb-3">
                        <label for="count" class="form-label">Number of spoof entrants</label>
                        <input type="number" class="form-control" id="count" name="count"
                               min="1" max="{{ remaining }}" value="{{ remaining }}" required>
                        <div class="form-text">
                            {{ remaining }} slot{{ remaining == 1 ? '' : 's' }} remaining before this
                            competition auto-locks.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" {{ remaining < 1 ? 'disabled' : '' }}>
                        <i class="fa fa-clone"></i> Generate
                    </button>
                    <a href="{{ detailUrl }}" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
