{% extends 'admin/bmc_page.html.twig' %}
{#
  System → Import / Export, on bmc_page + bmc-pages.css/js.
  Data: DashboardController::importExport() — languages.

  ONE PAGE FOR FIVE DOMAINS. The sidebar used to carry four separate entries all labelled
  "Import / Export" with the same icon in four different submenus, so finding a file meant
  knowing which group its domain lived in.

  EACH CARD POSTS TO ITS OWN EXISTING ROUTE, with its own CSRF token id and its own file-input
  NAME. No service or controller logic changed here, and the per-domain pages still work and
  keep their longer copy — this is the index over them, so each blurb is one line.

  WATCH THE CHECKBOX IDS. All four domains name the field clear_before_import, which is fine
  as a POST field and would be a duplicate id on one page, so each id (and its label's `for`)
  is suffixed per domain.

  CLEARING IS SPELLED OUT, NOT JUST TICKED. "Clear first" is the one control here that destroys
  data an export would have saved, so it carries a confirm rather than only a red label.
#}

{% set domains = [
    {
        key: 'world', title: 'WORLD', icon: 'earth', details: 'admin_world_content',
        blurb: 'Leagues and NPC clubs. Matched on country/tier for leagues and name/country/tier for clubs.',
        export: 'admin_world_export', import: 'admin_world_import',
        token: 'world_import', file: 'world_file',
        clear: 'Clear all leagues and clubs first',
    },
    {
        key: 'narrative', title: 'NARRATIVE', icon: 'scroll', details: 'admin_narrative_content',
        blurb: 'Event templates, facility templates, player archetypes and tactical advantages. Upserted by slug; records absent from the file are left alone.',
        export: 'admin_narrative_export', import: 'admin_narrative_import',
        token: 'narrative_import', file: 'narrative_file',
        clear: 'Clear existing narrative content first',
    },
    {
        key: 'config', title: 'CONFIG', icon: 'sliders-horizontal', details: 'admin_config_content',
        blurb: 'Game, starter and pool settings. Only keys present in the file are applied, so a partial export is safe to import.',
        export: 'admin_config_export', import: 'admin_config_import',
        token: 'config_import', file: 'config_file',
        warn: 'Importing overwrites live configuration immediately. There is no clear-first option here, and no undo — export a backup first.',
    },
    {
        key: 'quiz', title: 'SETUP QUIZ', icon: 'circle-help', details: 'admin_setup_quiz_content',
        blurb: 'Onboarding quiz questions, options and correct answers. Matched on <code class="bmc-code">id</code>, so re-importing updates rather than duplicates; a hand-written file with no ids imports as new questions.',
        export: 'admin_setup_quiz_export', import: 'admin_setup_quiz_import',
        token: 'setup_quiz_import', file: 'quiz_file',
        danger: 'Contains the answer key, and the quiz pays a credit bonus — do not commit this file publicly or share it with players.',
        dry_run: true,
    },
] %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_settings'}) }}"><span>SETTINGS</span></a>
{% endblock %}

{% block bmc_body %}

<div class="bmc-rule">
    <span class="bmc-rule__title">MOVE DATA BETWEEN ENVIRONMENTS</span>
    <span class="bmc-rule__line"></span>
    <span class="bmc-rule__meta">each domain is independent — there is no combined file</span>
</div>

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(380px,1fr))">
    {% for d in domains %}
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head">
                <i data-lucide="{{ d.icon }}"></i>
                <span class="bmc-card__title">{{ d.title }}</span>
                <a class="bmc-card__link" href="{{ path('admin', {routeName: d.details}) }}">Details →</a>
            </div>
            <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:12px;height:100%">
                <p class="bmc-bodytext">{{ d.blurb|raw }}</p>

                {% if d.warn is defined %}
                    <span class="bmc-note"><i data-lucide="triangle-alert"></i>{{ d.warn }}</span>
                {% endif %}
                {% if d.danger is defined %}
                    <div class="bmc-danger">
                        <i data-lucide="key-round"></i>
                        <div class="bmc-danger__text"><span class="bmc-data">{{ d.danger }}</span></div>
                    </div>
                {% endif %}

                <a class="bmc-btn bmc-btn--blue" href="{{ path(d.export) }}" style="align-self:flex-start"><span>DOWNLOAD JSON</span></a>

                <form method="post" action="{{ path(d.import) }}" enctype="multipart/form-data"
                      style="display:flex;flex-direction:column;gap:8px;margin-top:auto">
                    <input type="hidden" name="_token" value="{{ csrf_token(d.token) }}">

                    <label class="bmc-lbl bmc-lbl--ink" for="ie_{{ d.key }}_file">JSON FILE</label>
                    <input type="file" id="ie_{{ d.key }}_file" name="{{ d.file }}"
                           accept=".json,application/json" required class="bmc-data">

                    {% if d.clear is defined %}
                        <label class="bmc-check" style="padding-left:0">
                            <input type="checkbox" id="ie_clear_{{ d.key }}" name="clear_before_import">
                            <span class="bmc-tile"></span>
                            <span class="bmc-data ink-danger">{{ d.clear }}</span>
                        </label>
                    {% endif %}

                    {% if d.dry_run is defined %}
                        {# Dry run on by default: the hub is where somebody lands by accident, and an
                           accidental import of the wrong file should report rather than apply. The
                           Details page is where the other options live. #}
                        <label class="bmc-check" style="padding-left:0">
                            <input type="checkbox" id="ie_{{ d.key }}_dry" name="dry_run" value="1" checked>
                            <span class="bmc-tile"></span>
                            <span class="bmc-data">Dry run — report what would change, write nothing</span>
                        </label>
                    {% endif %}

                    <button type="submit" class="bmc-btn bmc-btn--orange" style="align-self:flex-start"
                            data-bmc-dialog-title="IMPORT {{ d.title }}?"
                            data-bmc-dialog-message="{{ d.clear is defined ? 'If you ticked clear-first, existing records are deleted before the file is applied. ' : '' }}This writes to the live environment."
                            data-bmc-dialog-confirm="IMPORT" data-bmc-dialog-variant="yellow"><span>IMPORT</span></button>
                </form>
            </div>
        </section>
    {% endfor %}

    {# ── translations, which need a language on both halves ──────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="languages"></i>
            <span class="bmc-card__title">TRANSLATIONS</span>
            <a class="bmc-card__link" href="{{ path('admin', {routeName: 'admin_translations_content'}) }}">Details →</a>
        </div>
        <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:12px">
            {% if languages|length == 0 %}
                <span class="bmc-note">
                    <i data-lucide="triangle-alert"></i>
                    No languages are configured yet — add one under Translations → Languages first.
                </span>
            {% else %}
                <p class="bmc-bodytext">
                    The generic UI-copy catalogue, one language at a time. Narrative text has its own
                    Translations action on each entity and is not covered here.
                </p>

                <form method="get" action="{{ path('admin_translations_export') }}"
                      style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap">
                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="ie_export_language">EXPORT LANGUAGE</label>
                        <span class="bmc-select">
                            <select id="ie_export_language" name="language" required style="min-width:190px">
                                {% for language in languages %}
                                    <option value="{{ language.code }}">{{ language.name }} ({{ language.code }})</option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>
                    <button type="submit" class="bmc-btn bmc-btn--blue"><span>DOWNLOAD JSON</span></button>
                </form>

                <form method="post" action="{{ path('admin_translations_import') }}" enctype="multipart/form-data"
                      style="display:flex;flex-direction:column;gap:8px;border-top:2px solid var(--wk-stroke);padding-top:12px">
                    <input type="hidden" name="_token" value="{{ csrf_token('translations_import') }}">

                    <div class="bmc-field-col">
                        <label class="bmc-lbl bmc-lbl--ink" for="ie_import_language">TARGET LANGUAGE</label>
                        <span class="bmc-select">
                            <select id="ie_import_language" name="language" required style="min-width:190px">
                                {% for language in languages %}
                                    <option value="{{ language.code }}">{{ language.name }} ({{ language.code }})</option>
                                {% endfor %}
                            </select>
                        </span>
                    </div>

                    <label class="bmc-lbl bmc-lbl--ink" for="ie_translations_file">JSON FILE</label>
                    <input type="file" id="ie_translations_file" name="translations_file"
                           accept=".json,application/json" required class="bmc-data">

                    <label class="bmc-check" style="padding-left:0">
                        <input type="checkbox" id="ie_clear_translations" name="clear_before_import">
                        <span class="bmc-tile"></span>
                        <span class="bmc-data ink-danger">Clear this language's values first</span>
                    </label>

                    <button type="submit" class="bmc-btn bmc-btn--orange" style="align-self:flex-start"
                            data-bmc-dialog-title="IMPORT TRANSLATIONS?"
                            data-bmc-dialog-message="If you ticked clear-first, this language's existing values are deleted before the file is applied."
                            data-bmc-dialog-confirm="IMPORT" data-bmc-dialog-variant="yellow"><span>IMPORT</span></button>
                </form>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
