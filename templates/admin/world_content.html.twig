{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">World Data — Import / Export</h5>
        <p class="text-muted small mb-0">
            Export all world data (Leagues & NPC Clubs) to a single JSON file.
            Import a file to update or create world data — this handles country/tier mappings automatically.
            Use this to sync the world structure between environments.
        </p>
    </div>

    {# ── Export ──────────────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <i class="fa fa-file-arrow-down text-primary"></i>
                <span class="fw-semibold small">Export</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Downloads a <code>.json</code> snapshot of all world data in this environment.
                </p>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Leagues (country, tier, name, prize money, promotion spots)</li>
                    <li>NPC Clubs (name, colors, stadium, balance, playing style, formation)</li>
                </ul>
                <div class="mt-auto">
                    <a href="{{ path('admin_world_export') }}" class="btn btn-primary btn-sm">
                        <i class="fa fa-download me-1"></i> Download JSON
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ── Import ──────────────────────────────────────────────────────────── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100 border-warning">
            <div class="card-header py-2 d-flex align-items-center gap-2 bg-warning-subtle">
                <i class="fa fa-file-arrow-up text-warning"></i>
                <span class="fw-semibold small">Import</span>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-muted small mb-0">
                    Upload a previously exported <code>.json</code> file.
                    Existing leagues and clubs will be updated based on their country/tier (leagues) or name/country/tier (clubs).
                    New entities will be created if they do not exist.
                </p>
                <form method="POST" action="{{ path('admin_world_import') }}" enctype="multipart/form-data" class="mt-auto">
                    <input type="hidden" name="_token" value="{{ csrf_token('world_import') }}">
                    <div class="mb-3">
                        <label for="world_file" class="form-label small fw-semibold">JSON file</label>
                        <input class="form-control form-control-sm" type="file" id="world_file"
                               name="world_file" accept=".json,application/json" required>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="clear_before_import" name="clear_before_import">
                        <label class="form-check-label small fw-semibold text-danger" for="clear_before_import">
                            Clear all existing leagues and clubs before importing
                        </label>
                    </div>
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="fa fa-upload me-1"></i> Import
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}
