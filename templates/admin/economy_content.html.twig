{% extends 'admin/bmc_page.html.twig' %}
{#
  World → Economy. Data: EconomyAdminController::index().

  THE SCREEN'S JOB IS TO MAKE TURNING THIS ON DELIBERATE. Every control ships in its "no
  change" position, so the PREVIEW is the feature — it is the only way to see what the
  `turnover` wage model would pay before committing, and it runs the real resolver rather than
  a copy of the arithmetic.

  THREE SEPARATE FORMS, ON PURPOSE. The scalar knobs and the two per-tier tables save together
  because they are only meaningful together; the country factors save separately because moving
  the baseline is a different kind of write (one UPDATE with a CASE, see the controller); and
  the inflation rate saves on its own because it writes an audit row and changes every existing
  save retroactively — it should not ride along with a typo in a turnover field.

  POUNDS IN THE TURNOVER INPUTS, PENCE IN THE COLUMN. England tier 1 is around half a billion
  pounds, and typing that in pence is how two orders of magnitude go missing unnoticed.
#}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_leagues_overview'}) }}"><span>LEAGUE OVERVIEW</span></a>
    <a class="bmc-btn bmc-btn--teal" href="{{ path('admin', {routeName: 'admin_game_config'}) }}"><span>GAME CONFIG</span></a>
{% endblock %}

{% macro money(pence) %}{{ pence is null ? '—' : '£' ~ (pence / 100)|number_format(2) }}{% endmacro %}
{% macro bp(v) %}{{ (v / 100)|number_format(2) }}%{% endmacro %}
{# PARTS PER MILLION, so the divisor is 10000 and not 100 — the league-payout ladders are
   authored in ppm because tier 8 is 4.24 basis points. Rendering one through bp() would be out
   by 100x, which is the whole reason the column headers name their unit. #}
{% macro ppm(v) %}{{ (v / 10000)|number_format(4) }}%{% endmacro %}

{% block bmc_body %}

{# ── where the switch is ──────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="activity"></i>
        <span class="bmc-card__title">STATUS</span>
        <span class="bmc-card__meta">
            {% if config.economyWageModel.value == 'legacy' %}
                <span class="ink-info">LEGACY — nothing generated so far was priced by the turnover model</span>
            {% else %}
                <span class="ink-warning">TURNOVER — LIVE</span>
            {% endif %}
        </span>
    </div>
    <div class="bmc-card__body">
        <div class="bmc-data">
            Flipping the wage model re-prices every player the world generates <em>from then on</em>, and
            <strong>cached world packs hold wages</strong>. Pack content changes without pack shape changing, which is the
            one case <code>WORLD_PACK_VERSION</code> (currently <strong>{{ worldPackVersion }}</strong>) does not catch on
            its own — bump it in the same pass or every already-cached country serves pre-flip wages forever.
            Run <code>app:economy:wage-table</code> first; it refuses on the same checks this preview warns about.
        </div>
    </div>
</section>

{# ── scalar knobs + the two per-tier tables ───────────────────────────── #}
<form method="post" action="{{ path('admin', {routeName: 'admin_economy_save'}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('economy_save') }}">
    <input type="hidden" name="preview" value="{{ previewCountry }}">

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="sliders-horizontal"></i>
            <span class="bmc-card__title">WAGE MODEL</span>
            <span class="bmc-card__meta">blank leaves a value alone</span>
        </div>
        <div class="bmc-rows">
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">MODEL</span>
                    <span class="bmc-setting__help">
                        <code>legacy</code> is wage bands x ability x a random roll — what priced every row in the world so far,
                        and a supported mode rather than dead code. <code>turnover</code> anchors each tier's scale to a share of
                        its turnover.
                    </span>
                </div>
                <div class="bmc-setting__ctl">
                    <span class="bmc-select"><select name="economyWageModel">
                        {% for m in wageModels %}
                            <option value="{{ m.value }}" {{ m == config.economyWageModel ? 'selected' : '' }}>{{ m.label }}</option>
                        {% endfor %}
                    </select></span>
                </div>
            </div>

            {% set knobs = [
                {n: 'economyWageToTurnoverRatioBp', l: 'WAGE : TURNOVER (bp)', v: config.economyWageToTurnoverRatioBp,
                 h: 'Share of a tier\'s turnover that goes on wages. 6000 = 60%.'},
                {n: 'economyStaffWageShareBp', l: 'STAFF SHARE (bp)', v: config.economyStaffWageShareBp,
                 h: 'How much of the wage budget is staff rather than players. 2500 = 25%. Capped below 10000 — at 100% every player would be free.'},
                {n: 'economyWageCurveExponentBp', l: 'CURVE EXPONENT k (bp)', v: config.economyWageCurveExponentBp,
                 h: 'Ability curve exponent. 25000 = 2.5. Basis points so the whole chain stays integer; the one float is a single pow() in the resolver.'},
                {n: 'economyReputationSpreadBp', l: 'REPUTATION SPREAD (bp)', v: config.economyReputationSpreadBp,
                 h: 'How far a club\'s reputation moves a wage either side of its tier. 0 = flat. A non-zero spread REDISTRIBUTES a tier\'s bill between its clubs rather than inflating it — the calibration is anchored at reputation 50.'},
                {n: 'economyWeeksPerSeason', l: 'WEEKS PER SEASON', v: config.economyWeeksPerSeason,
                 h: '46 — what the APP charges wages for. Deliberately not the backend\'s own 52-week financial year, so six of its weeks are unpriced by this model.'},
                {n: 'economyYouthScholarshipTier1Pence', l: 'SCHOLARSHIP AT TIER 1 (pence/wk)', v: config.economyYouthScholarshipTier1Pence,
                 h: 'What a youth scholar costs at the TOP tier, per week, in pence. 150000 = £1,500. Every lower tier is the same <em>proportion</em> of its own average first-team wage, so one figure sets the whole ladder and it follows the turnover table rather than being authored twice. <strong>0 = off</strong>, and the flat Game Config figure plus its cap stands. Inert under the legacy model.'},
                {n: 'economyYouthScholarshipFloorPence', l: 'SCHOLARSHIP FLOOR (pence/wk)', v: config.economyYouthScholarshipFloorPence,
                 h: 'The least a scholar can cost per week, in pence. 2500 = £25. <strong>Needed, not optional:</strong> a pure proportion reaches £5.05 at tier 7 and £1.43 at tier 8, and free is a different mechanic from cheap. Only reachable when a tier-1 anchor is set. The cap below is still applied last, so a floor above a tier\'s cap is clamped down rather than breaking the invariant.'},
                {n: 'economyYouthScholarshipCapBp', l: 'SCHOLARSHIP CAP (bp)', v: config.economyYouthScholarshipCapBp,
                 h: 'A youth scholarship may not exceed this share of the tier\'s <strong>AVERAGE</strong> first-team wage. 5000 = 50%. This is the one invariant the mechanism promises — a scholar never out-earns an average professional at their tier — so it is applied last and always wins. <strong>0 = no cap.</strong> Inert under the legacy model: there is no band wage to cap against. (Anchored to the average, not the cheapest professional: England tier 8\'s cheapest earns £12.84/wk, so half of that is £6.42 and the old rule produced a free scholar rather than a cheap one.)'},
            ] %}

            {% for k in knobs %}
                <div class="bmc-setting" data-bmc-setting>
                    <div class="bmc-setting__text">
                        <span class="bmc-setting__label">{{ k.l }}</span>
                        <span class="bmc-setting__help">{{ k.h }}</span>
                    </div>
                    <div class="bmc-setting__ctl">
                        <label class="bmc-num bmc-num--104">
                            <input name="{{ k.n }}" value="{{ k.v }}" data-saved="{{ k.v }}" data-kind="int"
                                   data-blank="ok" inputmode="numeric" aria-label="{{ k.l|lower }}">
                        </label>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="table"></i>
            <span class="bmc-card__title">PER-TIER TABLES</span>
            <span class="bmc-card__meta">tier t reads row t — no stretching for a shallow pyramid</span>
        </div>
        <div class="bmc-card__body">
            <div class="bmc-data" style="margin-bottom:10px">
                <strong>Baseline turnover ships as zeros, which is not a usable configuration and deliberately not a harmless one.</strong>
                The wage scale divides by turnover, so zero makes the turnover model <em>undefined</em> rather than cheap and the
                resolver refuses it — which is what keeps the model unreachable until somebody authors these.
                Figures are <strong>base-year</strong> for the baseline country; the app applies inflation.
            </div>
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">TIER-1 TICKET BASE (£)</span>
                    <span class="bmc-setting__help">
                        The one figure the whole ticket ladder hangs off. Blank or 0 = unauthored, and
                        <strong>0 propagates</strong>: every division publishes 0 whatever the ratios say, so the app keeps
                        using its own 2500p constant. Base-year pounds for the baseline country.
                    </span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--fill" style="min-width:150px">
                        <span class="bmc-num__unit">£</span>
                        <input name="ticketPriceTier1Pounds" inputmode="decimal" data-kind="money"
                               value="{{ config.economyTicketPriceTier1Pence > 0
                                         ? (config.economyTicketPriceTier1Pence / 100)|number_format(2, '.', '')
                                         : '' }}"
                               placeholder="unauthored"
                               aria-label="tier 1 base ticket price pounds">
                    </label>
                </div>
            </div>
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">TIER-1 CHAMPION PRIZE (£)</span>
                    <span class="bmc-setting__help">
                        Paid <strong>whole, to the champion only</strong>. The base the prize ladder hangs off: a
                        division with no figure of its own is paid this times its tier's PRIZE RATIO times the
                        country factor. Blank or 0 = unauthored, and <strong>0 propagates</strong> — every division
                        falls back to its own stored column. Base-year pounds for the baseline country.
                    </span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--fill" style="min-width:150px">
                        <span class="bmc-num__unit">£</span>
                        <input name="leaguePrizeTier1Pounds" inputmode="decimal" data-kind="money"
                               value="{{ config.economyLeaguePrizeTier1Pence > 0
                                         ? (config.economyLeaguePrizeTier1Pence / 100)|number_format(2, '.', '')
                                         : '' }}"
                               placeholder="unauthored"
                               aria-label="tier 1 base champion prize pounds">
                    </label>
                </div>
            </div>
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">TIER-1 POSITION POT (£)</span>
                    <span class="bmc-setting__help">
                        ⚠️ This is the <strong>first-place amount, not the division's bill</strong>. Each club is paid
                        this tapered by its finishing position, so at the configured taper the division pays out
                        <strong>several times</strong> what is typed here — RESOLVED LEAGUE PAYOUTS below shows the
                        real total per tier. Blank or 0 = unauthored and propagates, as above.
                    </span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--fill" style="min-width:150px">
                        <span class="bmc-num__unit">£</span>
                        <input name="leaguePositionPotTier1Pounds" inputmode="decimal" data-kind="money"
                               value="{{ config.economyLeaguePositionPotTier1Pence > 0
                                         ? (config.economyLeaguePositionPotTier1Pence / 100)|number_format(2, '.', '')
                                         : '' }}"
                               placeholder="unauthored"
                               aria-label="tier 1 base position pot pounds">
                    </label>
                </div>
            </div>

            <div style="overflow-x:auto">
                <table class="bmc-minitable" style="min-width:860px">
                    <thead><tr>
                        <th>TIER</th>
                        <th class="is-right">TIER FACTOR (bp)</th>
                        <th class="is-right">BASELINE TURNOVER (£)</th>
                        <th class="is-right">SPONSOR RATIO (bp)</th>
                        <th class="is-right">TICKET RATIO (bp)</th>
                        <th class="is-right">PRIZE RATIO (ppm)</th>
                        <th class="is-right">POSITION RATIO (ppm)</th>
                    </tr>
                    <tr>
                        <th colspan="7" style="font-weight:400">
                            <span class="bmc-data">Tier 1 is the base for every ratio column, so its own ratio is parity by construction. <strong>Two different units:</strong> the sponsor and ticket columns are basis points, where 10000 = parity; the prize and position columns are <strong>parts per million</strong>, where 1000000 = parity, because a tier-8 prize ratio of 424 ppm is 4.24 bp and integer basis points cannot hold it. Resolved figures are in RESOLVED SPONSOR &amp; TICKET and RESOLVED LEAGUE PAYOUTS below.</span>
                        </th>
                    </tr></thead>
                    <tbody>
                        {% for i in 0..7 %}
                            <tr>
                                <td>T{{ i + 1 }}</td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="tierFactorsBp[{{ i }}]" inputmode="numeric" data-kind="int"
                                               value="{{ config.economyTierFactorsBp[i]|default(10000) }}"
                                               aria-label="tier {{ i + 1 }} factor basis points">
                                    </label>
                                </td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--fill" style="min-width:150px">
                                        <span class="bmc-num__unit">£</span>
                                        <input name="baselineTurnoverPounds[{{ i }}]" inputmode="decimal" data-kind="money"
                                               value="{{ config.economyBaselineTurnoverPence[i]|default(0) > 0
                                                         ? (config.economyBaselineTurnoverPence[i] / 100)|number_format(0, '.', '')
                                                         : '' }}"
                                               placeholder="unauthored"
                                               aria-label="tier {{ i + 1 }} baseline turnover pounds">
                                    </label>
                                </td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="sponsorTierRatioBp[{{ i }}]" inputmode="numeric" data-kind="int"
                                               value="{{ config.economySponsorTierRatioBp[i]|default(10000) }}"
                                               placeholder="10000"
                                               aria-label="tier {{ i + 1 }} sponsor ratio basis points">
                                    </label>
                                </td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="ticketPriceTierRatioBp[{{ i }}]" inputmode="numeric" data-kind="int"
                                               value="{{ config.economyTicketPriceTierRatioBp[i]|default(10000) }}"
                                               placeholder="10000"
                                               aria-label="tier {{ i + 1 }} ticket ratio basis points">
                                    </label>
                                </td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="prizeTierRatioPpm[{{ i }}]" inputmode="numeric" data-kind="int"
                                               value="{{ config.economyPrizeTierRatioPpm[i]|default(1000000) }}"
                                               placeholder="1000000"
                                               aria-label="tier {{ i + 1 }} prize ratio parts per million">
                                    </label>
                                </td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="positionPotTierRatioPpm[{{ i }}]" inputmode="numeric" data-kind="int"
                                               value="{{ config.economyPositionPotTierRatioPpm[i]|default(1000000) }}"
                                               placeholder="1000000"
                                               aria-label="tier {{ i + 1 }} position pot ratio parts per million">
                                    </label>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="hand-coins"></i>
            <span class="bmc-card__title">OWNER SEASON INVESTMENT</span>
            <span class="bmc-card__meta">
                {% if config.economySeasonInvestmentBasePence > 0 %}
                    <span class="ink-warning">LIVE</span>
                {% else %}
                    <span class="ink-info">OFF — every request is refused</span>
                {% endif %}
            </span>
        </div>
        <div class="bmc-rows">
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">BASE CEILING (£)</span>
                    <span class="bmc-setting__help">
                        The most an owner may gift into one <strong>tier 1</strong> club per season (baseline country, base year).
                        Each tier gets the share of it set in the table below; a blank row follows its baseline turnover share of tier 1. The resolved ceiling is
                        <code>base x countryFactor x tierShare x inflationIndex(season)</code> — the one place the backend applies
                        inflation itself, because a ceiling has to be checked against the season being claimed for.
                        While the turnover table is unauthored, a blank row uses the tier factor column instead.
                        <strong>0 switches the feature off</strong>: every amount is then above the ceiling and
                        <code>POST /api/club/season-investment</code> refuses, which is how its two new error codes ship
                        unreachable by a client that does not understand them yet.
                    </span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--fill" style="min-width:150px">
                        <span class="bmc-num__unit">£</span>
                        <input name="seasonInvestmentBasePounds" inputmode="decimal" data-kind="money" data-blank="ok"
                               value="{{ config.economySeasonInvestmentBasePence > 0
                                        ? (config.economySeasonInvestmentBasePence / 100)|number_format(0, '.', '')
                                        : '' }}"
                               placeholder="off"
                               aria-label="season investment base ceiling pounds">
                    </label>
                </div>
            </div>
            <div style="overflow-x:auto">
                <table class="bmc-minitable" style="min-width:640px">
                    <thead><tr>
                        <th>TIER</th>
                        <th class="is-right">OWNER INVESTMENT SHARE (% OF TIER 1)</th>
                        <th class="is-right">TURNOVER SHARE</th>
                        <th class="is-right">CEILING ({{ previewCountry }}, SEASON 1)</th>
                    </tr>
                    <tr>
                        <th colspan="4" style="font-weight:400">
                            <span class="bmc-data">The owner investment curve, separate from the turnover table so it can be tuned on its own.
                            Each tier's ceiling is <code>base x this share</code> (then country and inflation). <strong>Blank follows turnover</strong>:
                            the row uses the turnover share shown beside it (the placeholder), which is how every tier behaved before.
                            Decimals are fine (2.5 = 2.5%); anything above 100 is capped at 100, because the base is the tier 1 maximum.
                            Tier rows are raw: a 4-tier country's bottom division reads T4.</span>
                        </th>
                    </tr></thead>
                    <tbody>
                        {% set turnover = config.economyBaselineTurnoverPence %}
                        {% set shares = config.economySeasonInvestmentTierSharePpm %}
                        {% for i in 0..7 %}
                            {% if turnover[0]|default(0) > 0 and turnover[i]|default(0) > 0 %}
                                {% set turnoverPct = (min(turnover[i], turnover[0]) / turnover[0]) * 100 %}
                            {% else %}
                                {% set turnoverPct = config.economyTierFactorsBp[i]|default(10000) / 100 %}
                            {% endif %}
                            {% set ceiling = null %}
                            {% for row in investmentCeilings %}
                                {% if row.tier == i + 1 %}{% set ceiling = row %}{% endif %}
                            {% endfor %}
                            <tr>
                                <td>T{{ i + 1 }}</td>
                                <td class="is-right">
                                    <label class="bmc-num bmc-num--104">
                                        <input name="seasonInvestmentTierSharePct[{{ i }}]" inputmode="decimal" data-kind="decimal" data-blank="ok" data-min="0" data-max="100"
                                               value="{{ shares[i] is not null ? (shares[i] / 10000)|round(4) : '' }}"
                                               placeholder="{{ turnoverPct|round(4) }}"
                                               aria-label="tier {{ i + 1 }} owner investment share percent of tier 1">
                                        <span class="bmc-num__unit">%</span>
                                    </label>
                                </td>
                                <td class="is-right">{{ turnoverPct|number_format(2) }}%</td>
                                <td class="is-right">
                                    {% if ceiling is null %}
                                        &mdash;
                                    {% elseif config.economySeasonInvestmentBasePence <= 0 %}
                                        off
                                    {% else %}
                                        £{{ (ceiling.ceilingPence / 100)|number_format(0) }}
                                        <span class="bmc-data">({{ (ceiling.sharePpm / 10000)|number_format(2) }}%{{ ceiling.isCustom ? '' : ', turnover' }})</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="parachute"></i>
            <span class="bmc-card__title">GLOBAL PARACHUTE</span>
            <span class="bmc-card__meta">used by any league with no override</span>
        </div>
        <div class="bmc-card__body">
            <div class="bmc-field-col">
                <label for="leagueParachute">Parachute (JSON)</label>
                <textarea id="leagueParachute" name="leagueParachute" rows="4" data-kind="text" data-blank="ok"
                          placeholder='{"seasons":3,"perSeasonPence":[7202985402,4801990268,2400995134]}'>{{ config.leagueParachute is null ? '' : config.leagueParachute|json_encode }}</textarea>
                <div class="bmc-data">
                    Served <strong>verbatim</strong> — the backend stores and publishes this without reading inside it, so the app
                    owns the shape. Resolution is <code>league ?? this</code>, <strong>whole-value</strong>: a league override
                    replaces this entirely rather than merging with it. Money in <strong>base-year pence</strong>.
                    Blank clears it; malformed JSON is ignored and leaves the stored value alone.
                    <br><strong>You probably do not need this.</strong> The live scheme is authored <em>per tier</em> on the
                    league tier defaults, because a parachute is sized against the division a club drops into &mdash; one global
                    figure cannot be right for both tier 2 and tier 8. The placeholder shows the authored <strong>tier&nbsp;2</strong>
                    schedule (60/40/20% of that tier's turnover) so the magnitude is real; this field is the fallback for a league
                    whose tier has no default.
                </div>
            </div>
        </div>
        <div class="bmc-card__band">
            <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE ECONOMY SETTINGS</span></button>
        </div>
    </section>
</form>

{# ── per-country factors + the baseline ───────────────────────────────── #}
<form method="post" action="{{ path('admin', {routeName: 'admin_economy_countries'}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('economy_countries') }}">
    <input type="hidden" name="preview" value="{{ previewCountry }}">

    <section class="bmc-card" data-domain="location">
        <div class="bmc-card__head">
            <i data-lucide="globe"></i>
            <span class="bmc-card__title">COUNTRY FACTORS</span>
            <span class="bmc-card__meta">
                baseline:
                {% if baseline %}<span class="ink-accent">{{ countryLabels[baseline.code]|default(baseline.code) }}</span>
                {% else %}<span class="ink-warning">NONE — every country resolves at parity</span>{% endif %}
            </span>
        </div>
        <div class="bmc-card__body">
            <div class="bmc-data" style="margin-bottom:10px">
                A factor is a <strong>percentage of the baseline</strong>, normalised against the baseline row's own value — so
                setting the baseline to 12000 does not shift every other country as a side effect, and the baseline is always
                exactly parity with itself. <strong>Exactly one baseline</strong> is enforced by a partial unique index, not by this
                form: two baselines would make the whole chain ambiguous, with "slightly wrong money everywhere" as the only symptom.
            </div>
            {% if profiles is empty %}
                <span class="bmc-empty-note">NO COUNTRY PROFILES YET</span>
            {% else %}
                <div style="overflow-x:auto">
                    <table class="bmc-minitable" style="min-width:520px">
                        <thead><tr>
                            <th>COUNTRY</th><th>TIERS</th>
                            <th class="is-right">FACTOR (bp)</th>
                            <th class="is-right">OF BASELINE</th>
                            <th class="is-right">BASELINE</th>
                        </tr></thead>
                        <tbody>
                            {% for p in profiles %}
                                <tr>
                                    <td>{{ countryLabels[p.code]|default(p.code) }} <span class="bmc-data">{{ p.code }}</span></td>
                                    <td>{{ p.leagueTierCount }}</td>
                                    <td class="is-right">
                                        <label class="bmc-num bmc-num--104">
                                            <input name="factorBp[{{ p.code }}]" inputmode="numeric" data-kind="int"
                                                   value="{{ p.economyFactorBp }}" aria-label="{{ p.code }} factor basis points">
                                        </label>
                                    </td>
                                    <td class="is-right">
                                        {% if baseline and baseline.economyFactorBp > 0 %}
                                            {{ _self.bp((p.economyFactorBp * 10000) // baseline.economyFactorBp) }}
                                        {% else %}
                                            <span class="bmc-data">100.00%</span>
                                        {% endif %}
                                    </td>
                                    <td class="is-right">
                                        <input type="radio" name="baselineCountry" value="{{ p.code }}"
                                               {{ p.isEconomyBaseline ? 'checked' : '' }}
                                               aria-label="make {{ p.code }} the baseline">
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        <div class="bmc-card__band">
            <button type="submit" class="bmc-btn bmc-btn--yellow"><span>SAVE COUNTRY FACTORS</span></button>
        </div>
    </section>
</form>

{# ── inflation ────────────────────────────────────────────────────────── #}
<form method="post" action="{{ path('admin', {routeName: 'admin_economy_inflation'}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('economy_inflation') }}">
    <input type="hidden" name="preview" value="{{ previewCountry }}">

    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="trending-up"></i>
            <span class="bmc-card__title">INFLATION</span>
            <span class="bmc-card__meta">{{ config.inflationRatePerSeasonBp }} bp per season</span>
        </div>
        <div class="bmc-card__body">
            <div class="bmc-data" style="margin-bottom:10px">
                <strong>The backend holds the rate and nothing else.</strong> It is never applied to a generated row, a stored
                value or a world pack — every money figure published is base-year and the app compounds the index itself.
                <strong>Changing it moves every existing save's derived prices retroactively</strong>, which is why each change is
                recorded below. Deflation is not supported: a negative rate would make a long save's ceiling approach zero,
                so the owner who played longest could invest least.
                <br>At the current rate, season 10 multiplies by <strong>{{ _self.bp(preview.indexAt10) }}</strong>
                and season 25 by <strong>{{ _self.bp(preview.indexAt25) }}</strong>.
            </div>
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">RATE (bp / season)</span>
                    <span class="bmc-setting__help">0 = no inflation. 250 = 2.5% a season, compounded.</span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--104">
                        <input name="inflationRatePerSeasonBp" value="{{ config.inflationRatePerSeasonBp }}"
                               data-kind="int" inputmode="numeric" aria-label="inflation rate basis points">
                    </label>
                </div>
            </div>
            <div class="bmc-setting" data-bmc-setting>
                <div class="bmc-setting__text">
                    <span class="bmc-setting__label">NOTE</span>
                    <span class="bmc-setting__help">Why, in your own words. The one field a later reader actually wants.</span>
                </div>
                <div class="bmc-setting__ctl">
                    <label class="bmc-num bmc-num--fill" style="min-width:260px">
                        <input name="note" maxlength="255" placeholder="optional" aria-label="change note">
                    </label>
                </div>
            </div>
        </div>
        <div class="bmc-card__band">
            <button type="submit" class="bmc-btn bmc-btn--orange"><span>SET RATE &amp; RECORD</span></button>
        </div>
    </section>
</form>

{% if history is not empty %}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="history"></i>
            <span class="bmc-card__title">RATE HISTORY</span>
            <span class="bmc-card__meta">append-only · nothing computes from it</span>
        </div>
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:560px">
                <thead><tr><th>WHEN (UTC)</th><th class="is-right">FROM</th><th class="is-right">TO</th><th>BY</th><th>NOTE</th></tr></thead>
                <tbody>
                    {% for h in history %}
                        <tr>
                            <td>{{ h.recordedAt|date('Y-m-d H:i') }}</td>
                            <td class="is-right">{{ h.previousRatePerSeasonBp is null ? '—' : h.previousRatePerSeasonBp ~ ' bp' }}</td>
                            <td class="is-right">{{ h.ratePerSeasonBp }} bp</td>
                            <td>{{ h.changedBy ? h.changedBy.email : '—' }}</td>
                            <td>{{ h.note ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endif %}

{# ── the resolved revenue tables ──────────────────────────────────────── #}
{#
  READ-ONLY, AND THE PROVENANCE IS THE FEATURE. A sponsor band can come from three places and
  two of them look identical in the output — a parity ratio and no ratio give the same figure —
  so the resolved number alone cannot tell an operator which table to edit. The SOURCE column
  answers that, and it comes from the controller rather than being inferred from the number.
#}
<section class="bmc-card" data-domain="location" id="revenue">
    <div class="bmc-card__head">
        <i data-lucide="receipt"></i>
        <span class="bmc-card__title">RESOLVED SPONSOR &amp; TICKET — {{ countryLabels[previewCountry]|default(previewCountry) }}</span>
        <span class="bmc-card__meta">{{ revenue.tierCount }} tier(s) · the real resolvers, not a copy</span>
    </div>
    <div class="bmc-card__body">
        <div class="bmc-data" style="margin-bottom:10px">
            <strong>Resolution order, per tier:</strong> the explicit per-tier row (an override, used verbatim), then the
            flat column × this tier's ratio, then the flat column alone. The country factor applies once, last, to
            whichever won — these figures are therefore <strong>resolved and country-scaled</strong>, which is exactly what
            the app receives, and the app applies no factor of its own.
            <br>A published ticket price above 0 is the <strong>advised</strong> price the app's elasticity measures a club
            against, so publishing one cannot make a club mispriced.
        </div>

        {% if revenue.warnings is not empty %}
            <div class="bmc-data" style="margin-bottom:10px">
                {% for w in revenue.warnings %}
                    <div class="ink-warning">⚠ {{ w }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:1080px">
                <thead><tr>
                    <th>T</th>
                    <th class="is-right">SPONSOR RATIO</th>
                    <th class="is-right">SMALL</th>
                    <th class="is-right">MEDIUM</th>
                    <th class="is-right">LARGE</th>
                    <th>SOURCE</th>
                    <th class="is-right">TICKET RATIO</th>
                    <th class="is-right">TICKET</th>
                    <th>SOURCE</th>
                </tr></thead>
                <tbody>
                    {% for r in revenue.rows %}
                        <tr>
                            <td>T{{ r.tier }}</td>
                            <td class="is-right">{{ _self.bp(r.sponsorRatioBp) }}</td>
                            {% for size in ['small', 'medium', 'large'] %}
                                <td class="is-right{{ r.sizes[size].max <= 0 ? ' ink-warning' : '' }}">
                                    {{ _self.money(r.sizes[size].min) }}–{{ _self.money(r.sizes[size].max) }}
                                </td>
                            {% endfor %}
                            <td>{{ r.sizes.large.source }}</td>
                            <td class="is-right">{{ _self.bp(r.ticketRatioBp) }}</td>
                            <td class="is-right{{ r.ticketPence <= 0 ? ' ink-warning' : '' }}">
                                {{ r.ticketPence > 0 ? _self.money(r.ticketPence) : 'UNAUTHORED' }}
                            </td>
                            <td>{{ r.ticketSource }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-data" style="margin-top:10px">
            <code>override</code> = this tier has an explicit authored row, used verbatim and <strong>not</strong> scaled by
            the ratio. <code>ratio</code> = the base × this tier's ratio. <code>flat</code> = the flat column, unscaled
            (what every tier resolved to before the ratio table existed). <code>unauthored</code> = no figure at all; the
            app uses its own. The SOURCE column shows the <code>large</code> band's source, which is the row's source —
            a tier is authored all three sizes or none.
        </div>
    </div>
</section>

{# ── the resolved league payouts ───────────────────────────────────────── #}
{#
  THE LEAGUE TOTAL IS WHY THIS CARD EXISTS. Both authored figures are PER CLUB, and the position
  pot is the first-place amount rather than a pool, so the money the division actually hands out
  is invisible on the authoring grid above. That is how a tier-8 pot of £2,000,000 came to cost
  £11,000,000 a year against £2,967,328 of combined authored turnover. The TOTAL and SHARE
  columns are that arithmetic, run once, where the figures causing it are edited.
#}
<section class="bmc-card" data-domain="location" id="payouts">
    <div class="bmc-card__head">
        <i data-lucide="trophy"></i>
        <span class="bmc-card__title">RESOLVED LEAGUE PAYOUTS — {{ countryLabels[previewCountry]|default(previewCountry) }}</span>
        <span class="bmc-card__meta">{{ payouts.tierCount }} tier(s) · the real resolver, not a copy</span>
    </div>
    <div class="bmc-card__body">
        <div class="bmc-data" style="margin-bottom:10px">
            <strong>Resolution order, per tier:</strong> the league's own column when it is set (an override, used
            verbatim and <strong>not</strong> scaled), then the tier-1 base × this tier's ratio. The country factor
            applies once, last, so these figures are <strong>resolved and country-scaled</strong> — what the app
            receives, with no factor of its own to apply.
            <br><strong>PRIZE goes whole to the champion.</strong> POSITION is the first-place amount; each lower
            placing is tapered by the decrease percent, so the division's bill is POSITION × the taper sum, which is
            the ×POT column. TOTAL is TV pool + position bill + prize. SHARE is TOTAL against the tier's combined
            authored turnover across its own club count.
        </div>

        {% if payouts.warnings is not empty %}
            <div class="bmc-data" style="margin-bottom:10px">
                {% for w in payouts.warnings %}
                    <div class="ink-warning">⚠ {{ w }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:1240px">
                <thead><tr>
                    <th>T</th>
                    <th class="is-right">PRIZE RATIO</th>
                    <th class="is-right">PRIZE</th>
                    <th>SOURCE</th>
                    <th class="is-right">POSITION RATIO</th>
                    <th class="is-right">POSITION (1st)</th>
                    <th>SOURCE</th>
                    <th class="is-right">CLUBS</th>
                    <th class="is-right">TAPER</th>
                    <th class="is-right">×POT</th>
                    <th class="is-right">TOTAL</th>
                    <th class="is-right">SHARE</th>
                    <th class="is-right">CHAMPION</th>
                </tr></thead>
                <tbody>
                    {% for r in payouts.rows %}
                        <tr>
                            <td>T{{ r.tier }}</td>
                            <td class="is-right">{{ _self.ppm(r.prizeRatioPpm) }}</td>
                            <td class="is-right{{ r.prizePence is null ? ' ink-warning' : '' }}">
                                {{ r.prizePence is null ? 'UNAUTHORED' : _self.money(r.prizePence) }}
                            </td>
                            <td>{{ r.prizeSource }}</td>
                            <td class="is-right">{{ _self.ppm(r.potRatioPpm) }}</td>
                            <td class="is-right{{ r.potPence is null ? ' ink-warning' : '' }}">
                                {{ r.potPence is null ? 'UNAUTHORED' : _self.money(r.potPence) }}
                            </td>
                            <td>{{ r.potSource }}</td>
                            <td class="is-right{{ r.clubs <= 0 ? ' ink-warning' : '' }}">{{ r.clubs }}</td>
                            <td class="is-right">{{ r.decreasePercent }}%</td>
                            <td class="is-right">{{ (r.taperSumPpm / 1000000)|number_format(2) }}×</td>
                            <td class="is-right">{{ _self.money(r.leagueTotalPence) }}</td>
                            <td class="is-right{{ r.shareOfTurnoverPct is not null and r.shareOfTurnoverPct > 100 ? ' ink-warning' : '' }}">
                                {{ r.shareOfTurnoverPct is null ? '—' : r.shareOfTurnoverPct|number_format(1) ~ '%' }}
                            </td>
                            <td class="is-right{{ r.championSharePct is not null and r.championSharePct > 100 ? ' ink-warning' : '' }}">
                                {{ r.championSharePct is null ? '—' : r.championSharePct|number_format(1) ~ '%' }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-data" style="margin-top:10px">
            <code>override</code> = this league has its own stored figure, used verbatim and <strong>not</strong> scaled
            by the ratio or the country factor. <code>ratio</code> = the tier-1 base × this tier's ratio.
            <code>unauthored</code> = no base authored, so the league's own column is all there is.
            <br><strong>TAPER</strong> is the decrease percent per finishing position and <strong>×POT</strong> is the
            resulting sum of multipliers — the number the first-place amount is multiplied by to get the division's
            bill. Both come off this country's own league rows, never assumed: <code>slots</code> is 10 in KR, 14 in BE,
            18 in EN and 20 in FR, and the decrease has a per-league override.
            <br><strong>CHAMPION</strong> is prize + first-place position against that tier's own authored turnover —
            what one club can bank for winning, which is the figure the economy gate bounds at 100%.
            <br>A <code>—</code> in SHARE or CHAMPION means the tier has no authored turnover to measure against, not a
            share of zero.
        </div>
    </div>
</section>

{# ── the preview ──────────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="location" id="preview">
    <div class="bmc-card__head">
        <i data-lucide="search-check"></i>
        <span class="bmc-card__title">RESOLVER PREVIEW — {{ countryLabels[previewCountry]|default(previewCountry) }}</span>
        <span class="bmc-card__meta">{{ preview.tierCount }} tier(s) · the real resolver, not a copy</span>
    </div>
    <div class="bmc-card__body">
        <form method="get" action="{{ path('admin') }}" style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
            <input type="hidden" name="routeName" value="admin_economy">
            <span class="bmc-select"><select name="preview">
                {% for p in profiles %}
                    <option value="{{ p.code }}" {{ p.code == previewCountry ? 'selected' : '' }}>
                        {{ countryLabels[p.code]|default(p.code) }}
                    </option>
                {% endfor %}
            </select></span>
            <button type="submit" class="bmc-btn bmc-btn--blue"><span>PREVIEW</span></button>
        </form>

        {% if preview.warnings is not empty %}
            <div class="bmc-data" style="margin-bottom:10px">
                {% for w in preview.warnings %}
                    <div class="ink-warning">⚠ {{ w }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:1080px">
                <thead><tr>
                    <th>T</th>
                    <th class="is-right">COUNTRY</th>
                    <th class="is-right">TIER</th>
                    <th class="is-right">COMBINED</th>
                    <th class="is-right">TURNOVER</th>
                    <th class="is-right">S_tier (p)</th>
                    <th>BAND</th>
                    <th class="is-right">SQUAD</th>
                    <th class="is-right">MIN /wk</th>
                    <th class="is-right">MID /wk</th>
                    <th class="is-right">MAX /wk</th>
                    <th class="is-right">TV/CLUB</th>
                    <th class="is-right">TV % T/O</th>
                </tr></thead>
                <tbody>
                    {% for r in preview.rows %}
                        <tr>
                            <td>T{{ r.tier }}</td>
                            <td class="is-right">{{ _self.bp(r.countryFactorBp) }}</td>
                            <td class="is-right">{{ _self.bp(r.tierFactorBp) }}</td>
                            <td class="is-right">{{ _self.bp(r.combinedBp) }}</td>
                            <td class="is-right">{{ _self.money(r.turnoverPence) }}</td>
                            {% if r.resolvable %}
                                <td class="is-right">{{ (r.scaleMicroPence / wageScaleUnit)|number_format(4) }}</td>
                                <td>{{ r.band.min }}-{{ r.band.max }}</td>
                                <td class="is-right">{{ r.squad }}</td>
                                <td class="is-right">{{ _self.money(r.wageMin) }}</td>
                                <td class="is-right">{{ _self.money(r.wageMid) }}</td>
                                <td class="is-right">{{ _self.money(r.wageMax) }}</td>
                            {% else %}
                                <td class="is-right ink-warning">UNAUTHORED</td>
                                <td>{{ r.band.min }}-{{ r.band.max }}</td>
                                <td class="is-right">{{ r.squad }}</td>
                                <td class="is-right" colspan="3"><span class="bmc-data">no turnover authored for this tier</span></td>
                            {% endif %}
                            <td class="is-right">{{ _self.money(r.tvPerClubPence) }}</td>
                            <td class="is-right{{ r.tvSharePct is not null and r.tvSharePct > 100 ? ' ink-danger' : '' }}">
                                {{ r.tvSharePct is null ? '—' : (r.tvSharePct|number_format(1) ~ '%') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="bmc-data" style="margin-top:10px">
            Wages are shown at <strong>reputation 50</strong>, the calibration anchor where the modifier is exactly 1.0.
            <code>S_tier</code> is pence per unit of <code>ability^k</code> and should decrease strictly down the table.
            Everything here is <strong>base-year</strong>.
        </div>
    </div>
</section>

{% endblock %}
