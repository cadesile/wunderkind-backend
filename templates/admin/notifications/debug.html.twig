{% extends 'admin/bmc_page.html.twig' %}
{#
  System → Debug tools, on bmc_page + bmc-pages.css/js.
  Data: NotificationDebugController::index() — clubs, triggerTypes, deviceCount, recentDevices,
  recentLogs.

  NO CONFIRMS HERE, DELIBERATELY. Nothing on this page deletes: it validates a connection,
  drains a queue that would drain itself a minute later, and sends a push marked [TEST]. A
  dialog in front of each would be noise, and the pages that do delete are a click away under
  Settings & tools.

  THE TRIGGER FORM REWRITES ITS OWN ACTION, and that is not avoidable. {club} is a
  Doctrine-typed route parameter baked into the PATH, so Twig cannot interpolate a client-side
  <select> into path() — the placeholder is swapped for the chosen id on submit. Kept verbatim
  from the old page; only the selector it binds to changed.
#}

{% set tools = [
    {
        title: 'VALIDATE FIREBASE CONNECTION', icon: 'plug',
        route: 'admin_notification_validate_firebase', token: 'notification_validate_firebase',
        button: 'VALIDATE',
        body: 'Checks whether <code class="bmc-code">FIREBASE_SERVICE_ACCOUNT_JSON</code> is present and well-formed, then makes a validate-only send to confirm Google actually accepts the credentials. No real push is sent.',
    },
    {
        title: 'FORCE PROCESS QUEUE', icon: 'fast-forward',
        route: 'admin_notification_force_process_queue', token: 'notification_force_process_queue',
        button: 'PROCESS NOW',
        body: 'Runs <code class="bmc-code">messenger:consume async</code> immediately, capped at 20 seconds or 200 messages, instead of waiting up to a minute for the cron.',
    },
] %}

{% block bmc_strip_right %}
    <a class="bmc-btn bmc-btn--teal" href="{{ ea_url().setController('App\\Controller\\Admin\\NotificationLogCrudController').setAction('index').generateUrl() }}"><span>NOTIFICATION LOGS</span></a>
{% endblock %}

{% block bmc_body %}

<div class="bmc-stats bmc-stats--card">
    <div class="bmc-stat">
        <span class="bmc-stat__label">REGISTERED DEVICES</span>
        <span class="bmc-stat__value {{ deviceCount == 0 ? 'ink-danger' : '' }}">{{ deviceCount|number_format }}</span>
        <span class="bmc-stat__sub">{{ deviceCount == 0 ? 'nothing to deliver to' : 'can receive a push' }}</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">RECENT LOG ENTRIES</span>
        <span class="bmc-stat__value">{{ recentLogs|length }}</span>
        <span class="bmc-stat__sub">the audit trail these actions write to</span>
    </div>
    <div class="bmc-stat">
        <span class="bmc-stat__label">CLUBS</span>
        <span class="bmc-stat__value">{{ clubs|length|number_format }}</span>
        <span class="bmc-stat__sub">available as a test target</span>
    </div>
</div>

<div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(340px,1fr))">
    {% for t in tools %}
        <section class="bmc-card" data-domain="club">
            <div class="bmc-card__head">
                <i data-lucide="{{ t.icon }}"></i>
                <span class="bmc-card__title">{{ t.title }}</span>
            </div>
            <div class="bmc-card__body" style="display:flex;flex-direction:column;gap:12px;height:100%">
                <p class="bmc-bodytext" style="flex:1">{{ t.body|raw }}</p>
                <form method="post" action="{{ path(t.route) }}" style="align-self:flex-start">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token(t.token) }}">
                    <button type="submit" class="bmc-btn bmc-btn--blue"><span>{{ t.button }}</span></button>
                </form>
            </div>
        </section>
    {% endfor %}

    {# ── a test push ─────────────────────────────────────────────────── #}
    <section class="bmc-card" data-domain="club">
        <div class="bmc-card__head">
            <i data-lucide="send"></i>
            <span class="bmc-card__title">SEND TEST PUSH</span>
            <span class="bmc-card__meta">{{ triggerTypes|length }} type(s)</span>
        </div>
        <div class="bmc-card__body">
            <p class="bmc-bodytext">
                Dispatches a clearly-marked <code class="bmc-code">[TEST]</code> push of the chosen type to one
                club's devices — synthetic ids, not tied to any real competition or message. Use
                <strong>Force process queue</strong> above, or wait for the cron, to actually send it.
            </p>
            {% if clubs|length == 0 %}
                <span class="bmc-empty-note" style="margin-top:10px">NO CLUBS EXIST YET</span>
            {% endif %}
        </div>

        {% if clubs|length > 0 %}
            <div class="bmc-card__band" style="display:flex;flex-direction:column;gap:8px">
                {% for type in triggerTypes %}
                    <form method="post" action="{{ path('admin_notification_trigger', {type: type, club: 'CLUB_ID_PLACEHOLDER'}) }}"
                          class="notification-trigger-form" data-type="{{ type }}"
                          style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('notification_trigger') }}">
                        <span class="bmc-select">
                            <select name="club_select" style="min-width:170px" aria-label="Club to notify for {{ type }}">
                                {% for club in clubs %}
                                    <option value="{{ club.id }}">{{ club.name }}</option>
                                {% endfor %}
                            </select>
                        </span>
                        <button type="submit" class="bmc-btn"><span>{{ type|upper }}</span></button>
                    </form>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>

{# ── registered devices ──────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="people">
    <div class="bmc-card__head">
        <i data-lucide="smartphone"></i>
        <span class="bmc-card__title">REGISTERED DEVICES</span>
        <span class="bmc-card__meta">{{ deviceCount|number_format }}</span>
    </div>
    {% if deviceCount == 0 %}
        <div class="bmc-card__body">
            <div class="bmc-danger">
                <i data-lucide="triangle-alert"></i>
                <div class="bmc-danger__text">
                    <span class="bmc-lbl bmc-lbl--ink">NO DEVICE HAS EVER REGISTERED FOR PUSH</span>
                    <span class="bmc-data">
                        A push has nothing to deliver to until the app successfully calls
                        <code class="bmc-code">POST /api/device-tokens</code>. That is an app-side gap rather than a
                        backend one — the in-app poll-delivered overlay is a separate path and works independently.
                    </span>
                </div>
            </div>
        </div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:560px">
                <thead><tr><th>PLATFORM</th><th>USER</th><th>LAST ACTIVE</th><th>REGISTERED</th></tr></thead>
                <tbody>
                    {% for device in recentDevices %}
                        <tr>
                            <td><span class="bmc-badge bmc-badge--subtle">{{ device.platform.value }}</span></td>
                            <td><span class="bmc-celltext">{{ device.user.email }}</span></td>
                            <td><span class="bmc-data">{{ device.lastActiveAt|date('Y-m-d H:i:s') }}</span></td>
                            <td><span class="bmc-data">{{ device.createdAt|date('Y-m-d H:i:s') }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>

{# ── the audit trail ─────────────────────────────────────────────────── #}
<section class="bmc-card" data-domain="club">
    <div class="bmc-card__head">
        <i data-lucide="bell"></i>
        <span class="bmc-card__title">RECENT NOTIFICATION LOG</span>
        <a class="bmc-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\NotificationLogCrudController').setAction('index').generateUrl() }}">View all →</a>
    </div>
    {% if recentLogs|length == 0 %}
        <div class="bmc-card__body"><span class="bmc-empty-note">NO NOTIFICATION ACTIVITY YET</span></div>
    {% else %}
        <div style="overflow-x:auto">
            <table class="bmc-minitable" style="min-width:620px">
                <thead><tr><th>STATUS</th><th>TYPE</th><th>SUMMARY</th><th>WHEN</th></tr></thead>
                <tbody>
                    {% for log in recentLogs %}
                        <tr>
                            <td>
                                <span class="bmc-badge bmc-badge--{{ log.status.value == 'success' ? 'positive' : 'danger' }}">
                                    {{ log.status.value == 'success' ? 'SUCCESS' : 'FAILED' }}
                                </span>
                            </td>
                            <td><span class="bmc-celltext">{{ log.messageType }}</span></td>
                            <td>
                                <span class="bmc-data">{{ log.summary }}</span>
                                {%- if log.errorMessage %} <span class="bmc-data ink-danger">— {{ log.errorMessage }}</span>{% endif %}
                            </td>
                            <td><span class="bmc-data">{{ log.createdAt|date('Y-m-d H:i:s') }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}

{% block body_javascript %}
{{ parent() }}
<script>
// The trigger route needs {club} baked into the URL PATH — a Doctrine-typed route parameter,
// not a query or body field — so Twig cannot interpolate a client-side <select> choice into
// path(). The placeholder is rewritten to the chosen id immediately before submit.
document.querySelectorAll('.notification-trigger-form').forEach(function (form) {
    form.addEventListener('submit', function () {
        var clubId = form.querySelector('select[name="club_select"]').value;
        form.action = form.action.replace('CLUB_ID_PLACEHOLDER', encodeURIComponent(clubId));
    });
});
</script>
{% endblock %}
