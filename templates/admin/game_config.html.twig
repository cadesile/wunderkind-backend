{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Game Config</h5>
        <p class="text-muted small mb-0">Runtime engine constants synced to every client on each /api/sync response. Changes take effect on the next sync.</p>
    </div>

    <div class="col-12">
    <form method="POST" action="{{ path('admin_game_config_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_game_config') }}">
        <div class="d-flex flex-column gap-4">

            {# ── Developer / Debug ──────────────────────────────────────── #}
            <div class="card border-warning">
                <div class="card-header py-2 d-flex align-items-center gap-2 bg-warning-subtle">
                    <i class="fa fa-bug text-warning"></i>
                    <span class="fw-semibold small">Developer / Debug</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        When enabled, a <strong>cog icon</strong> appears in the app's bottom navigation.
                        Tapping it opens the in-app debug log panel which records all API requests and responses.
                        <strong>Disable in production.</strong>
                    </p>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="debugLoggingEnabled" name="debugLoggingEnabled"
                               {% if config.debugLoggingEnabled %}checked{% endif %}>
                        <label class="form-check-label fw-semibold small" for="debugLoggingEnabled">
                            Enable in-app debug log panel
                        </label>
                    </div>
                </div>
            </div>

            {# ── Section navigation ───────────────────────────────────────── #}
            {% set cfgSections = [
                {id: 'clique',            label: 'Clique System'},
                {id: 'xp',               label: 'XP &amp; Progression'},
                {id: 'development',      label: 'Development / Potential'},
                {id: 'coach',            label: 'Coach Influence'},
                {id: 'reputation',       label: 'Reputation'},
                {id: 'injury',           label: 'Injury'},
                {id: 'scouting',         label: 'Scouting'},
                {id: 'morale',           label: 'Morale'},
                {id: 'incidents',        label: 'Incidents'},
                {id: 'transfer',         label: 'Transfer Market'},
                {id: 'guardian',         label: 'Guardian Complaints'},
                {id: 'league-finances',  label: 'League Finances'},
                {id: 'staff-limits',     label: 'Staff Limits'},
                {id: 'sponsor-probs',    label: 'Sponsor Offers'},
                {id: 'investor-probs',   label: 'Investor Offers'},
                {id: 'facility-income',  label: 'Facility Income'},
                {id: 'facility-build',   label: 'Facility Construction'},
                {id: 'playing-style',    label: 'Playing Style'},
                {id: 'stadium',          label: 'Stadium'},
                {id: 'attendance',       label: 'Attendance'},
                {id: 'ability-ranges',   label: 'Ability Ranges'},
                {id: 'npc-finances',     label: 'NPC Club Finances'},
                {id: 'squad',            label: 'Squad'},
                {id: 'retirement',       label: 'Retirement'},
                {id: 'inbox',            label: 'Inbox'},
                {id: 'wages',            label: 'Wages'},
                {id: 'sacking',          label: 'Manager Sacking'},
                {id: 'cards',            label: 'Cards &amp; Discipline'},
            ] %}
            <div class="d-flex flex-wrap gap-1" id="cfg-tab-nav">
                {% for s in cfgSections %}
                <button type="button"
                        class="cfg-tab btn btn-sm btn-outline-secondary"
                        data-tab="{{ s.id }}"
                        style="font-size:.72rem;padding:.2rem .55rem;">
                    {{ s.label|raw }}
                </button>
                {% endfor %}
            </div>

            {# ── Clique System ──────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="clique">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-people-group text-muted"></i>
                    <span class="fw-semibold small">Clique System</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        A clique forms when 3+ players all have pairwise relationship values above the threshold.
                        Total cliqued players across all cliques cannot exceed the squad cap %.
                        Example: squad of 10, cap 30% → max 3 cliqued players → one clique of 3 maximum.
                        Squad drops to 9 → cap becomes 2 → clique disbands automatically.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="cliqueRelationshipThreshold" class="form-label fw-semibold small">Relationship Threshold</label>
                            <input type="number" id="cliqueRelationshipThreshold" name="cliqueRelationshipThreshold"
                                   value="{{ config.cliqueRelationshipThreshold }}"
                                   min="-100" max="100" class="form-control">
                            <div class="form-text">Min pairwise value for clique eligibility. Default: 20</div>
                        </div>
                        <div class="col-md-4">
                            <label for="cliqueSquadCapPercent" class="form-label fw-semibold small">Squad Cap %</label>
                            <input type="number" id="cliqueSquadCapPercent" name="cliqueSquadCapPercent"
                                   value="{{ config.cliqueSquadCapPercent }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Max % of squad in cliques combined. Default: 30</div>
                        </div>
                        <div class="col-md-4">
                            <label for="cliqueMinTenureWeeks" class="form-label fw-semibold small">Min Tenure (weeks)</label>
                            <input type="number" id="cliqueMinTenureWeeks" name="cliqueMinTenureWeeks"
                                   value="{{ config.cliqueMinTenureWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">Club tenure required before clique eligibility. Default: 3</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── XP & Progression ───────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="xp">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-star text-muted"></i>
                    <span class="fw-semibold small">XP &amp; Progression</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="baseXP" class="form-label fw-semibold small">Base XP</label>
                            <input type="number" id="baseXP" name="baseXP"
                                   value="{{ config.baseXP }}"
                                   min="1" class="form-control">
                            <div class="form-text">Base XP awarded per player per week before facility/coach multipliers. Default: 10</div>
                        </div>
                        <div class="col-md-4">
                            <label for="regressionUpperThreshold" class="form-label fw-semibold small">Regression Upper Threshold</label>
                            <input type="number" id="regressionUpperThreshold" name="regressionUpperThreshold"
                                   value="{{ config.regressionUpperThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value above which regression-to-mean pushes down (1–20 scale). Default: 14</div>
                        </div>
                        <div class="col-md-4">
                            <label for="regressionLowerThreshold" class="form-label fw-semibold small">Regression Lower Threshold</label>
                            <input type="number" id="regressionLowerThreshold" name="regressionLowerThreshold"
                                   value="{{ config.regressionLowerThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value below which regression-to-mean pushes up (1–20 scale). Default: 7</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Development / Potential Ceiling ────────────────────────── #}
            <div class="card cfg-section" data-section-id="development">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-chart-bar text-muted"></i>
                    <span class="fw-semibold small">Development / Potential Ceiling</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how far a player's overall rating can temporarily exceed their potential ceiling,
                        and how quickly attributes decay back down once they do.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="potentialOvershootMax" class="form-label fw-semibold small">Overshoot Max</label>
                            <input type="number" id="potentialOvershootMax" name="potentialOvershootMax"
                                   value="{{ config.potentialOvershootMax }}"
                                   step="0.01" min="0.0" max="0.5" class="form-control">
                            <div class="form-text">Max % overall can temporarily exceed potential ceiling (e.g. 0.05 = 5%). Default: 0.05</div>
                        </div>
                        <div class="col-md-6">
                            <label for="potentialDecayRate" class="form-label fw-semibold small">Decay Rate</label>
                            <input type="number" id="potentialDecayRate" name="potentialDecayRate"
                                   value="{{ config.potentialDecayRate }}"
                                   step="0.1" min="0.0" max="5.0" class="form-control">
                            <div class="form-text">Attribute points nudged down per week above ceiling. Default: 0.5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Coach Development Influence ─────────────────────────────── #}
            <div class="card cfg-section" data-section-id="coach">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-whistle text-muted"></i>
                    <span class="fw-semibold small">Coach Development Influence</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how coach attribute specialisms (pace, technical, vision, power, stamina, heart)
                        scale player XP gain, and how morale and stacking across multiple coaches are handled.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="coachDevelopmentMaxMultiplier" class="form-label fw-semibold small">Max XP Multiplier</label>
                            <input type="number" id="coachDevelopmentMaxMultiplier" name="coachDevelopmentMaxMultiplier"
                                   value="{{ config.coachDevelopmentMaxMultiplier }}"
                                   step="0.1" min="1.0" max="5.0" class="form-control">
                            <div class="form-text">Max XP multiplier at specialism 100. Default: 2.0</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachDevelopmentMinSpecialism" class="form-label fw-semibold small">Min Specialism Threshold</label>
                            <input type="number" id="coachDevelopmentMinSpecialism" name="coachDevelopmentMinSpecialism"
                                   value="{{ config.coachDevelopmentMinSpecialism }}"
                                   step="1" min="0" max="100" class="form-control">
                            <div class="form-text">Minimum specialism before any bonus applies (0–100). Default: 20</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachDevelopmentStackingFactor" class="form-label fw-semibold small">Stacking Factor</label>
                            <input type="number" id="coachDevelopmentStackingFactor" name="coachDevelopmentStackingFactor"
                                   value="{{ config.coachDevelopmentStackingFactor }}"
                                   step="0.05" min="0.0" max="1.0" class="form-control">
                            <div class="form-text">0 = best coach only, 1 = full linear stack. Default: 0.3</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachMoraleInfluence" class="form-label fw-semibold small">Morale Influence</label>
                            <input type="number" id="coachMoraleInfluence" name="coachMoraleInfluence"
                                   value="{{ config.coachMoraleInfluence }}"
                                   step="0.1" min="0.0" max="2.0" class="form-control">
                            <div class="form-text">Exponent: 0.5 = square root scaling with morale. Default: 0.5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Physical Degradation & Form ─────────────────────────────── #}
            <div class="card cfg-section" data-section-id="physical-degradation">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-running text-muted"></i>
                    <span class="fw-semibold small">Physical Degradation &amp; Form</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls the hard cap on individual player attributes, physical pace/stamina
                        decay after a configurable age threshold, and how recent match form influences
                        the weekly development multiplier.
                    </p>

                    <p class="fw-semibold small mb-2">Attribute Cap</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="attributeHardCap" class="form-label fw-semibold small">Attribute Hard Cap</label>
                            <input type="number" id="attributeHardCap" name="attributeHardCap"
                                   value="{{ config.attributeHardCap }}"
                                   step="1" min="1" max="100" class="form-control">
                            <div class="form-text">Maximum value for any individual player attribute</div>
                        </div>
                    </div>

                    <p class="fw-semibold small mb-2">Physical Degradation (after age threshold)</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="physicalDegradationAgeThreshold" class="form-label fw-semibold small">Age Threshold</label>
                            <input type="number" id="physicalDegradationAgeThreshold" name="physicalDegradationAgeThreshold"
                                   value="{{ config.physicalDegradationAgeThreshold }}"
                                   step="1" min="25" max="40" class="form-control">
                            <div class="form-text">Age degradation begins (players at or below this age are unaffected)</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateMild" class="form-label fw-semibold small">Mild Rate (threshold+1 to +3)</label>
                            <input type="number" id="physicalDegradationRateMild" name="physicalDegradationRateMild"
                                   value="{{ config.physicalDegradationRateMild }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly pace/stamina loss: age threshold+1 to threshold+3</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateModerate" class="form-label fw-semibold small">Moderate Rate (threshold+4 to +6)</label>
                            <input type="number" id="physicalDegradationRateModerate" name="physicalDegradationRateModerate"
                                   value="{{ config.physicalDegradationRateModerate }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly loss: age threshold+4 to threshold+6</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateSevere" class="form-label fw-semibold small">Severe Rate (threshold+7+)</label>
                            <input type="number" id="physicalDegradationRateSevere" name="physicalDegradationRateSevere"
                                   value="{{ config.physicalDegradationRateSevere }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly loss: age threshold+7 and above</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationPersonalityScale" class="form-label fw-semibold small">Personality Scale</label>
                            <input type="number" id="physicalDegradationPersonalityScale" name="physicalDegradationPersonalityScale"
                                   value="{{ config.physicalDegradationPersonalityScale }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">How much heart/determination trait reduces degradation rate</div>
                        </div>
                    </div>

                    <p class="fw-semibold small mb-2">Form &amp; Development</p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="formDevelopmentMatchCount" class="form-label fw-semibold small">Match Count</label>
                            <input type="number" id="formDevelopmentMatchCount" name="formDevelopmentMatchCount"
                                   value="{{ config.formDevelopmentMatchCount }}"
                                   step="1" min="1" max="20" class="form-control">
                            <div class="form-text">Recent matches used for form average</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentThreshold" class="form-label fw-semibold small">Full Development Threshold</label>
                            <input type="number" id="formDevelopmentThreshold" name="formDevelopmentThreshold"
                                   value="{{ config.formDevelopmentThreshold }}"
                                   step="0.1" min="1" max="10" class="form-control">
                            <div class="form-text">Rating average for full development (1.0×)</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentThresholdLow" class="form-label fw-semibold small">Low Threshold</label>
                            <input type="number" id="formDevelopmentThresholdLow" name="formDevelopmentThresholdLow"
                                   value="{{ config.formDevelopmentThresholdLow }}"
                                   step="0.1" min="1" max="10" class="form-control">
                            <div class="form-text">Rating average below which low multiplier applies</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentMultiplierMid" class="form-label fw-semibold small">Mid Multiplier</label>
                            <input type="number" id="formDevelopmentMultiplierMid" name="formDevelopmentMultiplierMid"
                                   value="{{ config.formDevelopmentMultiplierMid }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">Development rate between low and full threshold</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentMultiplierLow" class="form-label fw-semibold small">Low Multiplier</label>
                            <input type="number" id="formDevelopmentMultiplierLow" name="formDevelopmentMultiplierLow"
                                   value="{{ config.formDevelopmentMultiplierLow }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">Development rate below low threshold</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Reputation ─────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="reputation">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-chart-line text-muted"></i>
                    <span class="fw-semibold small">Reputation</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="reputationDeltaBase" class="form-label fw-semibold small">Delta Base</label>
                            <input type="number" id="reputationDeltaBase" name="reputationDeltaBase"
                                   value="{{ config.reputationDeltaBase }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">Base reputation delta per week before facility multiplier. Default: 0.15</div>
                        </div>
                        <div class="col-md-6">
                            <label for="reputationDeltaFacilityMultiplier" class="form-label fw-semibold small">Facility Multiplier</label>
                            <input type="number" id="reputationDeltaFacilityMultiplier" name="reputationDeltaFacilityMultiplier"
                                   value="{{ config.reputationDeltaFacilityMultiplier }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">Per-level facility multiplier applied to reputation delta. Default: 0.15</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Injury ─────────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="injury">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-kit-medical text-muted"></i>
                    <span class="fw-semibold small">Injury</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="baseInjuryProbability" class="form-label fw-semibold small">Base Probability</label>
                            <input type="number" id="baseInjuryProbability" name="baseInjuryProbability"
                                   value="{{ config.baseInjuryProbability }}"
                                   step="0.0001" min="0" max="1" class="form-control">
                            <div class="form-text">Weekly injury chance per player (fraction). Default: 0.05</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injuryMinorWeight" class="form-label fw-semibold small">Minor Weight</label>
                            <input type="number" id="injuryMinorWeight" name="injuryMinorWeight"
                                   value="{{ config.injuryMinorWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for minor severity. Default: 60</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injuryModerateWeight" class="form-label fw-semibold small">Moderate Weight</label>
                            <input type="number" id="injuryModerateWeight" name="injuryModerateWeight"
                                   value="{{ config.injuryModerateWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for moderate severity. Default: 30</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injurySeriousWeight" class="form-label fw-semibold small">Serious Weight</label>
                            <input type="number" id="injurySeriousWeight" name="injurySeriousWeight"
                                   value="{{ config.injurySeriousWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for serious severity. Default: 10</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Scouting ───────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="scouting">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-binoculars text-muted"></i>
                    <span class="fw-semibold small">Scouting</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how scouts reveal players and how active missions discover prospects each week.
                        The gem roll thresholds define a weighted table: a random float (0–1) is tested against
                        the four cutoffs in order to determine how many players are found per tick.
                        Example defaults: 25% chance of 0, 50% chance of 1, 10% chance of 2, 9% chance of 3, 6% chance of 4.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="scoutMoraleThreshold" class="form-label fw-semibold small">Morale Threshold</label>
                            <input type="number" id="scoutMoraleThreshold" name="scoutMoraleThreshold"
                                   value="{{ config.scoutMoraleThreshold }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Morale below this value halts all scouting progress. Default: 40</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutRevealWeeks" class="form-label fw-semibold small">Reveal Weeks</label>
                            <input type="number" id="scoutRevealWeeks" name="scoutRevealWeeks"
                                   value="{{ config.scoutRevealWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">Weekly ticks before an assigned player is fully revealed. Default: 2</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutAbilityErrorRange" class="form-label fw-semibold small">Ability Error Range</label>
                            <input type="number" id="scoutAbilityErrorRange" name="scoutAbilityErrorRange"
                                   value="{{ config.scoutAbilityErrorRange }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Max ±variance on perceived ability, scaled by scout accuracy. Default: 30</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutMaxAssignments" class="form-label fw-semibold small">Max Assignments</label>
                            <input type="number" id="scoutMaxAssignments" name="scoutMaxAssignments"
                                   value="{{ config.scoutMaxAssignments }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Max players a scout can be assigned to simultaneously. Default: 5</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold small">Mission Gem Roll Thresholds</label>
                        <div class="row g-2">
                            {% set thresholds = config.missionGemRollThresholds %}
                            <div class="col-md-3">
                                <label for="gemThreshold0" class="form-label small text-muted">0 players cutoff (t0)</label>
                                <input type="number" id="gemThreshold0" name="gemThreshold0"
                                       value="{{ thresholds[0] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">roll &lt; t0 → 0 found. Default: 0.25</div>
                            </div>
                            <div class="col-md-3">
                                <label for="gemThreshold1" class="form-label small text-muted">1 player cutoff (t1)</label>
                                <input type="number" id="gemThreshold1" name="gemThreshold1"
                                       value="{{ thresholds[1] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">t0 ≤ roll &lt; t1 → 1 found. Default: 0.75</div>
                            </div>
                            <div class="col-md-3">
                                <label for="gemThreshold2" class="form-label small text-muted">2 players cutoff (t2)</label>
                                <input type="number" id="gemThreshold2" name="gemThreshold2"
                                       value="{{ thresholds[2] }}"
