{% extends 'admin/bmc_page.html.twig' %}

{% block bmc_page_class %} bmc-page--savebar{% endblock %}

{% block bmc_body %}


    <div class="bmc-rule"><span class="bmc-rule__title">ENGINE CONSTANTS</span><span class="bmc-rule__line"></span><span class="bmc-rule__meta">synced to every client on the next /api/sync</span></div>

    <form method="post" action="{{ path('admin_game_config_save') }}" data-bmc-form id="game-config-form" style="display:contents">
        <input type="hidden" name="_token" value="{{ csrf_token('save_game_config') }}">
        <div style="display:flex;flex-direction:column;gap:12px">

            {# ── Section navigation ───────────────────────────────────────── #}
            {#
                cfgGroups  — parent fieldsets; each group button shows all child sections at once.
                cfgSections — individual tabs; sections with a 'group' key belong to a parent fieldset.
                Ungrouped sections (group: null) are standalone — clicked individually.
            #}
            {% set cfgGroups = [
                {id: 'player-dev',      label: 'Player Development', icon: 'chart-column',           subs: 'Clique · Development · Coach · Physical · Retirement · Dev Tick'},
                {id: 'transfer',        label: 'Transfers',          icon: 'arrow-left-right', subs: 'Transfer Market · Wages · Scouting'},
                {id: 'match-settings',  label: 'Match Settings',     icon: 'circle-dot',              subs: 'Injury · Playing Style · Cards'},
                {id: 'league-config',   label: 'League Config',      icon: 'trophy',              subs: 'Morale · Finances · NPC · Squad · Penalties · Trophy Points · Pyramid News'},
                {id: 'facility-config', label: 'Facility Config',    icon: 'building',            subs: 'Income · Construction · Staff Morale'},
                {id: 'event-config',    label: 'Event Config',       icon: 'zap',                subs: 'Incidents · Sacking · Guardian'},
                {id: 'club-dev',        label: 'Club Development',   icon: 'sprout',            subs: 'Reputation · Inbox · XP · Staff · Sponsors · Investors · Stadium · Cooldowns'},
            ] %}
            {% set cfgSections = [
                {id: 'clique',               label: 'Clique System',          group: 'player-dev'},
                {id: 'bonds',                label: 'Bond System',            group: 'player-dev'},
                {id: 'development',          label: 'Development / Potential', group: 'player-dev'},
                {id: 'coach',                label: 'Coach Influence',         group: 'player-dev'},
                {id: 'transfer',             label: 'Transfer Market',         group: 'transfer'},
                {id: 'injury',               label: 'Injury',                  group: 'match-settings'},
                {id: 'playing-style',        label: 'Playing Style',           group: 'match-settings'},
                {id: 'cards',                label: 'Cards &amp; Discipline',  group: 'match-settings'},
                {id: 'morale',               label: 'Morale',                  group: 'league-config'},
                {id: 'league-finances',      label: 'League Finances',         group: 'league-config'},
                {id: 'npc-finances',         label: 'NPC Club Finances',       group: 'league-config'},
                {id: 'squad-roles',          label: 'Squad Roles',             group: 'league-config'},
                {id: 'squad',                label: 'Squad',                   group: 'league-config'},
                {id: 'facility-income',      label: 'Facility Income',         group: 'facility-config'},
                {id: 'facility-build',       label: 'Facility Construction',   group: 'facility-config'},
                {id: 'facility-morale',      label: 'Facility Staff Morale',   group: 'facility-config'},
                {id: 'incidents',            label: 'Incidents',               group: 'event-config'},
                {id: 'sacking',              label: 'Manager Sacking',         group: 'event-config'},
                {id: 'guardian',             label: 'Guardian Complaints',     group: 'event-config'},
                {id: 'xp',                   label: 'XP &amp; Progression',   group: 'club-dev'},
                {id: 'physical-degradation', label: 'Physical Degradation',   group: 'player-dev'},
                {id: 'reputation',           label: 'Reputation',              group: 'club-dev'},
                {id: 'scouting',             label: 'Scouting',                group: 'transfer'},
                {id: 'financial-penalties',  label: 'Financial Penalties',     group: 'league-config'},
                {id: 'staff-limits',         label: 'Staff Limits',            group: 'club-dev'},
                {id: 'sponsor-probs',        label: 'Sponsor Offers',          group: 'club-dev'},
                {id: 'investor-probs',       label: 'Investor Offers',         group: 'club-dev'},
                {id: 'stadium',              label: 'Stadium',                 group: 'club-dev'},
                {id: 'attendance',           label: 'Attendance',              group: 'league-config'},
                {id: 'retirement',           label: 'Retirement',              group: 'player-dev'},
                {id: 'inbox',                label: 'Inbox',                   group: 'club-dev'},
                {id: 'wages',                label: 'Wages',                   group: 'transfer'},
                {id: 'competition-history',  label: 'Competition History',     group: 'league-config'},
                {id: 'pyramid-news',         label: 'Pyramid News',            group: 'league-config'},
                {id: 'dev-tick',             label: 'Dev Tick Frequency',      group: 'player-dev'},
                {id: 'cooldowns',            label: 'Feature Cooldowns',       group: 'club-dev'},
            ] %}

            <div class="d-flex flex-column gap-2" id="cfg-tab-nav">
                {# Row 1 — parent group buttons #}
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class=" fw-semibold me-1" style="font-size:.68rem;white-space:nowrap">GROUPS:</span>
                    {% for g in cfgGroups %}
                    <button type="button"
                            class="cfg-group-btn bmc-quick-btn"
                            data-group="{{ g.id }}"
                            title="{{ g.subs }}"
                            style="font-size:.72rem;padding:.2rem .55rem;">
                        <i data-lucide="{{ g.icon }}" width="14" height="14"></i>{{ g.label }}
                    </button>
                    {% endfor %}
                </div>
                {# Row 2 — individual section tabs (collapsible) #}
                <details id="cfg-sections-drawer" style="border:1px solid var(--wk-stroke);border-radius:.375rem;padding:.25rem .5rem;">
                    <summary style="font-size:.68rem;font-weight:600;color:var(--wk-text-dim);cursor:pointer;list-style:none;display:flex;align-items:center;gap:.4rem;">
                        <i data-lucide="chevron-right" id="cfg-sections-chevron" width="14" height="14" style="transition:transform .2s"></i>
                        SECTIONS
                        <span id="cfg-sections-summary-hint" class="opacity-50 fw-normal ms-1"></span>
                    </summary>
                    <div class="d-flex flex-wrap gap-1 align-items-center pt-2">
                        {% for s in cfgSections %}
                        <button type="button"
                                class="cfg-tab bmc-quick-btn"
                                data-tab="{{ s.id }}"
                                {% if s.group %}data-group-member="{{ s.group }}"{% endif %}
                                style="font-size:.72rem;padding:.2rem .55rem;">
                            {{ s.label|raw }}
                        </button>
                        {% endfor %}
                    </div>
                </details>
            </div>

            {# Active group context banner — populated and shown by JS when a group button is active #}
            <div id="cfg-group-banner" class="d-none small py-2 px-3"
                 style="border-left:3px solid var(--wk-accent);background:var(--wk-panel);color:var(--wk-text)">
                <strong id="cfg-group-banner-title"></strong>
                <span class="ms-2 opacity-75" id="cfg-group-banner-subs"></span>
            </div>

            {# ── Clique System ──────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="clique" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">CLIQUE SYSTEM</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        A clique forms when 3+ players all have pairwise relationship values above the threshold.
                        Total cliqued players across all cliques cannot exceed the squad cap %.
                        Example: squad of 10, cap 30% → max 3 cliqued players → one clique of 3 maximum.
                        Squad drops to 9 → cap becomes 2 → clique disbands automatically.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RELATIONSHIP THRESHOLD</span><span class="bmc-setting__help">Min pairwise value for clique eligibility. Default: 20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="cliqueRelationshipThreshold" value="{{ config.cliqueRelationshipThreshold }}" data-saved="{{ config.cliqueRelationshipThreshold }}" data-kind="int" data-min="-100" data-max="100" inputmode="numeric" aria-label="relationship threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SQUAD CAP %</span><span class="bmc-setting__help">Max % of squad in cliques combined. Default: 30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="cliqueSquadCapPercent" value="{{ config.cliqueSquadCapPercent }}" data-saved="{{ config.cliqueSquadCapPercent }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="squad cap %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MIN TENURE (WEEKS)</span><span class="bmc-setting__help">Club tenure required before clique eligibility. Default: 3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="cliqueMinTenureWeeks" value="{{ config.cliqueMinTenureWeeks }}" data-saved="{{ config.cliqueMinTenureWeeks }}" data-kind="int" data-min="1" data-max="52" inputmode="numeric" aria-label="min tenure (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Bond System ────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="bonds" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">BOND SYSTEM</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Bonds run from Bond Min to Bond Max and move in two directions each week.
                        Negative bonds recover toward 0 at the drift rate — grudges fade.
                        Positive bonds above the <strong>decay floor</strong> erode back down to it
                        once they have gone <strong>neglect weeks</strong> without an interaction;
                        anything at or below the floor is permanent. Coaching a player refreshes the
                        interaction clock, so an actively coached player never decays.
                        Set Positive Decay / Week to 0 to switch neglect decay off entirely.
                    </p>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">DECAY &AMP; DRIFT</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DECAY FLOOR</span><span class="bmc-setting__help">Bonds at or below this never decay — the earned baseline is permanent. Default: 50</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondDecayFloor" value="{{ config.bondDecayFloor }}" data-saved="{{ config.bondDecayFloor }}" data-kind="int" data-min="-100" data-max="100" inputmode="numeric" aria-label="decay floor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NEGLECT WEEKS</span><span class="bmc-setting__help">Weeks without an interaction before a bond above the floor starts decaying. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondNeglectWeeks" value="{{ config.bondNeglectWeeks }}" data-saved="{{ config.bondNeglectWeeks }}" data-kind="int" data-min="1" data-max="104" inputmode="numeric" aria-label="neglect weeks"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">POSITIVE DECAY / WEEK</span><span class="bmc-setting__help">Points a neglected bond loses each week. 0 disables neglect decay. Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondPositiveDecayPerWeek" value="{{ config.bondPositiveDecayPerWeek }}" data-saved="{{ config.bondPositiveDecayPerWeek }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="positive decay / week"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NEGATIVE DRIFT / WEEK</span><span class="bmc-setting__help">Points a soured bond recovers toward 0 each week — grudges fade. Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondNegativeDriftPerWeek" value="{{ config.bondNegativeDriftPerWeek }}" data-saved="{{ config.bondNegativeDriftPerWeek }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="negative drift / week"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NEGATIVE THRESHOLD</span><span class="bmc-setting__help">Below this a bond arms weekly morale decay. Default: -20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondNegativeRelationsThreshold" value="{{ config.bondNegativeRelationsThreshold }}" data-saved="{{ config.bondNegativeRelationsThreshold }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="negative threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BOND MIN</span><span class="bmc-setting__help">Lower clamp on every bond write. Default: -100</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMin" value="{{ config.bondMin }}" data-saved="{{ config.bondMin }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="bond min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BOND MAX</span><span class="bmc-setting__help">Upper clamp on every bond write. Default: 100</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMax" value="{{ config.bondMax }}" data-saved="{{ config.bondMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="bond max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">MORALE CONSEQUENCES</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE DECAY CHANCE</span><span class="bmc-setting__help">Weekly chance an entity with negative relations loses morale. Default: 0.1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMoraleDecayChance" value="{{ config.bondMoraleDecayChance }}" data-saved="{{ config.bondMoraleDecayChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="morale decay chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE DECAY PENALTY</span><span class="bmc-setting__help">Morale lost when that roll passes. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMoraleDecayPenalty" value="{{ config.bondMoraleDecayPenalty }}" data-saved="{{ config.bondMoraleDecayPenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="morale decay penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST THRESHOLD</span><span class="bmc-setting__help">Coach↔manager value below this arms trust decay. Default: -20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustThreshold" value="{{ config.coachManagerTrustThreshold }}" data-saved="{{ config.coachManagerTrustThreshold }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="coach trust threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST CHANCE</span><span class="bmc-setting__help">Weekly chance a distrusting coach loses morale. Default: 0.15</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustDecayChance" value="{{ config.coachManagerTrustDecayChance }}" data-saved="{{ config.coachManagerTrustDecayChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="coach trust chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST PENALTY</span><span class="bmc-setting__help">Morale a distrusting coach loses. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustMoralePenalty" value="{{ config.coachManagerTrustMoralePenalty }}" data-saved="{{ config.coachManagerTrustMoralePenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="coach trust penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">BOND GAINS</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ORGANIC GROWTH CHANCE</span><span class="bmc-setting__help">Base weekly chance a player↔coach bond grows, before boosts. Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondOrganicGrowthBaseChance" value="{{ config.bondOrganicGrowthBaseChance }}" data-saved="{{ config.bondOrganicGrowthBaseChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="organic growth chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ORGANIC GROWTH DELTA</span><span class="bmc-setting__help">Bond points added when the growth roll passes. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondOrganicGrowthDelta" value="{{ config.bondOrganicGrowthDelta }}" data-saved="{{ config.bondOrganicGrowthDelta }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="organic growth delta"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOYALTY DIVISOR</span><span class="bmc-setting__help">Divides player loyalty (1–20) for the growth boost. Default: 20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondOrganicGrowthLoyaltyDivisor" value="{{ config.bondOrganicGrowthLoyaltyDivisor }}" data-saved="{{ config.bondOrganicGrowthLoyaltyDivisor }}" data-kind="int" data-min="1" data-max="100" inputmode="numeric" aria-label="loyalty divisor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ABILITY DIVISOR</span><span class="bmc-setting__help">Divides coachingAbility (0–100) for the growth boost. Default: 100</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondOrganicGrowthAbilityDivisor" value="{{ config.bondOrganicGrowthAbilityDivisor }}" data-saved="{{ config.bondOrganicGrowthAbilityDivisor }}" data-kind="int" data-min="1" data-max="100" inputmode="numeric" aria-label="ability divisor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SUPPORT / CRITICISE DELTA</span><span class="bmc-setting__help">Bond shift from an AMP SUPPORT (+) or CRITICISE (−) action. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondManagerAmpDelta" value="{{ config.bondManagerAmpDelta }}" data-saved="{{ config.bondManagerAmpDelta }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="support / criticise delta"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">INCIDENT DELTA (NEGATIVE)</span><span class="bmc-setting__help">Player↔player change from a negative training incident. Default: -10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondIncidentNegativeDelta" value="{{ config.bondIncidentNegativeDelta }}" data-saved="{{ config.bondIncidentNegativeDelta }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="incident delta (negative)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">INCIDENT DELTA (POSITIVE)</span><span class="bmc-setting__help">Player↔player change from a positive training incident. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondIncidentPositiveDelta" value="{{ config.bondIncidentPositiveDelta }}" data-saved="{{ config.bondIncidentPositiveDelta }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="incident delta (positive)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── XP & Progression ───────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="xp" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">XP &AMP; PROGRESSION</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BASE XP</span><span class="bmc-setting__help">Base XP awarded per player per week before facility/coach multipliers. Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="baseXP" value="{{ config.baseXP }}" data-saved="{{ config.baseXP }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="base xp"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">REGRESSION UPPER THRESHOLD</span><span class="bmc-setting__help">Trait value above which regression-to-mean pushes down (1–20 scale). Default: 14</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="regressionUpperThreshold" value="{{ config.regressionUpperThreshold }}" data-saved="{{ config.regressionUpperThreshold }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="regression upper threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">REGRESSION LOWER THRESHOLD</span><span class="bmc-setting__help">Trait value below which regression-to-mean pushes up (1–20 scale). Default: 7</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="regressionLowerThreshold" value="{{ config.regressionLowerThreshold }}" data-saved="{{ config.regressionLowerThreshold }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="regression lower threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Development / Potential Ceiling ────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="development" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">DEVELOPMENT / POTENTIAL CEILING</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how far a player's overall rating can temporarily exceed their potential ceiling,
                        and how quickly attributes decay back down once they do.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">OVERSHOOT MAX</span><span class="bmc-setting__help">Max % overall can temporarily exceed potential ceiling (e.g. 0.05 = 5%). Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="potentialOvershootMax" value="{{ config.potentialOvershootMax }}" data-saved="{{ config.potentialOvershootMax }}" data-kind="decimal" data-min="0.0" data-max="0.5" inputmode="decimal" aria-label="overshoot max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DECAY RATE</span><span class="bmc-setting__help">Attribute points nudged down per week above ceiling. Default: 0.5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="potentialDecayRate" value="{{ config.potentialDecayRate }}" data-saved="{{ config.potentialDecayRate }}" data-kind="decimal" data-min="0.0" data-max="5.0" inputmode="decimal" aria-label="decay rate"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Coach Development Influence ─────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="coach" data-group="player-dev">
