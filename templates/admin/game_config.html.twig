{% extends '@EasyAdmin/layout.html.twig' %}

{% block content %}
<div class="row g-4 mt-1">

    <div class="col-12">
        <h5 class="fw-semibold mb-0">Game Config</h5>
        <p class="text-muted small mb-0">Runtime engine constants synced to every client on each /api/sync response. Changes take effect on the next sync.</p>
    </div>

    <div class="col-12">
    <form method="POST" action="{{ path('admin_game_config_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('save_game_config') }}">
        <div class="d-flex flex-column gap-4">

            {# ── Section navigation ───────────────────────────────────────── #}
            {#
                cfgGroups  — parent fieldsets; each group button shows all child sections at once.
                cfgSections — individual tabs; sections with a 'group' key belong to a parent fieldset.
                Ungrouped sections (group: null) are standalone — clicked individually.
            #}
            {% set cfgGroups = [
                {id: 'player-dev',      label: 'Player Development', icon: 'fa-chart-bar',           subs: 'Clique · Development · Coach · Physical · Retirement · Dev Tick'},
                {id: 'transfer',        label: 'Transfers',          icon: 'fa-money-bill-transfer', subs: 'Transfer Market · Wages · Scouting'},
                {id: 'match-settings',  label: 'Match Settings',     icon: 'fa-futbol',              subs: 'Injury · Playing Style · Cards'},
                {id: 'league-config',   label: 'League Config',      icon: 'fa-trophy',              subs: 'Morale · Finances · NPC · Squad · Penalties · Trophy Points · Pyramid News'},
                {id: 'facility-config', label: 'Facility Config',    icon: 'fa-building',            subs: 'Income · Construction'},
                {id: 'event-config',    label: 'Event Config',       icon: 'fa-bolt',                subs: 'Incidents · Sacking · Guardian'},
                {id: 'club-dev',        label: 'Club Development',   icon: 'fa-seedling',            subs: 'Reputation · Inbox · XP · Staff · Sponsors · Investors · Stadium · Cooldowns'},
            ] %}
            {% set cfgSections = [
                {id: 'clique',               label: 'Clique System',          group: 'player-dev'},
                {id: 'development',          label: 'Development / Potential', group: 'player-dev'},
                {id: 'coach',                label: 'Coach Influence',         group: 'player-dev'},
                {id: 'transfer',             label: 'Transfer Market',         group: 'transfer'},
                {id: 'injury',               label: 'Injury',                  group: 'match-settings'},
                {id: 'playing-style',        label: 'Playing Style',           group: 'match-settings'},
                {id: 'cards',                label: 'Cards &amp; Discipline',  group: 'match-settings'},
                {id: 'morale',               label: 'Morale',                  group: 'league-config'},
                {id: 'league-finances',      label: 'League Finances',         group: 'league-config'},
                {id: 'npc-finances',         label: 'NPC Club Finances',       group: 'league-config'},
                {id: 'squad-roles',          label: 'Squad Roles',             group: 'league-config'},
                {id: 'squad',                label: 'Squad',                   group: 'league-config'},
                {id: 'facility-income',      label: 'Facility Income',         group: 'facility-config'},
                {id: 'facility-build',       label: 'Facility Construction',   group: 'facility-config'},
                {id: 'incidents',            label: 'Incidents',               group: 'event-config'},
                {id: 'sacking',              label: 'Manager Sacking',         group: 'event-config'},
                {id: 'guardian',             label: 'Guardian Complaints',     group: 'event-config'},
                {id: 'xp',                   label: 'XP &amp; Progression',   group: 'club-dev'},
                {id: 'physical-degradation', label: 'Physical Degradation',   group: 'player-dev'},
                {id: 'reputation',           label: 'Reputation',              group: 'club-dev'},
                {id: 'scouting',             label: 'Scouting',                group: 'transfer'},
                {id: 'financial-penalties',  label: 'Financial Penalties',     group: 'league-config'},
                {id: 'staff-limits',         label: 'Staff Limits',            group: 'club-dev'},
                {id: 'sponsor-probs',        label: 'Sponsor Offers',          group: 'club-dev'},
                {id: 'investor-probs',       label: 'Investor Offers',         group: 'club-dev'},
                {id: 'stadium',              label: 'Stadium',                 group: 'club-dev'},
                {id: 'attendance',           label: 'Attendance',              group: 'league-config'},
                {id: 'retirement',           label: 'Retirement',              group: 'player-dev'},
                {id: 'inbox',                label: 'Inbox',                   group: 'club-dev'},
                {id: 'wages',                label: 'Wages',                   group: 'transfer'},
                {id: 'competition-history',  label: 'Competition History',     group: 'league-config'},
                {id: 'pyramid-news',         label: 'Pyramid News',            group: 'league-config'},
                {id: 'dev-tick',             label: 'Dev Tick Frequency',      group: 'player-dev'},
                {id: 'cooldowns',            label: 'Feature Cooldowns',       group: 'club-dev'},
            ] %}

            <div class="d-flex flex-column gap-2" id="cfg-tab-nav">
                {# Row 1 — parent group buttons #}
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="text-muted fw-semibold me-1" style="font-size:.68rem;white-space:nowrap">GROUPS:</span>
                    {% for g in cfgGroups %}
                    <button type="button"
                            class="cfg-group-btn btn btn-sm btn-outline-primary"
                            data-group="{{ g.id }}"
                            title="{{ g.subs }}"
                            style="font-size:.72rem;padding:.2rem .55rem;">
                        <i class="fa {{ g.icon }} me-1"></i>{{ g.label }}
                    </button>
                    {% endfor %}
                </div>
                {# Row 2 — individual section tabs (collapsible) #}
                <details id="cfg-sections-drawer" style="border:1px solid var(--bs-border-color);border-radius:.375rem;padding:.25rem .5rem;">
                    <summary style="font-size:.68rem;font-weight:600;color:var(--bs-secondary-color);cursor:pointer;list-style:none;display:flex;align-items:center;gap:.4rem;">
                        <i class="fa fa-chevron-right" id="cfg-sections-chevron" style="font-size:.6rem;transition:transform .2s;"></i>
                        SECTIONS
                        <span id="cfg-sections-summary-hint" class="opacity-50 fw-normal ms-1"></span>
                    </summary>
                    <div class="d-flex flex-wrap gap-1 align-items-center pt-2">
                        {% for s in cfgSections %}
                        <button type="button"
                                class="cfg-tab btn btn-sm btn-outline-secondary"
                                data-tab="{{ s.id }}"
                                {% if s.group %}data-group-member="{{ s.group }}"{% endif %}
                                style="font-size:.72rem;padding:.2rem .55rem;">
                            {{ s.label|raw }}
                        </button>
                        {% endfor %}
                    </div>
                </details>
            </div>

            {# Active group context banner — populated and shown by JS when a group button is active #}
            <div id="cfg-group-banner" class="d-none small py-2 px-3"
                 style="border-left:3px solid var(--bs-primary);background:var(--bs-primary-bg-subtle,#cfe2ff);color:var(--bs-primary-text-emphasis,#052c65)">
                <i class="fa fa-layer-group me-2"></i>
                <strong id="cfg-group-banner-title"></strong>
                <span class="ms-2 opacity-75" id="cfg-group-banner-subs"></span>
            </div>

            {# ── Clique System ──────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="clique" data-group="player-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-people-group text-muted"></i>
                    <span class="fw-semibold small">Clique System</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        A clique forms when 3+ players all have pairwise relationship values above the threshold.
                        Total cliqued players across all cliques cannot exceed the squad cap %.
                        Example: squad of 10, cap 30% → max 3 cliqued players → one clique of 3 maximum.
                        Squad drops to 9 → cap becomes 2 → clique disbands automatically.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="cliqueRelationshipThreshold" class="form-label fw-semibold small">Relationship Threshold</label>
                            <input type="number" id="cliqueRelationshipThreshold" name="cliqueRelationshipThreshold"
                                   value="{{ config.cliqueRelationshipThreshold }}"
                                   min="-100" max="100" class="form-control">
                            <div class="form-text">Min pairwise value for clique eligibility. Default: 20</div>
                        </div>
                        <div class="col-md-4">
                            <label for="cliqueSquadCapPercent" class="form-label fw-semibold small">Squad Cap %</label>
                            <input type="number" id="cliqueSquadCapPercent" name="cliqueSquadCapPercent"
                                   value="{{ config.cliqueSquadCapPercent }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Max % of squad in cliques combined. Default: 30</div>
                        </div>
                        <div class="col-md-4">
                            <label for="cliqueMinTenureWeeks" class="form-label fw-semibold small">Min Tenure (weeks)</label>
                            <input type="number" id="cliqueMinTenureWeeks" name="cliqueMinTenureWeeks"
                                   value="{{ config.cliqueMinTenureWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">Club tenure required before clique eligibility. Default: 3</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── XP & Progression ───────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="xp" data-group="club-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-star text-muted"></i>
                    <span class="fw-semibold small">XP &amp; Progression</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="baseXP" class="form-label fw-semibold small">Base XP</label>
                            <input type="number" id="baseXP" name="baseXP"
                                   value="{{ config.baseXP }}"
                                   min="1" class="form-control">
                            <div class="form-text">Base XP awarded per player per week before facility/coach multipliers. Default: 10</div>
                        </div>
                        <div class="col-md-4">
                            <label for="regressionUpperThreshold" class="form-label fw-semibold small">Regression Upper Threshold</label>
                            <input type="number" id="regressionUpperThreshold" name="regressionUpperThreshold"
                                   value="{{ config.regressionUpperThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value above which regression-to-mean pushes down (1–20 scale). Default: 14</div>
                        </div>
                        <div class="col-md-4">
                            <label for="regressionLowerThreshold" class="form-label fw-semibold small">Regression Lower Threshold</label>
                            <input type="number" id="regressionLowerThreshold" name="regressionLowerThreshold"
                                   value="{{ config.regressionLowerThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value below which regression-to-mean pushes up (1–20 scale). Default: 7</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Development / Potential Ceiling ────────────────────────── #}
            <div class="card cfg-section" data-section-id="development" data-group="player-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-chart-bar text-muted"></i>
                    <span class="fw-semibold small">Development / Potential Ceiling</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how far a player's overall rating can temporarily exceed their potential ceiling,
                        and how quickly attributes decay back down once they do.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="potentialOvershootMax" class="form-label fw-semibold small">Overshoot Max</label>
                            <input type="number" id="potentialOvershootMax" name="potentialOvershootMax"
                                   value="{{ config.potentialOvershootMax }}"
                                   step="0.01" min="0.0" max="0.5" class="form-control">
                            <div class="form-text">Max % overall can temporarily exceed potential ceiling (e.g. 0.05 = 5%). Default: 0.05</div>
                        </div>
                        <div class="col-md-6">
                            <label for="potentialDecayRate" class="form-label fw-semibold small">Decay Rate</label>
                            <input type="number" id="potentialDecayRate" name="potentialDecayRate"
                                   value="{{ config.potentialDecayRate }}"
                                   step="0.1" min="0.0" max="5.0" class="form-control">
                            <div class="form-text">Attribute points nudged down per week above ceiling. Default: 0.5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Coach Development Influence ─────────────────────────────── #}
            <div class="card cfg-section" data-section-id="coach" data-group="player-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-whistle text-muted"></i>
                    <span class="fw-semibold small">Coach Development Influence</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how coach attribute specialisms (pace, technical, vision, power, stamina, heart)
                        scale player XP gain, and how morale and stacking across multiple coaches are handled.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="coachDevelopmentMaxMultiplier" class="form-label fw-semibold small">Max XP Multiplier</label>
                            <input type="number" id="coachDevelopmentMaxMultiplier" name="coachDevelopmentMaxMultiplier"
                                   value="{{ config.coachDevelopmentMaxMultiplier }}"
                                   step="0.1" min="1.0" max="5.0" class="form-control">
                            <div class="form-text">Max XP multiplier at specialism 100. Default: 2.0</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachDevelopmentMinSpecialism" class="form-label fw-semibold small">Min Specialism Threshold</label>
                            <input type="number" id="coachDevelopmentMinSpecialism" name="coachDevelopmentMinSpecialism"
                                   value="{{ config.coachDevelopmentMinSpecialism }}"
                                   step="1" min="0" max="100" class="form-control">
                            <div class="form-text">Minimum specialism before any bonus applies (0–100). Default: 20</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachDevelopmentStackingFactor" class="form-label fw-semibold small">Stacking Factor</label>
                            <input type="number" id="coachDevelopmentStackingFactor" name="coachDevelopmentStackingFactor"
                                   value="{{ config.coachDevelopmentStackingFactor }}"
                                   step="0.05" min="0.0" max="1.0" class="form-control">
                            <div class="form-text">0 = best coach only, 1 = full linear stack. Default: 0.3</div>
                        </div>
                        <div class="col-md-3">
                            <label for="coachMoraleInfluence" class="form-label fw-semibold small">Morale Influence</label>
                            <input type="number" id="coachMoraleInfluence" name="coachMoraleInfluence"
                                   value="{{ config.coachMoraleInfluence }}"
                                   step="0.1" min="0.0" max="2.0" class="form-control">
                            <div class="form-text">Exponent: 0.5 = square root scaling with morale. Default: 0.5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Physical Degradation & Form ─────────────────────────────── #}
            <div class="card cfg-section" data-section-id="physical-degradation" data-group="player-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-running text-muted"></i>
                    <span class="fw-semibold small">Physical Degradation &amp; Form</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls the hard cap on individual player attributes, physical pace/stamina
                        decay after a configurable age threshold, and how recent match form influences
                        the weekly development multiplier.
                    </p>

                    <p class="fw-semibold small mb-2">Attribute Cap</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="attributeHardCap" class="form-label fw-semibold small">Attribute Hard Cap</label>
                            <input type="number" id="attributeHardCap" name="attributeHardCap"
                                   value="{{ config.attributeHardCap }}"
                                   step="1" min="1" max="100" class="form-control">
                            <div class="form-text">Maximum value for any individual player attribute</div>
                        </div>
                    </div>

                    <p class="fw-semibold small mb-2">Physical Degradation (after age threshold)</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="physicalDegradationAgeThreshold" class="form-label fw-semibold small">Age Threshold</label>
                            <input type="number" id="physicalDegradationAgeThreshold" name="physicalDegradationAgeThreshold"
                                   value="{{ config.physicalDegradationAgeThreshold }}"
                                   step="1" min="25" max="40" class="form-control">
                            <div class="form-text">Age degradation begins (players at or below this age are unaffected)</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateMild" class="form-label fw-semibold small">Mild Rate (threshold+1 to +3)</label>
                            <input type="number" id="physicalDegradationRateMild" name="physicalDegradationRateMild"
                                   value="{{ config.physicalDegradationRateMild }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly pace/stamina loss: age threshold+1 to threshold+3</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateModerate" class="form-label fw-semibold small">Moderate Rate (threshold+4 to +6)</label>
                            <input type="number" id="physicalDegradationRateModerate" name="physicalDegradationRateModerate"
                                   value="{{ config.physicalDegradationRateModerate }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly loss: age threshold+4 to threshold+6</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationRateSevere" class="form-label fw-semibold small">Severe Rate (threshold+7+)</label>
                            <input type="number" id="physicalDegradationRateSevere" name="physicalDegradationRateSevere"
                                   value="{{ config.physicalDegradationRateSevere }}"
                                   step="0.05" min="0" max="2.0" class="form-control">
                            <div class="form-text">Weekly loss: age threshold+7 and above</div>
                        </div>
                        <div class="col-md-3">
                            <label for="physicalDegradationPersonalityScale" class="form-label fw-semibold small">Personality Scale</label>
                            <input type="number" id="physicalDegradationPersonalityScale" name="physicalDegradationPersonalityScale"
                                   value="{{ config.physicalDegradationPersonalityScale }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">How much heart/determination trait reduces degradation rate</div>
                        </div>
                    </div>

                    <p class="fw-semibold small mb-2">Form &amp; Development</p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="formDevelopmentMatchCount" class="form-label fw-semibold small">Match Count</label>
                            <input type="number" id="formDevelopmentMatchCount" name="formDevelopmentMatchCount"
                                   value="{{ config.formDevelopmentMatchCount }}"
                                   step="1" min="1" max="20" class="form-control">
                            <div class="form-text">Recent matches used for form average</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentThreshold" class="form-label fw-semibold small">Full Development Threshold</label>
                            <input type="number" id="formDevelopmentThreshold" name="formDevelopmentThreshold"
                                   value="{{ config.formDevelopmentThreshold }}"
                                   step="0.1" min="1" max="10" class="form-control">
                            <div class="form-text">Rating average for full development (1.0×)</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentThresholdLow" class="form-label fw-semibold small">Low Threshold</label>
                            <input type="number" id="formDevelopmentThresholdLow" name="formDevelopmentThresholdLow"
                                   value="{{ config.formDevelopmentThresholdLow }}"
                                   step="0.1" min="1" max="10" class="form-control">
                            <div class="form-text">Rating average below which low multiplier applies</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentMultiplierMid" class="form-label fw-semibold small">Mid Multiplier</label>
                            <input type="number" id="formDevelopmentMultiplierMid" name="formDevelopmentMultiplierMid"
                                   value="{{ config.formDevelopmentMultiplierMid }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">Development rate between low and full threshold</div>
                        </div>
                        <div class="col-md-3">
                            <label for="formDevelopmentMultiplierLow" class="form-label fw-semibold small">Low Multiplier</label>
                            <input type="number" id="formDevelopmentMultiplierLow" name="formDevelopmentMultiplierLow"
                                   value="{{ config.formDevelopmentMultiplierLow }}"
                                   step="0.05" min="0" max="1.0" class="form-control">
                            <div class="form-text">Development rate below low threshold</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Reputation ─────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="reputation" data-group="club-dev">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-chart-line text-muted"></i>
                    <span class="fw-semibold small">Reputation</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="reputationDeltaBase" class="form-label fw-semibold small">Delta Base</label>
                            <input type="number" id="reputationDeltaBase" name="reputationDeltaBase"
                                   value="{{ config.reputationDeltaBase }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">Base reputation delta per week before facility multiplier. Default: 0.15</div>
                        </div>
                        <div class="col-md-6">
                            <label for="reputationDeltaFacilityMultiplier" class="form-label fw-semibold small">Facility Multiplier</label>
                            <input type="number" id="reputationDeltaFacilityMultiplier" name="reputationDeltaFacilityMultiplier"
                                   value="{{ config.reputationDeltaFacilityMultiplier }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">Per-level facility multiplier applied to reputation delta. Default: 0.15</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Injury ─────────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="injury" data-group="match-settings">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-kit-medical text-muted"></i>
                    <span class="fw-semibold small">Injury</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="baseInjuryProbability" class="form-label fw-semibold small">Base Probability</label>
                            <input type="number" id="baseInjuryProbability" name="baseInjuryProbability"
                                   value="{{ config.baseInjuryProbability }}"
                                   step="0.0001" min="0" max="1" class="form-control">
                            <div class="form-text">Weekly injury chance per player (fraction). Default: 0.05</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injuryMinorWeight" class="form-label fw-semibold small">Minor Weight</label>
                            <input type="number" id="injuryMinorWeight" name="injuryMinorWeight"
                                   value="{{ config.injuryMinorWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for minor severity. Default: 60</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injuryModerateWeight" class="form-label fw-semibold small">Moderate Weight</label>
                            <input type="number" id="injuryModerateWeight" name="injuryModerateWeight"
                                   value="{{ config.injuryModerateWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for moderate severity. Default: 30</div>
                        </div>
                        <div class="col-md-3">
                            <label for="injurySeriousWeight" class="form-label fw-semibold small">Serious Weight</label>
                            <input type="number" id="injurySeriousWeight" name="injurySeriousWeight"
                                   value="{{ config.injurySeriousWeight }}"
                                   min="0" class="form-control">
                            <div class="form-text">Relative weight for serious severity. Default: 10</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Scouting ───────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="scouting" data-group="transfer">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-binoculars text-muted"></i>
                    <span class="fw-semibold small">Scouting</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how scouts reveal players and how active missions discover prospects each week.
                        The gem roll thresholds define a weighted table: a random float (0–1) is tested against
                        the four cutoffs in order to determine how many players are found per tick.
                        Example defaults: 25% chance of 0, 50% chance of 1, 10% chance of 2, 9% chance of 3, 6% chance of 4.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="scoutMoraleThreshold" class="form-label fw-semibold small">Morale Threshold</label>
                            <input type="number" id="scoutMoraleThreshold" name="scoutMoraleThreshold"
                                   value="{{ config.scoutMoraleThreshold }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Morale below this value halts all scouting progress. Default: 40</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutRevealWeeks" class="form-label fw-semibold small">Reveal Weeks</label>
                            <input type="number" id="scoutRevealWeeks" name="scoutRevealWeeks"
                                   value="{{ config.scoutRevealWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">Weekly ticks before an assigned player is fully revealed. Default: 2</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutAbilityErrorRange" class="form-label fw-semibold small">Ability Error Range</label>
                            <input type="number" id="scoutAbilityErrorRange" name="scoutAbilityErrorRange"
                                   value="{{ config.scoutAbilityErrorRange }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Max ±variance on perceived ability, scaled by scout accuracy. Default: 30</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutMaxAssignments" class="form-label fw-semibold small">Max Assignments</label>
                            <input type="number" id="scoutMaxAssignments" name="scoutMaxAssignments"
                                   value="{{ config.scoutMaxAssignments }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Max players a scout can be assigned to simultaneously. Default: 5</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutReportValidWeeks" class="form-label fw-semibold small">Scout Report Valid Weeks</label>
                            <input type="number" id="scoutReportValidWeeks" name="scoutReportValidWeeks"
                                   value="{{ config.scoutReportValidWeeks }}"
                                   min="1" max="104" class="form-control">
                            <div class="form-text">Weeks before scout report attributes begin to decay. Default: 26</div>
                        </div>
                        <div class="col-md-3">
                            <label for="scoutReportDecayRatePerWeek" class="form-label fw-semibold small">Attribute Decay Rate (per week)</label>
                            <input type="number" id="scoutReportDecayRatePerWeek" name="scoutReportDecayRatePerWeek"
                                   value="{{ config.scoutReportDecayRatePerWeek }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Noise added to each attribute per week of decay (0-100 scale). Default: 2</div>
                        </div>
                        <div class="col-md-3">
                            <label for="npcScoutRejectionCooldownWeeks" class="form-label fw-semibold small">Scout Rejection Cooldown (weeks)</label>
                            <input type="number" id="npcScoutRejectionCooldownWeeks" name="npcScoutRejectionCooldownWeeks"
                                   value="{{ config.npcScoutRejectionCooldownWeeks }}"
                                   min="1" max="104" class="form-control">
                            <div class="form-text">Weeks before a rejected scouting approach can be retried. Default: 52</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-semibold small">Mission Gem Roll Thresholds</label>
                        <div class="row g-2">
                            {% set thresholds = config.missionGemRollThresholds %}
                            <div class="col-md-3">
                                <label for="gemThreshold0" class="form-label small text-muted">0 players cutoff (t0)</label>
                                <input type="number" id="gemThreshold0" name="gemThreshold0"
                                       value="{{ thresholds[0] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">roll &lt; t0 → 0 found. Default: 0.25</div>
                            </div>
                            <div class="col-md-3">
                                <label for="gemThreshold1" class="form-label small text-muted">1 player cutoff (t1)</label>
                                <input type="number" id="gemThreshold1" name="gemThreshold1"
                                       value="{{ thresholds[1] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">t0 ≤ roll &lt; t1 → 1 found. Default: 0.75</div>
                            </div>
                            <div class="col-md-3">
                                <label for="gemThreshold2" class="form-label small text-muted">2 players cutoff (t2)</label>
                                <input type="number" id="gemThreshold2" name="gemThreshold2"
                                       value="{{ thresholds[2] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">t1 ≤ roll &lt; t2 → 2 found. Default: 0.85</div>
                            </div>
                            <div class="col-md-3">
                                <label for="gemThreshold3" class="form-label small text-muted">3 players cutoff (t3)</label>
                                <input type="number" id="gemThreshold3" name="gemThreshold3"
                                       value="{{ thresholds[3] }}"
                                       step="0.01" min="0" max="1" class="form-control">
                                <div class="form-text">t2 ≤ roll &lt; t3 → 3 found; ≥ t3 → 4. Default: 0.94</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Morale ─────────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="morale" data-group="league-config">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-face-smile text-muted"></i>
                    <span class="fw-semibold small">Morale</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Range used when assigning starting morale to newly recruited or generated entities.
                        A random value between min and max is selected at creation time.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="defaultMoraleMin" class="form-label fw-semibold small">Default Morale Min</label>
                            <input type="number" id="defaultMoraleMin" name="defaultMoraleMin"
                                   value="{{ config.defaultMoraleMin }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Minimum starting morale (0–100). Default: 50</div>
                        </div>
                        <div class="col-md-4">
                            <label for="defaultMoraleMax" class="form-label fw-semibold small">Default Morale Max</label>
                            <input type="number" id="defaultMoraleMax" name="defaultMoraleMax"
                                   value="{{ config.defaultMoraleMax }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Maximum starting morale (0–100). Default: 80</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Incidents ──────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="incidents" data-group="event-config">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-bolt text-muted"></i>
                    <span class="fw-semibold small">Incidents</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls the frequency and escalation of personality-driven incidents during the weekly tick.
                        Professionalism and determination thresholds use the trait's 1–20 scale.
                        Chances are weekly probabilities (0–1).
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="incidentLowProfessionalismThreshold" class="form-label fw-semibold small">Low Professionalism Threshold</label>
                            <input type="number" id="incidentLowProfessionalismThreshold" name="incidentLowProfessionalismThreshold"
                                   value="{{ config.incidentLowProfessionalismThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value below which late-training incidents can fire. Default: 6</div>
                        </div>
                        <div class="col-md-3">
                            <label for="incidentLowProfessionalismChance" class="form-label fw-semibold small">Low Professionalism Chance</label>
                            <input type="number" id="incidentLowProfessionalismChance" name="incidentLowProfessionalismChance"
                                   value="{{ config.incidentLowProfessionalismChance }}"
                                   step="0.01" min="0" max="1" class="form-control">
                            <div class="form-text">Weekly probability of firing. Default: 0.3</div>
                        </div>
                        <div class="col-md-3">
                            <label for="incidentHighDeterminationThreshold" class="form-label fw-semibold small">High Determination Threshold</label>
                            <input type="number" id="incidentHighDeterminationThreshold" name="incidentHighDeterminationThreshold"
                                   value="{{ config.incidentHighDeterminationThreshold }}"
                                   min="1" max="20" class="form-control">
                            <div class="form-text">Trait value above which extra-effort incidents can fire. Default: 15</div>
                        </div>
                        <div class="col-md-3">
                            <label for="incidentHighDeterminationChance" class="form-label fw-semibold small">High Determination Chance</label>
                            <input type="number" id="incidentHighDeterminationChance" name="incidentHighDeterminationChance"
                                   value="{{ config.incidentHighDeterminationChance }}"
                                   step="0.01" min="0" max="1" class="form-control">
                            <div class="form-text">Weekly probability of firing. Default: 0.25</div>
                        </div>
                        <div class="col-md-4">
                            <label for="incidentAltercationBaseChance" class="form-label fw-semibold small">Altercation Base Chance</label>
                            <input type="number" id="incidentAltercationBaseChance" name="incidentAltercationBaseChance"
                                   value="{{ config.incidentAltercationBaseChance }}"
                                   step="0.01" min="0" max="1" class="form-control">
                            <div class="form-text">Base weekly chance any player pair clashes. Default: 0.10</div>
                        </div>
                        <div class="col-md-4">
                            <label for="incidentAltercationSeriousBase" class="form-label fw-semibold small">Altercation Serious Base</label>
                            <input type="number" id="incidentAltercationSeriousBase" name="incidentAltercationSeriousBase"
                                   value="{{ config.incidentAltercationSeriousBase }}"
                                   step="0.01" min="0" max="1" class="form-control">
                            <div class="form-text">Floor probability for serious escalation. Default: 0.2</div>
                        </div>
                        <div class="col-md-4">
                            <label for="incidentAltercationSeriousTemperamentScale" class="form-label fw-semibold small">Altercation Temperament Scale</label>
                            <input type="number" id="incidentAltercationSeriousTemperamentScale" name="incidentAltercationSeriousTemperamentScale"
                                   value="{{ config.incidentAltercationSeriousTemperamentScale }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">How much temperament amplifies escalation. Default: 0.5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Transfer Market ────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="transfer" data-group="transfer">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-money-bill-transfer text-muted"></i>
                    <span class="fw-semibold small">Transfer Market</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="playerFeeMultiplier" class="form-label fw-semibold small">Player Fee Multiplier</label>
                            <input type="number" id="playerFeeMultiplier" name="playerFeeMultiplier"
                                   value="{{ config.playerFeeMultiplier }}"
                                   step="1" min="1" class="form-control">
                            <div class="form-text">Controls player transfer fee scale. Default 1000. Higher = larger fees.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="playerWageMultiplier" class="form-label fw-semibold small">Player Wage Multiplier</label>
                            <input type="number" id="playerWageMultiplier" name="playerWageMultiplier"
                                   value="{{ config.playerWageMultiplier }}"
                                   step="0.01" min="0" class="form-control">
                            <div class="form-text">Global multiplier applied to all player wage calculations. Default 1.0. Higher = larger wages.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="freeTransfersPerSeason" class="form-label fw-semibold small">Free Transfers Per Season</label>
                            <input type="number" id="freeTransfersPerSeason" name="freeTransfersPerSeason"
                                   value="{{ config.freeTransfersPerSeason }}"
                                   step="1" min="0" class="form-control">
                            <div class="form-text">Number of zero-fee transfers a club may make per season. Default 3.</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Guardian Complaints ─────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="guardian" data-group="event-config">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-family text-muted"></i>
                    <span class="fw-semibold small">Guardian Complaints</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Effects applied to the player and their guardian when the manager responds to a complaint.
                        <strong>Convince</strong> costs money but boosts morale and loyalty.
                        <strong>Ignore</strong> damages morale, loyalty trait, and guardian relationship — siblings with the same surname are also affected.
                    </p>
                    <div class="row g-3">
                        <div class="col-12"><p class="fw-semibold small mb-0 text-success">✓ Convince</p></div>
                        <div class="col-md-4">
                            <label for="guardianConvinceMoraleBoost" class="form-label fw-semibold small">Player Morale Boost</label>
                            <input type="number" id="guardianConvinceMoraleBoost" name="guardianConvinceMoraleBoost"
                                   value="{{ config.guardianConvinceMoraleBoost }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Morale added to the player. Default: 5</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianConvinceGuardianLoyaltyBoost" class="form-label fw-semibold small">Guardian Loyalty Boost</label>
                            <input type="number" id="guardianConvinceGuardianLoyaltyBoost" name="guardianConvinceGuardianLoyaltyBoost"
                                   value="{{ config.guardianConvinceGuardianLoyaltyBoost }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Loyalty added to the worst guardian. Default: 8</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianConvinceGuardianDemandIncrease" class="form-label fw-semibold small">Guardian Demand Increase</label>
                            <input type="number" id="guardianConvinceGuardianDemandIncrease" name="guardianConvinceGuardianDemandIncrease"
                                   value="{{ config.guardianConvinceGuardianDemandIncrease }}"
                                   min="0" max="10" class="form-control">
                            <div class="form-text">Demand level added to the worst guardian (capped at 10). Default: 1</div>
                        </div>

                        <div class="col-12 mt-2"><p class="fw-semibold small mb-0 text-danger">✗ Ignore</p></div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreMoralePenalty" class="form-label fw-semibold small">Player Morale Penalty</label>
                            <input type="number" id="guardianIgnoreMoralePenalty" name="guardianIgnoreMoralePenalty"
                                   value="{{ config.guardianIgnoreMoralePenalty }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Morale deducted from the player. Default: 8</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreLoyaltyTraitPenalty" class="form-label fw-semibold small">Player Loyalty Trait Penalty</label>
                            <input type="number" id="guardianIgnoreLoyaltyTraitPenalty" name="guardianIgnoreLoyaltyTraitPenalty"
                                   value="{{ config.guardianIgnoreLoyaltyTraitPenalty }}"
                                   min="0" max="20" class="form-control">
                            <div class="form-text">Loyalty trait deducted from the player. Default: 3</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreGuardianLoyaltyPenalty" class="form-label fw-semibold small">Guardian Loyalty Penalty</label>
                            <input type="number" id="guardianIgnoreGuardianLoyaltyPenalty" name="guardianIgnoreGuardianLoyaltyPenalty"
                                   value="{{ config.guardianIgnoreGuardianLoyaltyPenalty }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Loyalty deducted from the worst guardian. Default: 12</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreGuardianDemandIncrease" class="form-label fw-semibold small">Guardian Demand Increase</label>
                            <input type="number" id="guardianIgnoreGuardianDemandIncrease" name="guardianIgnoreGuardianDemandIncrease"
                                   value="{{ config.guardianIgnoreGuardianDemandIncrease }}"
                                   min="0" max="10" class="form-control">
                            <div class="form-text">Demand level added to the worst guardian (capped at 10). Default: 2</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreSiblingMoralePenalty" class="form-label fw-semibold small">Sibling Morale Penalty</label>
                            <input type="number" id="guardianIgnoreSiblingMoralePenalty" name="guardianIgnoreSiblingMoralePenalty"
                                   value="{{ config.guardianIgnoreSiblingMoralePenalty }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Morale deducted from surname-matching siblings. Default: 5</div>
                        </div>
                        <div class="col-md-4">
                            <label for="guardianIgnoreSiblingLoyaltyTraitPenalty" class="form-label fw-semibold small">Sibling Loyalty Trait Penalty</label>
                            <input type="number" id="guardianIgnoreSiblingLoyaltyTraitPenalty" name="guardianIgnoreSiblingLoyaltyTraitPenalty"
                                   value="{{ config.guardianIgnoreSiblingLoyaltyTraitPenalty }}"
                                   min="0" max="20" class="form-control">
                            <div class="form-text">Loyalty trait deducted from siblings. Default: 2</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── League Finances ─────────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="league-finances" data-group="league-config">
                <div class="card-header fw-semibold">League Finances</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12"><p class="small text-muted mb-0">Sponsor income ranges in <strong>£ (pounds)</strong> per season. Re-rolled each conclude-season.</p></div>

                        <div class="col-md-3">
                            <label for="smallSponsorMin" class="form-label fw-semibold small">Small Sponsor Min</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="smallSponsorMin" name="smallSponsorMin"
                                       value="{{ config.smallSponsorMin / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Minimum per-season income for SMALL sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="smallSponsorMax" class="form-label fw-semibold small">Small Sponsor Max</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="smallSponsorMax" name="smallSponsorMax"
                                       value="{{ config.smallSponsorMax / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Maximum per-season income for SMALL sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="mediumSponsorMin" class="form-label fw-semibold small">Medium Sponsor Min</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="mediumSponsorMin" name="mediumSponsorMin"
                                       value="{{ config.mediumSponsorMin / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Minimum per-season income for MEDIUM sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="mediumSponsorMax" class="form-label fw-semibold small">Medium Sponsor Max</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="mediumSponsorMax" name="mediumSponsorMax"
                                       value="{{ config.mediumSponsorMax / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Maximum per-season income for MEDIUM sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="largeSponsorMin" class="form-label fw-semibold small">Large Sponsor Min</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="largeSponsorMin" name="largeSponsorMin"
                                       value="{{ config.largeSponsorMin / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Minimum per-season income for LARGE sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="largeSponsorMax" class="form-label fw-semibold small">Large Sponsor Max</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input type="number" id="largeSponsorMax" name="largeSponsorMax"
                                       value="{{ config.largeSponsorMax / 100 }}"
                                       min="0" step="1" class="form-control">
                            </div>
                            <div class="form-text">Maximum per-season income for LARGE sponsors.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="leaguePositionDecreasePercent" class="form-label fw-semibold small">Position Prize Decrease %</label>
                            <input type="number" id="leaguePositionDecreasePercent" name="leaguePositionDecreasePercent"
                                   value="{{ config.leaguePositionDecreasePercent }}"
                                   min="1" max="99" class="form-control">
                            <div class="form-text">% reduction per finishing position for leaguePositionPot distribution. Default: 5</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Financial Penalties ──────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="financial-penalties" data-group="league-config">
                <div class="card-header fw-semibold">Financial Penalties</div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Controls the points deduction mechanic applied to clubs with a negative balance
                        at season end. Deductions take effect in the following season.
                    </p>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="bankruptcyDeductionsEnabled"
                                       name="bankruptcyDeductionsEnabled" value="1"
                                       {{ config.bankruptcyDeductionsEnabled ? 'checked' : '' }}>
                                <label class="form-check-label fw-semibold small" for="bankruptcyDeductionsEnabled">
                                    Enable points deductions for negative balance at season end
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label for="bankruptcyDeductionTiers" class="form-label fw-semibold small">Deficit Tiers (JSON)</label>
                            <textarea id="bankruptcyDeductionTiers" name="bankruptcyDeductionTiers"
                                      rows="6" class="form-control font-monospace"
                                      placeholder='[{"deficitMin":1,"deficitMax":200000,"points":3},{"deficitMin":200001,"deficitMax":500000,"points":6},{"deficitMin":500001,"deficitMax":null,"points":10}]'>{{ config.bankruptcyDeductionTiers|json_encode }}</textarea>
                            <div class="form-text">
                                Array of <code>{ deficitMin, deficitMax, points }</code> tiers evaluated in order — first match wins.
                                <code>deficitMax: null</code> means no upper bound. All values in <strong>pence</strong>.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Staff Limits Per Club ────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="staff-limits" data-group="club-dev">
                <div class="card-header fw-semibold">Staff Limits Per Club</div>
                <div class="card-body">
                    <p class="small text-muted mb-3">Maximum number of each staff type a single club is allowed to hold.</p>
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label for="maxCoachesPerClub" class="form-label fw-semibold small">Coaches</label>
                            <input type="number" id="maxCoachesPerClub" name="maxCoachesPerClub"
                                   value="{{ config.maxCoachesPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 15</div>
                        </div>
                        <div class="col-md-2">
                            <label for="maxManagersPerClub" class="form-label fw-semibold small">Managers</label>
                            <input type="number" id="maxManagersPerClub" name="maxManagersPerClub"
                                   value="{{ config.maxManagersPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 1</div>
                        </div>
                        <div class="col-md-2">
                            <label for="maxDirectorsOfFootballPerClub" class="form-label fw-semibold small">Directors of Football</label>
                            <input type="number" id="maxDirectorsOfFootballPerClub" name="maxDirectorsOfFootballPerClub"
                                   value="{{ config.maxDirectorsOfFootballPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 1</div>
                        </div>
                        <div class="col-md-2">
                            <label for="maxFacilityManagersPerClub" class="form-label fw-semibold small">Facility Managers</label>
                            <input type="number" id="maxFacilityManagersPerClub" name="maxFacilityManagersPerClub"
                                   value="{{ config.maxFacilityManagersPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 1</div>
                        </div>
                        <div class="col-md-2">
                            <label for="maxChairmensPerClub" class="form-label fw-semibold small">Chairmen</label>
                            <input type="number" id="maxChairmensPerClub" name="maxChairmensPerClub"
                                   value="{{ config.maxChairmensPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 1</div>
                        </div>
                        <div class="col-md-2">
                            <label for="maxScoutsPerClub" class="form-label fw-semibold small">Scouts</label>
                            <input type="number" id="maxScoutsPerClub" name="maxScoutsPerClub"
                                   value="{{ config.maxScoutsPerClub }}"
                                   min="0" class="form-control">
                            <div class="form-text">Default: 3</div>
                        </div>
                    </div>

                    <hr class="my-3">
