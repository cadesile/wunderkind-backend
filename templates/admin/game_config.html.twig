                    </div>
                </div>
            </div>

            {# ── Injury ─────────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="injury" data-group="match-settings">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">INJURY</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BASE PROBABILITY</span><span class="bmc-setting__help">Weekly injury chance per player (fraction). Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="baseInjuryProbability" value="{{ config.baseInjuryProbability }}" data-saved="{{ config.baseInjuryProbability }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="base probability"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MINOR WEIGHT</span><span class="bmc-setting__help">Relative weight for minor severity. Default: 60</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="injuryMinorWeight" value="{{ config.injuryMinorWeight }}" data-saved="{{ config.injuryMinorWeight }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="minor weight"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MODERATE WEIGHT</span><span class="bmc-setting__help">Relative weight for moderate severity. Default: 30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="injuryModerateWeight" value="{{ config.injuryModerateWeight }}" data-saved="{{ config.injuryModerateWeight }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="moderate weight"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SERIOUS WEIGHT</span><span class="bmc-setting__help">Relative weight for serious severity. Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="injurySeriousWeight" value="{{ config.injurySeriousWeight }}" data-saved="{{ config.injurySeriousWeight }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="serious weight"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Scouting ───────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="scouting" data-group="transfer">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SCOUTING</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how scouts reveal players and how active missions discover prospects each week.
                        The gem roll thresholds define a weighted table: a random float (0–1) is tested against
                        the four cutoffs in order to determine how many players are found per tick.
                        Example defaults: 25% chance of 0, 50% chance of 1, 10% chance of 2, 9% chance of 3, 6% chance of 4.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE THRESHOLD</span><span class="bmc-setting__help">Morale below this value halts all scouting progress. Default: 40</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutMoraleThreshold" value="{{ config.scoutMoraleThreshold }}" data-saved="{{ config.scoutMoraleThreshold }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="morale threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">REVEAL WEEKS</span><span class="bmc-setting__help">Weekly ticks before an assigned player is fully revealed. Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutRevealWeeks" value="{{ config.scoutRevealWeeks }}" data-saved="{{ config.scoutRevealWeeks }}" data-kind="int" data-min="1" data-max="52" inputmode="numeric" aria-label="reveal weeks"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ABILITY ERROR RANGE</span><span class="bmc-setting__help">Max ±variance on perceived ability, scaled by scout accuracy. Default: 30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutAbilityErrorRange" value="{{ config.scoutAbilityErrorRange }}" data-saved="{{ config.scoutAbilityErrorRange }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="ability error range"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MAX ASSIGNMENTS</span><span class="bmc-setting__help">Max players a scout can be assigned to simultaneously. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutMaxAssignments" value="{{ config.scoutMaxAssignments }}" data-saved="{{ config.scoutMaxAssignments }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="max assignments"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SCOUT REPORT VALID WEEKS</span><span class="bmc-setting__help">Weeks before scout report attributes begin to decay. Default: 26</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutReportValidWeeks" value="{{ config.scoutReportValidWeeks }}" data-saved="{{ config.scoutReportValidWeeks }}" data-kind="int" data-min="1" data-max="104" inputmode="numeric" aria-label="scout report valid weeks"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ATTRIBUTE DECAY RATE (PER WEEK)</span><span class="bmc-setting__help">Noise added to each attribute per week of decay (0-100 scale). Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutReportDecayRatePerWeek" value="{{ config.scoutReportDecayRatePerWeek }}" data-saved="{{ config.scoutReportDecayRatePerWeek }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="attribute decay rate (per week)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SCOUT REJECTION COOLDOWN (WEEKS)</span><span class="bmc-setting__help">Weeks before a rejected scouting approach can be retried. Default: 52</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="npcScoutRejectionCooldownWeeks" value="{{ config.npcScoutRejectionCooldownWeeks }}" data-saved="{{ config.npcScoutRejectionCooldownWeeks }}" data-kind="int" data-min="1" data-max="104" inputmode="numeric" aria-label="scout rejection cooldown (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <div class="mt-3">
                        <label>Mission Gem Roll Thresholds</label>
                        <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                            {% set thresholds = config.missionGemRollThresholds %}
                            <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">0 PLAYERS CUTOFF (T0)</span><span class="bmc-setting__help">roll &lt; t0 → 0 found. Default: 0.25</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gemThreshold0" value="{{ thresholds[0] }}" data-saved="{{ thresholds[0] }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="0 players cutoff (t0)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                            <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">1 PLAYER CUTOFF (T1)</span><span class="bmc-setting__help">t0 ≤ roll &lt; t1 → 1 found. Default: 0.75</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gemThreshold1" value="{{ thresholds[1] }}" data-saved="{{ thresholds[1] }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="1 player cutoff (t1)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                            <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">2 PLAYERS CUTOFF (T2)</span><span class="bmc-setting__help">t1 ≤ roll &lt; t2 → 2 found. Default: 0.85</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gemThreshold2" value="{{ thresholds[2] }}" data-saved="{{ thresholds[2] }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="2 players cutoff (t2)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                            <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">3 PLAYERS CUTOFF (T3)</span><span class="bmc-setting__help">t2 ≤ roll &lt; t3 → 3 found; ≥ t3 → 4. Default: 0.94</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gemThreshold3" value="{{ thresholds[3] }}" data-saved="{{ thresholds[3] }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="3 players cutoff (t3)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Morale ─────────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="morale" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Range used when assigning starting morale to newly recruited or generated entities.
                        A random value between min and max is selected at creation time.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DEFAULT MORALE MIN</span><span class="bmc-setting__help">Minimum starting morale (0–100). Default: 50</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="defaultMoraleMin" value="{{ config.defaultMoraleMin }}" data-saved="{{ config.defaultMoraleMin }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="default morale min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DEFAULT MORALE MAX</span><span class="bmc-setting__help">Maximum starting morale (0–100). Default: 80</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="defaultMoraleMax" value="{{ config.defaultMoraleMax }}" data-saved="{{ config.defaultMoraleMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="default morale max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Incidents ──────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="incidents" data-group="event-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">INCIDENTS</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls the frequency and escalation of personality-driven incidents during the weekly tick.
                        Professionalism and determination thresholds use the trait's 1–20 scale.
                        Chances are weekly probabilities (0–1).
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOW PROFESSIONALISM THRESHOLD</span><span class="bmc-setting__help">Trait value below which late-training incidents can fire. Default: 6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentLowProfessionalismThreshold" value="{{ config.incidentLowProfessionalismThreshold }}" data-saved="{{ config.incidentLowProfessionalismThreshold }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="low professionalism threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOW PROFESSIONALISM CHANCE</span><span class="bmc-setting__help">Weekly probability of firing. Default: 0.3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentLowProfessionalismChance" value="{{ config.incidentLowProfessionalismChance }}" data-saved="{{ config.incidentLowProfessionalismChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="low professionalism chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">HIGH DETERMINATION THRESHOLD</span><span class="bmc-setting__help">Trait value above which extra-effort incidents can fire. Default: 15</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentHighDeterminationThreshold" value="{{ config.incidentHighDeterminationThreshold }}" data-saved="{{ config.incidentHighDeterminationThreshold }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="high determination threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">HIGH DETERMINATION CHANCE</span><span class="bmc-setting__help">Weekly probability of firing. Default: 0.25</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentHighDeterminationChance" value="{{ config.incidentHighDeterminationChance }}" data-saved="{{ config.incidentHighDeterminationChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="high determination chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ALTERCATION BASE CHANCE</span><span class="bmc-setting__help">Base weekly chance any player pair clashes. Default: 0.10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentAltercationBaseChance" value="{{ config.incidentAltercationBaseChance }}" data-saved="{{ config.incidentAltercationBaseChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="altercation base chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ALTERCATION SERIOUS BASE</span><span class="bmc-setting__help">Floor probability for serious escalation. Default: 0.2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentAltercationSeriousBase" value="{{ config.incidentAltercationSeriousBase }}" data-saved="{{ config.incidentAltercationSeriousBase }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="altercation serious base"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ALTERCATION TEMPERAMENT SCALE</span><span class="bmc-setting__help">How much temperament amplifies escalation. Default: 0.5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="incidentAltercationSeriousTemperamentScale" value="{{ config.incidentAltercationSeriousTemperamentScale }}" data-saved="{{ config.incidentAltercationSeriousTemperamentScale }}" data-kind="decimal" data-min="0" inputmode="decimal" aria-label="altercation temperament scale"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Transfer Market ────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="transfer" data-group="transfer">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">TRANSFER MARKET</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER FEE MULTIPLIER</span><span class="bmc-setting__help">Controls player transfer fee scale. Default 1000. Higher = larger fees.</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="playerFeeMultiplier" value="{{ config.playerFeeMultiplier }}" data-saved="{{ config.playerFeeMultiplier }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="player fee multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER WAGE MULTIPLIER</span><span class="bmc-setting__help">Global multiplier applied to all player wage calculations. Default 1.0. Higher = larger wages.</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="playerWageMultiplier" value="{{ config.playerWageMultiplier }}" data-saved="{{ config.playerWageMultiplier }}" data-kind="decimal" data-min="0" inputmode="decimal" aria-label="player wage multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FREE TRANSFERS PER SEASON</span><span class="bmc-setting__help">Number of zero-fee transfers a club may make per season. Default 3.</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="freeTransfersPerSeason" value="{{ config.freeTransfersPerSeason }}" data-saved="{{ config.freeTransfersPerSeason }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="free transfers per season"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Guardian Complaints ─────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="guardian" data-group="event-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">GUARDIAN COMPLAINTS</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Effects applied to the player and their guardian when the manager responds to a complaint.
                        <strong>Convince</strong> costs money but boosts morale and loyalty.
                        <strong>Ignore</strong> damages morale, loyalty trait, and guardian relationship — siblings with the same surname are also affected.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col"><p class="fw-semibold small mb-0 text-success">✓ Convince</p></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER MORALE BOOST</span><span class="bmc-setting__help">Morale added to the player. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianConvinceMoraleBoost" value="{{ config.guardianConvinceMoraleBoost }}" data-saved="{{ config.guardianConvinceMoraleBoost }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="player morale boost"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">GUARDIAN LOYALTY BOOST</span><span class="bmc-setting__help">Loyalty added to the worst guardian. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianConvinceGuardianLoyaltyBoost" value="{{ config.guardianConvinceGuardianLoyaltyBoost }}" data-saved="{{ config.guardianConvinceGuardianLoyaltyBoost }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="guardian loyalty boost"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">GUARDIAN DEMAND INCREASE</span><span class="bmc-setting__help">Demand level added to the worst guardian (capped at 10). Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianConvinceGuardianDemandIncrease" value="{{ config.guardianConvinceGuardianDemandIncrease }}" data-saved="{{ config.guardianConvinceGuardianDemandIncrease }}" data-kind="int" data-min="0" data-max="10" inputmode="numeric" aria-label="guardian demand increase"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>

                        <div class="bmc-field-col"><p class="fw-semibold small mb-0 text-danger">✗ Ignore</p></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER MORALE PENALTY</span><span class="bmc-setting__help">Morale deducted from the player. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreMoralePenalty" value="{{ config.guardianIgnoreMoralePenalty }}" data-saved="{{ config.guardianIgnoreMoralePenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="player morale penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER LOYALTY TRAIT PENALTY</span><span class="bmc-setting__help">Loyalty trait deducted from the player. Default: 3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreLoyaltyTraitPenalty" value="{{ config.guardianIgnoreLoyaltyTraitPenalty }}" data-saved="{{ config.guardianIgnoreLoyaltyTraitPenalty }}" data-kind="int" data-min="0" data-max="20" inputmode="numeric" aria-label="player loyalty trait penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">GUARDIAN LOYALTY PENALTY</span><span class="bmc-setting__help">Loyalty deducted from the worst guardian. Default: 12</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreGuardianLoyaltyPenalty" value="{{ config.guardianIgnoreGuardianLoyaltyPenalty }}" data-saved="{{ config.guardianIgnoreGuardianLoyaltyPenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="guardian loyalty penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">GUARDIAN DEMAND INCREASE</span><span class="bmc-setting__help">Demand level added to the worst guardian (capped at 10). Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreGuardianDemandIncrease" value="{{ config.guardianIgnoreGuardianDemandIncrease }}" data-saved="{{ config.guardianIgnoreGuardianDemandIncrease }}" data-kind="int" data-min="0" data-max="10" inputmode="numeric" aria-label="guardian demand increase"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SIBLING MORALE PENALTY</span><span class="bmc-setting__help">Morale deducted from surname-matching siblings. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreSiblingMoralePenalty" value="{{ config.guardianIgnoreSiblingMoralePenalty }}" data-saved="{{ config.guardianIgnoreSiblingMoralePenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="sibling morale penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SIBLING LOYALTY TRAIT PENALTY</span><span class="bmc-setting__help">Loyalty trait deducted from siblings. Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="guardianIgnoreSiblingLoyaltyTraitPenalty" value="{{ config.guardianIgnoreSiblingLoyaltyTraitPenalty }}" data-saved="{{ config.guardianIgnoreSiblingLoyaltyTraitPenalty }}" data-kind="int" data-min="0" data-max="20" inputmode="numeric" aria-label="sibling loyalty trait penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── League Finances ─────────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="league-finances" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">LEAGUE FINANCES</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col"><p class="small  mb-0">Sponsor income ranges in <strong>£ (pounds)</strong> per season. Re-rolled each conclude-season.</p></div>

                        <div class="bmc-field-col">
                            <label for="smallSponsorMin">Small Sponsor Min</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="smallSponsorMin" value="{{ config.smallSponsorMin / 100 }}" data-saved="{{ config.smallSponsorMin / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Minimum per-season income for SMALL sponsors.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="smallSponsorMax">Small Sponsor Max</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="smallSponsorMax" value="{{ config.smallSponsorMax / 100 }}" data-saved="{{ config.smallSponsorMax / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Maximum per-season income for SMALL sponsors.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="mediumSponsorMin">Medium Sponsor Min</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="mediumSponsorMin" value="{{ config.mediumSponsorMin / 100 }}" data-saved="{{ config.mediumSponsorMin / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Minimum per-season income for MEDIUM sponsors.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="mediumSponsorMax">Medium Sponsor Max</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="mediumSponsorMax" value="{{ config.mediumSponsorMax / 100 }}" data-saved="{{ config.mediumSponsorMax / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Maximum per-season income for MEDIUM sponsors.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="largeSponsorMin">Large Sponsor Min</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="largeSponsorMin" value="{{ config.largeSponsorMin / 100 }}" data-saved="{{ config.largeSponsorMin / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Minimum per-season income for LARGE sponsors.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="largeSponsorMax">Large Sponsor Max</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="largeSponsorMax" value="{{ config.largeSponsorMax / 100 }}" data-saved="{{ config.largeSponsorMax / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Maximum per-season income for LARGE sponsors.</div>
                        </div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">POSITION PRIZE DECREASE %</span><span class="bmc-setting__help">% reduction per finishing position for leaguePositionPot distribution. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="leaguePositionDecreasePercent" value="{{ config.leaguePositionDecreasePercent }}" data-saved="{{ config.leaguePositionDecreasePercent }}" data-kind="int" data-min="1" data-max="99" inputmode="numeric" aria-label="position prize decrease %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Youth Academy ────────────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="youth-academy" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">YOUTH ACADEMY</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">
                        Terms for a player <strong>signed</strong> below the first-team age — an academy
                        scholarship. This does not affect academy <strong>intake</strong> players, who
                        join on no wage and are only put on a real one when they turn 16.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col">
                            <label for="youthScholarshipWagePence">Scholarship Wage</label>
                            <label class="bmc-num bmc-num--104"><span class="bmc-num__unit">£</span><input name="youthScholarshipWagePence" value="{{ config.youthScholarshipWagePence / 100 }}" data-saved="{{ config.youthScholarshipWagePence / 100 }}" data-kind="int" data-min="0" inputmode="numeric"></label>
                            <div class="bmc-data">Flat weekly wage for every signed scholar, in pounds. Default: 250</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Financial Penalties ──────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="financial-penalties" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">FINANCIAL PENALTIES</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">
                        Controls the points deduction mechanic applied to clubs with a negative balance
                        at season end. Deductions take effect in the following season.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col">
                            <div class="bmc-check">
                                <input  type="checkbox" id="bankruptcyDeductionsEnabled"
                                       name="bankruptcyDeductionsEnabled" value="1"
                                       {{ config.bankruptcyDeductionsEnabled ? 'checked' : '' }}>
                                <label for="bankruptcyDeductionsEnabled">
                                    Enable points deductions for negative balance at season end
                                </label>
                            </div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="bankruptcyDeductionTiers">Deficit Tiers (JSON)</label>
                            <textarea id="bankruptcyDeductionTiers" name="bankruptcyDeductionTiers"
                                      rows="6" 
                                      placeholder='[{"deficitMin":1,"deficitMax":200000,"points":3},{"deficitMin":200001,"deficitMax":500000,"points":6},{"deficitMin":500001,"deficitMax":null,"points":10}]' data-kind="text" data-blank="ok">{{ config.bankruptcyDeductionTiers|json_encode }}</textarea>
                            <div class="bmc-data">
                                Array of <code>{ deficitMin, deficitMax, points }</code> tiers evaluated in order — first match wins.
                                <code>deficitMax: null</code> means no upper bound. All values in <strong>pence</strong>.
                            </div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="npcSolvencyThresholds">NPC Solvency Thresholds (JSON)</label>
                            <textarea id="npcSolvencyThresholds" name="npcSolvencyThresholds"
                                      rows="3"
                                      placeholder='[4,12,26]' data-kind="text" data-blank="ok">{{ config.npcSolvencyThresholds|json_encode }}</textarea>
                            <div class="bmc-data">
                                <strong>Weeks in deficit</strong>, not money, at which an insolvent NPC club escalates:
                                <code>[warn, crisis, folded]</code>. Sorted ascending on save — the app walks it as a ladder,
                                so an out-of-order row would make a harsher rung unreachable. Read by the app; nothing
                                server-side consumes it. Default <code>[4,12,26]</code>.
                            </div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="dofWageBillThresholdPct">DoF Wage-Bill Thresholds (JSON)</label>
                            <textarea id="dofWageBillThresholdPct" name="dofWageBillThresholdPct"
                                      rows="3"
                                      placeholder='[0.4,0.5,0.6,0.7]' data-kind="text" data-blank="ok">{{ config.dofWageBillThresholdPct|json_encode }}</textarea>
                            <div class="bmc-data">
                                Wage-bill-to-turnover ratios at which a Director of Football starts objecting, as
                                <strong>fractions</strong> (<code>0.40</code> = 40%) — not basis points, because nothing
                                multiplies these into money; the app compares a ratio against them. Sorted ascending on save.
                                Default <code>[0.4,0.5,0.6,0.7]</code>.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Staff Limits Per Club ────────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="staff-limits" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">STAFF LIMITS PER CLUB</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">Maximum number of each staff type a single club is allowed to hold.</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACHES</span><span class="bmc-setting__help">Default: 15</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxCoachesPerClub" value="{{ config.maxCoachesPerClub }}" data-saved="{{ config.maxCoachesPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="coaches"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MANAGERS</span><span class="bmc-setting__help">Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxManagersPerClub" value="{{ config.maxManagersPerClub }}" data-saved="{{ config.maxManagersPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="managers"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DIRECTORS OF FOOTBALL</span><span class="bmc-setting__help">Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxDirectorsOfFootballPerClub" value="{{ config.maxDirectorsOfFootballPerClub }}" data-saved="{{ config.maxDirectorsOfFootballPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="directors of football"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FACILITY MANAGERS</span><span class="bmc-setting__help">Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxFacilityManagersPerClub" value="{{ config.maxFacilityManagersPerClub }}" data-saved="{{ config.maxFacilityManagersPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="facility managers"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">CHAIRMEN</span><span class="bmc-setting__help">Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxChairmensPerClub" value="{{ config.maxChairmensPerClub }}" data-saved="{{ config.maxChairmensPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="chairmen"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SCOUTS</span><span class="bmc-setting__help">Default: 3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="maxScoutsPerClub" value="{{ config.maxScoutsPerClub }}" data-saved="{{ config.maxScoutsPerClub }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="scouts"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <hr class="my-3">
                    <p class="small  mb-3">Sign-on fee as a % of the overall contract offer value.</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SIGN-ON % MIN</span><span class="bmc-setting__help">Default: 0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="signOnFeePercentMin" value="{{ config.signOnFeePercentMin }}" data-saved="{{ config.signOnFeePercentMin }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="sign-on % min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SIGN-ON % MAX</span><span class="bmc-setting__help">Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="signOnFeePercentMax" value="{{ config.signOnFeePercentMax }}" data-saved="{{ config.signOnFeePercentMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="sign-on % max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Sponsor Offer Probabilities ──────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="sponsor-probs" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SPONSOR OFFER PROBABILITIES</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">Weekly probability (0.0–1.0) that an academy receives a sponsor offer from each reputation tier.</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOCAL</span><span class="bmc-setting__help">Default: 0.30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorProbabilityLocal" value="{{ config.sponsorProbabilityLocal }}" data-saved="{{ config.sponsorProbabilityLocal }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="local"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">REGIONAL</span><span class="bmc-setting__help">Default: 0.20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorProbabilityRegional" value="{{ config.sponsorProbabilityRegional }}" data-saved="{{ config.sponsorProbabilityRegional }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="regional"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NATIONAL</span><span class="bmc-setting__help">Default: 0.10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorProbabilityNational" value="{{ config.sponsorProbabilityNational }}" data-saved="{{ config.sponsorProbabilityNational }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="national"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ELITE</span><span class="bmc-setting__help">Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorProbabilityElite" value="{{ config.sponsorProbabilityElite }}" data-saved="{{ config.sponsorProbabilityElite }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="elite"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Investor Offer Probabilities ─────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="investor-probs" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">INVESTOR OFFER PROBABILITIES</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">Weekly probability (0.0–1.0) that an academy receives an investor offer from each reputation tier.</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOCAL</span><span class="bmc-setting__help">Default: 0.20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="investorProbabilityLocal" value="{{ config.investorProbabilityLocal }}" data-saved="{{ config.investorProbabilityLocal }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="local"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">REGIONAL</span><span class="bmc-setting__help">Default: 0.12</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="investorProbabilityRegional" value="{{ config.investorProbabilityRegional }}" data-saved="{{ config.investorProbabilityRegional }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="regional"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NATIONAL</span><span class="bmc-setting__help">Default: 0.06</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="investorProbabilityNational" value="{{ config.investorProbabilityNational }}" data-saved="{{ config.investorProbabilityNational }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="national"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ELITE</span><span class="bmc-setting__help">Default: 0.02</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="investorProbabilityElite" value="{{ config.investorProbabilityElite }}" data-saved="{{ config.investorProbabilityElite }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="elite"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Sponsor & Investor Limits ────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="sponsor-investor-limits" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SPONSOR &AMP; INVESTOR LIMITS</span></div>
                <div class="bmc-card__body">
                    <p class="small  mb-3">Maximum active contracts per reputation tier. Keys: <code>local</code>, <code>regional</code>, <code>national</code>, <code>elite</code>. Integer slot counts.</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col">
                            <label for="maxSponsorsByTier">Max Sponsors by Tier (JSON)</label>
                            <textarea id="maxSponsorsByTier" name="maxSponsorsByTier"
                                      rows="3"  style="font-size:.8rem;" data-kind="text" data-blank="ok">{{ config.maxSponsorsByTier|json_encode }}</textarea>
                            <div class="bmc-data">Default: <code>{"local":3,"regional":5,"national":7,"elite":10}</code></div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="maxInvestorsByTier">Max Investors by Tier (JSON)</label>
                            <textarea id="maxInvestorsByTier" name="maxInvestorsByTier"
                                      rows="3"  style="font-size:.8rem;" data-kind="text" data-blank="ok">{{ config.maxInvestorsByTier|json_encode }}</textarea>
                            <div class="bmc-data">Default: <code>{"local":3,"regional":5,"national":7,"elite":10}</code></div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Facility Income ────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="facility-income" data-group="facility-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">FACILITY INCOME</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NON-MATCH FACILITY INCOME %</span><span class="bmc-setting__help">Percentage of matchday facility income earned on non-match weeks (0–100). Default: 0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="nonMatchFacilityIncomePercent" value="{{ config.nonMatchFacilityIncomePercent }}" data-saved="{{ config.nonMatchFacilityIncomePercent }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="non-match facility income %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Facility Construction ──────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="facility-build" data-group="facility-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">FACILITY CONSTRUCTION</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how long facility upgrades take to complete and the parameters for
                        random construction failure events (Feature 47a).
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">TIME MULTIPLIER</span><span class="bmc-setting__help">Global multiplier applied to all construction times. Default: 1.0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="constructionTimeMultiplier" value="{{ config.constructionTimeMultiplier }}" data-saved="{{ config.constructionTimeMultiplier }}" data-kind="decimal" data-min="0.1" data-max="5.0" inputmode="decimal" aria-label="time multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAILURE CHANCE</span><span class="bmc-setting__help">Weekly probability of a failure event (0.0 = never, 1.0 = always). Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityConstructionFailureChance" value="{{ config.facilityConstructionFailureChance }}" data-saved="{{ config.facilityConstructionFailureChance }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="failure chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-field-col">
                            {# spacer #}
                        </div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAILURE COST MIN %</span><span class="bmc-setting__help">% of upgrade cost added on failure. Default: 5.0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityConstructionFailureCostMin" value="{{ config.facilityConstructionFailureCostMin }}" data-saved="{{ config.facilityConstructionFailureCostMin }}" data-kind="decimal" data-min="0" data-max="100" inputmode="decimal" aria-label="failure cost min %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAILURE COST MAX %</span><span class="bmc-setting__help">% of upgrade cost added on failure. Default: 20.0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityConstructionFailureCostMax" value="{{ config.facilityConstructionFailureCostMax }}" data-saved="{{ config.facilityConstructionFailureCostMax }}" data-kind="decimal" data-min="0" data-max="100" inputmode="decimal" aria-label="failure cost max %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAILURE TIME MIN</span><span class="bmc-setting__help">Weeks added on failure. Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityConstructionFailureTimeMin" value="{{ config.facilityConstructionFailureTimeMin }}" data-saved="{{ config.facilityConstructionFailureTimeMin }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="failure time min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAILURE TIME MAX</span><span class="bmc-setting__help">Weeks added on failure. Default: 6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityConstructionFailureTimeMax" value="{{ config.facilityConstructionFailureTimeMax }}" data-saved="{{ config.facilityConstructionFailureTimeMax }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="failure time max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Facility Staff Morale ──────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="facility-morale" data-group="facility-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">FACILITY STAFF MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Morale granted to staff when the club starts or completes a facility build or upgrade.
                        The Facility Manager takes the full amount; every other staff member takes a share.
                        This counterweights the Facility Manager's workload and condition penalties, which are
                        otherwise a one-way ratchet down.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FM BASE GAIN</span><span class="bmc-setting__help">Facility Manager morale on completing a level-1 upgrade. Default: 6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMoraleFmBase" value="{{ config.facilityMoraleFmBase }}" data-saved="{{ config.facilityMoraleFmBase }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="fm base gain"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PER LEVEL</span><span class="bmc-setting__help">Added for each level above 1. Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMoraleFmPerLevel" value="{{ config.facilityMoraleFmPerLevel }}" data-saved="{{ config.facilityMoraleFmPerLevel }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="per level"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">NEW BUILD BONUS</span><span class="bmc-setting__help">Extra gain when a facility goes 0 → 1. Default: 4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMoraleNewBuildBonus" value="{{ config.facilityMoraleNewBuildBonus }}" data-saved="{{ config.facilityMoraleNewBuildBonus }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="new build bonus"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">OTHER STAFF SHARE</span><span class="bmc-setting__help">Fraction of the FM gain given to every other staff member. Default: 0.34</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMoraleStaffShare" value="{{ config.facilityMoraleStaffShare }}" data-saved="{{ config.facilityMoraleStaffShare }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="other staff share"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">START MULTIPLIER</span><span class="bmc-setting__help">Fraction of the completion gain paid when work starts. Default: 0.4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMoraleStartMultiplier" value="{{ config.facilityMoraleStartMultiplier }}" data-saved="{{ config.facilityMoraleStartMultiplier }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="start multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MID BAND FACTOR</span><span class="bmc-setting__help">Diminishing returns while morale is in the mid band. Default: 0.6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffMoraleBandFactorMid" value="{{ config.staffMoraleBandFactorMid }}" data-saved="{{ config.staffMoraleBandFactorMid }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="mid band factor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">HIGH BAND FACTOR</span><span class="bmc-setting__help">Diminishing returns while morale is in the high band. Default: 0.25</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffMoraleBandFactorHigh" value="{{ config.staffMoraleBandFactorHigh }}" data-saved="{{ config.staffMoraleBandFactorHigh }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="high band factor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Playing Style Influence ────────────────────────────────── #}
            {% set psStyles = {
                'POSSESSION': 'Possession',
                'DIRECT':     'Direct',
                'COUNTER':    'Counter',
                'HIGH_PRESS': 'High Press'
            } %}
            {% set psAttributes = ['pace', 'technical', 'vision', 'power', 'stamina', 'heart'] %}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="playing-style" data-group="match-settings">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">PLAYING STYLE INFLUENCE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Select which player attributes are emphasised during match simulation for each playing style.
                        The client uses this to weight attribute contributions when calculating match outcomes.
                    </p>
                    <div class="table-responsive">
                        <table class="bmc-minitable" style="font-size:0.85rem">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-nowrap" style="width:130px">Style</th>
                                    {% for attr in psAttributes %}
                                        <th class="text-center text-uppercase">{{ attr }}</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for styleKey, styleLabel in psStyles %}
                                    <tr>
                                        <td class="fw-semibold">{{ styleLabel }}</td>
                                        {% for attr in psAttributes %}
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       name="playingStyleInfluence[{{ styleKey }}][]"
                                                       value="{{ attr }}"
                                                       
                                                       {% if attr in (config.playingStyleInfluence[styleKey] ?? []) %}checked{% endif %}>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# ── Stadium Settings ────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="stadium" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">STADIUM SETTINGS</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">CAPACITY CALCULATION</span><span class="bmc-setting__help">Multiplier used to calculate stadium capacity from fan base. Default: 100</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="capacityCalculation" value="{{ config.capacityCalculation }}" data-saved="{{ config.capacityCalculation }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="capacity calculation"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SEASON TICKET HOLDERS %</span><span class="bmc-setting__help">Percentage of matchday attendance made up of season-ticket holders (0–100). Default: 60</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="seasonTicketHolderPercent" value="{{ config.seasonTicketHolderPercent }}" data-saved="{{ config.seasonTicketHolderPercent }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="season ticket holders %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MATCHDAY FOOD UPTAKE %</span><span class="bmc-setting__help">Share of a matchday crowd that buys food (0–100). Read by the app; the server has no matchday. Default: 35</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="matchdayFoodUptakePercent" value="{{ config.matchdayFoodUptakePercent }}" data-saved="{{ config.matchdayFoodUptakePercent }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="matchday food uptake %"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SPONSOR WEEKLY (£)</span><span class="bmc-setting__help">A sponsor’s WEEKLY payment. The six sponsor bands below are PER SEASON — different deals, not convertible by dividing. 0 = no weekly sponsor income. Default: 0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorWeeklyPence" value="{{ (config.sponsorWeeklyPence / 100)|round }}" data-saved="{{ (config.sponsorWeeklyPence / 100)|round }}" data-kind="int" data-min="0" inputmode="numeric" aria-label="sponsor weekly pounds"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Attendance Ranges ───────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="attendance" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">ATTENDANCE RANGES</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Attendance as a <strong>percentage of stadium capacity</strong> (0–100%) per reputation tier.
                        The engine picks a random value between min and max each matchday.
                        Min cannot exceed max.
                    </p>
                    {% set tiers = [
                        { key: 'Local',    label: 'Local',    color: 'secondary' },
                        { key: 'Regional', label: 'Regional', color: 'info' },
                        { key: 'National', label: 'National', color: 'primary' },
                        { key: 'Elite',    label: 'Elite',    color: 'warning' },
                    ] %}
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        {% for tier in tiers %}
                        <div class="bmc-field-col">
                            <div class="border rounded p-3">
                                <div class="fw-semibold small mb-3 d-flex align-items-center gap-2">
                                    <span class="bmc-badge bmc-badge--subtle">{{ tier.label }}</span>
                                </div>
                                <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                                    <div class="bmc-field-col">
                                        <label for="attendance{{ tier.key }}Min">Min %</label>
                                        <input type="number"
                                               id="attendance{{ tier.key }}Min"
                                               name="attendance{{ tier.key }}Min"
                                               value="{{ attribute(config, 'attendance' ~ tier.key ~ 'Min') }}"
                                               min="0" max="100"
                                               oninput="clampAttendance(this)">
                                    </div>
                                    <div class="bmc-field-col">
                                        <label for="attendance{{ tier.key }}Max">Max %</label>
                                        <input type="number"
                                               id="attendance{{ tier.key }}Max"
                                               name="attendance{{ tier.key }}Max"
                                               value="{{ attribute(config, 'attendance' ~ tier.key ~ 'Max') }}"
                                               min="0" max="100"
                                               oninput="clampAttendance(this)">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    {% set minVal = attribute(config, 'attendance' ~ tier.key ~ 'Min') %}
                                    {% set maxVal = attribute(config, 'attendance' ~ tier.key ~ 'Max') %}
                                    <div class="progress" style="height:4px;border-radius:2px;">
                                        <div class="progress-bar bg-{{ tier.color }}"
                                             style="margin-left:{{ minVal }}%;width:{{ maxVal - minVal }}%;">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1" style="font-size:.68rem;color:var(--wk-text-dim);">
                                        <span>{{ minVal }}%</span><span>{{ maxVal }}%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <script>
            function clampAttendance(input) {
                var val = parseInt(input.value, 10) || 0;
                val = Math.max(0, Math.min(100, val));
                input.value = val;
                var isMin = input.name.endsWith('Min');
                var base  = input.name.replace(/Min$|Max$/, '');
                var minEl = document.querySelector('[name="' + base + 'Min"]');
                var maxEl = document.querySelector('[name="' + base + 'Max"]');
                if (!minEl || !maxEl) return;
                if (isMin && parseInt(minEl.value) > parseInt(maxEl.value)) {
                    maxEl.value = minEl.value;
                } else if (!isMin && parseInt(maxEl.value) < parseInt(minEl.value)) {
                    minEl.value = maxEl.value;
                }
            }
            </script>

            {# ── NPC Club Finances ────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="npc-finances" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">NPC CLUB STARTING BALANCE</span></div>
                <div class="bmc-card__body">
                    <p class=" small mb-4">
                        Starting cash balance given to each NPC club when generated, expressed as a random draw
                        within a min–max range per tier. Tier 1 is the top division; Tier 8 is the bottom.
                        Values are in <strong>£ (pounds)</strong>.
                    </p>
                    <div class="table-responsive">
                        <table class="bmc-minitable" style="font-size:.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px;">Tier</th>
                                    <th>Min (£)</th>
                                    <th>Max (£)</th>
                                    <th class="" style="width:180px;">Preview</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set balanceRanges = config.npcClubBalanceRanges %}
                                {% for i in 1..8 %}
                                    {% set row = balanceRanges[i - 1] ?? {min: 0, max: 0} %}
                                    {% set minPounds = (row.min / 100)|round(0, 'floor') %}
                                    {% set maxPounds = (row.max / 100)|round(0, 'floor') %}
                                    <tr>
                                        <td class="fw-semibold text-center">{{ i }}</td>
                                        <td>
                                            <input type="number"
                                                   name="npcBalanceRange[{{ i }}][min]"
                                                   value="{{ minPounds }}"
                                                   min="0" step="1000"
                                                  
                                                   data-tier="{{ i }}"
                                                   data-bound="min"
                                                   oninput="syncNpcBalancePreview({{ i }})">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="npcBalanceRange[{{ i }}][max]"
                                                   value="{{ maxPounds }}"
                                                   min="0" step="1000"
                                                  
                                                   data-tier="{{ i }}"
                                                   data-bound="max"
                                                   oninput="syncNpcBalancePreview({{ i }})">
                                        </td>
                                        <td class="bmc-bodytext" id="npc-bal-preview-{{ i }}">
                                            £{{ (minPounds / 1000)|number_format(0) }}k – £{{ (maxPounds / 1000)|number_format(0) }}k
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <script>
            function syncNpcBalancePreview(tier) {
                var minEl  = document.querySelector('[data-tier="' + tier + '"][data-bound="min"].npc-bal-input');
                var maxEl  = document.querySelector('[data-tier="' + tier + '"][data-bound="max"].npc-bal-input');
                var prev   = document.getElementById('npc-bal-preview-' + tier);
                if (!minEl || !maxEl || !prev) return;
                var min = Math.max(0, parseInt(minEl.value, 10) || 0);
                var max = Math.max(min, parseInt(maxEl.value, 10) || 0);
                function fmt(n) {
                    if (n >= 1000000) return '£' + (n / 1000000).toFixed(1) + 'm';
                    return '£' + Math.round(n / 1000) + 'k';
                }
                prev.textContent = fmt(min) + ' – ' + fmt(max);
            }
            </script>

            {# ── Squad Roles ─────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="squad-roles" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SQUAD ROLES</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Configures the six squad roles (<code>star_player</code>, <code>important</code>,
                        <code>first_team</code>, <code>squad_player</code>, <code>backup</code>, <code>prospect</code>).
                        Edit each field as a JSON object keyed by role slug.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col">
                            <label for="squadRoleAppearanceExpectations">Appearance Expectations</label>
                            <textarea id="squadRoleAppearanceExpectations" name="squadRoleAppearanceExpectations"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleAppearanceExpectations|json_encode }}</textarea>
                            <div class="bmc-data">Percentage of season matches expected per role (0.0–1.0). e.g. 0.9 = 90% of matches. Translated to actual match counts on the frontend based on season length.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="squadRoleMoraleDecayPerWeek">Morale Decay Per Week</label>
                            <textarea id="squadRoleMoraleDecayPerWeek" name="squadRoleMoraleDecayPerWeek"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleMoraleDecayPerWeek|json_encode }}</textarea>
                            <div class="bmc-data">Weekly morale delta when a player is below their appearance expectation. Negative = morale loss.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="squadRoleMoraleBoostPerWeek">Morale Boost Per Week</label>
                            <textarea id="squadRoleMoraleBoostPerWeek" name="squadRoleMoraleBoostPerWeek"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleMoraleBoostPerWeek|json_encode }}</textarea>
                            <div class="bmc-data">Weekly morale delta when a player exceeds their appearance expectation. Positive = morale gain.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="squadRoleAutoAssignThresholds">Auto-Assign Thresholds</label>
                            <textarea id="squadRoleAutoAssignThresholds" name="squadRoleAutoAssignThresholds"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleAutoAssignThresholds|json_encode }}</textarea>
                            <div class="bmc-data">Overall rating (0–100) at which a player is auto-assigned to that role during world generation. Highest matching role wins.</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Squad Configuration ────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="squad" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SQUAD CONFIGURATION</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Defines the minimum and maximum number of players allowed in a club's active squad.
                        The client enforces these limits when signing or releasing players.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MIN SQUAD SIZE</span><span class="bmc-setting__help">Minimum players required in the squad. Default: 11</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="squadSizeMin" value="{{ config.squadSizeMin }}" data-saved="{{ config.squadSizeMin }}" data-kind="int" data-min="1" data-max="50" inputmode="numeric" aria-label="min squad size"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MAX SQUAD SIZE</span><span class="bmc-setting__help">Maximum players allowed in the squad. Default: 25</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="squadSizeMax" value="{{ config.squadSizeMax }}" data-saved="{{ config.squadSizeMax }}" data-kind="int" data-min="1" data-max="100" inputmode="numeric" aria-label="max squad size"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Player Retirement ──────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="retirement" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">PLAYER RETIREMENT</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls when players become eligible to retire and how likely they are to do so each week.
                        Probability scales linearly from 0 at min age up to <strong>Retirement Chance</strong> at max age,
                        at which point retirement is guaranteed.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MIN AGE</span><span class="bmc-setting__help">Earliest age a player can retire. Default: 30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="retirementMinAge" value="{{ config.retirementMinAge }}" data-saved="{{ config.retirementMinAge }}" data-kind="int" data-min="30" data-max="50" inputmode="numeric" aria-label="min age"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MAX AGE</span><span class="bmc-setting__help">Age at which retirement is guaranteed. Default: 38</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="retirementMaxAge" value="{{ config.retirementMaxAge }}" data-saved="{{ config.retirementMaxAge }}" data-kind="int" data-min="35" data-max="50" inputmode="numeric" aria-label="max age"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RETIREMENT CHANCE</span><span class="bmc-setting__help">Weekly probability at max age (0–1). Default: 0.35</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="retirementChance" value="{{ config.retirementChance }}" data-saved="{{ config.retirementChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="retirement chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Inbox / Notification Frequencies ───────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="inbox" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">INBOX &AMP; NOTIFICATION FREQUENCIES</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how often the system generates recurring inbox notifications for players.
                        Values are in weeks (1–52).
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FACILITY MAINTENANCE REMINDER (WEEKS)</span><span class="bmc-setting__help">How often a facility maintenance reminder is sent to the inbox. Default: 4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="facilityMaintenanceFrequencyWeeks" value="{{ config.facilityMaintenanceFrequencyWeeks }}" data-saved="{{ config.facilityMaintenanceFrequencyWeeks }}" data-kind="int" data-min="1" data-max="52" inputmode="numeric" aria-label="facility maintenance reminder (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SYSTEM NOTIFICATION FREQUENCY (WEEKS)</span><span class="bmc-setting__help">How often general system digest notifications are sent to the inbox. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="systemNotificationFrequencyWeeks" value="{{ config.systemNotificationFrequencyWeeks }}" data-saved="{{ config.systemNotificationFrequencyWeeks }}" data-kind="int" data-min="1" data-max="52" inputmode="numeric" aria-label="system notification frequency (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Wage Multiplier Tiers ───────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="wages" data-group="transfer">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">WAGE MULTIPLIER TIERS</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Ability-based multipliers applied when generating player and staff contract values.
                        Pool players never have a club, so the player's own <strong>current ability</strong> determines the tier.<br>
                        Formula: <code>contractValue = currentAbility × rand(min, max) × playerMultiplier</code><br>
                        Tiers are evaluated in order; first entry where current ability &lt; Max Ability wins.
                        Leave Max Ability blank on the last row to catch all higher abilities.
                    </p>

                    <div class="table-responsive mb-3">
                        <table class="bmc-minitable">
                            <thead class="table-light">
                                <tr>
                                    <th class="small  fw-semibold">Tier</th>
                                    <th class="small  fw-semibold">Max Ability (exclusive)</th>
                                    <th class="small  fw-semibold">Player ×</th>
                                    <th class="small  fw-semibold">Staff ×</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for i, tier in config.wageMultiplierTiers %}
                                <tr>
                                    <td class="small fw-semibold ">Tier {{ i + 1 }}</td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][maxAbility]"
                                               value="{{ tier.maxAbility ?? '' }}"
                                               min="0" max="100" placeholder="∞ (default)"
                                               style="width:140px;">
                                    </td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][playerMultiplier]"
                                               value="{{ tier.playerMultiplier }}"
                                               min="0" step="0.1" style="width:100px;">
                                    </td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][staffMultiplier]"
                                               value="{{ tier.staffMultiplier }}"
                                               min="0" step="0.1" style="width:100px;">
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RAND MIN</span><span class="bmc-setting__help">Lower bound of the random multiplier. Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="contractValueRandMin" value="{{ config.contractValueRandMin }}" data-saved="{{ config.contractValueRandMin }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="rand min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RAND MAX</span><span class="bmc-setting__help">Upper bound of the random multiplier. Must be ≥ Rand Min. Default: 40</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="contractValueRandMax" value="{{ config.contractValueRandMax }}" data-saved="{{ config.contractValueRandMax }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="rand max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Manager Sacking ─────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="sacking" data-group="event-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">MANAGER SACKING</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls when fan sacking demands are raised and resolved, and the attendance
                        penalty applied while a demand is active.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WIN RATIO TRIGGER</span><span class="bmc-setting__help">Win % below which sacking demand fires (0–1). Default: 0.20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="managerSackingWinRatioTrigger" value="{{ config.managerSackingWinRatioTrigger }}" data-saved="{{ config.managerSackingWinRatioTrigger }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="win ratio trigger"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WIN RATIO RECOVERY</span><span class="bmc-setting__help">Win % above which demand is resolved (0–1). Default: 0.25</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="managerSackingWinRatioRecovery" value="{{ config.managerSackingWinRatioRecovery }}" data-saved="{{ config.managerSackingWinRatioRecovery }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="win ratio recovery"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MIN GAMES BEFORE TRIGGER</span><span class="bmc-setting__help">Games played before trigger can fire. Default: 30</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="managerSackingMinGames" value="{{ config.managerSackingMinGames }}" data-saved="{{ config.managerSackingMinGames }}" data-kind="int" data-min="0" data-max="200" inputmode="numeric" aria-label="min games before trigger"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WEEKLY ATTENDANCE PENALTY</span><span class="bmc-setting__help">Weekly attendance drop while demand is active (0–1). Default: 0.05</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="managerSackingAttendancePenaltyPerWeek" value="{{ config.managerSackingAttendancePenaltyPerWeek }}" data-saved="{{ config.managerSackingAttendancePenaltyPerWeek }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="weekly attendance penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Cards & Discipline ──────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="cards" data-group="match-settings">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">CARDS &AMP; DISCIPLINE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls yellow and red card probabilities and suspension lengths. The frontend
                        scales these values by a player's temperament trait before applying them.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">YELLOW CARD BASE CHANCE</span><span class="bmc-setting__help">Base probability per player per match. Default: 0.08</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="yellowCardBaseChance" value="{{ config.yellowCardBaseChance }}" data-saved="{{ config.yellowCardBaseChance }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="yellow card base chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RED CARD BASE CHANCE</span><span class="bmc-setting__help">Direct red card probability per player per match. Default: 0.01</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="redCardBaseChance" value="{{ config.redCardBaseChance }}" data-saved="{{ config.redCardBaseChance }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="red card base chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">TEMPERAMENT SCALE</span><span class="bmc-setting__help">How much temperament affects card probability. Default: 1.0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="temperamentCardScale" value="{{ config.temperamentCardScale }}" data-saved="{{ config.temperamentCardScale }}" data-kind="decimal" data-min="0.0" data-max="5.0" inputmode="decimal" aria-label="temperament scale"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">YELLOW ACCUMULATION THRESHOLD</span><span class="bmc-setting__help">Yellows before automatic one-match suspension. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="yellowCardAccumulationThreshold" value="{{ config.yellowCardAccumulationThreshold }}" data-saved="{{ config.yellowCardAccumulationThreshold }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="yellow accumulation threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">RED CARD SUSPENSION (MATCHES)</span><span class="bmc-setting__help">Matches banned for a direct red card. Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="redCardSuspensionMatches" value="{{ config.redCardSuspensionMatches }}" data-saved="{{ config.redCardSuspensionMatches }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="red card suspension (matches)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Competition History ─────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="competition-history" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">COMPETITION HISTORY</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Points awarded for winning each league tier (1 = top flight). Used to calculate a club's all-time
                        competition history score. The 10× reduction per tier ensures one League 1 title outweighs any
                        number of lower-division wins.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        {% for tier, points in config.leagueWinPoints %}
                        <div class="bmc-field-col">
                            <label for="leagueWinPoints_{{ tier }}">Tier {{ tier }} Points</label>
                            <input type="number" id="leagueWinPoints_{{ tier }}"
                                   name="leagueWinPoints[{{ tier }}]"
                                   value="{{ points }}"
                                   min="0" step="1">
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# ── Pyramid News ────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="pyramid-news" data-group="league-config">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">PYRAMID NEWS</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how often pyramid news generates and per-page-type duplicate-prevention behaviour.
                        Only page types with <code>prevent_duplicate</code> need entries in the config JSON.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FREQUENCY (WEEKS)</span><span class="bmc-setting__help">How often pyramid news generates. Default: 4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="pyramidNewsFrequencyWeeks" value="{{ config.pyramidNewsFrequencyWeeks }}" data-saved="{{ config.pyramidNewsFrequencyWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="frequency (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-field-col">
                            <label for="pyramidNewsConfig">Page-type Config (JSON)</label>
                            <textarea id="pyramidNewsConfig" name="pyramidNewsConfig"
                                      rows="12" 
                                      style="font-size:.8rem;" data-kind="text" data-blank="ok">{{ config.pyramidNewsConfig|json_encode(constant('JSON_PRETTY_PRINT')) }}</textarea>
                            <div class="bmc-data">
                                Keyed by page type slug. <code>usedCacheClearAfterEditions</code> controls how many editions
                                a club can appear in a <code>preventDuplicate</code> page before becoming eligible again.
                            </div>
                            <div class="mt-3">
                                <p class="fw-semibold small mb-1">Available page types &amp; recommended defaults</p>
                                <table class="bmc-minitable" style="font-size:.78rem;max-width:480px">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Page type</th>
                                            <th class="text-center">usedCacheClearAfterEditions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set pyramidDefaults = [
                                            {slug: 'financial_turmoil',     val: 5},
                                            {slug: 'top_goalscorer',        val: 10},
                                            {slug: 'top_assists',           val: 10},
                                            {slug: 'most_on_form_player',   val: 10},
                                            {slug: 'best_game_most_goals',  val: 10},
                                            {slug: 'best_game_biggest_win', val: 10},
                                            {slug: 'biggest_upset',         val: 5},
                                            {slug: 'on_the_rise',           val: 5},
                                            {slug: 'outperforming_critics', val: 3},
                                            {slug: 'season_predictions',    val: 20},
                                        ] %}
                                        {% for row in pyramidDefaults %}
                                        <tr>
                                            <td><code>{{ row.slug }}</code></td>
                                            <td class="text-center">{{ row.val }}</td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Player Development Schedule ──────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="dev-tick" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">PLAYER DEVELOPMENT</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how frequently the player development pass runs on the client.
                        A value of 1 runs every week; 2 runs every other week, etc.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DEVELOPMENT TICK FREQUENCY (WEEKS)</span><span class="bmc-setting__help">How many in-game weeks between each development pass. Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="developmentTickFrequencyWeeks" value="{{ config.developmentTickFrequencyWeeks }}" data-saved="{{ config.developmentTickFrequencyWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="development tick frequency (weeks)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Feature Cooldowns ────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="cooldowns" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">FEATURE COOLDOWNS (WEEKS)</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Minimum in-game weeks between each use of these manager actions.
                        All values must be at least 1.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ADDRESS SQUAD COOLDOWN</span><span class="bmc-setting__help">Default: 4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="addressSquadCooldownWeeks" value="{{ config.addressSquadCooldownWeeks }}" data-saved="{{ config.addressSquadCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="address squad cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FAN EVENT COOLDOWN</span><span class="bmc-setting__help">Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="fanEventCooldownWeeks" value="{{ config.fanEventCooldownWeeks }}" data-saved="{{ config.fanEventCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="fan event cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SPONSOR OFFER COOLDOWN</span><span class="bmc-setting__help">Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="sponsorOfferCooldownWeeks" value="{{ config.sponsorOfferCooldownWeeks }}" data-saved="{{ config.sponsorOfferCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="sponsor offer cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">INVESTOR OFFER COOLDOWN</span><span class="bmc-setting__help">Default: 12</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="investorOfferCooldownWeeks" value="{{ config.investorOfferCooldownWeeks }}" data-saved="{{ config.investorOfferCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="investor offer cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SCOUT REPORT COOLDOWN</span><span class="bmc-setting__help">Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="scoutReportCooldownWeeks" value="{{ config.scoutReportCooldownWeeks }}" data-saved="{{ config.scoutReportCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="scout report cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">YOUTH INTAKE COOLDOWN</span><span class="bmc-setting__help">Default: 12</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="youthIntakeCooldownWeeks" value="{{ config.youthIntakeCooldownWeeks }}" data-saved="{{ config.youthIntakeCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="youth intake cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PLAYER INTERACTION COOLDOWN (SUPPORT/PUNISH)</span><span class="bmc-setting__help">Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="playerInteractionCooldownWeeks" value="{{ config.playerInteractionCooldownWeeks }}" data-saved="{{ config.playerInteractionCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="player interaction cooldown (support/punish)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">STAFF MEETING COOLDOWN</span><span class="bmc-setting__help">Default: 4</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffMeetingCooldownWeeks" value="{{ config.staffMeetingCooldownWeeks }}" data-saved="{{ config.staffMeetingCooldownWeeks }}" data-kind="int" data-min="1" inputmode="numeric" aria-label="staff meeting cooldown"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

        </div>{# /gap wrapper #}


        {# ── Developer / Debug — footer ──────────────────────────────── #}
        <div class="mt-4 pt-4" style="border-top:3px solid var(--wk-stroke)">
            <div class="bmc-inset">
                <div class="bmc-card__head"><i data-lucide="triangle-alert" class="ink-danger"></i><span class="bmc-card__title">DEVELOPER / DEBUG</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        When enabled, a <strong>cog icon</strong> appears in the app's bottom navigation.
                        Tapping it opens the in-app debug log panel which records all API requests and responses.
                        <strong>Disable in production.</strong>
                    </p>
                    <div class="bmc-check">
                        <input  type="checkbox" role="switch"
                               id="debugLoggingEnabled" name="debugLoggingEnabled"
                               {% if config.debugLoggingEnabled %}checked{% endif %}>
                        <label for="debugLoggingEnabled">
                            Enable in-app debug log panel
                        </label>
                    </div>
                    <p class=" small mb-0 mt-3">
                        <i data-lucide="info" width="14" height="14"></i>
                        To debug <strong>one player</strong> instead, leave this off and set
                        <em>Debug panel</em> on that account (Users &rarr; edit &rarr; Developer / Debug).
                        While this global switch is on it wins for everyone, and those per-account
                        settings have no further effect.
                    </p>
                </div>
            </div>
        </div>
    <div class="bmc-savebar" data-bmc-savebar data-idle="Synced to every client on its next /api/sync.">
        <span class="bmc-savebar__dot"></span>
        <span class="bmc-savebar__title">ALL SAVED</span>
        <span class="bmc-savebar__sub"></span>
        <button type="button" class="bmc-btn" data-bmc-discard><span>DISCARD</span></button>
        <button type="submit" class="bmc-btn bmc-btn--yellow" data-bmc-save><span>SAVE GAME CONFIG</span></button>
    </div>
    </form>


<script>
(function () {
    var STORAGE_KEY = 'gc_active_tab';
    var tabs    = Array.from(document.querySelectorAll('.cfg-tab'));
    var grpBtns = Array.from(document.querySelectorAll('.cfg-group-btn'));
    var panels  = Array.from(document.querySelectorAll('.cfg-section'));
    var banner  = document.getElementById('cfg-group-banner');
    var bannerTitle = document.getElementById('cfg-group-banner-title');
    var bannerSubs  = document.getElementById('cfg-group-banner-subs');

    if (!panels.length) return;

    // Build section-id → group-id map from data-group attributes on each panel
    var groupMap = {};
    panels.forEach(function (p) {
        if (p.dataset.group) groupMap[p.dataset.sectionId] = p.dataset.group;
    });

    // Build group-id → { label, subs } metadata from group button attributes
    var groupMeta = {};
    grpBtns.forEach(function (g) {
        groupMeta[g.dataset.group] = { label: g.textContent.trim(), subs: g.title || '' };
    });

    function setNavState(activeSectionId, activeGroupId) {
        tabs.forEach(function (t) {
            var on = t.dataset.tab === activeSectionId;
            t.classList.toggle('btn-primary',           on);
            t.classList.toggle('btn-outline-secondary', !on);
        });
        grpBtns.forEach(function (g) {
            var on = g.dataset.group === activeGroupId;
            g.classList.toggle('btn-primary',        on);
            g.classList.toggle('btn-outline-primary', !on);
        });
    }

    function showBanner(groupId) {
        if (!banner) return;
        var meta = groupMeta[groupId];
        if (meta) {
            bannerTitle.textContent = meta.label;
            bannerSubs.textContent  = meta.subs ? '— ' + meta.subs : '';
        }
        banner.classList.remove('d-none');
    }

    function hideBanner() {
        if (banner) banner.classList.add('d-none');
    }

    // Show a single section
    function activate(id) {
        var parentGroup = groupMap[id] || null;
        panels.forEach(function (p) {
            p.style.display = p.dataset.sectionId === id ? '' : 'none';
        });
        setNavState(id, parentGroup);
        if (parentGroup) { showBanner(parentGroup); } else { hideBanner(); }
        try { localStorage.setItem(STORAGE_KEY, 'section:' + id); } catch (e) {}
    }

    // Show all sections belonging to a group
    function activateGroup(groupId) {
        panels.forEach(function (p) {
            p.style.display = groupMap[p.dataset.sectionId] === groupId ? '' : 'none';
        });
        setNavState(null, groupId);
        showBanner(groupId);
        try { localStorage.setItem(STORAGE_KEY, 'group:' + groupId); } catch (e) {}
    }

    tabs.forEach(function (t) {
        t.addEventListener('click', function () { activate(t.dataset.tab); });
    });
    grpBtns.forEach(function (g) {
        g.addEventListener('click', function () { activateGroup(g.dataset.group); });
    });

    // Restore saved state (supports legacy bare ids, 'section:id', 'group:id')
    var saved = null;
    try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}

    if (saved) {
        if (saved.indexOf('group:') === 0) {
            var gId = saved.slice(6);
            if (grpBtns.some(function (g) { return g.dataset.group === gId; })) {
                activateGroup(gId);
                return;
            }
        } else {
            var sId = saved.indexOf('section:') === 0 ? saved.slice(8) : saved;
            if (panels.some(function (p) { return p.dataset.sectionId === sId; })) {
                activate(sId);
                return;
            }
        }
    }

    // Default: open first group
    if (grpBtns.length) {
        activateGroup(grpBtns[0].dataset.group);
    } else if (tabs.length) {
        activate(tabs[0].dataset.tab);
    }
})();

// ── Sections drawer chevron + hint ───────────────────────────────────
(function () {
    var drawer   = document.getElementById('cfg-sections-drawer');
    var chevron  = document.getElementById('cfg-sections-chevron');
    var hint     = document.getElementById('cfg-sections-summary-hint');
    if (!drawer) return;

    function updateChevron() {
        chevron.style.transform = drawer.open ? 'rotate(90deg)' : 'rotate(0deg)';
    }
    drawer.addEventListener('toggle', updateChevron);
    updateChevron();

    // Show the active tab label in the summary when collapsed
    function updateHint() {
        if (drawer.open) { hint.textContent = ''; return; }
        var active = document.querySelector('.cfg-tab.active, .cfg-tab.btn-secondary');
        hint.textContent = active ? '— ' + active.textContent.trim() : '';
    }
    drawer.addEventListener('toggle', updateHint);
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('cfg-tab') || e.target.classList.contains('cfg-group-btn')) {
            setTimeout(updateHint, 50);
        }
    });
})();
</script>
{% endblock %}
