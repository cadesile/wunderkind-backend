                        </div>
                        <div class="col-md-3">
                            <label for="sponsorProbabilityElite" class="form-label fw-semibold small">Elite</label>
                            <input type="number" id="sponsorProbabilityElite" name="sponsorProbabilityElite"
                                   value="{{ config.sponsorProbabilityElite }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Default: 0.05</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Investor Offer Probabilities ─────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="investor-probs">
                <div class="card-header fw-semibold">Investor Offer Probabilities</div>
                <div class="card-body">
                    <p class="small text-muted mb-3">Weekly probability (0.0–1.0) that an academy receives an investor offer from each reputation tier.</p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="investorProbabilityLocal" class="form-label fw-semibold small">Local</label>
                            <input type="number" id="investorProbabilityLocal" name="investorProbabilityLocal"
                                   value="{{ config.investorProbabilityLocal }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Default: 0.20</div>
                        </div>
                        <div class="col-md-3">
                            <label for="investorProbabilityRegional" class="form-label fw-semibold small">Regional</label>
                            <input type="number" id="investorProbabilityRegional" name="investorProbabilityRegional"
                                   value="{{ config.investorProbabilityRegional }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Default: 0.12</div>
                        </div>
                        <div class="col-md-3">
                            <label for="investorProbabilityNational" class="form-label fw-semibold small">National</label>
                            <input type="number" id="investorProbabilityNational" name="investorProbabilityNational"
                                   value="{{ config.investorProbabilityNational }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Default: 0.06</div>
                        </div>
                        <div class="col-md-3">
                            <label for="investorProbabilityElite" class="form-label fw-semibold small">Elite</label>
                            <input type="number" id="investorProbabilityElite" name="investorProbabilityElite"
                                   value="{{ config.investorProbabilityElite }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Default: 0.02</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Facility Income ────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="facility-income">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-building text-muted"></i>
                    <span class="fw-semibold small">Facility Income</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="nonMatchFacilityIncomePercent" class="form-label fw-semibold small">Non-Match Facility Income %</label>
                            <input type="number" id="nonMatchFacilityIncomePercent" name="nonMatchFacilityIncomePercent"
                                   value="{{ config.nonMatchFacilityIncomePercent }}"
                                   min="0" max="100" class="form-control">
                            <div class="form-text">Percentage of matchday facility income earned on non-match weeks (0–100). Default: 0</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Facility Construction ──────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="facility-build">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-hard-hat text-muted"></i>
                    <span class="fw-semibold small">Facility Construction</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how long facility upgrades take to complete and the parameters for
                        random construction failure events (Feature 47a).
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="constructionTimeMultiplier" class="form-label fw-semibold small">Time Multiplier</label>
                            <input type="number" id="constructionTimeMultiplier" name="constructionTimeMultiplier"
                                   value="{{ config.constructionTimeMultiplier }}"
                                   step="0.1" min="0.1" max="5.0" class="form-control">
                            <div class="form-text">Global multiplier applied to all construction times. Default: 1.0</div>
                        </div>
                        <div class="col-md-4">
                            <label for="facilityConstructionFailureChance" class="form-label fw-semibold small">Failure Chance</label>
                            <input type="number" id="facilityConstructionFailureChance" name="facilityConstructionFailureChance"
                                   value="{{ config.facilityConstructionFailureChance }}"
                                   step="0.01" min="0.0" max="1.0" class="form-control">
                            <div class="form-text">Weekly probability of a failure event (0.0 = never, 1.0 = always). Default: 0.05</div>
                        </div>
                        <div class="col-md-4">
                            {# spacer #}
                        </div>
                        <div class="col-md-3">
                            <label for="facilityConstructionFailureCostMin" class="form-label fw-semibold small">Failure Cost Min %</label>
                            <input type="number" id="facilityConstructionFailureCostMin" name="facilityConstructionFailureCostMin"
                                   value="{{ config.facilityConstructionFailureCostMin }}"
                                   step="0.5" min="0" max="100" class="form-control">
                            <div class="form-text">% of upgrade cost added on failure. Default: 5.0</div>
                        </div>
                        <div class="col-md-3">
                            <label for="facilityConstructionFailureCostMax" class="form-label fw-semibold small">Failure Cost Max %</label>
                            <input type="number" id="facilityConstructionFailureCostMax" name="facilityConstructionFailureCostMax"
                                   value="{{ config.facilityConstructionFailureCostMax }}"
                                   step="0.5" min="0" max="100" class="form-control">
                            <div class="form-text">% of upgrade cost added on failure. Default: 20.0</div>
                        </div>
                        <div class="col-md-3">
                            <label for="facilityConstructionFailureTimeMin" class="form-label fw-semibold small">Failure Time Min</label>
                            <input type="number" id="facilityConstructionFailureTimeMin" name="facilityConstructionFailureTimeMin"
                                   value="{{ config.facilityConstructionFailureTimeMin }}"
                                   step="1" min="0" class="form-control">
                            <div class="form-text">Weeks added on failure. Default: 2</div>
                        </div>
                        <div class="col-md-3">
                            <label for="facilityConstructionFailureTimeMax" class="form-label fw-semibold small">Failure Time Max</label>
                            <input type="number" id="facilityConstructionFailureTimeMax" name="facilityConstructionFailureTimeMax"
                                   value="{{ config.facilityConstructionFailureTimeMax }}"
                                   step="1" min="0" class="form-control">
                            <div class="form-text">Weeks added on failure. Default: 6</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Playing Style Influence ────────────────────────────────── #}
            {% set psStyles = {
                'POSSESSION': 'Possession',
                'DIRECT':     'Direct',
                'COUNTER':    'Counter',
                'HIGH_PRESS': 'High Press'
            } %}
            {% set psAttributes = ['pace', 'technical', 'vision', 'power', 'stamina', 'heart'] %}
            <div class="card cfg-section" data-section-id="playing-style">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-futbol text-muted"></i>
                    <span class="fw-semibold small">Playing Style Influence</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Select which player attributes are emphasised during match simulation for each playing style.
                        The client uses this to weight attribute contributions when calculating match outcomes.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.85rem">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-nowrap" style="width:130px">Style</th>
                                    {% for attr in psAttributes %}
                                        <th class="text-center text-uppercase">{{ attr }}</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for styleKey, styleLabel in psStyles %}
                                    <tr>
                                        <td class="fw-semibold">{{ styleLabel }}</td>
                                        {% for attr in psAttributes %}
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       name="playingStyleInfluence[{{ styleKey }}][]"
                                                       value="{{ attr }}"
                                                       class="form-check-input"
                                                       {% if attr in (config.playingStyleInfluence[styleKey] ?? []) %}checked{% endif %}>
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# ── Stadium Settings ────────────────────────────────────────── #}
            <div class="card mb-4 cfg-section" data-section-id="stadium">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-building text-muted"></i>
                    <span class="fw-semibold small">Stadium Settings</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="capacityCalculation" class="form-label fw-semibold small">Capacity Calculation</label>
                            <input type="number" id="capacityCalculation" name="capacityCalculation"
                                   value="{{ config.capacityCalculation }}"
                                   min="1" class="form-control">
                            <div class="form-text">Multiplier used to calculate stadium capacity from fan base. Default: 100</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Attendance Ranges ───────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="attendance">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-people-roof text-muted"></i>
                    <span class="fw-semibold small">Attendance Ranges</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Attendance as a <strong>percentage of stadium capacity</strong> (0–100%) per reputation tier.
                        The engine picks a random value between min and max each matchday.
                        Min cannot exceed max.
                    </p>
                    {% set tiers = [
                        { key: 'Local',    label: 'Local',    color: 'secondary' },
                        { key: 'Regional', label: 'Regional', color: 'info' },
                        { key: 'National', label: 'National', color: 'primary' },
                        { key: 'Elite',    label: 'Elite',    color: 'warning' },
                    ] %}
                    <div class="row g-3">
                        {% for tier in tiers %}
                        <div class="col-sm-6 col-xl-3">
                            <div class="border rounded p-3">
                                <div class="fw-semibold small mb-3 d-flex align-items-center gap-2">
                                    <span class="badge bg-{{ tier.color }}-subtle text-{{ tier.color }} border border-{{ tier.color }}-subtle">{{ tier.label }}</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label for="attendance{{ tier.key }}Min" class="form-label small mb-1">Min %</label>
                                        <input type="number"
                                               id="attendance{{ tier.key }}Min"
                                               name="attendance{{ tier.key }}Min"
                                               value="{{ attribute(config, 'attendance' ~ tier.key ~ 'Min') }}"
                                               min="0" max="100" class="form-control form-control-sm"
                                               oninput="clampAttendance(this)">
                                    </div>
                                    <div class="col-6">
                                        <label for="attendance{{ tier.key }}Max" class="form-label small mb-1">Max %</label>
                                        <input type="number"
                                               id="attendance{{ tier.key }}Max"
                                               name="attendance{{ tier.key }}Max"
                                               value="{{ attribute(config, 'attendance' ~ tier.key ~ 'Max') }}"
                                               min="0" max="100" class="form-control form-control-sm"
                                               oninput="clampAttendance(this)">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    {% set minVal = attribute(config, 'attendance' ~ tier.key ~ 'Min') %}
                                    {% set maxVal = attribute(config, 'attendance' ~ tier.key ~ 'Max') %}
                                    <div class="progress" style="height:4px;border-radius:2px;">
                                        <div class="progress-bar bg-{{ tier.color }}"
                                             style="margin-left:{{ minVal }}%;width:{{ maxVal - minVal }}%;">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1" style="font-size:.68rem;color:var(--bs-secondary-color);">
                                        <span>{{ minVal }}%</span><span>{{ maxVal }}%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <script>
            function clampAttendance(input) {
                var val = parseInt(input.value, 10) || 0;
                val = Math.max(0, Math.min(100, val));
                input.value = val;
                var isMin = input.name.endsWith('Min');
                var base  = input.name.replace(/Min$|Max$/, '');
                var minEl = document.querySelector('[name="' + base + 'Min"]');
                var maxEl = document.querySelector('[name="' + base + 'Max"]');
                if (!minEl || !maxEl) return;
                if (isMin && parseInt(minEl.value) > parseInt(maxEl.value)) {
                    maxEl.value = minEl.value;
                } else if (!isMin && parseInt(maxEl.value) < parseInt(minEl.value)) {
                    minEl.value = maxEl.value;
                }
            }
            </script>

            {# ── League Player Ability Ranges ───────────────────────────── #}
            {% set tierDefaults = {1: {min: 55, max: 95}, 2: {min: 45, max: 65}, 3: {min: 35, max: 55}, 4: {min: 25, max: 50}, 5: {min: 25, max: 40}, 6: {min: 15, max: 35}, 7: {min: 15, max: 25}, 8: {min: 5, max: 15}} %}

            {# Build a flat lookup: "EN_1" → {min, max} from stored config #}
            {% set abilityLookup = {} %}
            {% for entry in config.leaguePlayerAbilityRanges %}
                {% for league in entry.leagues %}
                    {% set abilityLookup = abilityLookup|merge({(entry.country ~ '_' ~ league.tier): league}) %}
                {% endfor %}
            {% endfor %}

            <div class="card cfg-section" data-section-id="ability-ranges">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-chart-line text-muted"></i>
                    <span class="fw-semibold small">League Player Ability Ranges</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-4">
                        Define the min/max ability for players generated for NPC clubs in each league tier.
                        If missing, sensible tier-based defaults are used (e.g. Tier 1: 55–95, Tier 8: 5–15).
                    </p>

                    {% if leaguesByCountry|length == 0 %}
                        <p class="text-muted small"><i class="fa fa-circle-info me-1"></i> No leagues configured yet. Create leagues first.</p>
                    {% else %}
                        {% for country, tiers in leaguesByCountry %}
                        <div class="{{ not loop.last ? 'mb-4' : '' }}">
                            <div class="text-uppercase fw-bold small text-muted mb-2"
                                 style="letter-spacing:.1em;font-size:.7rem;border-bottom:1px solid var(--bs-border-color);padding-bottom:.35rem;">
                                {{ country }} Leagues
                            </div>
                            <div class="row g-3">
                                {% for tier, league in tiers %}
                                    {% set lookupKey = country ~ '_' ~ tier %}
                                    {% set stored = abilityLookup[lookupKey] ?? null %}
                                    {% set defaults = tierDefaults[tier] ?? {min: 10, max: 60} %}
                                    {% set curMin = stored ? stored.min : defaults.min %}
                                    {% set curMax = stored ? stored.max : defaults.max %}
                                    <div class="col-sm-6 col-lg-3">
                                        <div class="border rounded p-2" style="font-size:.8rem;">
                                            <div class="fw-semibold mb-2">Tier {{ tier }}</div>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <label class="form-label small mb-1 text-muted">Min</label>
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text" style="font-size:.7rem;">Min</span>
                                                        <input type="number"
                                                               name="abilityRange[{{ country }}][{{ tier }}][min]"
                                                               value="{{ curMin }}"
                                                               min="0" max="100"
                                                               class="form-control form-control-sm ability-range-input"
                                                               data-country="{{ country }}"
                                                               data-tier="{{ tier }}"
                                                               data-bound="min"
                                                               oninput="clampAbilityRange(this)">
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small mb-1 text-muted">Max</label>
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text" style="font-size:.7rem;">Max</span>
                                                        <input type="number"
                                                               name="abilityRange[{{ country }}][{{ tier }}][max]"
                                                               value="{{ curMax }}"
                                                               min="0" max="100"
                                                               class="form-control form-control-sm ability-range-input"
                                                               data-country="{{ country }}"
                                                               data-tier="{{ tier }}"
                                                               data-bound="max"
                                                               oninput="clampAbilityRange(this)">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <script>
            function clampAbilityRange(input) {
                var val = parseInt(input.value, 10) || 0;
                val = Math.max(0, Math.min(100, val));
                input.value = val;
                var country = input.dataset.country;
                var tier    = input.dataset.tier;
                var isMin   = input.dataset.bound === 'min';
                var minEl   = document.querySelector('[data-country="' + country + '"][data-tier="' + tier + '"][data-bound="min"]');
                var maxEl   = document.querySelector('[data-country="' + country + '"][data-tier="' + tier + '"][data-bound="max"]');
                if (!minEl || !maxEl) return;
                if (isMin && parseInt(minEl.value) > parseInt(maxEl.value)) {
                    maxEl.value = minEl.value;
                } else if (!isMin && parseInt(maxEl.value) < parseInt(minEl.value)) {
                    minEl.value = maxEl.value;
                }
            }
            </script>

            {# ── NPC Club Finances ────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="npc-finances">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-coins text-muted"></i>
                    <span class="fw-semibold small">NPC Club Starting Balance</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-4">
                        Starting cash balance given to each NPC club when generated, expressed as a random draw
                        within a min–max range per tier. Tier 1 is the top division; Tier 8 is the bottom.
                        Values are in <strong>£ (pounds)</strong>.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size:.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px;">Tier</th>
                                    <th>Min (£)</th>
                                    <th>Max (£)</th>
                                    <th class="text-muted" style="width:180px;">Preview</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set balanceRanges = config.npcClubBalanceRanges %}
                                {% for i in 1..8 %}
                                    {% set row = balanceRanges[i - 1] ?? {min: 0, max: 0} %}
                                    {% set minPounds = (row.min / 100)|round(0, 'floor') %}
                                    {% set maxPounds = (row.max / 100)|round(0, 'floor') %}
                                    <tr>
                                        <td class="fw-semibold text-center">{{ i }}</td>
                                        <td>
                                            <input type="number"
                                                   name="npcBalanceRange[{{ i }}][min]"
                                                   value="{{ minPounds }}"
                                                   min="0" step="1000"
                                                   class="form-control form-control-sm font-monospace npc-bal-input"
                                                   data-tier="{{ i }}"
                                                   data-bound="min"
                                                   oninput="syncNpcBalancePreview({{ i }})">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="npcBalanceRange[{{ i }}][max]"
                                                   value="{{ maxPounds }}"
                                                   min="0" step="1000"
                                                   class="form-control form-control-sm font-monospace npc-bal-input"
                                                   data-tier="{{ i }}"
                                                   data-bound="max"
                                                   oninput="syncNpcBalancePreview({{ i }})">
                                        </td>
                                        <td class="text-muted small" id="npc-bal-preview-{{ i }}">
                                            £{{ (minPounds / 1000)|number_format(0) }}k – £{{ (maxPounds / 1000)|number_format(0) }}k
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <script>
            function syncNpcBalancePreview(tier) {
                var minEl  = document.querySelector('[data-tier="' + tier + '"][data-bound="min"].npc-bal-input');
                var maxEl  = document.querySelector('[data-tier="' + tier + '"][data-bound="max"].npc-bal-input');
                var prev   = document.getElementById('npc-bal-preview-' + tier);
                if (!minEl || !maxEl || !prev) return;
                var min = Math.max(0, parseInt(minEl.value, 10) || 0);
                var max = Math.max(min, parseInt(maxEl.value, 10) || 0);
                function fmt(n) {
                    if (n >= 1000000) return '£' + (n / 1000000).toFixed(1) + 'm';
                    return '£' + Math.round(n / 1000) + 'k';
                }
                prev.textContent = fmt(min) + ' – ' + fmt(max);
            }
            </script>

            {# ── Squad Roles ─────────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="squad-roles">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-id-badge text-muted"></i>
                    <span class="fw-semibold small">Squad Roles</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Configures the six squad roles (<code>star_player</code>, <code>important</code>,
                        <code>first_team</code>, <code>squad_player</code>, <code>backup</code>, <code>prospect</code>).
                        Edit each field as a JSON object keyed by role slug.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="squadRoleAppearanceExpectations" class="form-label fw-semibold small">Appearance Expectations</label>
                            <textarea id="squadRoleAppearanceExpectations" name="squadRoleAppearanceExpectations"
                                      rows="8" class="form-control font-monospace">{{ config.squadRoleAppearanceExpectations|json_encode }}</textarea>
                            <div class="form-text">Percentage of season matches expected per role (0.0–1.0). e.g. 0.9 = 90% of matches. Translated to actual match counts on the frontend based on season length.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="squadRoleMoraleDecayPerWeek" class="form-label fw-semibold small">Morale Decay Per Week</label>
                            <textarea id="squadRoleMoraleDecayPerWeek" name="squadRoleMoraleDecayPerWeek"
                                      rows="8" class="form-control font-monospace">{{ config.squadRoleMoraleDecayPerWeek|json_encode }}</textarea>
                            <div class="form-text">Weekly morale delta when a player is below their appearance expectation. Negative = morale loss.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="squadRoleMoraleBoostPerWeek" class="form-label fw-semibold small">Morale Boost Per Week</label>
                            <textarea id="squadRoleMoraleBoostPerWeek" name="squadRoleMoraleBoostPerWeek"
                                      rows="8" class="form-control font-monospace">{{ config.squadRoleMoraleBoostPerWeek|json_encode }}</textarea>
                            <div class="form-text">Weekly morale delta when a player exceeds their appearance expectation. Positive = morale gain.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="squadRoleAutoAssignThresholds" class="form-label fw-semibold small">Auto-Assign Thresholds</label>
                            <textarea id="squadRoleAutoAssignThresholds" name="squadRoleAutoAssignThresholds"
                                      rows="8" class="form-control font-monospace">{{ config.squadRoleAutoAssignThresholds|json_encode }}</textarea>
                            <div class="form-text">Overall rating (0–100) at which a player is auto-assigned to that role during world generation. Highest matching role wins.</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Squad Configuration ────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="squad">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-users text-muted"></i>
                    <span class="fw-semibold small">Squad Configuration</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Defines the minimum and maximum number of players allowed in a club's active squad.
                        The client enforces these limits when signing or releasing players.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="squadSizeMin" class="form-label fw-semibold small">Min Squad Size</label>
                            <input type="number" id="squadSizeMin" name="squadSizeMin"
                                   value="{{ config.squadSizeMin }}"
                                   min="1" max="50" class="form-control">
                            <div class="form-text">Minimum players required in the squad. Default: 11</div>
                        </div>
                        <div class="col-md-6">
                            <label for="squadSizeMax" class="form-label fw-semibold small">Max Squad Size</label>
                            <input type="number" id="squadSizeMax" name="squadSizeMax"
                                   value="{{ config.squadSizeMax }}"
                                   min="1" max="100" class="form-control">
                            <div class="form-text">Maximum players allowed in the squad. Default: 25</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Player Retirement ──────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="retirement">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-person-walking-arrow-right text-muted"></i>
                    <span class="fw-semibold small">Player Retirement</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls when players become eligible to retire and how likely they are to do so each week.
                        Probability scales linearly from 0 at min age up to <strong>Retirement Chance</strong> at max age,
                        at which point retirement is guaranteed.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="retirementMinAge" class="form-label fw-semibold small">Min Age</label>
                            <input type="number" id="retirementMinAge" name="retirementMinAge"
                                   value="{{ config.retirementMinAge }}"
                                   min="30" max="50" class="form-control">
                            <div class="form-text">Earliest age a player can retire. Default: 30</div>
                        </div>
                        <div class="col-md-4">
                            <label for="retirementMaxAge" class="form-label fw-semibold small">Max Age</label>
                            <input type="number" id="retirementMaxAge" name="retirementMaxAge"
                                   value="{{ config.retirementMaxAge }}"
                                   min="35" max="50" class="form-control">
                            <div class="form-text">Age at which retirement is guaranteed. Default: 38</div>
                        </div>
                        <div class="col-md-4">
                            <label for="retirementChance" class="form-label fw-semibold small">Retirement Chance</label>
                            <input type="number" id="retirementChance" name="retirementChance"
                                   value="{{ config.retirementChance }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Weekly probability at max age (0–1). Default: 0.35</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Inbox / Notification Frequencies ───────────────────────── #}
            <div class="card cfg-section" data-section-id="inbox">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-bell text-muted"></i>
                    <span class="fw-semibold small">Inbox &amp; Notification Frequencies</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls how often the system generates recurring inbox notifications for players.
                        Values are in weeks (1–52).
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="facilityMaintenanceFrequencyWeeks" class="form-label fw-semibold small">Facility Maintenance Reminder (weeks)</label>
                            <input type="number" id="facilityMaintenanceFrequencyWeeks" name="facilityMaintenanceFrequencyWeeks"
                                   value="{{ config.facilityMaintenanceFrequencyWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">How often a facility maintenance reminder is sent to the inbox. Default: 4</div>
                        </div>
                        <div class="col-md-6">
                            <label for="systemNotificationFrequencyWeeks" class="form-label fw-semibold small">System Notification Frequency (weeks)</label>
                            <input type="number" id="systemNotificationFrequencyWeeks" name="systemNotificationFrequencyWeeks"
                                   value="{{ config.systemNotificationFrequencyWeeks }}"
                                   min="1" max="52" class="form-control">
                            <div class="form-text">How often general system digest notifications are sent to the inbox. Default: 8</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Wage Multiplier Tiers ───────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="wages">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-money-bill-trend-up text-muted"></i>
                    <span class="fw-semibold small">Wage Multiplier Tiers</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Ability-based multipliers applied when generating player and staff contract values.
                        Pool players never have a club, so the player's own <strong>current ability</strong> determines the tier.<br>
                        Formula: <code>contractValue = currentAbility × rand(min, max) × playerMultiplier</code><br>
                        Tiers are evaluated in order; first entry where current ability &lt; Max Ability wins.
                        Leave Max Ability blank on the last row to catch all higher abilities.
                    </p>

                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="small text-muted fw-semibold">Tier</th>
                                    <th class="small text-muted fw-semibold">Max Ability (exclusive)</th>
                                    <th class="small text-muted fw-semibold">Player ×</th>
                                    <th class="small text-muted fw-semibold">Staff ×</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for i, tier in config.wageMultiplierTiers %}
                                <tr>
                                    <td class="small fw-semibold text-muted">Tier {{ i + 1 }}</td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][maxAbility]"
                                               value="{{ tier.maxAbility ?? '' }}"
                                               min="0" max="100" placeholder="∞ (default)"
                                               class="form-control form-control-sm" style="width:140px;">
                                    </td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][playerMultiplier]"
                                               value="{{ tier.playerMultiplier }}"
                                               min="0" step="0.1" class="form-control form-control-sm" style="width:100px;">
                                    </td>
                                    <td>
                                        <input type="number" name="wageMultiplierTiers[{{ i }}][staffMultiplier]"
                                               value="{{ tier.staffMultiplier }}"
                                               min="0" step="0.1" class="form-control form-control-sm" style="width:100px;">
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="contractValueRandMin" class="form-label fw-semibold small">Rand Min</label>
                            <input type="number" id="contractValueRandMin" name="contractValueRandMin"
                                   value="{{ config.contractValueRandMin }}"
                                   min="1" class="form-control">
                            <div class="form-text">Lower bound of the random multiplier. Default: 10</div>
                        </div>
                        <div class="col-md-4">
                            <label for="contractValueRandMax" class="form-label fw-semibold small">Rand Max</label>
                            <input type="number" id="contractValueRandMax" name="contractValueRandMax"
                                   value="{{ config.contractValueRandMax }}"
                                   min="1" class="form-control">
                            <div class="form-text">Upper bound of the random multiplier. Must be ≥ Rand Min. Default: 40</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Manager Sacking ─────────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="sacking">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-person-walking-arrow-right text-muted"></i>
                    <span class="fw-semibold small">Manager Sacking</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls when fan sacking demands are raised and resolved, and the attendance
                        penalty applied while a demand is active.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="managerSackingWinRatioTrigger" class="form-label fw-semibold small">Win Ratio Trigger</label>
                            <input type="number" id="managerSackingWinRatioTrigger" name="managerSackingWinRatioTrigger"
                                   value="{{ config.managerSackingWinRatioTrigger }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Win % below which sacking demand fires (0–1). Default: 0.20</div>
                        </div>
                        <div class="col-md-3">
                            <label for="managerSackingWinRatioRecovery" class="form-label fw-semibold small">Win Ratio Recovery</label>
                            <input type="number" id="managerSackingWinRatioRecovery" name="managerSackingWinRatioRecovery"
                                   value="{{ config.managerSackingWinRatioRecovery }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Win % above which demand is resolved (0–1). Default: 0.25</div>
                        </div>
                        <div class="col-md-3">
                            <label for="managerSackingMinGames" class="form-label fw-semibold small">Min Games Before Trigger</label>
                            <input type="number" id="managerSackingMinGames" name="managerSackingMinGames"
                                   value="{{ config.managerSackingMinGames }}"
                                   min="0" max="200" class="form-control">
                            <div class="form-text">Games played before trigger can fire. Default: 30</div>
                        </div>
                        <div class="col-md-3">
                            <label for="managerSackingAttendancePenaltyPerWeek" class="form-label fw-semibold small">Weekly Attendance Penalty</label>
                            <input type="number" id="managerSackingAttendancePenaltyPerWeek" name="managerSackingAttendancePenaltyPerWeek"
                                   value="{{ config.managerSackingAttendancePenaltyPerWeek }}"
                                   min="0" max="1" step="0.01" class="form-control">
                            <div class="form-text">Weekly attendance drop while demand is active (0–1). Default: 0.05</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Cards & Discipline ──────────────────────────────────────── #}
            <div class="card cfg-section" data-section-id="cards">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    <i class="fa fa-rectangle-xmark text-muted"></i>
                    <span class="fw-semibold small">Cards &amp; Discipline</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Controls yellow and red card probabilities and suspension lengths. The frontend
                        scales these values by a player's temperament trait before applying them.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="yellowCardBaseChance" class="form-label fw-semibold small">Yellow Card Base Chance</label>
                            <input type="number" id="yellowCardBaseChance" name="yellowCardBaseChance"
                                   value="{{ config.yellowCardBaseChance }}"
                                   step="0.01" min="0.0" max="1.0" class="form-control">
                            <div class="form-text">Base probability per player per match. Default: 0.08</div>
                        </div>
                        <div class="col-md-4">
                            <label for="redCardBaseChance" class="form-label fw-semibold small">Red Card Base Chance</label>
                            <input type="number" id="redCardBaseChance" name="redCardBaseChance"
                                   value="{{ config.redCardBaseChance }}"
                                   step="0.001" min="0.0" max="1.0" class="form-control">
                            <div class="form-text">Direct red card probability per player per match. Default: 0.01</div>
                        </div>
                        <div class="col-md-4">
                            <label for="temperamentCardScale" class="form-label fw-semibold small">Temperament Scale</label>
                            <input type="number" id="temperamentCardScale" name="temperamentCardScale"
                                   value="{{ config.temperamentCardScale }}"
                                   step="0.1" min="0.0" max="5.0" class="form-control">
                            <div class="form-text">How much temperament affects card probability. Default: 1.0</div>
                        </div>
                        <div class="col-md-6">
                            <label for="yellowCardAccumulationThreshold" class="form-label fw-semibold small">Yellow Accumulation Threshold</label>
                            <input type="number" id="yellowCardAccumulationThreshold" name="yellowCardAccumulationThreshold"
                                   value="{{ config.yellowCardAccumulationThreshold }}"
                                   step="1" min="1" class="form-control">
                            <div class="form-text">Yellows before automatic one-match suspension. Default: 5</div>
                        </div>
                        <div class="col-md-6">
                            <label for="redCardSuspensionMatches" class="form-label fw-semibold small">Red Card Suspension (matches)</label>
                            <input type="number" id="redCardSuspensionMatches" name="redCardSuspensionMatches"
                                   value="{{ config.redCardSuspensionMatches }}"
                                   step="1" min="1" class="form-control">
                            <div class="form-text">Matches banned for a direct red card. Default: 1</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>{# /gap wrapper #}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary btn-sm">Save Game Config</button>
        </div>
    </form>
    </div>

</div>

<script>
(function () {
    var STORAGE_KEY = 'gc_active_tab';
    var tabs   = Array.from(document.querySelectorAll('.cfg-tab'));
    var panels = Array.from(document.querySelectorAll('.cfg-section'));

    if (!tabs.length || !panels.length) return;

    function activate(id) {
        panels.forEach(function (p) {
            p.style.display = p.dataset.sectionId === id ? '' : 'none';
        });
        tabs.forEach(function (t) {
            var active = t.dataset.tab === id;
            t.classList.toggle('btn-primary',          active);
            t.classList.toggle('btn-outline-secondary', !active);
        });
        try { localStorage.setItem(STORAGE_KEY, id); } catch (e) {}
    }

    tabs.forEach(function (t) {
        t.addEventListener('click', function () { activate(t.dataset.tab); });
    });

    var saved = null;
    try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}
    var validIds = panels.map(function (p) { return p.dataset.sectionId; });
    activate(saved && validIds.indexOf(saved) !== -1 ? saved : tabs[0].dataset.tab);
})();
</script>
{% endblock %}
