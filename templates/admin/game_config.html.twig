            {# ── Morale / Motivation: squad role morale ── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="squad-role-morale" data-group="morale-motivation">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">SQUAD ROLE MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Weekly morale change by squad role when a player is under or over their appearance expectation (set under League Config → Squad Roles). Edit each as a JSON object keyed by role slug.
                    </p>

                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-field-col">
                            <label for="squadRoleMoraleDecayPerWeek">Morale Decay Per Week</label>
                            <textarea id="squadRoleMoraleDecayPerWeek" name="squadRoleMoraleDecayPerWeek"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleMoraleDecayPerWeek|json_encode }}</textarea>
                            <div class="bmc-data">Weekly morale delta when a player is below their appearance expectation. Negative = morale loss.</div>
                        </div>
                        <div class="bmc-field-col">
                            <label for="squadRoleMoraleBoostPerWeek">Morale Boost Per Week</label>
                            <textarea id="squadRoleMoraleBoostPerWeek" name="squadRoleMoraleBoostPerWeek"
                                      rows="8"  data-kind="text" data-blank="ok">{{ config.squadRoleMoraleBoostPerWeek|json_encode }}</textarea>
                            <div class="bmc-data">Weekly morale delta when a player exceeds their appearance expectation. Positive = morale gain.</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Morale / Motivation: starting morale ── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="morale" data-group="morale-motivation">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">STARTING MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Range used when assigning starting morale to newly recruited or generated entities.
                        A random value between min and max is selected at creation time.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DEFAULT MORALE MIN</span><span class="bmc-setting__help">Minimum starting morale (0–100). Default: 50</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="defaultMoraleMin" value="{{ config.defaultMoraleMin }}" data-saved="{{ config.defaultMoraleMin }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="default morale min"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DEFAULT MORALE MAX</span><span class="bmc-setting__help">Maximum starting morale (0–100). Default: 80</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="defaultMoraleMax" value="{{ config.defaultMoraleMax }}" data-saved="{{ config.defaultMoraleMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="default morale max"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Morale / Motivation: cliques & bonds ── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="morale-social" data-group="morale-motivation">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">CLIQUES &AMP; BONDS MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Morale and motivation consequences of the bond and clique systems. The bonds themselves are set under Player Development → Bond System and Clique System.
                    </p>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">CLIQUES</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">CLIQUE BLEED SHARE</span><span class="bmc-setting__help">Share (0–1) of a disgruntled player's motivation hit that spreads to the rest of their clique. Default: 0.3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="cliqueMotivationBleedShare" value="{{ config.cliqueMotivationBleedShare }}" data-saved="{{ config.cliqueMotivationBleedShare }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="clique bleed share"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">BOND MORALE CONSEQUENCES</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE DECAY CHANCE</span><span class="bmc-setting__help">Weekly chance an entity with negative relations loses morale. Default: 0.1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMoraleDecayChance" value="{{ config.bondMoraleDecayChance }}" data-saved="{{ config.bondMoraleDecayChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="morale decay chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE DECAY PENALTY</span><span class="bmc-setting__help">Morale lost when that roll passes. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="bondMoraleDecayPenalty" value="{{ config.bondMoraleDecayPenalty }}" data-saved="{{ config.bondMoraleDecayPenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="morale decay penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST THRESHOLD</span><span class="bmc-setting__help">Coach↔manager value below this arms trust decay. Default: -20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustThreshold" value="{{ config.coachManagerTrustThreshold }}" data-saved="{{ config.coachManagerTrustThreshold }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="coach trust threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST CHANCE</span><span class="bmc-setting__help">Weekly chance a distrusting coach loses morale. Default: 0.15</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustDecayChance" value="{{ config.coachManagerTrustDecayChance }}" data-saved="{{ config.coachManagerTrustDecayChance }}" data-kind="decimal" data-min="0" data-max="1" inputmode="decimal" aria-label="coach trust chance"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">COACH TRUST PENALTY</span><span class="bmc-setting__help">Morale a distrusting coach loses. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachManagerTrustMoralePenalty" value="{{ config.coachManagerTrustMoralePenalty }}" data-saved="{{ config.coachManagerTrustMoralePenalty }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="coach trust penalty"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Morale / Motivation: staff & manager ── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="staff-morale" data-group="morale-motivation">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">STAFF &AMP; MANAGER MORALE</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Morale granted to all staff (every coach including manager, DOF, chairman and facility manager, plus every scout) after a win or draw, banded by each member's current morale so gains shrink as morale rises. Losses grant nothing here. The band factors scale every other staff morale gain the same way. Facility build morale lives under Facility Config → Facility Staff Morale.
                    </p>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">MATCH RESULT GAINS</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WIN: LOW BAND</span><span class="bmc-setting__help">Staff morale gained on a win while morale is in the low band. Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleWinLow" value="{{ config.staffResultMoraleWinLow }}" data-saved="{{ config.staffResultMoraleWinLow }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="win: low band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WIN: MID BAND</span><span class="bmc-setting__help">Staff morale gained on a win while morale is in the mid band. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleWinMid" value="{{ config.staffResultMoraleWinMid }}" data-saved="{{ config.staffResultMoraleWinMid }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="win: mid band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">WIN: HIGH BAND</span><span class="bmc-setting__help">Staff morale gained on a win above the mid band. Default: 2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleWinHigh" value="{{ config.staffResultMoraleWinHigh }}" data-saved="{{ config.staffResultMoraleWinHigh }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="win: high band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DRAW: LOW BAND</span><span class="bmc-setting__help">Staff morale gained on a draw while morale is in the low band. Default: 5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleDrawLow" value="{{ config.staffResultMoraleDrawLow }}" data-saved="{{ config.staffResultMoraleDrawLow }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="draw: low band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DRAW: MID BAND</span><span class="bmc-setting__help">Staff morale gained on a draw while morale is in the mid band. Default: 3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleDrawMid" value="{{ config.staffResultMoraleDrawMid }}" data-saved="{{ config.staffResultMoraleDrawMid }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="draw: mid band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DRAW: HIGH BAND</span><span class="bmc-setting__help">Staff morale gained on a draw above the mid band. Default: 1</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleDrawHigh" value="{{ config.staffResultMoraleDrawHigh }}" data-saved="{{ config.staffResultMoraleDrawHigh }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="draw: high band"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">MORALE BANDS</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOW BAND UP TO</span><span class="bmc-setting__help">Highest morale (inclusive) that counts as the low band. Default: 50</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleLowBandMax" value="{{ config.staffResultMoraleLowBandMax }}" data-saved="{{ config.staffResultMoraleLowBandMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="low band up to"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MID BAND UP TO</span><span class="bmc-setting__help">Highest morale (inclusive) that counts as the mid band. Default: 80</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffResultMoraleMidBandMax" value="{{ config.staffResultMoraleMidBandMax }}" data-saved="{{ config.staffResultMoraleMidBandMax }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="mid band up to"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MID BAND FACTOR</span><span class="bmc-setting__help">Diminishing returns while morale is in the mid band. Default: 0.6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="staffMoraleBandFactorMid" value="{{ config.staffMoraleBandFactorMid }}" data-saved="{{ config.staffMoraleBandFactorMid }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="mid band factor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
