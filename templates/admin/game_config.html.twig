                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BROKEN GAME-TIME PROMISE</span><span class="bmc-setting__help">Motivation change when a game-time promise is broken. Default: -40</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gametimePromiseBrokenMotivationDelta" value="{{ config.gametimePromiseBrokenMotivationDelta }}" data-saved="{{ config.gametimePromiseBrokenMotivationDelta }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="broken game-time promise"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BROKEN CONTRACT PROMISE</span><span class="bmc-setting__help">Motivation change when a contract promise is broken. Default: -40</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="playerContractPromiseBrokenMotivationDelta" value="{{ config.playerContractPromiseBrokenMotivationDelta }}" data-saved="{{ config.playerContractPromiseBrokenMotivationDelta }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="broken contract promise"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">KEPT GAME-TIME PROMISE</span><span class="bmc-setting__help">Motivation gained when a game-time promise is honoured. Default: 8</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gametimePromiseKeptMotivationDelta" value="{{ config.gametimePromiseKeptMotivationDelta }}" data-saved="{{ config.gametimePromiseKeptMotivationDelta }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="kept game-time promise"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">CONTRACT ROLE BREACH</span><span class="bmc-setting__help">Weekly motivation change while a contract role guarantee is in breach, before ambition scaling. Default: -2</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="contractBreachMotivationDelta" value="{{ config.contractBreachMotivationDelta }}" data-saved="{{ config.contractBreachMotivationDelta }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="contract role breach"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <span class="bmc-lbl bmc-lbl--ink" style="margin-top:10px">MORALE</span>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">KEPT PROMISE: MORALE</span><span class="bmc-setting__help">Morale gained when a game-time promise is kept. Default: 10</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gametimePromiseKeptMoraleDelta" value="{{ config.gametimePromiseKeptMoraleDelta }}" data-saved="{{ config.gametimePromiseKeptMoraleDelta }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="kept promise: morale"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">BROKEN PROMISE: MORALE</span><span class="bmc-setting__help">Morale change when a game-time promise is broken. Default: -20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="gametimePromiseBrokenMoraleDelta" value="{{ config.gametimePromiseBrokenMoraleDelta }}" data-saved="{{ config.gametimePromiseBrokenMoraleDelta }}" data-kind="int" data-min="-100" data-max="0" inputmode="numeric" aria-label="broken promise: morale"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
