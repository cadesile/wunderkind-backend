                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls how coach attribute specialisms (pace, technical, vision, power, stamina, heart)
                        scale player XP gain, and how morale and stacking across multiple coaches are handled.
                    </p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MAX XP MULTIPLIER</span><span class="bmc-setting__help">Max XP multiplier at specialism 100. Default: 2.0</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachDevelopmentMaxMultiplier" value="{{ config.coachDevelopmentMaxMultiplier }}" data-saved="{{ config.coachDevelopmentMaxMultiplier }}" data-kind="decimal" data-min="1.0" data-max="5.0" inputmode="decimal" aria-label="max xp multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MIN SPECIALISM THRESHOLD</span><span class="bmc-setting__help">Minimum specialism before any bonus applies (0–100). Default: 20</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachDevelopmentMinSpecialism" value="{{ config.coachDevelopmentMinSpecialism }}" data-saved="{{ config.coachDevelopmentMinSpecialism }}" data-kind="int" data-min="0" data-max="100" inputmode="numeric" aria-label="min specialism threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">STACKING FACTOR</span><span class="bmc-setting__help">0 = best coach only, 1 = full linear stack. Default: 0.3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachDevelopmentStackingFactor" value="{{ config.coachDevelopmentStackingFactor }}" data-saved="{{ config.coachDevelopmentStackingFactor }}" data-kind="decimal" data-min="0.0" data-max="1.0" inputmode="decimal" aria-label="stacking factor"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MORALE INFLUENCE</span><span class="bmc-setting__help">Exponent: 0.5 = square root scaling with morale. Default: 0.5</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="coachMoraleInfluence" value="{{ config.coachMoraleInfluence }}" data-saved="{{ config.coachMoraleInfluence }}" data-kind="decimal" data-min="0.0" data-max="2.0" inputmode="decimal" aria-label="morale influence"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Physical Degradation & Form ─────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="physical-degradation" data-group="player-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">PHYSICAL DEGRADATION &AMP; FORM</span></div>
                <div class="bmc-card__body">
                    <p class="bmc-bodytext">
                        Controls the hard cap on individual player attributes, physical pace/stamina
                        decay after a configurable age threshold, and how recent match form influences
                        the weekly development multiplier.
                    </p>

                    <p class="fw-semibold small mb-2">Attribute Cap</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">ATTRIBUTE HARD CAP</span><span class="bmc-setting__help">Maximum value for any individual player attribute</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="attributeHardCap" value="{{ config.attributeHardCap }}" data-saved="{{ config.attributeHardCap }}" data-kind="int" data-min="1" data-max="100" inputmode="numeric" aria-label="attribute hard cap"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <p class="fw-semibold small mb-2">Physical Degradation (after age threshold)</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">AGE THRESHOLD</span><span class="bmc-setting__help">Age degradation begins (players at or below this age are unaffected)</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="physicalDegradationAgeThreshold" value="{{ config.physicalDegradationAgeThreshold }}" data-saved="{{ config.physicalDegradationAgeThreshold }}" data-kind="int" data-min="25" data-max="40" inputmode="numeric" aria-label="age threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MILD RATE (THRESHOLD+1 TO +3)</span><span class="bmc-setting__help">Weekly pace/stamina loss: age threshold+1 to threshold+3</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="physicalDegradationRateMild" value="{{ config.physicalDegradationRateMild }}" data-saved="{{ config.physicalDegradationRateMild }}" data-kind="decimal" data-min="0" data-max="2.0" inputmode="decimal" aria-label="mild rate (threshold+1 to +3)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MODERATE RATE (THRESHOLD+4 TO +6)</span><span class="bmc-setting__help">Weekly loss: age threshold+4 to threshold+6</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="physicalDegradationRateModerate" value="{{ config.physicalDegradationRateModerate }}" data-saved="{{ config.physicalDegradationRateModerate }}" data-kind="decimal" data-min="0" data-max="2.0" inputmode="decimal" aria-label="moderate rate (threshold+4 to +6)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">SEVERE RATE (THRESHOLD+7+)</span><span class="bmc-setting__help">Weekly loss: age threshold+7 and above</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="physicalDegradationRateSevere" value="{{ config.physicalDegradationRateSevere }}" data-saved="{{ config.physicalDegradationRateSevere }}" data-kind="decimal" data-min="0" data-max="2.0" inputmode="decimal" aria-label="severe rate (threshold+7+)"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">PERSONALITY SCALE</span><span class="bmc-setting__help">How much heart/determination trait reduces degradation rate</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="physicalDegradationPersonalityScale" value="{{ config.physicalDegradationPersonalityScale }}" data-saved="{{ config.physicalDegradationPersonalityScale }}" data-kind="decimal" data-min="0" data-max="1.0" inputmode="decimal" aria-label="personality scale"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>

                    <p class="fw-semibold small mb-2">Form &amp; Development</p>
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MATCH COUNT</span><span class="bmc-setting__help">Recent matches used for form average</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="formDevelopmentMatchCount" value="{{ config.formDevelopmentMatchCount }}" data-saved="{{ config.formDevelopmentMatchCount }}" data-kind="int" data-min="1" data-max="20" inputmode="numeric" aria-label="match count"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">FULL DEVELOPMENT THRESHOLD</span><span class="bmc-setting__help">Rating average for full development (1.0×)</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="formDevelopmentThreshold" value="{{ config.formDevelopmentThreshold }}" data-saved="{{ config.formDevelopmentThreshold }}" data-kind="decimal" data-min="1" data-max="10" inputmode="decimal" aria-label="full development threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOW THRESHOLD</span><span class="bmc-setting__help">Rating average below which low multiplier applies</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="formDevelopmentThresholdLow" value="{{ config.formDevelopmentThresholdLow }}" data-saved="{{ config.formDevelopmentThresholdLow }}" data-kind="decimal" data-min="1" data-max="10" inputmode="decimal" aria-label="low threshold"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">MID MULTIPLIER</span><span class="bmc-setting__help">Development rate between low and full threshold</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="formDevelopmentMultiplierMid" value="{{ config.formDevelopmentMultiplierMid }}" data-saved="{{ config.formDevelopmentMultiplierMid }}" data-kind="decimal" data-min="0" data-max="1.0" inputmode="decimal" aria-label="mid multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">LOW MULTIPLIER</span><span class="bmc-setting__help">Development rate below low threshold</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="formDevelopmentMultiplierLow" value="{{ config.formDevelopmentMultiplierLow }}" data-saved="{{ config.formDevelopmentMultiplierLow }}" data-kind="decimal" data-min="0" data-max="1.0" inputmode="decimal" aria-label="low multiplier"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
                    </div>
                </div>
            </div>

            {# ── Reputation ─────────────────────────────────────────────── #}
            <div class="bmc-card cfg-section" data-domain="club" data-section-id="reputation" data-group="club-dev">
                <div class="bmc-card__head"><i data-lucide="sliders-horizontal"></i><span class="bmc-card__title">REPUTATION</span></div>
                <div class="bmc-card__body">
                    <div class="bmc-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px">
                        <div class="bmc-setting" data-bmc-setting><div class="bmc-setting__text"><span class="bmc-setting__label">DELTA BASE</span><span class="bmc-setting__help">Base reputation delta per week before facility multiplier. Default: 0.15</span><span class="bmc-setting__hint" data-bmc-hint data-default=""></span></div><div class="bmc-setting__ctl"><label class="bmc-num bmc-num--104"><input name="reputationDeltaBase" value="{{ config.reputationDeltaBase }}" data-saved="{{ config.reputationDeltaBase }}" data-kind="decimal" data-min="0" inputmode="decimal" aria-label="delta base"></label><button type="button" class="bmc-revert" hidden title="Revert to saved"><i data-lucide="rotate-ccw" width="16" height="16"></i></button></div></div>
