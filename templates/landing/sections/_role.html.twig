{% import 'landing/sections/_shot.html.twig' as shot %}

<!-- ═══════════════════════════════ YOUR ROLE ═══════════════════════════════ -->
<section class="role-section" id="your-role">
    <div class="wrap">
        <div class="section-label">Your Role</div>
        <h2 class="section-title">You're the chairman. Not the gaffer.</h2>
        <p class="section-sub">Delegate matchday tactics to your manager and scouting to your Director of Football. Your job is the bigger picture: balancing multi-million pound budgets, expanding state-of-the-art facilities, negotiating brutal player contracts, and managing board expectations. Your Manager Personality Traits — Temperament, Discipline, Ambition — shift with every decision you make. The board notices. So do the players.</p>

        <div class="role-grid">
            <div class="role-col role-col-owner">
                <div class="role-col-title">YOU CONTROL</div>
                <ul class="role-list">
                    <li>Capital allocation &amp; financial decisions</li>
                    <li>Facility investment &amp; infrastructure build-out</li>
                    <li>Staff hiring across 6 distinct roles</li>
                    <li>Sponsor negotiations &amp; investor equity deals</li>
                    <li>Agent &amp; guardian relations</li>
                    <li>Club identity, kit colours &amp; strategic direction</li>
                </ul>
            </div>
            <div class="role-col role-col-staff">
                <div class="role-col-title">YOUR STAFF HANDLE</div>
                <ul class="role-list">
                    <li><span class="role-staff-name">Manager</span>Formation &amp; playing style — override anytime</li>
                    <li><span class="role-staff-name">Director of Football</span>Scouting, signings &amp; transfers — delegate or control</li>
                    <li><span class="role-staff-name">Facility Manager</span>Upkeep, repairs &amp; auto-maintenance</li>
                    <li><span class="role-staff-name">Scout</span>Talent identification &amp; player reports</li>
                    <li><span class="role-staff-name">Chairman</span>Board relations &amp; club governance</li>
                </ul>
            </div>
        </div>

        {# Paired with the closing text rather than dropped underneath it on its
           own — a lone tall phone shot centred under a full-width block reads as
           an orphan and leaves a column of dead space either side. #}
        <div class="feature-split is-reversed" style="margin-top:32px;">
            <figure class="feature-shot">
                {{ shot.img('club-value-budget', 'Club finances — £7.0m club value, £6.2m balance, and budget allocation sliders splitting the pot between transfers, facilities and an operating reserve', false, 340) }}
                <figcaption>Club value, balance and where the money goes</figcaption>
            </figure>

            <p class="role-footer" style="margin-top:0;">Delegate everything to your DoF and Manager and focus on the boardroom — or override every decision yourself. The level of involvement is always your choice. Promotion means your decisions worked, not just your tactics.</p>
        </div>
    </div>
</section>
