{#
   Closing CTA. Keeps id="download" even though the design anchors the header's
   PLAY NOW at the hero's #get instead — older inbound links and the privacy/beta
   modals' own copy point here, and an id costs nothing to keep.

   #download-note is written by landing.js from /api/app-links: it names whichever
   platforms are not yet available, and otherwise states the three things that are
   true on both (free, offline, no gameplay ads).
#}
<section class="cta-section" id="download">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="wrap">
        <h2 class="cta-title">TAKE THE <span class="glow-gold">OWNER'S SEAT.</span></h2>
        <p class="cta-sub">Live on Google Play now. Join the iOS build on TestFlight.</p>

        <div class="cta-actions" id="download-buttons">
            <a href="#" class="btn btn-gold btn-lg" data-store-link="android" style="display:none">GET IT ON GOOGLE PLAY</a>
            <a href="#" class="btn btn-outline btn-lg" data-store-link="ios" style="display:none">JOIN ON TESTFLIGHT</a>
            <button type="button" class="btn btn-outline btn-lg" onclick="openBetaModal()">REQUEST ACCESS</button>
        </div>

        <p id="download-note" class="cta-note"></p>
    </div>
</section>
