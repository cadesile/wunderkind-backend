<section class="cta-section" id="download">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="wrap">
        <h2>Ready to take the chair?</h2>
        <p class="cta-sub">Start your journey at the bottom of the pyramid today. Build My Club is in active Android beta — beta slots are limited, and the market pool is scarcity-driven from day one. Get in early, get ranked, and start building your legacy before the competition does.</p>
        <div class="cta-actions" id="download-buttons">
            <a href="#" id="android-download-btn" class="btn btn-gold btn-lg" aria-label="Get it on Google Play" style="display:none">Get it on Google Play</a>
            <a href="#" id="ios-download-btn" class="btn btn-outline btn-lg" aria-label="Download iOS" style="display:none">Download (iOS)</a>
            <button type="button" class="btn btn-outline btn-lg" onclick="openBetaModal()">Join the iOS beta</button>
        </div>
        <p id="download-note" style="margin-top:24px; font-size:11px; color:var(--text-muted);"></p>
    </div>
</section>
