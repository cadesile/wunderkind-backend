{#
   Archetype showcase, read from the live catalogue rather than hard-coded.

   Four positive then four negative, filling the two rows of the existing
   four-column grid, re-sampled on every page load by ArchetypeShowcaseService.
   Polarity drives the accent colour AND carries a text label — colour alone
   would leave the split invisible to anyone who cannot distinguish red from
   green, which is precisely the distinction being drawn here.
#}
{% set positive = archetypes.positive|default([]) %}
{% set negative = archetypes.negative|default([]) %}

{% if positive is not empty or negative is not empty %}
    <!-- ═══════════════════════════════ ARCHETYPES ═══════════════════════════════ -->
    <section id="archetypes">
        <div class="wrap">
            <div class="section-label">Player Archetypes</div>
            <h2 class="section-title">Every player has a type. Know who you're signing.</h2>
            <p class="section-sub">
                Archetypes are derived from a player's 8-trait personality matrix and are
                visible before you consume them from the pool. Every player resolves to one
                positive and one negative type — the question is never whether a signing has
                a flaw, only whether you can live with it.
            </p>

            <div class="archetype-grid">
                {% for archetype in positive %}
                    <div class="archetype-card mint">
                        <span class="archetype-tag is-positive">Positive</span>
                        <div class="archetype-name">{{ archetype.name }}</div>
                        <p class="archetype-desc">{{ archetype.description }}</p>
                    </div>
                {% endfor %}

                {% for archetype in negative %}
                    <div class="archetype-card red">
                        <span class="archetype-tag is-negative">Negative</span>
                        <div class="archetype-name">{{ archetype.name }}</div>
                        <p class="archetype-desc">{{ archetype.description }}</p>
                    </div>
                {% endfor %}
            </div>

            <p class="archetype-footnote">
                A random draw from the {{ archetypes.total }}-archetype catalogue
                ({{ archetypes.totalPositive }} positive, {{ archetypes.totalNegative }} negative) —
                reload for a different set.
            </p>
        </div>
    </section>

    <hr class="divider">
{% endif %}
