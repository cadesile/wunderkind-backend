<!-- ═══════════════════════════════ STATS BAND ═══════════════════════════════ -->
<div class="stats-band">
    <div class="wrap stats-inner">
        <div class="stat-block">
            <span class="stat-num">{{ world.totals.npcClubs }}</span>
            <span class="stat-lbl">NPC clubs simulated across {{ world.totals.tierCount }} tiers</span>
        </div>
        <div class="stat-block">
            <span class="stat-num">{{ world.totals.leaderboardCategories }}</span>
            <span class="stat-lbl">Global leaderboard categories</span>
        </div>
        <div class="stat-block">
            <span class="stat-num">8</span>
            <span class="stat-lbl">Personality traits per player</span>
        </div>
        <div class="stat-block">
            <span class="stat-num">100%</span>
            <span class="stat-lbl">Offline-first, integrity synced</span>
        </div>
    </div>
</div>
