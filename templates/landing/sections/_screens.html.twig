{% import 'landing/sections/_shot.html.twig' as shot %}

<!-- ═══════════════════════════════ SCREENSHOTS ═══════════════════════════════ -->
{#
   Gallery rebuilt from the October 2026 captures (public/screenshots/2026-10/).
   The previous August set no longer matched the shipped UI, so it was replaced
   wholesale rather than topped up — a gallery that mixes two generations of the
   interface reads as inconsistency, not history. Every one of the 21 October
   captures appears somewhere on the page; the full set is shown here since this
   section's entire point is "no mockups, no renders."
#}
<section class="screenshots-section" id="screenshots">
    <div class="wrap">
        <div class="section-label">Real Screenshots</div>
        <h2 class="section-title">No mockups. No renders.</h2>
        <p class="section-sub">Every frame taken from the live build on Google Play.</p>
    </div>

    {# Featured three #}
    <div class="bento-phones" aria-label="Featured screenshots">
        {% set featured = [
            { name: 'story-event-chemistry', label: 'Story Events',  alt: 'Story event "Instant Chemistry" — a scored goal triggers a bonding moment between two players, each gaining morale' },
            { name: 'tactics-first-xi',      label: 'Tactics',       alt: 'First XI in a 4-3-3 direct formation with star ratings and form arrows per player' },
            { name: 'match-result-ratings',  label: 'Match Day',     alt: 'Match result screen — player stats tab showing individual ratings for every outfield position' }
        ] %}
        {% for item in featured %}
            <div class="bento-phone-frame">
                <div class="bento-phone-outer">
                    <div class="bento-phone-screen">
                        {{ shot.img(item.name, item.alt, false, 304, '2026-10') }}
                    </div>
                </div>
                <span class="bento-phone-label">{{ item.label }}</span>
            </div>
        {% endfor %}
    </div>

    {# Full gallery — deliberately outside .wrap so the track runs full-bleed.
       .screenshot-scroll only provides overflow; .screenshot-track is the flex
       container, and without it the frames stack vertically. #}
    <div class="screenshot-scroll" role="region" aria-label="Game screenshots">
        <div class="screenshot-track">
            {% set gallery = [
                { name: 'owner-identity',            label: 'Your Identity',    alt: 'Club identity screen — owner avatar, nationality, club and stadium name, club value and reputation progress' },
                { name: 'chairman-duties',           label: 'Chairman',         alt: 'Chairman staff screen — season mandate, facility discount sign-off, investor offers, auto-decide toggle' },
                { name: 'manager-duties',             label: 'Manager',          alt: 'Manager staff screen — matchday selection, training pace, win rate, auto-manage player events toggle' },
                { name: 'dof-scouting-priorities',    label: 'DoF Priorities',   alt: 'Director of Football scouting priorities — positions, age brackets, emergency band-aid flag, scouting reach' },
                { name: 'agent-tiers',                label: 'Agent Tiers',      alt: 'Agent directory — Elite, Reputable, Notable, Recognised tabs with tier, rating and client list columns' },
                { name: 'dressing-room-pulse',        label: 'Dressing Room',    alt: 'Dressing room overview — bonded, unformed and friction percentages, average morale, relationship network' },
                { name: 'club-leadership',            label: 'Club Leadership',  alt: 'Rival club profile — Manager, Director of Football, Facility Manager and Chairman leadership grid' },
                { name: 'facility-training',          label: 'Training',         alt: 'Training sector screen — isometric Training Pitch at level two' },
                { name: 'facility-medical',           label: 'Medical',          alt: 'Medical sector screen — isometric Physio Clinic reducing injury probability' },
                { name: 'facility-scouting',          label: 'Scouting',         alt: 'Scouting sector screen — isometric Scouting Centre complex' },
                { name: 'facility-stadium',           label: 'Stadium',          alt: 'Stadium sector screen — capacity, record attendance, isometric stadium render' },
                { name: 'club-facilities-overview',   label: 'Campus',           alt: 'A rival club facilities tab — facilities built out of the full catalogue, total levels across the campus' },
                { name: 'league-table',               label: 'League Table',     alt: 'League standings — season one table with points, goal difference and form' },
                { name: 'browse-leagues',              label: 'Pyramid',          alt: 'Browse Leagues screen — all eight tiers listed with clubs per division and your current league highlighted' },
                { name: 'weekly-tick-processing',      label: 'Weekly Tick',      alt: 'Week advancing — checklist covering squad morale, Director of Football activity, and reports to head office' },
                { name: 'weekly-advance-checklist',    label: 'Advancing',        alt: 'Week advancing — checking squad fitness, preparing fixtures, briefing staff and agents' },
                { name: 'matchday-preview',            label: 'Match Day',        alt: 'Pre-match screen — home and away crests and kits, preparing match or skip to result' },
                { name: 'matchday-ticker-live',        label: 'Live Matchday',    alt: 'Live matchday ticker — 2D pitch with running scoreline, minute counter and commentary at 1x, 2x or 4x speed' }
            ] %}
            {% for item in gallery %}
                <div class="ss-frame">
                    {{ shot.img(item.name, item.alt, false, 190, '2026-10') }}
                    <p class="ss-caption">{{ item.label }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
