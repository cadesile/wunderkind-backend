{% import 'landing/sections/_shot.html.twig' as shot %}

<!-- ═══════════════════════════════ STAFF CONSENSUS ═══════════════════════════════ -->
<section class="consensus-section" id="consensus">
    <div class="wrap">
        <div class="section-label">Scouting &amp; Transfers</div>
        <h2 class="section-title">Multi-perspective scouting &amp; agent dynamics</h2>
        <div class="consensus-inner">
            <div>
                <p class="section-sub">Never buy blind. Gather conflicting feedback from your Manager, Scout, and Director of Football before making an offer. Navigate agent personalities, sign-on fees, and squad role expectations to build a championship-winning squad without going bankrupt.</p>
                <br>
                <p class="section-sub" style="color: var(--text-muted);">Every scout works their own shortlist against the transfer list and free agent pool in parallel. Compare their reports, weigh conflicting staff opinions, and decide who's worth the fee.</p>
            </div>
            <figure class="role-visual">
                {{ shot.img('staff-opinions', 'Signing a free agent — manager, director of football and scout each give a different verdict on whether the squad needs the player', false, 260) }}
                <p class="ss-caption">Three staff, three verdicts, one signing</p>
            </figure>
        </div>
    </div>
</section>

<hr class="divider">
