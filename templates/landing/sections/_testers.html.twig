<!-- ═══════════════════════════════ TESTERS ═══════════════════════════════ -->
<section id="testers" class="consensus-section">
    <div class="wrap">
        <div class="section-label">Testers Wanted</div>
        <h2 class="section-title">Help us break it before the App Store does.</h2>
        <p class="section-sub">
            Android is live on Google Play. iOS is next, and we are recruiting testers now —
            people who will actually play a season, file the odd bug, and tell us when
            something feels wrong.
        </p>

        <div class="features-grid" style="margin-top:40px;">
            <div class="feature-card">
                <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><line x1="10" y1="18.5" x2="14" y2="18.5"/></svg>
                <h3 class="feature-title">iOS TestFlight</h3>
                <p class="feature-desc">Get on the list for the iOS build. Limited slots, and testers get in before general release.</p>
            </div>
            <div class="feature-card">
                <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9a2.8 2.8 0 0 0-5 1.6c0 2.6 5 1.8 5 4.2A2.8 2.8 0 0 1 9.5 15"/><line x1="12" y1="6.5" x2="12" y2="17.5"/></svg>
                <h3 class="feature-title">Perks for active testers</h3>
                <p class="feature-desc">
                    We are planning rewards for testers who stick with it — starting with a
                    boosted transfer kitty on your first club, well above the standard
                    £{{ world.starter.startingBalance|number_format }} start.
                </p>
            </div>
            <div class="feature-card">
                <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="M3 6.5 12 13l9-6.5"/></svg>
                <h3 class="feature-title">Talk to us directly</h3>
                <p class="feature-desc">
                    Email <a href="mailto:admin@buildmyclub.co.uk">admin@buildmyclub.co.uk</a>
                    with your device and how much football management you have played. We read all of them.
                </p>
            </div>
        </div>

        <div class="cta-actions" style="margin-top:32px;">
            <button type="button" class="btn btn-gold btn-lg" onclick="openBetaModal()">Request to join the beta</button>
            <a href="mailto:admin@buildmyclub.co.uk?subject=Build%20My%20Club%20—%20tester%20application" class="btn btn-outline btn-lg">Email the team</a>
        </div>
    </div>
</section>

<hr class="divider">
