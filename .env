# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration


###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="postgresql://wunderkind:wunderkind@database:5432/wunderkind?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> trusted proxies ###
# Empty locally (nothing in front of the app). Deployed environments set this to
# 'private_ranges' so the Caddy reverse proxy on the docker bridge is trusted.
TRUSTED_PROXIES=
###< trusted proxies ###

###> lexik/jwt-authentication-bundle ###
# JWT_SECRET_KEY and JWT_PUBLIC_KEY must be set in .env.local (dev)
# or as CI/CD environment secrets (staging/prod). Never commit key values here.
# Generate keys: lando php bin/console lexik:jwt:generate-keypair --no-pass
JWT_SECRET_KEY=
JWT_PUBLIC_KEY=
###< lexik/jwt-authentication-bundle ###

###> game balance ###
CLUB_STARTING_BALANCE=500000
###< game balance ###

###> leaderboards ###
LEADERBOARD_CACHE_TTL=300
###< leaderboards ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@buildmyclub.co.uk
MAILER_FROM_NAME="Build My Club"
APP_URL=https://www.buildmyclub.co.uk
###< symfony/mailer ###

###> symfony/google-mailer ###
# Gmail SHOULD NOT be used on production, use it in development only.
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
###< symfony/google-mailer ###

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###

###> social account connections ###
# All values below must be set in .env.local (dev) or as CI/CD environment
# secrets (staging/prod). Never commit real values here.
#
# Facebook app credentials (developers.facebook.com — Facebook Login for Business):
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-domain.example/admin/social/facebook/callback
#
# X (Twitter) app credentials (developer.x.com — OAuth 2.0 with PKCE):
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://your-domain.example/admin/social/twitter/callback
#
# 32-byte key (base64), used by TokenEncryptionService to encrypt stored
# OAuth tokens at rest (sodium_crypto_secretbox). Generate with:
#   php -r "echo base64_encode(sodium_crypto_secretbox_keygen()), PHP_EOL;"
SOCIAL_TOKEN_ENCRYPTION_KEY=
###< social account connections ###
