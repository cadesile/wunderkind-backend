# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration


###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="postgresql://wunderkind:wunderkind@database:5432/wunderkind?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> trusted proxies ###
# Empty locally (nothing in front of the app). Deployed environments set this to
# 'private_ranges' so the Caddy reverse proxy on the docker bridge is trusted.
TRUSTED_PROXIES=
###< trusted proxies ###

###> lexik/jwt-authentication-bundle ###
# JWT_SECRET_KEY and JWT_PUBLIC_KEY must be set in .env.local (dev)
# or as CI/CD environment secrets (staging/prod). Never commit key values here.
# Generate keys: lando php bin/console lexik:jwt:generate-keypair --no-pass
JWT_SECRET_KEY=
JWT_PUBLIC_KEY=
###< lexik/jwt-authentication-bundle ###

###> game balance ###
CLUB_STARTING_BALANCE=500000
###< game balance ###

###> leaderboards ###
LEADERBOARD_CACHE_TTL=300
###< leaderboards ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@buildmyclub.co.uk
MAILER_FROM_NAME="Build My Club"
BETA_INVITE_MAILER_FROM=admin@buildmyclub.co.uk
APP_URL=https://www.buildmyclub.co.uk
###< symfony/mailer ###

###> symfony/google-mailer ###
# Gmail SHOULD NOT be used on production, use it in development only.
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
###< symfony/google-mailer ###

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###

###> social account connections ###
# All values below must be set in .env.local (dev) or as CI/CD environment
# secrets (staging/prod). Never commit real values here.
#
# Facebook app credentials (developers.facebook.com — Facebook Login for Business):
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-domain.example/admin/social/facebook/callback
#
# X (Twitter) app credentials (developer.x.com — OAuth 2.0 with PKCE):
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://your-domain.example/admin/social/twitter/callback
#
# 32-byte key (base64), used by TokenEncryptionService to encrypt stored
# OAuth tokens at rest (sodium_crypto_secretbox). Generate with:
#   php -r "echo base64_encode(sodium_crypto_secretbox_keygen()), PHP_EOL;"
SOCIAL_TOKEN_ENCRYPTION_KEY=
###< social account connections ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# auto_setup=1: creates the transport table on first dispatch (no extra deploy step).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> push notifications (Firebase Cloud Messaging) ###
# Raw service-account JSON content (not a file path) for the Firebase project used to send
# push notifications — see src/Service/Notification/FirebaseMessagingFactory.php. Set in
# .env.local for dev; production/dev-server values come from the
# {DEV,PROD}_FIREBASE_SERVICE_ACCOUNT_JSON GitHub secrets (docs/deploy/hetzner.md).
FIREBASE_SERVICE_ACCOUNT_JSON='{}'
###< push notifications (Firebase Cloud Messaging) ###

###> location enrichment ###
# AI-supplied geography for the land economy: coordinates, population and land valuations for
# towns seeded with only a name and a country. See docs/world-generation/location-enrichment.md.
#
# THESE THREE NOW POWER TWO FEATURES, sharing one key deliberately. Enrichment fills in a town
# that already exists; town suggestion (app:locations:suggest-towns, and the admin "Pull towns"
# button) asks for the NAMES of towns a country does not have yet. A separate
# TOWN_SUGGESTER_PROVIDER would be a second thing to set correctly and a second thing to get
# wrong, for no benefit. Both refuse loudly when this is unset, for the same reason.
#
# The two have very different cost shapes. Suggestion is ONE call however many towns come
# back. Enrichment is one billed call PER TOWN — so a suggestion run that adds 300 towns is
# cheap now and has queued up 300 future calls, which happen lazily as players open them.
#
# LOCATION_ENRICHER_PROVIDER picks the implementation, and is what makes the other two take
# effect. Left EMPTY (the default), enrichment REFUSES LOUDLY — every attempt is recorded
# as outcome=error and the admin connection check reports not-ok, which is deliberate:
# an unconfigured enricher must be visible before an 865-row sweep, not after.
#
# To turn it on, set all three — in this file for local work, or as deploy secrets
# ({DEV,PROD}_LOCATION_ENRICHER_*) for dev and prod:
#   LOCATION_ENRICHER_PROVIDER='anthropic'
#   LOCATION_ENRICHER_MODEL='claude-sonnet-5'
#   LOCATION_ENRICHER_API_KEY='sk-ant-...'
#
# MODEL IS A DEPLOY VARIABLE ON PURPOSE, so trying a different one is a redeploy rather than a
# code change. claude-haiku-4-5-20251001 is the cheap option for a bulk sweep;
# claude-sonnet-5 is the default balance; claude-opus-5 if valuation judgement needs to be
# better. Whatever is set is stored on every row it produces (location.enrichment_model), so a
# change is visible per location rather than inferred from timestamps.
#
# THE API KEY IS A SECRET AND THIS FILE IS COMMITTED. Put the real value in .env.local (dev)
# or the deploy secret store (dev/prod) — never here, and never in the database: the config
# export is documented to admins as safe to commit to version control.
LOCATION_ENRICHER_PROVIDER=''
LOCATION_ENRICHER_MODEL='claude-sonnet-5'
LOCATION_ENRICHER_API_KEY=''
###< location enrichment ###
